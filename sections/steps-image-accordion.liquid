{% comment %}
  Steps Image Accordion — unified typography
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,700;0,800;1,700;1,800&display=swap" rel="stylesheet">

<section id="sia-{{ section.id }}" class="section">
  <style>
    #sia-{{ section.id }}{
      --p: #493d9a; --lil: #dad2ff;
      --bg: {{ section.settings.bg | default: '#f8f8f6' }};
      --text: {{ section.settings.text | default: '#1a1a1a' }};
      --muted: {{ section.settings.muted | default: 'rgba(73,61,154,0.72)' }};
      --line: rgba(73,61,154,.18);
      --maxw: {{ section.settings.max_width | default: 1200 }}px;
      --py: {{ section.settings.pad_y | default: 64 }}px;
      --px: {{ section.settings.pad_x | default: 40 }}px;
      --radius: {{ section.settings.radius | default: 18 }}px;
      background: var(--bg); color: var(--text);
    }
    #sia-{{ section.id }} .sia__wrap { max-width: var(--maxw); margin: 0 auto; padding: var(--py) var(--px); }

    /* ─ Section title — unified ─ */
    #sia-{{ section.id }} .sia__header { text-align: center; margin-bottom: 36px; }
    #sia-{{ section.id }} .sia__eyebrow {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 10px; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--p); opacity: 0.72; margin-bottom: 10px;
      justify-content: center;
    }
    #sia-{{ section.id }} .sia__eyebrow::before,
    #sia-{{ section.id }} .sia__eyebrow::after { content: ''; display: inline-block; width: 18px; height: 1.5px; background: var(--p); opacity: 0.5; }
    #sia-{{ section.id }} .sia__title {
      font-family: 'Raleway', system-ui, sans-serif;
      font-size: clamp(26px, 3.4vw, 46px);
      font-weight: 800; line-height: 1.08;
      color: #1a1340; margin: 0;
      letter-spacing: -0.025em;
    }
    #sia-{{ section.id }} .sia__title em { font-style: italic; color: var(--p); }

    #sia-{{ section.id }} .sia__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(22px, 4vw, 56px); align-items: start; }
    #sia-{{ section.id }} .sia__media { border-radius: var(--radius); overflow: hidden; background: rgba(218,210,255,0.55); border: 1px solid rgba(73,61,154,0.16); box-shadow: 0 22px 54px rgba(73,61,154,0.14); }
    #sia-{{ section.id }} .sia__media img, #sia-{{ section.id }} .sia__media svg { width: 100%; height: auto; display: block; }
    #sia-{{ section.id }} .sia__list { border-top: 1px solid var(--line); }
    #sia-{{ section.id }} details.sia__item { border-bottom: 1px solid var(--line); padding: 18px 0; }
    #sia-{{ section.id }} summary.sia__summary { list-style: none; display: grid; grid-template-columns: 1fr auto; gap: 18px; align-items: center; cursor: pointer; user-select: none; }
    #sia-{{ section.id }} summary.sia__summary::-webkit-details-marker { display: none; }
    #sia-{{ section.id }} .sia__meta { display: grid; gap: 6px; }
    #sia-{{ section.id }} .sia__step { font-size: 13px; color: var(--muted); display: inline-flex; gap: 10px; align-items: center; font-weight: 500; }
    #sia-{{ section.id }} .sia__dot { width: 6px; height: 6px; border-radius: 999px; background: var(--p); box-shadow: 0 0 0 6px rgba(178,165,255,0.32); display: inline-block; }
    #sia-{{ section.id }} .sia__heading { font-size: clamp(17px, 1.8vw, 24px); font-weight: 700; margin: 0; line-height: 1.15; color: #1a1a1a; letter-spacing: -0.01em; }
    #sia-{{ section.id }} .sia__icon { width: 40px; height: 40px; border-radius: 10px; overflow: hidden; background: rgba(218,210,255,0.65); border: 1px solid rgba(73,61,154,0.16); display: flex; align-items: center; justify-content: center; flex: none; box-shadow: 0 8px 20px rgba(73,61,154,0.12); transition: transform 0.2s, background 0.2s; padding: 4px; }
    #sia-{{ section.id }} .sia__item:hover .sia__icon { transform: translateX(-4px); background: rgba(218,210,255,0.85); }
    #sia-{{ section.id }} .sia__icon img, #sia-{{ section.id }} .sia__icon svg { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; display: block; }
    #sia-{{ section.id }} .sia__content { padding-top: 12px; max-width: 52ch; color: rgba(26,26,26,0.78); line-height: 1.65; font-size: 14px; }
    #sia-{{ section.id }} details:not([open]) .sia__content { display: none; }
    #sia-{{ section.id }} details.sia__item:hover .sia__heading { color: var(--p); }
    #sia-{{ section.id }} .sia__btn { display: inline-flex; align-items: center; gap: 8px; margin-top: 16px; padding: 12px 22px; border-radius: 999px; background: var(--p); color: #fff; text-decoration: none; font-size: 14px; font-weight: 700; border: none; box-shadow: 0 14px 32px rgba(73,61,154,0.22); transition: transform 0.2s, box-shadow 0.2s, background 0.2s; }
    #sia-{{ section.id }} .sia__btn:hover { transform: translateY(-2px); box-shadow: 0 18px 40px rgba(73,61,154,0.28); background: #3f347f; }

    @media (max-width: 990px) {
      #sia-{{ section.id }} .sia__wrap { padding: 56px 20px; }
      #sia-{{ section.id }} .sia__grid { grid-template-columns: 1fr; gap: 28px; }
      #sia-{{ section.id }} .sia__media { order: 2; max-height: 400px; overflow: hidden; }
      #sia-{{ section.id }} .sia__media img { object-fit: cover; height: 100%; }
      #sia-{{ section.id }} .sia__list { order: 1; }
      #sia-{{ section.id }} .sia__header { margin-bottom: 24px; }
    }
    @media (max-width: 750px) {
      #sia-{{ section.id }} .sia__wrap { padding: 44px 16px; }
      #sia-{{ section.id }} .sia__title { font-size: clamp(22px, 6.5vw, 32px); }
      #sia-{{ section.id }} .sia__heading { font-size: clamp(15px, 4vw, 19px); }
      #sia-{{ section.id }} .sia__icon { width: 32px; height: 32px; padding: 3px; }
      #sia-{{ section.id }} .sia__content { font-size: 13px; }
      #sia-{{ section.id }} .sia__media { border-radius: 14px; max-height: 320px; }
    }
  </style>

  <div class="sia__wrap">
    <div class="sia__header">
      {%- if section.settings.eyebrow != blank -%}<p class="sia__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="sia__title">{{ section.settings.title }}</h2>{%- endif -%}
    </div>
    <div class="sia__grid">
      <div class="sia__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', decoding: 'async', alt: section.settings.image_alt }}
        {%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
      </div>
      <div class="sia__list" role="region">
        {%- assign step_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_index = step_index | plus: 1 -%}
            {%- assign is_open = false -%}
            {%- if step_index == 1 and section.settings.open_first -%}{%- assign is_open = true -%}{%- endif -%}
            <details class="sia__item" {% if is_open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary class="sia__summary">
                <div class="sia__meta">
                  <div class="sia__step"><span class="sia__dot" aria-hidden="true"></span><span>{{ block.settings.step_label }}</span></div>
                  <h3 class="sia__heading">{{ block.settings.heading | escape }}</h3>
                </div>
                <div class="sia__icon" aria-hidden="true">
                  {%- if block.settings.icon != blank -%}{{ block.settings.icon | image_url: width: 220 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
                </div>
              </summary>
              <div class="sia__content">
                {%- if block.settings.body != blank -%}<div class="rte">{{ block.settings.body }}</div>{%- endif -%}
                {%- if block.settings.button_label != blank -%}<a class="sia__btn" href="{{ block.settings.button_link | default: '#' }}">{{ block.settings.button_label | escape }}</a>{%- endif -%}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Steps image list (.ki)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "info": "Örn: Nasıl Çalışır?" },
    { "type": "richtext", "id": "title", "label": "Başlık", "default": "<p>Nasıl kullanılır?</p>" },
    { "type": "checkbox", "id": "open_first", "label": "İlk adımı açık başlat", "default": true },
    { "type": "header", "content": "Sol görsel" },
    { "type": "image_picker", "id": "image", "label": "Görsel" },
    { "type": "text", "id": "image_alt", "label": "Alt metin", "default": "Rutin görseli" },
    { "type": "header", "content": "Layout" },
    { "type": "color", "id": "bg", "label": "Arka plan", "default": "#f8f8f6" },
    { "type": "color", "id": "text", "label": "Metin", "default": "#1a1a1a" },
    { "type": "color", "id": "muted", "label": "Soluk metin", "default": "rgba(73,61,154,0.72)" },
    { "type": "range", "id": "max_width", "label": "Maks. genişlik", "min": 900, "max": 1400, "step": 10, "default": 1200 },
    { "type": "range", "id": "pad_y", "label": "Dikey dolgu", "min": 24, "max": 120, "step": 4, "default": 64 },
    { "type": "range", "id": "pad_x", "label": "Yatay dolgu", "min": 16, "max": 80, "step": 4, "default": 40 },
    { "type": "range", "id": "radius", "label": "Görsel köşe yarıçapı", "min": 0, "max": 40, "step": 2, "default": 18 }
  ],
  "blocks": [{
    "type": "step", "name": "Adım",
    "settings": [
      { "type": "text", "id": "step_label", "label": "Adım etiketi", "default": "Adım 1" },
      { "type": "text", "id": "heading", "label": "Başlık", "default": "Uyandığınızda." },
      { "type": "image_picker", "id": "icon", "label": "İkon görseli" },
      { "type": "richtext", "id": "body", "label": "Açıklama", "default": "<p>Adım açıklamasını buraya ekleyin.</p>" },
      { "type": "text", "id": "button_label", "label": "Buton", "default": "Keşfet" },
      { "type": "url", "id": "button_link", "label": "Buton linki" }
    ]
  }],
  "presets": [{ "name": "Steps image list (.ki)", "blocks": [
    { "type": "step", "settings": { "step_label": "Adım 1", "heading": "Sabah rutini." } },
    { "type": "step", "settings": { "step_label": "Adım 2", "heading": "Gün boyu destek." } },
    { "type": "step", "settings": { "step_label": "Adım 3", "heading": "Akşam toparlanma." } }
  ]}]
}
{% endschema %}
