{% comment %}
  FAQ Section — Sıkça sorulan sorular (accordion)
  Pozisyon: Anasayfa #6 (en alt, footer öncesi)
  Sol alt köşede illüstrasyon; sağda tek-açılır accordion.
{% endcomment %}

<section id="faq-{{ section.id }}" class="section faq-section">
  <style>
    #faq-{{ section.id }} {
      --faq-bg: {{ section.settings.bg | default: '#f7f1e6' }};
      --faq-primary: {{ section.settings.primary_color | default: '#3a2d6e' }};
      --faq-text: {{ section.settings.text_color | default: '#1a1a1a' }};
      --faq-line: {{ section.settings.line_color | default: 'rgba(0,0,0,.15)' }};
      background: var(--faq-bg);
      padding: 80px 0;
      position: relative;
      overflow: hidden;
      font-family: system-ui, -apple-system, sans-serif;
    }

    #faq-{{ section.id }} .faq-illu {
      position: absolute; left: 0; bottom: 0;
      width: 145px; height: auto;
      pointer-events: none; user-select: none;
      z-index: 1;
    }

    #faq-{{ section.id }} .faq-wrap {
      position: relative; z-index: 2;
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 20px;
    }

    #faq-{{ section.id }} .faq-inner {
      max-width: 820px;
      margin-left: auto;
    }

    #faq-{{ section.id }} .faq-head {
      text-align: center;
      margin-bottom: 48px;
    }
    #faq-{{ section.id }} .faq-eyebrow {
      display: block;
      font-size: 11px; font-weight: 700;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: rgba(58,45,110,.7);
      margin-bottom: 16px;
    }
    #faq-{{ section.id }} .faq-title {
      font-size: 36px; line-height: 1.05;
      font-weight: 500;
      letter-spacing: -.02em;
      color: var(--faq-primary);
      margin: 0;
    }
    #faq-{{ section.id }} .faq-title em { font-style: italic; font-weight: 300; }

    #faq-{{ section.id }} details.faq-item {
      border-bottom: 1px solid var(--faq-line);
    }
    #faq-{{ section.id }} details.faq-item summary {
      list-style: none;
      cursor: pointer;
      padding: 20px 0;
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px;
      font-family: inherit;
      font-size: 18px; font-weight: 500;
      color: var(--faq-primary);
      transition: opacity .2s ease;
    }
    #faq-{{ section.id }} details.faq-item summary::-webkit-details-marker { display: none; }
    #faq-{{ section.id }} details.faq-item summary:hover { opacity: .8; }

    #faq-{{ section.id }} .faq-icon {
      width: 24px; height: 24px;
      flex-shrink: 0;
      display: grid; place-items: center;
      transition: transform .3s ease;
    }
    #faq-{{ section.id }} details[open] .faq-icon { transform: rotate(45deg); }

    #faq-{{ section.id }} .faq-body {
      padding: 0 32px 24px 0;
      font-size: 14px; line-height: 1.7;
      color: rgba(26,26,26,.75);
      white-space: pre-line;
    }

    #faq-{{ section.id }} .faq-cta {
      margin-top: 48px;
      display: flex; flex-direction: column; align-items: center;
      gap: 12px; text-align: center;
      padding-left: 120px;
    }
    #faq-{{ section.id }} .faq-cta-text {
      font-size: 13px;
      color: rgba(26,26,26,.6);
      margin: 0;
    }
    #faq-{{ section.id }} .faq-cta-btn {
      display: inline-flex; align-items: center; justify-content: center;
      gap: 8px;
      background: var(--faq-primary);
      color: #fff;
      padding: 0 32px;
      height: 48px;
      border-radius: 999px;
      font-size: 14px; font-weight: 500;
      letter-spacing: .02em;
      text-decoration: none;
      transition: opacity .2s ease;
    }
    #faq-{{ section.id }} .faq-cta-btn:hover { opacity: .9; }

    @media (min-width: 640px) {
      #faq-{{ section.id }} { padding: 96px 0; }
      #faq-{{ section.id }} .faq-illu { width: 193px; }
      #faq-{{ section.id }} .faq-wrap { padding: 0 32px; }
      #faq-{{ section.id }} .faq-title { font-size: 48px; }
      #faq-{{ section.id }} .faq-cta { padding-left: 160px; }
    }
    @media (min-width: 768px) {
      #faq-{{ section.id }} .faq-illu { width: 258px; }
    }
    @media (min-width: 1024px) {
      #faq-{{ section.id }} .faq-illu { width: 460px; }
      #faq-{{ section.id }} .faq-cta { padding-left: 0; }
    }
  </style>

  {%- if section.settings.illustration != blank -%}
    {{ section.settings.illustration | image_url: width: 1080 | image_tag: class: 'faq-illu', loading: 'lazy', alt: '' }}
  {%- endif -%}

  <div class="faq-wrap">
    <div class="faq-inner">
      <div class="faq-head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="faq-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="faq-title">{{ section.settings.heading | default: 'Bizce senin aklındaki <em>sorular.</em>' }}</h2>
      </div>

      {%- for block in section.blocks -%}
        <details class="faq-item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <span>{{ block.settings.question }}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
            </span>
          </summary>
          <div class="faq-body">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="faq-cta">
          <p class="faq-cta-text">{{ section.settings.cta_text | default: 'Aklındaki başka bir soru mu var?' }}</p>
          <a href="{{ section.settings.cta_link }}" class="faq-cta-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {{ section.settings.cta_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "faq-section",
  "settings": [
    { "type": "header", "content": "Başlık" },
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Sıkça sorulanlar" },
    { "type": "richtext", "id": "heading", "label": "Başlık", "default": "<p>Bizce senin aklındaki <em>sorular.</em></p>" },

    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_text", "label": "CTA üstü metin", "default": "Aklındaki başka bir soru mu var?" },
    { "type": "text", "id": "cta_label", "label": "Buton metni", "default": "Eczacımıza soru sor" },
    { "type": "url", "id": "cta_link", "label": "Buton linki" },

    { "type": "header", "content": "Görsel" },
    { "type": "image_picker", "id": "illustration", "label": "Sol alt illüstrasyon" },

    { "type": "header", "content": "Renkler" },
    { "type": "color", "id": "bg", "label": "Arka plan", "default": "#f7f1e6" },
    { "type": "color", "id": "primary_color", "label": "Primary", "default": "#3a2d6e" },
    { "type": "color", "id": "text_color", "label": "Yazı rengi", "default": "#1a1a1a" },
    { "type": "color", "id": "line_color", "label": "Çizgi", "default": "#dad2c0" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Soru / Cevap",
      "settings": [
        { "type": "text", "id": "question", "label": "Soru" },
        { "type": "textarea", "id": "answer", "label": "Cevap" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "settings": {
        "eyebrow": "Sıkça sorulanlar",
        "heading": "<p>Bizce senin aklındaki <em>sorular.</em></p>",
        "cta_text": "Aklındaki başka bir soru mu var?",
        "cta_label": "Eczacımıza soru sor",
        "cta_link": "/pages/contact"
      },
      "blocks": [
        { "type": "qa", "settings": { "question": ".ki Balance Your Cycle Modern Takviye Gıdası Nedir?", "answer": ".ki Balance Your Cycle, kadın döngüsünü desteklemek üzere formüle edilmiş; bitkisel ekstreler, mineraller ve doğal bileşenler içeren saşe formda bir takviye edici gıdadır." } },
        { "type": "qa", "settings": { "question": ".ki Change is Good Modern Takviye Gıdası Nedir?", "answer": "Kadınların ilerleyen yaş dönemini desteklemek üzere formüle edilmiş kapsül formda bir takviye edici gıdadır." } },
        { "type": "qa", "settings": { "question": "Modern Takviye Edici Gıdalarımız Ne Değildir?", "answer": "İlaç değildir. Hormon içermez. Tedavi edici amaç taşımaz." } }
      ]
    }
  ]
}
{% endschema %}
