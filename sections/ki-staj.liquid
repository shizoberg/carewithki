{% comment %}.ki Staj Sayfası — Modern v3{% endcomment %}
<style>
*,*::before,*::after{box-sizing:border-box;}
.staj{--p:#493d9a;--pd:#3b3280;--lil:#dad2ff;--lilf:#f0eeff;--bg:#f8f8f6;--txt:#1a1340;--mut:#6b6b8a;--bdr:#e8e2ff;font-family:'Raleway',system-ui,sans-serif;background:var(--bg);color:var(--txt);}
.staj__hero{background:linear-gradient(135deg,#2d1b69 0%,#493d9a 55%,#6b5dd3 100%);position:relative;overflow:hidden;padding:80px 24px 90px;text-align:center;}
.staj__hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 70% 30%,rgba(218,210,255,.15) 0%,transparent 60%),radial-gradient(ellipse at 20% 80%,rgba(255,255,255,.06) 0%,transparent 50%);pointer-events:none;}
.staj__hero-eyebrow{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.8);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:6px 16px;border-radius:50px;margin-bottom:22px;}
.staj__hero h1{font-size:clamp(32px,5vw,58px);font-weight:800;color:#fff;margin:0 0 16px;line-height:1.05;letter-spacing:-.03em;}
.staj__hero h1 em{font-style:italic;color:#c4b5fd;}
.staj__hero p{font-size:clamp(15px,2vw,18px);color:rgba(255,255,255,.7);max-width:560px;margin:0 auto 32px;line-height:1.7;font-weight:400;}
.staj__hero-cta{display:inline-flex;align-items:center;gap:8px;background:#fff;color:var(--p);font-size:14px;font-weight:800;letter-spacing:.02em;padding:14px 28px;border-radius:50px;text-decoration:none;box-shadow:0 8px 32px rgba(0,0,0,.2);transition:transform .2s,box-shadow .2s;}
.staj__hero-cta:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(0,0,0,.28);}
.staj__hero-cta svg{width:16px;height:16px;}
.staj__hero-tags{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:28px;}
.staj__htag{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);color:rgba(255,255,255,.85);font-size:12px;font-weight:600;padding:5px 14px;border-radius:50px;}
.staj__wrap{max-width:1060px;margin:0 auto;padding:0 24px;}
.staj__perks{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--bdr);border:1px solid var(--bdr);border-radius:20px;overflow:hidden;margin:56px auto;max-width:900px;}
.staj__perk{background:#fff;padding:28px 24px;display:flex;flex-direction:column;gap:10px;}
.staj__perk .ico{font-size:28px;line-height:1;}
.staj__perk h3{font-size:14px;font-weight:800;color:var(--txt);margin:0;}
.staj__perk p{font-size:13px;color:var(--mut);line-height:1.65;margin:0;font-weight:400;}
.staj__split{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;padding:0 0 64px;}
.staj__col h2{font-size:clamp(20px,2.5vw,28px);font-weight:800;color:var(--txt);margin:0 0 20px;letter-spacing:-.02em;}
.staj__col h2 span{color:var(--p);}
.staj__who{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:32px;}
.staj__who-tag{display:inline-flex;align-items:center;gap:6px;background:var(--lilf);border:1.5px solid var(--lil);color:var(--p);font-size:12px;font-weight:700;padding:6px 14px;border-radius:8px;}
.staj__learn{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px;}
.staj__learn li{display:flex;align-items:flex-start;gap:12px;font-size:14px;color:var(--txt);line-height:1.6;font-weight:500;}
.staj__learn li .dot{width:20px;height:20px;border-radius:6px;background:var(--lilf);border:1.5px solid var(--lil);color:var(--p);display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;flex-shrink:0;margin-top:2px;}
.staj__form-section{background:linear-gradient(135deg,#2d1b69 0%,#493d9a 100%);padding:80px 24px;position:relative;overflow:hidden;}
.staj__form-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 80% 20%,rgba(255,255,255,.08) 0%,transparent 55%);pointer-events:none;}
.staj__form-inner{max-width:720px;margin:0 auto;position:relative;z-index:1;}
.staj__form-hd{text-align:center;margin-bottom:40px;}
.staj__form-hd h2{font-size:clamp(24px,3vw,36px);font-weight:800;color:#fff;margin:0 0 10px;letter-spacing:-.02em;}
.staj__form-hd p{font-size:15px;color:rgba(255,255,255,.65);margin:0;font-weight:400;}
.staj__form{display:flex;flex-direction:column;gap:14px;}
.staj__form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.staj__field{display:flex;flex-direction:column;gap:6px;}
.staj__field label{font-size:11px;font-weight:700;color:rgba(255,255,255,.6);letter-spacing:.08em;text-transform:uppercase;}
.staj__field input,.staj__field select,.staj__field textarea{font-family:'Raleway',system-ui,sans-serif;font-size:14px;font-weight:500;color:#fff;background:rgba(255,255,255,.08);border:1.5px solid rgba(255,255,255,.15);border-radius:12px;padding:13px 16px;outline:none;transition:border-color .15s,background .15s;width:100%;}
.staj__field input::placeholder,.staj__field textarea::placeholder{color:rgba(255,255,255,.35);}
.staj__field input:focus,.staj__field select:focus,.staj__field textarea:focus{border-color:rgba(255,255,255,.45);background:rgba(255,255,255,.13);}
.staj__field select option{background:#2d1b69;color:#fff;}
.staj__field textarea{resize:vertical;min-height:120px;}
.staj__submit{background:#fff;color:var(--p);font-family:'Raleway',system-ui,sans-serif;font-size:15px;font-weight:800;letter-spacing:.02em;border:none;border-radius:14px;padding:16px 36px;cursor:pointer;align-self:center;margin-top:8px;transition:transform .15s,box-shadow .15s;box-shadow:0 4px 20px rgba(0,0,0,.2);display:flex;align-items:center;gap:8px;}
.staj__submit:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(0,0,0,.3);}
.staj__note{text-align:center;font-size:12px;color:rgba(255,255,255,.4);margin-top:8px;font-weight:400;}
.staj__success{display:none;background:rgba(255,255,255,.1);border:1.5px solid rgba(255,255,255,.2);border-radius:16px;padding:28px 32px;text-align:center;color:#fff;font-size:16px;font-weight:700;line-height:1.6;margin-top:20px;}
@media(max-width:900px){.staj__perks{grid-template-columns:repeat(3,1fr);}.staj__split{grid-template-columns:1fr;gap:32px;}}
@media(max-width:600px){.staj__hero{padding:56px 20px 64px;}.staj__perks{grid-template-columns:1fr;margin:32px 12px;}.staj__perk{padding:20px 16px;}.staj__form-row{grid-template-columns:1fr;}.staj__wrap{padding:0 16px;}.staj__form-section{padding:56px 16px;}}
</style>
<div class="staj">
  <div class="staj__hero">
    <p class="staj__hero-eyebrow">.ki Staj Programı 2026</p>
    <h1>Gerçek markada<br><em>gerçek deneyim.</em></h1>
    <p>Kadın sağlığını normalleştiren, hızla büyüyen bir DTC markasında staj yap. Raporlar değil, canlıya alınan projeler.</p>
    <a href="#basvur" class="staj__hero-cta">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      Hemen Başvur
    </a>
    <div class="staj__hero-tags">
      <span class="staj__htag">💊 Eczacılık</span>
      <span class="staj__htag">📣 Pazarlama</span>
      <span class="staj__htag">🎨 Tasarım</span>
      <span class="staj__htag">💻 Yazılım</span>
      <span class="staj__htag">🧪 Kimya / Biyoloji</span>
      <span class="staj__htag">📊 Veri</span>
    </div>
  </div>
  <div class="staj__perks">
    <div class="staj__perk"><span class="ico">🚀</span><h3>Canlı projeler</h3><p>Rafta duracak raporlar değil, yayına alınacak kampanyalar ve ürünler üzerinde çalışırsın.</p></div>
    <div class="staj__perk"><span class="ico">📦</span><h3>Ücretsiz .ki ürünleri</h3><p>Staj süresince tüm ürünlerimize ücretsiz erişim. Kullan, hisset, geri bildirim ver.</p></div>
    <div class="staj__perk"><span class="ico">📝</span><h3>Referans mektubu</h3><p>Stajını başarıyla tamamlarsan kişisel ve detaylı bir referans mektubu alırsın.</p></div>
  </div>
  <div class="staj__wrap">
    <div class="staj__split">
      <div class="staj__col">
        <h2>Kimler <span>başvurabilir?</span></h2>
        <div class="staj__who">
          <span class="staj__who-tag">📚 Üniversite öğrencisi</span>
          <span class="staj__who-tag">🎓 Son sınıf / yeni mezun</span>
          <span class="staj__who-tag">💊 Eczacılık</span>
          <span class="staj__who-tag">📣 Pazarlama / İletişim</span>
          <span class="staj__who-tag">🎨 Tasarım / İçerik</span>
          <span class="staj__who-tag">💻 Yazılım / Veri</span>
          <span class="staj__who-tag">🧪 Kimya / Biyoloji</span>
          <span class="staj__who-tag">🏥 Sağlık Bilimleri</span>
        </div>
        <p style="font-size:14px;color:#6b6b8a;line-height:1.7;font-weight:400;">Alan önemli ama merak ve motivasyon daha önemli. Doğru profili arıyoruz, doğru bölümü değil.</p>
      </div>
      <div class="staj__col">
        <h2>Neler <span>öğreneceksin?</span></h2>
        <ul class="staj__learn">
          <li><span class="dot">01</span>Meta Ads + Google Ads — gerçek bütçe, gerçek sonuçlar</li>
          <li><span class="dot">02</span>DTC e-ticaret operasyonu: Shopify, sipariş, müşteri</li>
          <li><span class="dot">03</span>İçerik üretimi: Reels, TikTok, influencer koordinasyonu</li>
          <li><span class="dot">04</span>Ürün geliştirme — formülasyon toplantılarına dahil olma</li>
          <li><span class="dot">05</span>B2B eczane satış kanalı ve saha deneyimi</li>
          <li><span class="dot">06</span>Kadın sağlığında bilimsel içerik (Eczacı Arin ile)</li>
        </ul>
      </div>
    </div>
  </div>
  <div class="staj__form-section" id="basvur">
    <div class="staj__form-inner">
      <div class="staj__form-hd">
        <h2>Başvurunu yap 👇</h2>
        <p>Formu doldur — 3 iş günü içinde sana dönelim.</p>
      </div>
      <form class="staj__form" id="ki-staj-form">
        <div class="staj__form-row">
          <div class="staj__field"><label>Ad Soyad</label><input type="text" name="name" placeholder="Ada Yılmaz" required></div>
          <div class="staj__field"><label>E-posta</label><input type="email" name="email" placeholder="ada@uni.edu.tr" required></div>
        </div>
        <div class="staj__form-row">
          <div class="staj__field"><label>Üniversite</label><input type="text" name="university" placeholder="DEÜ, EÜTF, Boğaziçi..." required></div>
          <div class="staj__field"><label>Bölüm &amp; Sınıf</label><input type="text" name="department" placeholder="Eczacılık, 3. sınıf" required></div>
        </div>
        <div class="staj__field"><label>İlgilendiğin Alan</label>
          <select name="area" required>
            <option value="">Seç...</option>
            <option>Pazarlama &amp; Reklam</option>
            <option>İçerik &amp; Sosyal Medya</option>
            <option>Tasarım</option>
            <option>Yazılım &amp; Veri</option>
            <option>Eczacılık &amp; Formülasyon</option>
            <option>Saha Satış &amp; Eczane</option>
            <option>Genel / Birden fazla alan</option>
          </select>
        </div>
        <div class="staj__field"><label>Neden .ki? — kendini tanıt</label><textarea name="message" placeholder="Motivasyonunu, ilgi alanlarını, varsa önceki deneyimlerini kısaca anlat." required></textarea></div>
        <div class="staj__field"><label>LinkedIn veya Portfolio (opsiyonel)</label><input type="url" name="portfolio" placeholder="https://linkedin.com/in/..."></div>
        <button type="submit" class="staj__submit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          Başvuruyu Gönder
        </button>
        <p class="staj__note">Başvurun berk@carewithki.com ve arin@carewithki.com adreslerine iletilir.</p>
      </form>
      <div class="staj__success" id="ki-staj-success">✅ Başvurun alındı!<br><span style="font-weight:400;font-size:14px;opacity:.85;">3 iş günü içinde seninle iletişime geçeceğiz. .ki ailesine hoş geldin 💜</span></div>
    </div>
  </div>
</div>
<script>
document.getElementById('ki-staj-form').addEventListener('submit',function(e){
  e.preventDefault();
  var d=new FormData(this);
  var lines=[];
  d.forEach(function(v,k){if(v) lines.push(k.toUpperCase()+': '+v);});
  var body=lines.join('\n\n');
  var subject=encodeURIComponent('.ki Staj Başvurusu — '+(d.get('name')||''));
  var bodyEnc=encodeURIComponent(body);
  window.location.href='mailto:berk@carewithki.com,arin@carewithki.com?subject='+subject+'&body='+bodyEnc;
  this.style.display='none';
  document.getElementById('ki-staj-success').style.display='block';
  document.getElementById('ki-staj-success').scrollIntoView({behavior:'smooth'});
});
document.querySelector('.staj__hero-cta').addEventListener('click',function(e){
  var t=document.getElementById('basvur');
  if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth'});}
});
</script>
{% schema %}
{"name":"Staj Sayfas\u0131 (.ki)","tag":"section","class":"section","settings":[],"presets":[{"name":"Staj Sayfas\u0131 (.ki)"}]}
{% endschema %}
