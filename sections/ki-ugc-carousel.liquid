{% comment %}UGC Carousel v7 — lightweight infinite native slider + creator popup{% endcomment %}

<style>
.ugc-{{ section.id }}{
  --p:#493d9a;
  --p-dark:#21184f;
  --lil:#dad2ff;
  --bg:{{ section.settings.bg | default: '#f8f8f6' }};
  background:var(--bg);
  padding:{{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 64 }}px;
  overflow:hidden;
}
.ugc-{{ section.id }} .ugc-shell{max-width:1240px;margin:0 auto;}
.ugc-{{ section.id }} .ugc-header{position:relative;text-align:center;padding:0 80px;margin:0 auto 28px;}
.ugc-{{ section.id }} .ugc-eyebrow{display:inline-flex;align-items:center;gap:6px;font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--p);opacity:.72;margin:0 0 10px;justify-content:center;}
.ugc-{{ section.id }} .ugc-eyebrow::before,.ugc-{{ section.id }} .ugc-eyebrow::after{content:'';display:inline-block;width:18px;height:1.5px;background:var(--p);opacity:.5;}
.ugc-{{ section.id }} .ugc-title{font-family:var(--font-heading-family),Raleway,system-ui,sans-serif;font-size:clamp(26px,3.4vw,46px);font-weight:800;line-height:1.08;color:#1a1340;margin:0 0 10px;letter-spacing:-.025em;}
.ugc-{{ section.id }} .ugc-title p{margin:0;}
.ugc-{{ section.id }} .ugc-title em{font-style:italic;color:var(--p);}
.ugc-{{ section.id }} .ugc-subtitle{font-size:15px;color:#777283;margin:0;line-height:1.6;}
.ugc-{{ section.id }} .ugc-controls{position:absolute;right:24px;bottom:0;display:flex;gap:8px;}
.ugc-{{ section.id }} .ugc-control{width:38px;height:38px;border-radius:50%;border:1px solid rgba(73,61,154,.2);background:#fff;color:var(--p);display:grid;place-items:center;cursor:pointer;box-shadow:0 5px 16px rgba(33,24,79,.08);transition:transform .2s,background .2s,color .2s;}
.ugc-{{ section.id }} .ugc-control:hover{transform:translateY(-2px);background:var(--p);color:#fff;}
.ugc-{{ section.id }} .ugc-control:disabled{opacity:.35;cursor:default;transform:none;}
.ugc-{{ section.id }} .ugc-control svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;}
.ugc-{{ section.id }} .ugc-slider-wrap{position:relative;}
.ugc-{{ section.id }} .ugc-track{
  display:flex;
  gap:12px;
  overflow-x:auto;
  overscroll-behavior-x:contain;
  scroll-snap-type:x mandatory;
  scroll-padding-inline:24px;
  padding:8px max(24px,calc((100vw - 1200px)/2)) 18px;
  cursor:grab;
  -webkit-overflow-scrolling:touch;
  scrollbar-width:none;
}
.ugc-{{ section.id }} .ugc-track::-webkit-scrollbar{display:none;}
.ugc-{{ section.id }} .ugc-track.is-dragging{cursor:grabbing;scroll-snap-type:none;user-select:none;}
.ugc-{{ section.id }} .ugc-card{
  position:relative;
  border:0;
  padding:0;
  border-radius:15px;
  overflow:hidden;
  width:168px;
  aspect-ratio:9/16;
  background:#1a1340;
  flex:0 0 auto;
  scroll-snap-align:start;
  cursor:pointer;
  box-shadow:0 6px 20px rgba(30,21,74,.16);
  transition:transform .25s,box-shadow .25s;
  color:#fff;
  text-align:left;
}
.ugc-{{ section.id }} .ugc-card:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(30,21,74,.23);}
.ugc-{{ section.id }} .ugc-card:focus-visible{outline:3px solid var(--lil);outline-offset:3px;}
.ugc-{{ section.id }} .ugc-card video,.ugc-{{ section.id }} .ugc-card img,.ugc-{{ section.id }} .ugc-card .placeholder-svg{position:absolute;inset:0;width:100% !important;height:100% !important;object-fit:cover;display:block;pointer-events:none;}
.ugc-{{ section.id }} .ugc-card-ov{position:absolute;bottom:0;left:0;right:0;padding:42px 11px 12px;background:linear-gradient(to top,rgba(10,5,30,.88) 0%,rgba(30,15,60,.4) 62%,transparent 100%);z-index:2;display:flex;align-items:flex-end;justify-content:space-between;gap:7px;}
.ugc-{{ section.id }} .ugc-card-label{font-size:11px;font-weight:650;color:rgba(255,255,255,.95);line-height:1.3;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ugc-{{ section.id }} .ugc-play-btn{width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.22);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.32);display:grid;place-items:center;flex:0 0 auto;color:#fff;}
.ugc-{{ section.id }} .ugc-play-btn svg{width:13px;height:13px;fill:currentColor;margin-left:2px;}
.ugc-{{ section.id }} .ugc-yt-badge{position:absolute;top:9px;right:9px;z-index:3;background:rgba(214,0,0,.88);color:#fff;font-size:8px;font-weight:750;letter-spacing:.05em;text-transform:uppercase;padding:3px 7px;border-radius:50px;display:flex;align-items:center;gap:4px;}
.ugc-{{ section.id }} .ugc-yt-badge svg{width:9px;height:9px;fill:#fff;}
.ugc-{{ section.id }} .ugc-card-badge{position:absolute;top:9px;left:9px;z-index:3;background:rgba(73,61,154,.82);backdrop-filter:blur(6px);color:#fff;font-size:8px;font-weight:750;letter-spacing:.05em;text-transform:uppercase;padding:3px 7px;border-radius:50px;border:1px solid rgba(218,210,255,.28);}

.ugc-lightbox-{{ section.id }}{--p:#493d9a;position:fixed;inset:0;z-index:99999;background:rgba(14,9,35,.88);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .22s,visibility .22s;padding:22px;}
.ugc-lightbox-{{ section.id }}.is-open{opacity:1;visibility:visible;pointer-events:auto;}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__panel{position:relative;width:min(820px,100%);max-height:min(760px,calc(100vh - 44px));display:grid;grid-template-columns:minmax(260px,350px) minmax(260px,1fr);overflow:hidden;border-radius:22px;background:#fff;box-shadow:0 28px 90px rgba(0,0,0,.5);transform:translateY(12px) scale(.97);transition:transform .25s;}
.ugc-lightbox-{{ section.id }}.is-open .ugc-lightbox__panel{transform:none;}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__media{position:relative;min-height:500px;background:#110c2e;overflow:hidden;}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__media iframe,.ugc-lightbox-{{ section.id }} .ugc-lightbox__media video,.ugc-lightbox-{{ section.id }} .ugc-lightbox__media img{position:absolute;inset:0;width:100%;height:100%;border:0;object-fit:cover;}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__info{padding:42px 34px 30px;display:flex;flex-direction:column;min-width:0;color:#1a1340;}
.ugc-lightbox-{{ section.id }} .ugc-creator{display:flex;align-items:center;gap:13px;margin-bottom:24px;}
.ugc-lightbox-{{ section.id }} .ugc-creator__avatar{width:56px;height:56px;border-radius:50%;object-fit:cover;background:#eeebf8;border:2px solid #fff;box-shadow:0 0 0 1px rgba(73,61,154,.15);}
.ugc-lightbox-{{ section.id }} .ugc-creator__fallback{width:56px;height:56px;border-radius:50%;display:grid;place-items:center;background:#eeebf8;color:var(--p);font-size:20px;font-weight:800;}
.ugc-lightbox-{{ section.id }} .ugc-creator__name{display:block;font-size:18px;font-weight:800;line-height:1.2;}
.ugc-lightbox-{{ section.id }} .ugc-creator__handle{display:block;margin-top:4px;color:#716b80;font-size:13px;}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__label{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--p);font-weight:800;margin:0 0 10px;}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__bio{font-size:16px;line-height:1.65;color:#625d6b;margin:0 0 24px;}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__actions{display:grid;gap:10px;margin-top:auto;}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__link{min-height:46px;border-radius:13px;padding:12px 16px;display:flex;align-items:center;justify-content:center;gap:8px;text-decoration:none;font-size:14px;font-weight:750;transition:transform .2s,opacity .2s;}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__link:hover{transform:translateY(-1px);opacity:.92;}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__link--primary{background:var(--p);color:#fff;}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__link--secondary{background:#f0eef8;color:var(--p);}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__link svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__close{position:absolute;top:12px;right:12px;z-index:10;width:38px;height:38px;border-radius:50%;background:rgba(26,19,64,.72);border:1px solid rgba(255,255,255,.3);color:#fff;cursor:pointer;display:grid;place-items:center;transition:background .2s;}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__close:hover{background:var(--p);}
.ugc-lightbox-{{ section.id }} .ugc-lightbox__close svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.5;stroke-linecap:round;}

@media(max-width:749px){
  .ugc-{{ section.id }}{padding:36px 0 42px;}
  .ugc-{{ section.id }} .ugc-header{padding:0 24px;margin-bottom:18px;}
  .ugc-{{ section.id }} .ugc-controls{position:static;justify-content:center;margin-top:16px;}
  .ugc-{{ section.id }} .ugc-control{width:36px;height:36px;}
  .ugc-{{ section.id }} .ugc-track{gap:10px;scroll-padding-inline:18px;padding:6px 18px 16px;}
  .ugc-{{ section.id }} .ugc-card{width:clamp(140px,40vw,156px);border-radius:13px;}
  .ugc-lightbox-{{ section.id }}{padding:10px;align-items:flex-end;}
  .ugc-lightbox-{{ section.id }} .ugc-lightbox__panel{width:100%;max-height:calc(100vh - 20px);grid-template-columns:1fr;grid-template-rows:minmax(300px,58vh) auto;border-radius:20px;}
  .ugc-lightbox-{{ section.id }} .ugc-lightbox__media{min-height:0;}
  .ugc-lightbox-{{ section.id }} .ugc-lightbox__info{padding:22px 20px 20px;}
  .ugc-lightbox-{{ section.id }} .ugc-creator{margin-bottom:16px;}
  .ugc-lightbox-{{ section.id }} .ugc-creator__avatar,.ugc-lightbox-{{ section.id }} .ugc-creator__fallback{width:46px;height:46px;}
  .ugc-lightbox-{{ section.id }} .ugc-lightbox__bio{font-size:14px;line-height:1.5;margin-bottom:16px;}
}
</style>

{%- assign block_count = section.blocks.size -%}
{%- assign autoplay_delay = section.settings.speed | default: 30 -%}

<div class="ugc-lightbox-{{ section.id }}" id="UGCLightbox-{{ section.id }}" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Video ve içerik üreticisi bilgileri">
  <div class="ugc-lightbox__panel" role="document">
    <div class="ugc-lightbox__media" id="UGCLBMedia-{{ section.id }}"></div>
    <div class="ugc-lightbox__info">
      <div class="ugc-creator">
        <div id="UGCLBAvatar-{{ section.id }}"></div>
        <div>
          <strong class="ugc-creator__name" id="UGCLBName-{{ section.id }}"></strong>
          <span class="ugc-creator__handle" id="UGCLBHandle-{{ section.id }}"></span>
        </div>
      </div>
      <p class="ugc-lightbox__label" id="UGCLBLabel-{{ section.id }}"></p>
      <p class="ugc-lightbox__bio" id="UGCLBBio-{{ section.id }}"></p>
      <div class="ugc-lightbox__actions">
        <a class="ugc-lightbox__link ugc-lightbox__link--primary" id="UGCLBVideoLink-{{ section.id }}" target="_blank" rel="noopener">
          Videoyu Aç
          <svg viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"/></svg>
        </a>
        <a class="ugc-lightbox__link ugc-lightbox__link--secondary" id="UGCLBAccountLink-{{ section.id }}" target="_blank" rel="noopener">
          Hesabı Gör
          <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
        </a>
      </div>
    </div>
    <button class="ugc-lightbox__close" id="UGCLBClose-{{ section.id }}" aria-label="Kapat" type="button">
      <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
</div>

<section class="ugc-{{ section.id }}" id="UGC-{{ section.id }}">
  <div class="ugc-shell">
    {%- if section.settings.title != blank -%}
      <div class="ugc-header">
        {%- if section.settings.eyebrow != blank -%}<p class="ugc-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <div class="ugc-title">{{ section.settings.title }}</div>
        {%- if section.settings.subtitle != blank -%}<p class="ugc-subtitle">{{ section.settings.subtitle | escape }}</p>{%- endif -%}
        {%- if block_count > 1 -%}
          <div class="ugc-controls" aria-label="Video kaydırma kontrolleri">
            <button class="ugc-control ugc-control--prev" type="button" aria-label="Önceki video">
              <svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button class="ugc-control ugc-control--next" type="button" aria-label="Sonraki video">
              <svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if block_count > 0 -%}
      <div class="ugc-slider-wrap">
        <div class="ugc-track" id="UGCTrack-{{ section.id }}" data-autoplay-delay="{{ autoplay_delay }}" aria-label="Influencer videoları">
          {%- for block in section.blocks -%}
            {%- assign yt_id = '' -%}
            {%- assign yt_embed = '' -%}
            {%- if block.settings.youtube_url != blank -%}
              {%- if block.settings.youtube_url contains 'youtu.be/' -%}
                {%- assign yt_id = block.settings.youtube_url | split: 'youtu.be/' | last | split: '?' | first -%}
              {%- elsif block.settings.youtube_url contains 'v=' -%}
                {%- assign yt_id = block.settings.youtube_url | split: 'v=' | last | split: '&' | first -%}
              {%- elsif block.settings.youtube_url contains '/shorts/' -%}
                {%- assign yt_id = block.settings.youtube_url | split: '/shorts/' | last | split: '?' | first -%}
              {%- endif -%}
              {%- if yt_id != '' -%}{%- assign yt_embed = 'https://www.youtube-nocookie.com/embed/' | append: yt_id | append: '?autoplay=1&rel=0&modestbranding=1' -%}{%- endif -%}
            {%- endif -%}
            {%- assign creator_name = block.settings.creator_name | default: block.settings.label | default: 'İçerik üreticisi' -%}
            {%- assign outbound_video_url = block.settings.video_link | default: block.settings.youtube_url -%}
            {%- assign avatar_url = '' -%}
            {%- if block.settings.creator_avatar != blank -%}{%- assign avatar_url = block.settings.creator_avatar | image_url: width: 120 -%}{%- endif -%}
            <button
              class="ugc-card"
              type="button"
              data-yt-embed="{{ yt_embed | escape }}"
              data-creator-name="{{ creator_name | escape }}"
              data-creator-handle="{{ block.settings.creator_handle | escape }}"
              data-creator-bio="{{ block.settings.creator_bio | escape }}"
              data-creator-avatar="{{ avatar_url | escape }}"
              data-account-url="{{ block.settings.account_link | escape }}"
              data-video-url="{{ outbound_video_url | escape }}"
              data-label="{{ block.settings.label | escape }}"
              aria-label="{{ creator_name | escape }} videosunu aç"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.badge != blank -%}<span class="ugc-card-badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
              {%- if yt_id != '' -%}
                <img src="https://img.youtube.com/vi/{{ yt_id }}/mqdefault.jpg" width="320" height="180" alt="{{ block.settings.label | escape }}" loading="lazy" decoding="async">
                <span class="ugc-yt-badge"><svg viewBox="0 0 24 24"><path d="M23 7s-.3-2-1.2-2.7c-1.1-1.2-2.4-1.2-3-1.3C16.4 3 12 3 12 3s-4.4 0-6.8.1c-.6.1-1.9.1-3 1.3C1.3 5 1 7 1 7S.7 9.1.7 11.2v2c0 2 .3 4.1.3 4.1s.3 2 1.2 2.7c1.1 1.2 2.6 1.1 3.3 1.2C7.3 21.3 12 21.3 12 21.3s4.4 0 6.8-.2c.6-.1 1.9-.1 3-1.2.9-.7 1.2-2.7 1.2-2.7s.3-2.1.3-4.1v-2C23.3 9.1 23 7 23 7zM9.7 15.5V8.4l8.1 3.6-8.1 3.5z"/></svg>YouTube</span>
              {%- elsif block.settings.video != blank -%}
                {{- block.settings.video | video_tag: autoplay: false, loop: true, muted: true, controls: false, playsinline: true, preload: 'none' -}}
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 420 | image_tag: widths: '180, 280, 360, 420', sizes: '(max-width: 749px) 40vw, 168px', loading: 'lazy', alt: block.settings.label }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              <span class="ugc-card-ov">
                <span class="ugc-card-label">{{ block.settings.label | escape }}</span>
                <span class="ugc-play-btn" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                </span>
              </span>
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function(){
  var sid='{{ section.id }}';
  var sec=document.getElementById('UGC-'+sid);
  var track=document.getElementById('UGCTrack-'+sid);
  var lb=document.getElementById('UGCLightbox-'+sid);
  var lbMedia=document.getElementById('UGCLBMedia-'+sid);
  var lbClose=document.getElementById('UGCLBClose-'+sid);
  if(!sec||!track||!lb||!lbMedia) return;
  document.body.appendChild(lb);

  var prev=sec.querySelector('.ugc-control--prev');
  var next=sec.querySelector('.ugc-control--next');
  var originalCards=Array.prototype.slice.call(track.querySelectorAll('.ugc-card'));
  var cards=originalCards;
  var reduceMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var autoplayDelay=(parseFloat(track.getAttribute('data-autoplay-delay'))||30)*1000;
  var autoplayTimer;
  var loopNormalizeTimer;
  var loopPeriod=0;
  var loopAnchor=0;
  var dragStartX=0;
  var dragScrollStart=0;
  var dragging=false;
  var suppressClickUntil=0;
  var previousBodyOverflow='';

  function cloneLoopCard(card){
    var clone=card.cloneNode(true);
    clone.setAttribute('data-loop-clone','true');
    clone.setAttribute('aria-hidden','true');
    clone.setAttribute('tabindex','-1');
    clone.removeAttribute('id');
    clone.removeAttribute('data-shopify-editor-block');
    Array.prototype.forEach.call(clone.querySelectorAll('[id]'),function(element){
      element.removeAttribute('id');
    });
    var video=clone.querySelector('video');
    if(video){
      video.autoplay=false;
      video.preload='none';
      video.removeAttribute('autoplay');
      video.setAttribute('preload','none');
      video.pause();
    }
    return clone;
  }

  function setupInfiniteLoop(){
    if(!originalCards.length) return;
    var gap=parseFloat(window.getComputedStyle(track).gap)||12;
    var step=originalCards[0].getBoundingClientRect().width+gap;
    loopPeriod=step*originalCards.length;
    if(!loopPeriod) return;

    var fillWidth=Math.max(track.clientWidth,1280);
    var repeatCount=Math.max(2,Math.ceil(fillWidth/loopPeriod)+1);
    var before=document.createDocumentFragment();
    var after=document.createDocumentFragment();
    var repeatIndex;

    for(repeatIndex=0;repeatIndex<repeatCount;repeatIndex+=1){
      originalCards.forEach(function(card){before.appendChild(cloneLoopCard(card));});
      originalCards.forEach(function(card){after.appendChild(cloneLoopCard(card));});
    }

    track.insertBefore(before,originalCards[0]);
    track.appendChild(after);
    cards=Array.prototype.slice.call(track.querySelectorAll('.ugc-card'));

    var trackLeft=track.getBoundingClientRect().left;
    var originalLeft=originalCards[0].getBoundingClientRect().left-trackLeft+track.scrollLeft;
    var paddingLeft=parseFloat(window.getComputedStyle(track).paddingLeft)||0;
    loopAnchor=originalLeft-paddingLeft;
    track.scrollLeft=loopAnchor;
  }

  function normalizeInfiniteLoop(){
    window.clearTimeout(loopNormalizeTimer);
    if(!loopPeriod||dragging) return;
    var distance=track.scrollLeft-loopAnchor;
    if(Math.abs(distance)<loopPeriod/2) return;
    track.scrollLeft-=Math.round(distance/loopPeriod)*loopPeriod;
  }

  function queueLoopNormalization(){
    window.clearTimeout(loopNormalizeTimer);
    loopNormalizeTimer=window.setTimeout(normalizeInfiniteLoop,100);
  }

  setupInfiniteLoop();

  function cardStep(){
    if(!cards.length) return 180;
    var gap=parseFloat(window.getComputedStyle(track).gap)||12;
    return cards[0].getBoundingClientRect().width+gap;
  }

  function scrollSlider(direction){
    track.scrollBy({left:direction*cardStep(),behavior:'smooth'});
    restartAutoplay();
  }

  function stopAutoplay(){
    if(autoplayTimer){window.clearInterval(autoplayTimer);autoplayTimer=null;}
  }

  function startAutoplay(){
    stopAutoplay();
    if(reduceMotion||cards.length<2||autoplayDelay<5000) return;
    autoplayTimer=window.setInterval(function(){
      if(!document.hidden&&!lb.classList.contains('is-open')) scrollSlider(1);
    },autoplayDelay);
  }

  function restartAutoplay(){
    stopAutoplay();
    window.setTimeout(startAutoplay,1200);
  }

  if(prev) prev.addEventListener('click',function(){scrollSlider(-1);});
  if(next) next.addEventListener('click',function(){scrollSlider(1);});

  track.addEventListener('pointerdown',function(event){
    if(event.pointerType==='touch') return;
    dragging=true;
    dragStartX=event.clientX;
    dragScrollStart=track.scrollLeft;
    track.classList.add('is-dragging');
    track.setPointerCapture(event.pointerId);
    stopAutoplay();
  });
  track.addEventListener('pointermove',function(event){
    if(!dragging) return;
    var distance=event.clientX-dragStartX;
    if(Math.abs(distance)>5) suppressClickUntil=Date.now()+250;
    track.scrollLeft=dragScrollStart-distance;
  });
  function endDrag(event){
    if(!dragging) return;
    dragging=false;
    track.classList.remove('is-dragging');
    if(event&&track.hasPointerCapture&&track.hasPointerCapture(event.pointerId)) track.releasePointerCapture(event.pointerId);
    queueLoopNormalization();
    restartAutoplay();
  }
  track.addEventListener('pointerup',endDrag);
  track.addEventListener('pointercancel',endDrag);
  track.addEventListener('scroll',queueLoopNormalization,{passive:true});
  track.addEventListener('touchstart',stopAutoplay,{passive:true});
  track.addEventListener('touchend',function(){
    queueLoopNormalization();
    restartAutoplay();
  },{passive:true});
  track.addEventListener('mouseenter',stopAutoplay);
  track.addEventListener('mouseleave',startAutoplay);

  function setText(id,value){
    var element=document.getElementById(id+'-'+sid);
    if(element) element.textContent=value||'';
  }

  function setLink(id,url){
    var link=document.getElementById(id+'-'+sid);
    if(!link) return;
    if(url){link.href=url;link.style.display='flex';}
    else{link.removeAttribute('href');link.style.display='none';}
  }

  function openLightbox(card){
    if(Date.now()<suppressClickUntil) return;
    lbMedia.innerHTML='';
    var embedUrl=card.getAttribute('data-yt-embed');
    var video=card.querySelector('video');
    var image=card.querySelector('img');
    if(embedUrl){
      var iframe=document.createElement('iframe');
      iframe.src=embedUrl;
      iframe.allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen=true;
      iframe.title=card.getAttribute('data-label')||'Influencer videosu';
      lbMedia.appendChild(iframe);
    }else if(video){
      var videoClone=video.cloneNode(true);
      videoClone.muted=false;
      videoClone.controls=true;
      videoClone.autoplay=true;
      videoClone.loop=false;
      videoClone.preload='auto';
      lbMedia.appendChild(videoClone);
      videoClone.play().catch(function(){});
    }else if(image){
      var imageClone=image.cloneNode(true);
      imageClone.removeAttribute('loading');
      lbMedia.appendChild(imageClone);
    }

    var name=card.getAttribute('data-creator-name')||'İçerik üreticisi';
    var handle=card.getAttribute('data-creator-handle')||'';
    var label=card.getAttribute('data-label')||'Topluluk deneyimi';
    var bio=card.getAttribute('data-creator-bio')||'Deneyimini kendi sözleriyle anlatıyor.';
    var avatarUrl=card.getAttribute('data-creator-avatar');
    var avatarWrap=document.getElementById('UGCLBAvatar-'+sid);
    if(avatarWrap){
      avatarWrap.innerHTML='';
      if(avatarUrl){
        var avatar=document.createElement('img');
        avatar.className='ugc-creator__avatar';
        avatar.src=avatarUrl;
        avatar.alt=name;
        avatar.width=56;
        avatar.height=56;
        avatarWrap.appendChild(avatar);
      }else{
        var fallback=document.createElement('span');
        fallback.className='ugc-creator__fallback';
        fallback.textContent=name.trim().charAt(0).toLocaleUpperCase('tr-TR')||'.';
        avatarWrap.appendChild(fallback);
      }
    }
    setText('UGCLBName',name);
    setText('UGCLBHandle',handle);
    setText('UGCLBLabel',label);
    setText('UGCLBBio',bio);
    setLink('UGCLBVideoLink',card.getAttribute('data-video-url'));
    setLink('UGCLBAccountLink',card.getAttribute('data-account-url'));

    previousBodyOverflow=document.body.style.overflow;
    document.body.style.overflow='hidden';
    lb.classList.add('is-open');
    lb.setAttribute('aria-hidden','false');
    stopAutoplay();
    window.setTimeout(function(){if(lbClose) lbClose.focus();},30);
  }

  function closeLightbox(){
    if(!lb.classList.contains('is-open')) return;
    lb.classList.remove('is-open');
    lb.setAttribute('aria-hidden','true');
    document.body.style.overflow=previousBodyOverflow;
    window.setTimeout(function(){lbMedia.innerHTML='';},250);
    restartAutoplay();
  }

  cards.forEach(function(card){
    var video=card.querySelector('video');
    if(video){
      video.muted=true;
      video.playsInline=true;
    }
  });

  track.addEventListener('click',function(event){
    var card=event.target.closest&&event.target.closest('.ugc-card');
    if(!card||!track.contains(card)) return;
    openLightbox(card);
  });

  if('IntersectionObserver' in window){
    var videoObserver=new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        var video=entry.target;
        if(entry.isIntersecting&&entry.intersectionRatio>.45){
          video.play().catch(function(){});
        }else{
          video.pause();
        }
      });
    },{root:track,threshold:[0,.45]});
    cards.forEach(function(card){
      var video=card.querySelector('video');
      if(video) videoObserver.observe(video);
    });
  }

  if(lbClose) lbClose.addEventListener('click',closeLightbox);
  lb.addEventListener('click',function(event){if(event.target===lb) closeLightbox();});
  document.addEventListener('keydown',function(event){if(event.key==='Escape') closeLightbox();});
  document.addEventListener('visibilitychange',function(){if(document.hidden) stopAutoplay();else startAutoplay();});
  startAutoplay();
})();
</script>

