{% comment %}.ki Koleksiyon v4 — Kompakt + Renkli Pill{% endcomment %}
<style>
.kicol-{{ section.id }}{--p:#493d9a;--pd:#3b3280;--lil:#dad2ff;--pur:#b2a5ff;--bg:#f8f8f6;--txt:#1a1340;--mut:#6b6b8a;background:var(--bg);min-height:60vh;font-family:system-ui,sans-serif;}
.kicol-{{ section.id }} .kc-banner{padding:44px 24px 38px;text-align:center;position:relative;overflow:hidden;background:{{ section.settings.banner_gradient | default: 'linear-gradient(135deg,#493d9a 0%,#6b5dd3 100%)' }};}
.kicol-{{ section.id }} .kc-banner::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 75% 40%,rgba(255,255,255,.1) 0%,transparent 65%);pointer-events:none;}
.kicol-{{ section.id }} .kc-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-bottom:12px;}
.kicol-{{ section.id }} .kc-eyebrow::before,.kicol-{{ section.id }} .kc-eyebrow::after{content:'';display:inline-block;width:24px;height:1px;background:rgba(255,255,255,.35);}
.kicol-{{ section.id }} .kc-title{font-family:'Raleway',system-ui,sans-serif;font-size:clamp(22px,4vw,40px);font-weight:800;color:#fff;margin:0 0 10px;line-height:1.1;letter-spacing:-.025em;}
.kicol-{{ section.id }} .kc-desc{font-size:14px;color:rgba(255,255,255,.65);max-width:540px;margin:0 auto;line-height:1.7;}
.kicol-{{ section.id }} .kc-count{display:inline-block;margin-top:14px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);padding:4px 14px;border-radius:50px;font-size:11px;font-weight:600;color:rgba(255,255,255,.7);}
.kicol-{{ section.id }} .kc-badge-bar{background:#fff;border-bottom:1px solid rgba(73,61,154,.07);padding:11px 32px;}
.kicol-{{ section.id }} .kc-badge-bar__inner{max-width:1400px;margin:0 auto;display:flex;flex-wrap:wrap;gap:8px;align-items:center;}
.kicol-{{ section.id }} .kc-rozet{display:inline-flex;align-items:center;gap:6px;padding:5px 13px;border-radius:50px;font-size:11px;font-weight:700;border:1.5px solid currentColor;white-space:nowrap;}
.kicol-{{ section.id }} .kc-rozet svg{width:12px;height:12px;flex-shrink:0;}
.kicol-{{ section.id }} .kc-rozet--1{color:#493d9a;background:rgba(73,61,154,.06);}
.kicol-{{ section.id }} .kc-rozet--2{color:#16a34a;background:rgba(22,163,74,.07);}
.kicol-{{ section.id }} .kc-rozet--3{color:#d97706;background:rgba(217,119,6,.07);}
.kicol-{{ section.id }} .kc-rozet--4{color:#dc2626;background:rgba(220,38,38,.06);}
.kicol-{{ section.id }} .kc-main{max-width:1400px;margin:0 auto;padding:28px 32px 64px;}
.kicol-{{ section.id }} .kc-grid{display:grid;grid-template-columns:repeat({{ section.settings.columns_desktop | default: 4 }},1fr);gap:18px;list-style:none;margin:0;padding:0;}
.kicol-{{ section.id }} .kc-card{background:#fff;border-radius:14px;overflow:hidden;display:flex;flex-direction:column;border:1px solid rgba(73,61,154,.07);box-shadow:0 2px 12px rgba(73,61,154,.04);transition:transform .25s,box-shadow .25s;}
.kicol-{{ section.id }} .kc-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(73,61,154,.11);}
.kicol-{{ section.id }} .kc-card__media{position:relative;aspect-ratio:4/5;overflow:hidden;background:linear-gradient(145deg,#ede8ff,#f0eef8);display:block;text-decoration:none;}
.kicol-{{ section.id }} .kc-card__img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .55s;}
.kicol-{{ section.id }} .kc-card:hover .kc-card__img{transform:scale(1.04);}
.kicol-{{ section.id }} .ki-care-bundle-collage{display:grid;width:100%;height:100%;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;padding:18px 16px;background:linear-gradient(140deg,#21194c,#6357bb);}
.kicol-{{ section.id }} .ki-care-bundle-collage__item{min-width:0;overflow:hidden;border-radius:12px;background:#2a2358;box-shadow:0 10px 24px rgba(7,4,30,.2);}
.kicol-{{ section.id }} .ki-care-bundle-collage__item:nth-child(2){transform:translateY(-7px);}
.kicol-{{ section.id }} .ki-care-bundle-collage__item img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .55s;}
.kicol-{{ section.id }} .kc-card:hover .ki-care-bundle-collage__item img{transform:scale(1.04);}
.kicol-{{ section.id }} .kc-card__discount{position:absolute;top:9px;left:9px;background:var(--p);color:#fff;font-size:9px;font-weight:800;padding:3px 8px;border-radius:50px;z-index:2;pointer-events:none;}
.kicol-{{ section.id }} .kc-card__badge{position:absolute;top:9px;right:9px;background:rgba(255,255,255,.9);backdrop-filter:blur(8px);color:var(--p);font-size:9px;font-weight:800;padding:3px 8px;border-radius:50px;border:1px solid rgba(73,61,154,.15);z-index:2;pointer-events:none;white-space:nowrap;}
.kicol-{{ section.id }} .kc-card__body{padding:12px 14px 14px;flex:1;display:flex;flex-direction:column;gap:4px;}
.kicol-{{ section.id }} .kc-card__category{font-size:8.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--pur);}
.kicol-{{ section.id }} .kc-card__pills{display:flex;flex-wrap:wrap;gap:3px;margin-bottom:1px;}
.kicol-{{ section.id }} .kc-card__pill{font-size:9px;font-weight:700;padding:2px 7px;border-radius:4px;white-space:nowrap;}
.kicol-{{ section.id }} .kc-card__pill--blue{background:rgba(96,165,250,.12);color:#1d4ed8;}
.kicol-{{ section.id }} .kc-card__pill--green{background:rgba(74,222,128,.13);color:#15803d;}
.kicol-{{ section.id }} .kc-card__pill--purple{background:rgba(73,61,154,.08);color:#493d9a;}
.kicol-{{ section.id }} .kc-card__pill--pink{background:rgba(244,114,182,.12);color:#be185d;}
.kicol-{{ section.id }} .kc-card__pill--amber{background:rgba(251,191,36,.14);color:#92400e;}
.kicol-{{ section.id }} .kc-card__pill--teal{background:rgba(45,212,191,.13);color:#0f766e;}
.kicol-{{ section.id }} .kc-card__pill--default{background:rgba(73,61,154,.07);color:#493d9a;}
.kicol-{{ section.id }} .kc-card__title{font-size:13px;font-weight:700;color:var(--txt);text-decoration:none;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.kicol-{{ section.id }} .kc-card__title:hover{color:var(--p);}
.kicol-{{ section.id }} .kc-card__desc{font-size:11px;color:var(--mut);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.kicol-{{ section.id }} .kc-card__label{display:inline-flex;align-items:center;gap:4px;font-size:9.5px;font-weight:700;color:var(--p);}
.kicol-{{ section.id }} .kc-card__label::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--p);flex-shrink:0;}
.kicol-{{ section.id }} .kc-card__footer{margin-top:auto;padding-top:10px;border-top:1px solid rgba(73,61,154,.06);display:flex;flex-direction:column;gap:8px;}
.kicol-{{ section.id }} .kc-card__price-row{display:flex;align-items:center;justify-content:space-between;}
.kicol-{{ section.id }} .kc-card__prices{display:flex;align-items:baseline;gap:5px;}
.kicol-{{ section.id }} .kc-card__price{font-size:15px;font-weight:900;color:var(--p);font-family:'Raleway',system-ui,sans-serif;}
.kicol-{{ section.id }} .kc-card__compare{font-size:10px;color:#bbb;text-decoration:line-through;}
.kicol-{{ section.id }} .kc-card__link{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:rgba(73,61,154,.1);color:var(--p);text-decoration:none;flex-shrink:0;transition:background .15s;}
.kicol-{{ section.id }} .kc-card__link:hover{background:var(--p);color:#fff;}
.kicol-{{ section.id }} .kc-card__link svg{width:13px;height:13px;}
.kicol-{{ section.id }} .kc-card__atc{width:100%;padding:9px;border-radius:8px;background:linear-gradient(135deg,#5a4daa,#493d9a);color:#fff;font-size:11.5px;font-weight:700;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;transition:opacity .2s,transform .15s;font-family:inherit;-webkit-tap-highlight-color:transparent;}
.kicol-{{ section.id }} .kc-card__atc:hover{background:linear-gradient(135deg,#6b5dbb,#5a4daa);transform:translateY(-1px);}
.kicol-{{ section.id }} .kc-card__atc svg{width:13px;height:13px;flex-shrink:0;}
.kicol-{{ section.id }} .kc-card__atc.is-loading{opacity:.65;pointer-events:none;}
.kicol-{{ section.id }} .kc-card__atc.is-done{background:linear-gradient(135deg,#16a34a,#15803d);}
.kicol-{{ section.id }} .kc-card__atc.is-unavailable{background:#e5e7eb;color:#9ca3af;pointer-events:none;}
.kicol-{{ section.id }} .kc-card__subscribe{width:100%;padding:8px;border-radius:8px;border:1px solid var(--p);background:#fff;color:var(--p);font-size:11.5px;font-weight:750;text-decoration:none;display:flex;align-items:center;justify-content:center;gap:6px;transition:background .15s,color .15s;}
.kicol-{{ section.id }} .kc-card__subscribe:hover{background:var(--p);color:#fff;}
.kicol-{{ section.id }} .kc-card__subscribe svg{width:13px;height:13px;}
.kicol-{{ section.id }} .kc-empty{text-align:center;padding:80px 24px;grid-column:1/-1;color:var(--mut);}
.kicol-{{ section.id }} .kc-pagination{display:flex;justify-content:center;gap:6px;padding:36px 0 0;flex-wrap:wrap;}
.kicol-{{ section.id }} .kc-pagination a,.kicol-{{ section.id }} .kc-pagination span{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:10px;font-size:13px;font-weight:600;border:1px solid rgba(73,61,154,.15);color:var(--txt);text-decoration:none;transition:all .15s;}
.kicol-{{ section.id }} .kc-pagination a:hover{background:var(--lil);border-color:var(--p);color:var(--p);}
.kicol-{{ section.id }} .kc-pagination span.current{background:var(--p);color:#fff;border-color:var(--p);}
@media(max-width:749px){.kicol-{{ section.id }} .kc-banner{padding:28px 14px 24px;}.kicol-{{ section.id }} .kc-badge-bar{padding:10px 14px;}.kicol-{{ section.id }} .kc-main{padding:14px 12px 48px;}.kicol-{{ section.id }} .kc-grid{grid-template-columns:repeat(2,1fr)!important;gap:10px;}.kicol-{{ section.id }} .kc-card__body{padding:10px 10px 12px;gap:3px;}.kicol-{{ section.id }} .kc-card__title{font-size:12px;}.kicol-{{ section.id }} .kc-card__price{font-size:13px;}.kicol-{{ section.id }} .kc-card__atc{font-size:10.5px;padding:8px;}}
@media(min-width:750px) and (max-width:1099px){.kicol-{{ section.id }} .kc-grid{grid-template-columns:repeat(3,1fr)!important;}.kicol-{{ section.id }} .kc-main{padding:22px 20px 56px;}}
</style>

{%- assign products_per_page = section.settings.products_per_page | default: 12 -%}
{%- assign badge_blocks = section.blocks | where: 'type', 'badge' -%}
{%- assign label_blocks = section.blocks | where: 'type', 'product_label' -%}

<div class="kicol-{{ section.id }}" id="KiCol-{{ section.id }}">
  <div class="kc-banner">
    <p class="kc-eyebrow">{{ section.settings.eyebrow_text | default: '.ki koleksiyonu' | escape }}</p>
    <h1 class="kc-title">{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}<p class="kc-desc">{{ collection.description }}</p>{%- endif -%}
    <span class="kc-count">{{ collection.products_count }} ürün</span>
  </div>
  {%- if badge_blocks.size > 0 -%}
  <div class="kc-badge-bar"><div class="kc-badge-bar__inner">
    {%- for block in badge_blocks -%}{%- if block.settings.label != blank -%}
    <span class="kc-rozet kc-rozet--{{ block.settings.color }}" {{ block.shopify_attributes }}>
      {%- case block.settings.icon -%}{%- when 'check' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>{%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/></svg>{%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>{%- when 'star' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{%- when 'heart' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>{%- endcase -%}
      {{ block.settings.label | escape }}
    </span>
    {%- endif -%}{%- endfor -%}
  </div></div>
  {%- endif -%}
  <div class="kc-main">
    {%- paginate collection.products by products_per_page -%}
    {%- if collection.products.size > 0 -%}
    <ul class="kc-grid">
      {%- for product in collection.products -%}
        {%- assign cv = product.selected_or_first_available_variant -%}
        {%- assign plabel = '' -%}{%- assign pbadge = '' -%}{%- assign ppills = '' -%}
        {%- for bl in label_blocks -%}{%- if bl.settings.product_handle == product.handle -%}{%- assign plabel = bl.settings.label -%}{%- assign pbadge = bl.settings.badge -%}{%- assign ppills = bl.settings.tags -%}{%- endif -%}{%- endfor -%}
        {%- assign pill_list = ppills | split: ',' -%}
        <li class="kc-card">
          <a href="{{ product.url }}" class="kc-card__media">
            {% render 'ki-product-card-media', product: product, image_class: 'kc-card__img', image_width: 700, placeholder_name: 'product-1' %}
            {%- if cv.compare_at_price > cv.price -%}{%- assign sp = cv.compare_at_price | minus: cv.price | times: 100 | divided_by: cv.compare_at_price -%}<span class="kc-card__discount">%{{ sp }}</span>{%- endif -%}
            {%- if pbadge != blank -%}<span class="kc-card__badge">{{ pbadge | escape }}</span>{%- endif -%}
          </a>
          <div class="kc-card__body">
            {%- if section.settings.show_category and product.type != blank -%}<span class="kc-card__category">{{ product.type | escape }}</span>{%- endif -%}
            {%- if pill_list.size > 0 and ppills != blank -%}
            <div class="kc-card__pills">
              {%- for pill in pill_list -%}
                {%- assign pc = pill | strip -%}
                {%- assign pcol = 'default' -%}
                {%- if pc == 'pH Dengeli' or pc == 'Hyaluronik Asit' or pc == 'Magnezyum' or pc == 'Derin Nem' -%}{%- assign pcol = 'blue' -%}
                {%- elsif pc == 'Aloe Vera' or pc == 'Paraben İçermez' or pc == 'Kimyasal Katkısız' or pc == 'Vegan' or pc == 'Nazik Formül' -%}{%- assign pcol = 'green' -%}
                {%- elsif pc == 'GMP' or pc == 'FDA Onaylı' or pc == 'Dermatolojik Test' or pc == 'Hayit' -%}{%- assign pcol = 'purple' -%}
                {%- elsif pc == 'Menopoz' or pc == 'PMS' or pc == 'Genistein' -%}{%- assign pcol = 'pink' -%}
                {%- elsif pc == 'Selenyum' or pc == 'Bor' or pc == 'Koruyucu' or pc == 'Günlük Kullanım' -%}{%- assign pcol = 'amber' -%}
                {%- elsif pc == 'Probiyotik' or pc == 'Pratik' or pc == 'Durulama Yok' or pc == 'B12' or pc == 'Folat' -%}{%- assign pcol = 'teal' -%}
                {%- endif -%}
                <span class="kc-card__pill kc-card__pill--{{ pcol }}">{{ pc | escape }}</span>
              {%- endfor -%}
            </div>
            {%- endif -%}
            <a href="{{ product.url }}" class="kc-card__title">{{ product.title | escape }}</a>
            {%- if section.settings.show_description and product.description != blank -%}<p class="kc-card__desc">{{ product.description | strip_html | truncate: 90 }}</p>{%- endif -%}
            {%- if plabel != blank -%}<span class="kc-card__label">{{ plabel | escape }}</span>{%- endif -%}
            <div class="kc-card__footer">
              <div class="kc-card__price-row">
                <div class="kc-card__prices"><span class="kc-card__price">{{ cv.price | money }}</span>{%- if cv.compare_at_price > cv.price -%}<span class="kc-card__compare">{{ cv.compare_at_price | money }}</span>{%- endif -%}</div>
                <a href="{{ product.url }}" class="kc-card__link" aria-label="İncele"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
              </div>
              {%- if cv.available -%}
              <button type="button" class="kc-card__atc" data-vid="{{ cv.id }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>Sepete Ekle</button>
              {% render 'ki-subscribe-link', product: product, class: 'kc-card__subscribe' %}
              {%- else -%}<button type="button" class="kc-card__atc is-unavailable">Satışa kapalı</button>{%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}<div class="kc-pagination">{%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&#8592;</a>{%- endif -%}{%- for part in paginate.parts -%}{%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="current">{{ part.title }}</span>{%- endif -%}{%- endfor -%}{%- if paginate.next -%}<a href="{{ paginate.next.url }}">&#8594;</a>{%- endif -%}</div>{%- endif -%}
    {%- else -%}<div class="kc-empty"><p>Bu koleksiyonda henüz ürün bulunmuyor.</p></div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</div>
<script>
(function(){var sec=document.getElementById('KiCol-{{ section.id }}');if(!sec) return;var IC='<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>';var OK='<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';sec.addEventListener('click',function(e){var btn=e.target.closest('.kc-card__atc');if(!btn||btn.classList.contains('is-unavailable')||btn.classList.contains('is-loading')||btn.classList.contains('is-done')) return;e.preventDefault();var vid=btn.getAttribute('data-vid');if(!vid) return;btn.classList.add('is-loading');btn.innerHTML=IC+' Ekleniyor...';var fd=new FormData();fd.append('id',vid);fd.append('quantity','1');fetch('/cart/add.js',{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'},body:fd}).then(function(r){if(!r.ok) throw new Error(r.status);return r.json();}).then(function(){btn.classList.remove('is-loading');btn.classList.add('is-done');btn.innerHTML=OK+' Eklendi';fetch('/cart.js').then(function(r){return r.json();}).then(function(c){document.querySelectorAll('[data-cart-count]').forEach(function(el){el.textContent=c.item_count;});});setTimeout(function(){btn.classList.remove('is-done');btn.innerHTML=IC+' Sepete Ekle';},2500);}).catch(function(){btn.classList.remove('is-loading');btn.textContent='Tekrar dene';});});})()
</script>
{% schema %}
{"name":"Koleksiyon Rozetli (.ki)","tag":"section","class":"section","settings":[{"type":"header","content":"Banner"},{"type":"text","id":"eyebrow_text","label":"Eyebrow","default":".ki koleksiyonu"},{"type":"text","id":"banner_gradient","label":"Banner gradient CSS","default":"linear-gradient(135deg,#493d9a 0%,#6b5dd3 100%)"},{"type":"color","id":"badge_color","label":"Indirim rozet rengi","default":"#493d9a"},{"type":"header","content":"Izgara"},{"type":"range","id":"columns_desktop","label":"Sutun desktop","min":2,"max":5,"step":1,"default":4},{"type":"range","id":"products_per_page","label":"Sayfa basi urun","min":4,"max":48,"step":4,"default":12},{"type":"header","content":"Gorunum"},{"type":"checkbox","id":"show_description","label":"Urun aciklamasi","default":true},{"type":"checkbox","id":"show_category","label":"Kategori etiketi","default":true}],"blocks":[{"type":"badge","name":"Koleksiyon Rozeti","settings":[{"type":"text","id":"label","label":"Rozet yazisi","default":"Vegan GMP"},{"type":"select","id":"icon","label":"Ikon","default":"check","options":[{"value":"check","label":"Tik"},{"value":"leaf","label":"Yaprak"},{"value":"shield","label":"Kalkan"},{"value":"star","label":"Yildiz"},{"value":"heart","label":"Kalp"},{"value":"none","label":"Yok"}]},{"type":"select","id":"color","label":"Renk","default":"1","options":[{"value":"1","label":"Mor"},{"value":"2","label":"Yesil"},{"value":"3","label":"Sari"},{"value":"4","label":"Kirmizi"}]}]},{"type":"product_label","name":"Urune Ozel Etiket","settings":[{"type":"text","id":"product_handle","label":"Urun handle","default":"urun-handle"},{"type":"text","id":"label","label":"Alt etiket","default":"En cok satilan"},{"type":"text","id":"badge","label":"Kart rozeti","default":"Yeni"},{"type":"text","id":"tags","label":"Pill etiketler virgülle","default":"pH Dengeli, Vegan"}]}],"presets":[{"name":"Koleksiyon Rozetli (.ki)","blocks":[{"type":"badge","settings":{"label":"Vegan GMP","icon":"leaf","color":"2"}},{"type":"badge","settings":{"label":"FDA Onaylidir","icon":"shield","color":"1"}},{"type":"badge","settings":{"label":"Uzman Formulu","icon":"check","color":"1"}}]}]}
{% endschema %}
