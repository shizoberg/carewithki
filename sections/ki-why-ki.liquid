{% comment %}
  .ki Neden Ki v5
  Öncelik: Block'lar varsa onlar, yoksa handle, o da yoksa settings varsayılan
  Sol medya: Shopify video > YouTube/Vimeo embed > Görsel > Ürün görseli
{% endcomment %}


<style>
.kineden-{{ section.id }}{
  --p:#493d9a;--lil:#dad2ff;
  --bg:{{ section.settings.bg | default: '#f0eef8' }};
  --txt:{{ section.settings.text_color | default: '#1a1340' }};
  --mut:{{ section.settings.muted_color | default: '#666680' }};
  background:var(--bg);
  padding:{{ section.settings.pad_y | default: 64 }}px 0;
  font-family:system-ui,sans-serif;
  overflow-x:hidden;
}
.kineden-{{ section.id }} .kn-inner{max-width:1180px;margin:0 auto;padding:0 {{ section.settings.pad_x | default: 32 }}px;}
.kineden-{{ section.id }} .kn-header{text-align:center;margin-bottom:48px;}
.kineden-{{ section.id }} .kn-eyebrow{font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#c0392b;display:block;margin-bottom:14px;}
.kineden-{{ section.id }} .kn-heading{font-family:'Raleway',system-ui,sans-serif;font-size:clamp(28px,4vw,52px);font-weight:700;color:var(--p);margin:0 0 16px;line-height:1.1;letter-spacing:-.025em;}
.kineden-{{ section.id }} .kn-subtext{font-size:15px;line-height:1.7;color:var(--mut);max-width:520px;margin:0 auto;}
.kineden-{{ section.id }} .kn-body{display:flex;flex-direction:row;gap:48px;align-items:stretch;}
/* Sol medya */
.kineden-{{ section.id }} .kn-media{
  flex:0 0 44%;max-width:44%;
  border-radius:20px;overflow:hidden;
  background:#6c5bb8;
  min-height:500px;
  display:flex;align-items:center;justify-content:center;
  position:relative;
}
.kineden-{{ section.id }} .kn-media img{width:100%;height:100%;object-fit:cover;display:block;}
.kineden-{{ section.id }} .kn-media video{
  width:100%;height:100%;object-fit:cover;display:block;
  position:absolute;inset:0;
}
.kineden-{{ section.id }} .kn-media-placeholder{color:rgba(255,255,255,.4);font-size:14px;text-align:center;padding:40px;}
/* Embed (YouTube/Vimeo) */
.kineden-{{ section.id }} .kn-media--embed{padding:0;background:#000;}
.kineden-{{ section.id }} .kn-video-wrap{position:relative;width:100%;height:100%;min-height:500px;}
.kineden-{{ section.id }} .kn-video-wrap iframe{position:absolute;top:0;left:0;width:100%;height:100%;border:0;}
/* Kartlar */
.kineden-{{ section.id }} .kn-cards{flex:1;min-width:0;display:grid;grid-template-columns:1fr 1fr;gap:14px;align-content:start;}
.kineden-{{ section.id }} .kn-card{background:#fff;border-radius:16px;padding:24px 20px;transition:box-shadow .2s,transform .2s;}
.kineden-{{ section.id }} .kn-card:hover{box-shadow:0 6px 24px rgba(73,61,154,.10);transform:translateY(-2px);}
.kineden-{{ section.id }} .kn-icon-box{width:48px;height:48px;border-radius:12px;background:rgba(73,61,154,.1);display:flex;align-items:center;justify-content:center;margin-bottom:16px;}
.kineden-{{ section.id }} .kn-icon-box svg{width:24px;height:24px;stroke:var(--p);fill:none;stroke-width:1.8px;stroke-linecap:round;stroke-linejoin:round;}
.kineden-{{ section.id }} .kn-card-title{font-size:16px;font-weight:700;color:var(--p);margin:0 0 8px;line-height:1.3;}
.kineden-{{ section.id }} .kn-card-desc{font-size:13.5px;line-height:1.6;color:var(--mut);margin:0;}
@media screen and (max-width:860px){
  .kineden-{{ section.id }} .kn-inner{padding:0;}
  .kineden-{{ section.id }} .kn-header{padding:0 20px;margin-bottom:32px;}
  .kineden-{{ section.id }} .kn-body{flex-direction:column;gap:24px;}
  .kineden-{{ section.id }} .kn-media{flex:none;max-width:100%;width:100%;border-radius:0;min-height:280px;max-height:360px;}
  .kineden-{{ section.id }} .kn-video-wrap{min-height:280px;max-height:360px;}
  .kineden-{{ section.id }} .kn-cards{padding:0 16px;gap:12px;}
  .kineden-{{ section.id }} .kn-card{padding:20px 16px;border-radius:14px;}
}
</style>

{%- comment -%} Block'lar var mı? {%- endcomment -%}
{%- assign card_blocks = section.blocks | where: 'type', 'card' -%}
{%- assign use_blocks = false -%}
{%- if card_blocks.size > 0 -%}{%- assign use_blocks = true -%}{%- endif -%}

{%- comment -%} Başlık kaynağı {%- endcomment -%}
{%- assign h = product.handle -%}
{%- if use_blocks -%}
  {%- assign kn_heading = section.settings.heading -%}
  {%- assign kn_sub = section.settings.subtext -%}
{%- elsif h == 'balance-your-cycle' -%}
  {%- assign kn_heading = 'Döngüne uyumlu, bilimsel takviye' -%}
  {%- assign kn_sub = 'Kadın fizyolojisinin dönemsel ihtiyaçları gözetilerek formüle edilmiş 17 etken madde.' -%}
  {%- assign kn_cards = 'leaf|Döngsel Bitkisel Kompleks|Hayit ve çin melek otu ile dönemsel ritminize doğal bir destek sağlar.,sparkle|Enerji ve Hücresel Koruma|B12, folat ve C vitamini ile normal enerji oluşum mekanizmasını destekler.,droplet|Yüksek Biyoyararlanım|Emilimi yüksek magnezyum bisglinat formu ile kas fonksiyonlarını destekler.,heart|Dönemsel Konfor Sinerjisi|Mayıs papatyası ve melisa özlerinin rahatlatcı sinerjisiyle ihtiyaç duyduğunuz bedensel sakinlik ve konforu sunar.,shield|Bilimsel Standartlar|GMP standartlarına uygun onaylı tesiste üretilmiştir.,wind|Sindirim Konforu|Zencefil ve tıbbi nane sinerjisiyle döngü boyunca sindirim konforu ve bedensel rahatlığı destekler.' -%}
{%- elsif h == 'change-is-good' -%}
  {%- assign kn_heading = 'Yeni döneme güçle adım at' -%}
  {%- assign kn_sub = 'Menopoz döneminin değişen ihtiyaçlarına özel, bilimsel formilleştirilmiş destek.' -%}
  {%- assign kn_cards = 'leaf|Yeni Dönemde Bedensel Uyum|Genistein, şerbetciotu ve hayit özlerinin sinerjisiyle vücudunuzun doğal ritmine bitkisel destek sunar.,sparkle|Bilişsel ve Ruhsal Denge|Magnezyum ile dönemsel yorgunluk ve bitkinliğin azalmasını destekler.,droplet|Dönemsel Sıcaklık Dengesi|Kohoş ve bitki özleriyle gün içinde ve gece boyunca bedensel konfor ve sıcaklık dengesi.,shield|Güçlü Antioksidan Savunma|E vitamini, selenyum ve krom kombinasyonu ile hücresel koruma.,heart|Kemik ve Kas Yapısı|Bor ve magnezyum bisglisinat sinerjisiyle kemik korunmasına katkı.,wind|Bölünmeyen Uykular|Şerbetci otu ve magnezyum sinerjisiyle doğal dinlenme ritmi.' -%}
{%- elsif h == 'ki-intimate-intim-bakim-spreyi' -%}
  {%- assign kn_heading = 'Gün boyu ferahlık, denge ve konfor' -%}
  {%- assign kn_sub = 'Her detayı seninle birlikte yaşadığın anların konforu için tasarlandı.' -%}
  {%- assign kn_cards = 'leaf|Doğal Bileşenler|Aloe vera, ölmez otu ve papatya özleriyle zenginleştirilmiş formil.,sparkle|Anlık Tazelik|Pratik sprey formu ile durulama gerektirmeden temizlik hissi.,shield|Mikrobiyom ve Flora Dostu|Probiyotikler ile doğal koruyucu bariyer desteği.,droplet|pH Dengeli|Doğal pH seviyesine uyumlu, paraben ve sülfat içermez.,heart|Hassas Cilt Dostu|İritasyon riskini azaltır, nem dengesini korur.,wind|Doğal Koku Kontrolü|Ylang ylang ve nioli yağları ile gün boyu tazelik.' -%}
{%- elsif h == 'ki-sens-care-intim-bakim-jeli' -%}
  {%- assign kn_heading = 'Hassas anlar için doğanın gücyüyle' -%}
  {%- assign kn_sub = 'Her detayı seninle birlikte yaşadığın anların konforu için tasarlandı.' -%}
  {%- assign kn_cards = 'leaf|Doğal Bileşenler|Aloe vera, civanperçemi ve hamamellis virginiana ile formil.,shield|Dermatolojik Test|Hassas ciltler üzerinde test edilmiş, SLES/SLS/paraben içermez.,droplet|Doğal Flora Uyumu|pH uyumlu, florayı bozmadan nazikçe temizler.,heart|İritasyon Karşıtı|Panthenol, allantoin, çinko ile hassasiyeti yatıştırır.,sparkle|Hücresel Koruma|Antioksidanlar ile dış etkenlere karşı bariyer.,wind|Doğal Koku Kontrolü|Çinko ve bitkisel ekstraktlarla gün boyu tazelik.' -%}
{%- elsif h == 'ki-50-care-intim-bakim-jeli' -%}
  {%- assign kn_heading = '50+ yaşta derin bakım' -%}
  {%- assign kn_sub = 'Menopoz döneminin ihtiyaçlarına özel, nazik ve etkili bakım.' -%}
  {%- assign kn_cards = 'droplet|İleri Düzey Nem|Hyaluronik asit ve pentavitin sinerjisiyle derin nemlendirme.,shield|Dönemsel pH|Menopoz dönemi florasıyla tam uyumlu.,leaf|Dermatolojik Test|Hassas ve olgun ciltler üzerinde test edilmiş.,sparkle|Bariyer Desteği|Beta glukan, panthenol ve E vitamini ile cilt dokusunu sakinleştirir.,wind|Bitkisel Destek|Kırmızı yonca çiçeği özüyle olgun cildin bariyerini destekler.,heart|Hassas İçerik|Bitkisel kaynaklı sürfaktanlarla tahriş etmeden arındırır.' -%}
{%- elsif h == 'ki-daily-care-intim-bakim-jeli' -%}
  {%- assign kn_heading = 'Her gün kendine iyi bakım' -%}
  {%- assign kn_sub = 'Günlük kullanıma özel, nazik ve etkili doğal formül.' -%}
  {%- assign kn_cards = 'leaf|Doğal Bileşenler|Aloe vera, ölmez otu, papatya özleriyle günlük bakım.,sparkle|Anlık Tazelik|Jel formuyla kolay ve hızlı temizlik hissi.,shield|Mikrobiyom Dostu|Flora dengesini bozmadan nazikçe temizler.,droplet|pH Dengeli|Doğal pH seviyesine uyumlu, paraben/sülfat içermez.,heart|Hassas Cilt|Günlük kullanımda tahriş riskini minimize eder.,wind|Doğal Tazelik|Flora dengesini koruyarak gün boyu ferahlık.' -%}
{%- elsif h == 'ki-flow-care-intim-bakim-jeli' -%}
  {%- assign kn_heading = 'Doğanın koruyucu gücü' -%}
  {%- assign kn_sub = 'Her detayı seninle birlikte yaşadığın anların konforu için tasarlandı.' -%}
  {%- assign kn_cards = 'leaf|Doğal Bileşenler|Aloe vera ve bitkisel özlerle, parfüm/kimyasal katkısız.,shield|Koruyucu Bariyer|Çinko ve bitkisel ekstraktlarla doğal bariyer güçlendirme.,droplet|pH Dengeli|Doğal pH seviyesine uyumlu, paraben/sülfat içermez.,heart|Hassas Cilt|İritasyon riskini azaltır, nem dengesini korur.,sparkle|Hücresel Destek|Antioksidanlar ile hüresel düzeyde koruma.,wind|Doğal Tazelik|Flora dengesini koruyarak gün boyu ferahlık.' -%}
{%- else -%}
  {%- assign kn_heading = section.settings.heading -%}
  {%- assign kn_sub = section.settings.subtext -%}
  {%- assign kn_cards = '' -%}
{%- endif -%}

{%- comment -%} Sol medya: öncelik sırası {%- endcomment -%}
{%- assign has_shopify_video = false -%}
{%- assign has_embed_url = false -%}
{%- if section.settings.shopify_video != blank -%}{%- assign has_shopify_video = true -%}{%- endif -%}
{%- if section.settings.video_url != blank -%}{%- assign has_embed_url = true -%}{%- endif -%}

{%- if has_embed_url -%}
  {%- assign vu = section.settings.video_url -%}
  {%- if vu contains 'youtube.com/watch' -%}
    {%- assign video_id = vu | split: 'v=' | last | split: '&' | first -%}
    {%- assign embed_src = 'https://www.youtube.com/embed/' | append: video_id | append: '?autoplay=0&rel=0&modestbranding=1' -%}
  {%- elsif vu contains 'youtu.be/' -%}
    {%- assign video_id = vu | split: 'youtu.be/' | last | split: '?' | first -%}
    {%- assign embed_src = 'https://www.youtube.com/embed/' | append: video_id | append: '?autoplay=0&rel=0&modestbranding=1' -%}
  {%- elsif vu contains 'vimeo.com/' -%}
    {%- assign video_id = vu | split: 'vimeo.com/' | last | split: '?' | first -%}
    {%- assign embed_src = 'https://player.vimeo.com/video/' | append: video_id -%}
  {%- else -%}
    {%- assign embed_src = vu -%}
  {%- endif -%}
{%- endif -%}

<section class="kineden-{{ section.id }}" id="KiNeden-{{ section.id }}">
  <div class="kn-inner">
    <div class="kn-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="kn-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="kn-heading">{{ kn_heading }}</h2>
      {%- if kn_sub != blank -%}<p class="kn-subtext">{{ kn_sub }}</p>{%- endif -%}
    </div>

    <div class="kn-body">
      {%- comment -%} Sol medya {%- endcomment -%}
      <div class="kn-media{% if has_embed_url and has_shopify_video == false %} kn-media--embed{% endif %}">
        {%- if has_shopify_video -%}
          {%- comment -%} 1. Öncelik: Shopify video (loop, sessiz) {%- endcomment -%}
          {{- section.settings.shopify_video | video_tag:
              autoplay: false,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              preload: 'none',
              class: 'kn-lazy-video',
              style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;' -}}
        {%- elsif has_embed_url -%}
          {%- comment -%} 2. YouTube/Vimeo embed {%- endcomment -%}
          <div class="kn-video-wrap">
            <iframe src="{{ embed_src }}" title="{{ product.title | escape }}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>
          </div>
        {%- elsif section.settings.image != blank -%}
          {%- comment -%} 3. Görsel {%- endcomment -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy" decoding="async">
        {%- elsif product.featured_image != blank -%}
          {%- comment -%} 4. Ürün ana görseli {%- endcomment -%}
          <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" loading="lazy" decoding="async">
        {%- else -%}
          <div class="kn-media-placeholder">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <p style="margin:8px 0 0">Görsel veya video ekleyin</p>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Sağ: Kartlar {%- endcomment -%}
      <div class="kn-cards">
        {%- if use_blocks -%}
          {%- for block in card_blocks -%}
          <div class="kn-card" {{ block.shopify_attributes }}>
            <div class="kn-icon-box">
              {%- case block.settings.icon -%}
                {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                {%- when 'droplet' -%}<svg viewBox="0 0 24 24"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                {%- when 'wind' -%}<svg viewBox="0 0 24 24"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/></svg>
                {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                {%- when 'sparkle' -%}<svg viewBox="0 0 24 24"><path d="M12 3c.132 4.426 4.428 8.07 9 8-4.572-.07-8.868 3.574-9 8-.132-4.426-4.428-8.07-9-8 4.572.07 8.868-3.574 9-8z"/></svg>
                {%- when 'sun' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
              {%- endcase -%}
            </div>
            <p class="kn-card-title">{{ block.settings.title | escape }}</p>
            <p class="kn-card-desc">{{ block.settings.description | escape }}</p>
          </div>
          {%- endfor -%}
        {%- elsif kn_cards != blank -%}
          {%- assign card_items = kn_cards | split: ',' -%}
          {%- for item in card_items -%}
            {%- assign parts = item | split: '|' -%}
            {%- assign c_icon = parts[0] | strip -%}
            {%- assign c_title = parts[1] | strip -%}
            {%- assign c_desc = parts[2] | strip -%}
            <div class="kn-card">
              <div class="kn-icon-box">
                {%- case c_icon -%}
                  {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                  {%- when 'droplet' -%}<svg viewBox="0 0 24 24"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
                  {%- when 'wind' -%}<svg viewBox="0 0 24 24"><path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/></svg>
                  {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                  {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  {%- when 'sparkle' -%}<svg viewBox="0 0 24 24"><path d="M12 3c.132 4.426 4.428 8.07 9 8-4.572-.07-8.868 3.574-9 8-.132-4.426-4.428-8.07-9-8 4.572.07 8.868-3.574 9-8z"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg>
                {%- endcase -%}
              </div>
              <p class="kn-card-title">{{ c_title }}</p>
              <p class="kn-card-desc">{{ c_desc }}</p>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  var root=document.getElementById('KiNeden-{{ section.id }}');
  var video=root&&root.querySelector('.kn-lazy-video');
  if(!video) return;
  function play(){
    if(video.preload==='none') video.preload='metadata';
    video.muted=true;
    video.play().catch(function(){});
  }
  function pause(){video.pause();}
  if('IntersectionObserver' in window){
    var observer=new IntersectionObserver(function(entries){
      entries.forEach(function(entry){if(entry.isIntersecting) play();else pause();});
    },{rootMargin:'180px 0px',threshold:.15});
    observer.observe(video);
  }else{
    play();
  }
})();
</script>

{% schema %}
{
  "name": "Neden .ki",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"header","content":"Layout"},
    {"type":"range","id":"pad_y","min":24,"max":120,"step":8,"unit":"px","label":"Dikey dolgu","default":64},
    {"type":"range","id":"pad_x","min":12,"max":80,"step":4,"unit":"px","label":"Yatay dolgu","default":32},
    {"type":"color","id":"bg","label":"Arka plan","default":"#f0eef8"},
    {"type":"color","id":"text_color","label":"Metin rengi","default":"#1a1340"},
    {"type":"color","id":"muted_color","label":"\u0130kincil metin","default":"#666680"},
    {"type":"header","content":"Ba\u015fl\u0131k"},
    {"type":"text","id":"eyebrow","label":"\u00dcst Etiket","default":"NEDEN .K\u0130?","info":"Varsay\u0131lan: NEDEN .K\u0130? \u2014 istedi\u011fin metni yaz"},
    {"type":"text","id":"heading","label":"Ba\u015fl\u0131k (block yokken)","default":"Cildine ve d\u00f6ng\u00fcne iyi gelen bir form\u00fcl"},
