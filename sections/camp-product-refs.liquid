<style>
.ckref{
  --p:#493d9a;--lil:#dad2ff;
  background:{{ section.settings.bg_color | default: '#f8f8f6' }};
  padding:60px 20px;
  font-family:system-ui,sans-serif;
}
.ckref__inner{max-width:960px;margin:0 auto;}
.ckref__head{text-align:center;margin-bottom:40px;}
.ckref__eyebrow{
  display:inline-flex;align-items:center;gap:6px;
  background:rgba(73,61,154,.08);border:1px solid rgba(73,61,154,.15);
  padding:5px 14px;border-radius:50px;
  font-size:11px;font-weight:700;color:var(--p);
  letter-spacing:.06em;text-transform:uppercase;
  margin-bottom:14px;
}
.ckref__title{
  font-family:'Raleway',system-ui,sans-serif;
  font-size:clamp(22px,5vw,34px);font-weight:800;
  color:#1a1340;letter-spacing:-.02em;margin:0 0 10px;
}
.ckref__sub{font-size:14px;color:#6b6b8a;max-width:560px;margin:0 auto;line-height:1.65;}
.ckref__grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:16px;
}
@media(min-width:768px){.ckref__grid{grid-template-columns:repeat(4,1fr);}}
.ckref__card{
  background:#fff;border-radius:18px;
  border:1px solid rgba(73,61,154,.09);
  box-shadow:0 4px 18px rgba(73,61,154,.07);
  overflow:hidden;
  display:flex;flex-direction:column;
  transition:transform .25s,box-shadow .25s;
}
.ckref__card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(73,61,154,.13);}
.ckref__band{height:5px;width:100%;display:block;}
.ckref__body{padding:18px 16px 20px;flex:1;display:flex;flex-direction:column;}
.ckref__icon{
  width:44px;height:44px;border-radius:12px;
  display:flex;align-items:center;justify-content:center;
  margin-bottom:12px;flex-shrink:0;
}
.ckref__icon svg{width:22px;height:22px;}
.ckref__tag{
  display:inline-block;
  font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;
  padding:3px 9px;border-radius:50px;
  margin-bottom:8px;width:fit-content;
}
.ckref__name{
  font-family:'Raleway',system-ui,sans-serif;
  font-size:14px;font-weight:800;color:#1a1340;
  margin:0 0 6px;line-height:1.2;
}
.ckref__desc{
  font-size:11px;color:#6b6b8a;line-height:1.6;margin:0 0 12px;
}
.ckref__ingredients{
  background:rgba(73,61,154,.04);border-radius:9px;
  padding:10px 12px;margin-bottom:12px;
}
.ckref__ing-title{
  font-size:9px;font-weight:800;letter-spacing:.08em;
  text-transform:uppercase;color:rgba(73,61,154,.5);
  margin:0 0 7px;
}
.ckref__ing-list{display:flex;flex-direction:column;gap:5px;}
.ckref__ing-item{
  display:flex;align-items:flex-start;gap:7px;
  font-size:11px;color:#1a1340;line-height:1.4;
}
.ckref__ing-dot{
  width:5px;height:5px;border-radius:50%;
  flex-shrink:0;margin-top:4px;
}
.ckref__needs{
  display:flex;flex-wrap:wrap;gap:5px;margin-bottom:14px;
}
.ckref__need{
  display:inline-flex;align-items:center;gap:4px;
  font-size:10px;font-weight:700;
  padding:4px 9px;border-radius:50px;
  background:rgba(73,61,154,.07);color:var(--p);
  border:1px solid rgba(73,61,154,.12);
}
.ckref__need svg{width:9px;height:9px;}
.ckref__cta{
  display:flex;align-items:center;justify-content:center;gap:5px;
  background:var(--p);color:#fff;
  padding:10px 16px;border-radius:50px;
  font-size:11px;font-weight:700;
  text-decoration:none;margin-top:auto;
  transition:transform .15s,box-shadow .15s;
}
.ckref__cta:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(73,61,154,.25);}
.ckref__cta svg{width:11px;height:11px;}
@media(max-width:480px){
  .ckref__name{font-size:13px;}
  .ckref__body{padding:14px 12px 16px;}
  .ckref__grid{gap:10px;}
}
</style>

