{% comment %}
  Paket Hero — "Paketini Oluştur" başlık + ?abone=<varyantID> ile builder'a otomatik urun ekleme.
{% endcomment %}

<section id="paket-hero-{{ section.id }}" class="section paket-hero">
  <style>
    #paket-hero-{{ section.id }} {
      --ph-bg: {{ section.settings.bg | default: '#ffffff' }};
      --ph-primary: #493d9a;
      --ph-muted: #6f6978;
      --ph-sage: var(--ki-sage, #2e6e51);
      --ph-border: rgba(73,61,154,.14);
      background: var(--ph-bg);
      border-bottom: 1px solid var(--ph-border);
      font-family: var(--ki-font-body, 'Raleway', system-ui, sans-serif);
    }
    #paket-hero-{{ section.id }} .ph-wrap { max-width: var(--ki-container-max, 1240px); margin: 0 auto; padding: 32px 20px 28px; }
    #paket-hero-{{ section.id }} .ph-eyebrow { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--ph-primary); background: rgba(73,61,154,.08); padding: 6px 12px; border-radius: 999px; margin: 0 0 14px; }
    #paket-hero-{{ section.id }} .ph-row { display: flex; flex-direction: column; gap: 20px; }
    #paket-hero-{{ section.id }} .ph-content { width: 100%; min-width: 0; }
    #paket-hero-{{ section.id }} .ph-title { font-family: var(--ki-font-primary, 'Raleway', sans-serif); font-size: 34px; line-height: 1.05; letter-spacing: -.02em; font-weight: 800; color: var(--ph-primary); margin: 0; max-width: 640px; }
    #paket-hero-{{ section.id }} .ph-title em { font-style: italic; color: #6558b8; }
    #paket-hero-{{ section.id }} .ph-text { font-size: 15px; line-height: 1.6; font-weight: 500; color: var(--ph-muted); margin: 16px 0 0; max-width: 640px; }
    #paket-hero-{{ section.id }} .ph-trust { display: flex; flex-wrap: wrap; gap: 8px 24px; list-style: none; padding: 0; margin: 0; }
    #paket-hero-{{ section.id }} .ph-trust li { display: flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; color: rgba(73,61,154,.82); }
    #paket-hero-{{ section.id }} .ph-trust svg { width: 15px; height: 15px; color: var(--ph-sage); flex-shrink: 0; }
    #paket-hero-{{ section.id }} .ph-guide {
      width: 100%;
      max-width: 640px;
      display: flex;
      gap: 8px;
      margin-top: 16px;
      padding: 0 0 4px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    #paket-hero-{{ section.id }} .ph-guide::-webkit-scrollbar { display: none; }
    #paket-hero-{{ section.id }} .ph-guide-card {
      flex: 0 0 min(42vw, 158px);
      min-height: 74px;
      padding: 10px;
      border-radius: 13px;
      display: grid;
      grid-template-columns: 27px minmax(0, 1fr);
      align-items: center;
      gap: 8px;
      scroll-snap-align: start;
      color: #fff;
      background: linear-gradient(135deg, #493d9a 0%, #6254b4 100%);
    }
    #paket-hero-{{ section.id }} .ph-guide-card:nth-child(2),
    #paket-hero-{{ section.id }} .ph-guide-card:nth-child(3) {
      color: #493d9a;
      background: linear-gradient(135deg, #ebe8f7 0%, #dcd6ef 100%);
    }
    #paket-hero-{{ section.id }} .ph-guide-icon {
      width: 27px;
      height: 27px;
      display: grid;
      place-items: center;
      border-radius: 8px;
      background: rgba(255,255,255,.14);
    }
    #paket-hero-{{ section.id }} .ph-guide-card:nth-child(2) .ph-guide-icon,
    #paket-hero-{{ section.id }} .ph-guide-card:nth-child(3) .ph-guide-icon { background: rgba(73,61,154,.08); }
    #paket-hero-{{ section.id }} .ph-guide-icon svg { width: 15px; height: 15px; }
    #paket-hero-{{ section.id }} .ph-guide-title {
      display: block;
      margin-bottom: 2px;
      font-size: 10.5px;
      font-weight: 800;
      line-height: 1.2;
    }
    #paket-hero-{{ section.id }} .ph-guide-copy {
      display: block;
      color: currentColor;
      font-size: 8.5px;
      line-height: 1.3;
      opacity: .82;
    }
    @media (max-width: 1023px) {
      #paket-hero-{{ section.id }} .ph-wrap { padding: 26px 20px 22px; }
      #paket-hero-{{ section.id }} .ph-title { font-size: 30px; line-height: 1.08; }
      #paket-hero-{{ section.id }} .ph-text { font-size: 14px; margin-top: 12px; }
      #paket-hero-{{ section.id }} .ph-trust { margin-top: 14px; gap: 6px 16px; }
      #paket-hero-{{ section.id }} .ph-trust li { font-size: 11.5px; }
    }
    @media (min-width: 640px) { #paket-hero-{{ section.id }} .ph-wrap { padding: 56px 32px; } #paket-hero-{{ section.id }} .ph-title { font-size: 44px; } }
    @media (min-width: 1024px) {
      #paket-hero-{{ section.id }} .ph-wrap { padding: 64px 32px; }
      #paket-hero-{{ section.id }} .ph-title { font-size: 54px; }
      #paket-hero-{{ section.id }} .ph-row { flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 24px; }
      #paket-hero-{{ section.id }} .ph-content { width: auto; flex: 1 1 640px; }
      #paket-hero-{{ section.id }} .ph-trust { justify-content: flex-end; padding-bottom: 4px; }
      #paket-hero-{{ section.id }} .ph-guide-card { flex: 1 1 0; }
    }
  </style>

  <div class="ph-wrap">
    <div class="ph-row">
      <div class="ph-content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="ph-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="ph-title">{{ section.settings.heading | default: 'Paketini Oluştur' }}</h1>
        <div class="ph-text">{{ section.settings.description | default: 'İhtiyacına göre Balance, Change, Ped ve ritüel ürünlerini birleştir. Ayda bir kapına gelsin — istediğin zaman değiştir veya durdur.' }}</div>
        {%- unless section.settings.quick_guide_enabled == false -%}
          <div class="ph-guide" aria-label="Paket oluşturma kısa rehberi">
            <div class="ph-guide-card">
              <span class="ph-guide-icon" aria-hidden="true">{% render 'ki-icon', name: 'sparkles', size: 15 %}</span>
              <span><strong class="ph-guide-title">Bakımını seç</strong><span class="ph-guide-copy">Ped, takviye, jel ve sprey</span></span>
            </div>
            <div class="ph-guide-card">
              <span class="ph-guide-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg></span>
              <span><strong class="ph-guide-title">Sıklığını belirle</strong><span class="ph-guide-copy">1 · 2 · 3 · 4 · 6 ay</span></span>
            </div>
            <div class="ph-guide-card">
              <span class="ph-guide-icon" aria-hidden="true">{% render 'ki-icon', name: 'package', size: 15 %}</span>
              <span><strong class="ph-guide-title">Paketini oluştur</strong><span class="ph-guide-copy">Ürün ve adetleri ayarla</span></span>
            </div>
            <div class="ph-guide-card">
              <span class="ph-guide-icon" aria-hidden="true">{% render 'ki-icon', name: 'truck', size: 15 %}</span>
              <span><strong class="ph-guide-title">Düzenli kapına gelsin</strong><span class="ph-guide-copy">%15 avantaj · ₺400+ kargo ₺59 · ₺800+ ücretsiz</span></span>
            </div>
          </div>
        {%- endunless -%}
      </div>

      <ul class="ph-trust">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {%- case block.settings.icon -%}
              {%- when 'check' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- endcase -%}
            {{ block.settings.label }}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

<script>
(function(){
  function getParam(n){ try { return new URLSearchParams(window.location.search).get(n); } catch(e){ return null; } }
  var abone = getParam('abone');
  var productHandle = getParam('product');
  if (!abone && !productHandle) return;
  var tries = 0;
  function tryPrefill(){
    tries++;
    var item = abone ? document.querySelector('[data-ki-pack-variant-id="' + CSS.escape(abone) + '"]') : null;
    if (!item && productHandle) {
      item = document.querySelector('[data-ki-pack-product-handle="' + CSS.escape(productHandle) + '"]');
    }
    if (item) {
      var cat = item.closest('[data-ki-pack-cat]');
      if (cat) {
        cat.setAttribute('data-open','true');
        var head = cat.querySelector('[data-ki-pack-cat-toggle]');
        if (head) head.setAttribute('aria-expanded','true');
      }
      var plus = item.querySelector('[data-ki-pack-plus]');
      if (plus) { plus.click(); }
      var builder = document.querySelector('[data-ki-section="pack"]');
      if (builder && builder.scrollIntoView) { builder.scrollIntoView({ behavior:'smooth', block:'start' }); }
      item.style.transition = 'background .3s';
      var prevBg = item.style.background;
      item.style.background = 'rgba(73,61,154,.10)';
      setTimeout(function(){ item.style.background = prevBg; }, 1400);
      return;
    }
    if (tries < 40) { setTimeout(tryPrefill, 150); }
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', function(){ setTimeout(tryPrefill, 250); }); }
  else { setTimeout(tryPrefill, 250); }
})();
</script>

{% schema %}
{
  "name": "Paket Hero",
  "tag": "section",
  "class": "paket-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Abonelik · Sana özel" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Paketini Oluştur" },
    { "type": "richtext", "id": "description", "label": "Açıklama", "default": "<p>İhtiyacına göre Balance, Change, Ped ve ritüel ürünlerini birleştir. Ayda bir kapına gelsin — istediğin zaman değiştir veya durdur.</p>" },
    { "type": "checkbox", "id": "quick_guide_enabled", "label": "Kompakt paket rehberini göster", "default": true },
    { "type": "color", "id": "bg", "label": "Arka plan", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust maddesi",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "İkon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "label", "label": "Metin", "default": "İptal yok, esnek abonelik" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Paket Hero",
      "blocks": [
        { "type": "trust", "settings": { "icon": "check", "label": "İptal yok, esnek abonelik" } },
        { "type": "trust", "settings": { "icon": "truck", "label": "₺400+ kargo ₺59 · ₺800+ ücretsiz" } },
        { "type": "trust", "settings": { "icon": "shield", "label": "Dermatolojik test edilmiş" } }
      ]
    }
  ]
}
{% endschema %}
