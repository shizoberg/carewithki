{% comment %}.ki Koleksiyon Sayfası v2 — koleksiyon tipine göre farklı tema{% endcomment %}


{%- assign banner_bg = section.settings.banner_gradient | default: 'linear-gradient(135deg, #493d9a 0%, #6b5dd3 100%)' -%}
{%- assign eyebrow = section.settings.eyebrow_text | default: '.ki koleksiyonu' -%}
{%- assign badge_clr = section.settings.badge_color | default: '#493d9a' -%}
{%- assign source_collection = collection -%}
{%- if section.settings.source_all_products -%}
  {%- assign source_collection = collections['all'] -%}
{%- endif -%}
{%- assign hidden_handles = section.settings.hidden_product_handles | default: 'abonelik-kutusu,ki-member,ki-test-urun' | split: ',' -%}
{%- assign visible_product_count = 0 -%}
{%- for source_product in source_collection.products -%}
  {%- unless hidden_handles contains source_product.handle -%}
    {%- assign visible_product_count = visible_product_count | plus: 1 -%}
  {%- endunless -%}
{%- endfor -%}

<style>
.kicol-{{ section.id }} {
  --p: #493d9a;
  --lil: #dad2ff;
  --pur: #b2a5ff;
  --bg: #fff;
  --txt: #1a1340;
  --mut: #6b6b8a;
  --badge: {{ badge_clr }};
  background: var(--bg);
  min-height: 60vh;
}

/* ── BANNER ── */
.kicol-{{ section.id }} .kicol-banner {
  background: {{ banner_bg }};
  padding: 42px 24px;
  position: relative;
  overflow: hidden;
  width: min(1320px, calc(100% - 40px));
  margin: 20px auto 0;
  border: 1px solid rgba(73, 61, 154, .12);
  border-radius: 28px;
  box-shadow: 0 16px 44px rgba(33, 24, 79, .12);
}
.kicol-{{ section.id }} .kicol-banner::before {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(ellipse at 70% 50%, rgba(255,255,255,.08) 0%, transparent 60%);
  pointer-events: none;
}
.kicol-{{ section.id }} .kicol-banner__inner {
  max-width: 1320px; margin: 0 auto;
  display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(320px, .8fr);
  align-items: center; gap: 44px; position: relative; z-index: 1;
}
.kicol-{{ section.id }} .kicol-banner__copy { max-width: 690px; }
.kicol-{{ section.id }} .kicol-banner__eyebrow {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 10px; font-weight: 700; letter-spacing: .14em;
  text-transform: uppercase; color: var(--lil);
  margin: 0 0 12px;
}
.kicol-{{ section.id }} .kicol-banner__eyebrow::before,
.kicol-{{ section.id }} .kicol-banner__eyebrow::after {
  content: ''; display: inline-block;
  width: 20px; height: 1px;
  background: var(--lil); opacity: .6;
}
.kicol-{{ section.id }} .kicol-banner__title {
  font-family: 'Raleway', system-ui, sans-serif;
  font-size: clamp(24px, 4vw, 44px);
  font-weight: 800; color: #fff;
  margin: 0 0 12px; line-height: 1.04; letter-spacing: -.03em;
}
.kicol-{{ section.id }} .kicol-banner__desc {
  font-size: 14px; color: rgba(255,255,255,.68);
  max-width: 620px; margin: 0;
  line-height: 1.65;
}
.kicol-{{ section.id }} .kicol-banner__count {
  display: inline-block; margin-top: 16px;
  background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.2);
  padding: 4px 14px; border-radius: 50px;
  font-size: 11px; font-weight: 600; color: rgba(255,255,255,.75);
  letter-spacing: .04em;
}
.kicol-{{ section.id }} .kicol-banner__visual {
  min-height: 220px; position: relative; display: flex; justify-content: flex-end; align-items: center;
}
.kicol-{{ section.id }} .kicol-banner__stack {
  width: min(100%, 410px); display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;
  transform: rotate(-2deg);
}
.kicol-{{ section.id }} .kicol-banner__mini {
  aspect-ratio: .8; border-radius: 18px; overflow: hidden; background: rgba(255,255,255,.12);
  border: 1px solid rgba(255,255,255,.24); box-shadow: 0 18px 38px rgba(17,12,55,.22);
}
.kicol-{{ section.id }} .kicol-banner__mini:nth-child(2) { transform: translateY(-16px); }
.kicol-{{ section.id }} .kicol-banner__mini img { width: 100%; height: 100%; object-fit: cover; display: block; }
.kicol-{{ section.id }} .kicol-banner__trust {
  display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px;
}
.kicol-{{ section.id }} .kicol-banner__trust span {
  display: inline-flex; align-items: center; gap: 6px; padding: 7px 11px; border-radius: 999px;
  background: rgba(255,255,255,.11); border: 1px solid rgba(255,255,255,.18);
  color: rgba(255,255,255,.88); font-size: 10px; font-weight: 700;
}

/* ── TOOLBAR ── */
.kicol-{{ section.id }} .kicol-toolbar {
  border-bottom: 1px solid rgba(73,61,154,.1);
  background: #fff;
}
.kicol-{{ section.id }} .kicol-toolbar__inner {
  max-width: 1320px; margin: 0 auto;
  padding: 0 32px;
  display: flex; align-items: center;
  justify-content: space-between;
  flex-wrap: wrap; gap: 8px;
  min-height: 52px;
}
.kicol-{{ section.id }} .kicol-tags {
  display: flex; gap: 4px; flex-wrap: wrap;
  list-style: none; margin: 0; padding: 8px 0;
}
.kicol-{{ section.id }} .kicol-tag {
  display: inline-flex; align-items: center;
  padding: 5px 14px; border-radius: 50px;
  font-size: 11px; font-weight: 600;
  text-decoration: none;
  border: 1.5px solid rgba(73,61,154,.18);
  color: var(--mut); background: transparent;
  transition: all .15s; white-space: nowrap;
}
.kicol-{{ section.id }} .kicol-tag:hover,
.kicol-{{ section.id }} .kicol-tag.is-active {
  background: var(--p); color: #fff; border-color: var(--p);
}
.kicol-{{ section.id }} .kicol-sort {
  display: flex; align-items: center; gap: 8px;
  font-size: 12px; color: var(--mut); flex-shrink: 0;
}
.kicol-{{ section.id }} .kicol-sort select {
  font-size: 12px; color: var(--txt);
  border: 1px solid rgba(73,61,154,.18);
  border-radius: 8px; padding: 5px 10px;
  background: transparent; cursor: pointer; outline: none;
}

/* ── GRID ── */
.kicol-{{ section.id }} .kicol-main {
  max-width: 1320px; margin: 0 auto;
  padding: 32px 32px 72px;
}
.kicol-{{ section.id }} .kicol-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, 1fr);
  gap: 20px;
  list-style: none; margin: 0; padding: 0;
}

/* ── KART ── */
.kicol-{{ section.id }} .kicol-card {
  background: #fff;
  border-radius: 16px; overflow: hidden;
  border: 1px solid rgba(73,61,154,.08);
  box-shadow: 0 2px 12px rgba(73,61,154,.05);
  transition: transform .25s, box-shadow .25s;
  display: flex; flex-direction: column;
}
.kicol-{{ section.id }} .kicol-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 36px rgba(73,61,154,.13);
}
.kicol-{{ section.id }} .kicol-card__img-wrap {
  position: relative; aspect-ratio: 1/1;
  overflow: hidden; background: #f5f3ff;
  display: block; text-decoration: none;
}
.kicol-{{ section.id }} .kicol-card__img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform .5s;
}
.kicol-{{ section.id }} .kicol-card:hover .kicol-card__img { transform: scale(1.04); }
.kicol-{{ section.id }} .ki-care-bundle-collage {
  display: grid; width: 100%; height: 100%;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 5px; padding: 12px;
  background: linear-gradient(140deg, #21194c, #6357bb);
}
.kicol-{{ section.id }} .ki-care-bundle-collage__item {
  min-width: 0; overflow: hidden; border-radius: 10px;
  background: #2a2358; box-shadow: 0 8px 20px rgba(7,4,30,.18);
}
.kicol-{{ section.id }} .ki-care-bundle-collage__item:nth-child(2) { transform: translateY(-5px); }
.kicol-{{ section.id }} .ki-care-bundle-collage__item img {
  width: 100%; height: 100%; object-fit: cover; display: block;
}
.kicol-{{ section.id }} .kicol-card__badge {
  position: absolute; top: 10px; left: 10px;
  background: var(--badge); color: #fff;
  font-size: 9px; font-weight: 700;
  letter-spacing: .06em; text-transform: uppercase;
  padding: 4px 10px; border-radius: 50px;
}
.kicol-{{ section.id }} .kicol-card__body {
  padding: 16px 18px 18px;
  flex: 1; display: flex; flex-direction: column; gap: 5px;
}
.kicol-{{ section.id }} .kicol-card__vendor {
  font-size: 10px; font-weight: 700; letter-spacing: .08em;
  text-transform: uppercase; color: var(--pur);
}
.kicol-{{ section.id }} .kicol-card__title {
  font-size: 14px; font-weight: 700; color: var(--txt);
  text-decoration: none; line-height: 1.3;
  display: -webkit-box; -webkit-line-clamp: 2;
  -webkit-box-orient: vertical; overflow: hidden;
}
.kicol-{{ section.id }} .kicol-card__title:hover { color: var(--p); }
.kicol-{{ section.id }} .kicol-card__desc {
  font-size: 11px; color: var(--mut); line-height: 1.55;
  display: -webkit-box; -webkit-line-clamp: 2;
  -webkit-box-orient: vertical; overflow: hidden;
}
.kicol-{{ section.id }} .kicol-card__bundle-tags {
  display: flex; flex-wrap: wrap; gap: 5px; margin: 5px 0 3px;
}
.kicol-{{ section.id }} .kicol-card__bundle-tag {
  display: inline-flex; padding: 4px 7px; border-radius: 999px;
  background: #f1effb; color: var(--p); font-size: 9px; font-weight: 750; line-height: 1.2;
}
.kicol-{{ section.id }} .kicol-card__footer {
  display: flex; align-items: center;
  justify-content: space-between;
  margin-top: auto; padding-top: 12px;
  border-top: 1px solid rgba(73,61,154,.06);
}
.kicol-{{ section.id }} .kicol-card__prices {
  display: flex; align-items: baseline; gap: 5px;
}
.kicol-{{ section.id }} .kicol-card__price {
  font-size: 16px; font-weight: 800; color: var(--p);
}
.kicol-{{ section.id }} .kicol-card__price-compare {
  font-size: 11px; color: #c0c0c0; text-decoration: line-through;
}
.kicol-{{ section.id }} .kicol-card__btn {
  display: inline-flex; align-items: center; justify-content: center;
  width: 34px; height: 34px; border-radius: 50%;
  background: var(--p); color: #fff;
  text-decoration: none; flex-shrink: 0;
  transition: background .15s, transform .15s;
}
.kicol-{{ section.id }} .kicol-card__btn:hover { background: #3b3280; transform: scale(1.08); }
.kicol-{{ section.id }} .kicol-card__btn svg { width: 15px; height: 15px; }
.kicol-{{ section.id }} .kicol-card__actions { display: grid; gap: 7px; margin-top: 10px; }
.kicol-{{ section.id }} .kicol-card__atc,
.kicol-{{ section.id }} .kicol-card__subscribe {
  width: 100%; min-height: 36px; border-radius: 9px; display: inline-flex; align-items: center;
  justify-content: center; gap: 6px; font: inherit; font-size: 11px; font-weight: 750; cursor: pointer;
}
.kicol-{{ section.id }} .kicol-card__atc { border: 0; background: var(--p); color: #fff; }
.kicol-{{ section.id }} .kicol-card__atc:disabled { background: #e5e7eb; color: #8b8b9b; cursor: not-allowed; }
.kicol-{{ section.id }} .kicol-card__subscribe { border: 1px solid var(--p); background: #fff; color: var(--p); text-decoration: none; }
.kicol-{{ section.id }} .kicol-card__subscribe:hover { background: var(--p); color: #fff; }
.kicol-{{ section.id }} .kicol-card__subscribe svg { width: 13px; height: 13px; }

/* Bundle için büyük kart — 2 sütunluk */
.kicol-{{ section.id }} .kicol-grid--bundle .kicol-card__img-wrap {
  aspect-ratio: 16 / 9;
}
.kicol-{{ section.id }} .kicol-grid--bundle .kicol-card__price { font-size: 20px; }

/* ── EMPTY ── */
.kicol-{{ section.id }} .kicol-empty {
  text-align: center; padding: 80px 24px;
  grid-column: 1 / -1;
  color: var(--mut); font-size: 14px;
}

/* ── PAGINATION ── */
.kicol-{{ section.id }} .kicol-pagination {
  display: flex; justify-content: center;
  gap: 6px; padding: 40px 0 0; flex-wrap: wrap;
}
.kicol-{{ section.id }} .kicol-pagination a,
.kicol-{{ section.id }} .kicol-pagination span {
  display: inline-flex; align-items: center; justify-content: center;
  width: 38px; height: 38px; border-radius: 10px;
  font-size: 13px; font-weight: 600;
  border: 1px solid rgba(73,61,154,.18);
  color: var(--txt); text-decoration: none;
  transition: all .15s;
}
.kicol-{{ section.id }} .kicol-pagination a:hover { background: var(--lil); border-color: var(--p); color: var(--p); }
.kicol-{{ section.id }} .kicol-pagination span.current { background: var(--p); color: #fff; border-color: var(--p); }

/* ── MOBILE ── */
@media (max-width: 749px) {
  .kicol-{{ section.id }} .kicol-banner {
    width: calc(100% - 24px);
    margin: 12px auto 0;
    border-radius: 20px;
    padding: 26px 18px 22px;
  }
  .kicol-{{ section.id }} .kicol-banner__inner { grid-template-columns: 1fr; gap: 22px; }
  .kicol-{{ section.id }} .kicol-banner__title { font-size: 30px; }
  .kicol-{{ section.id }} .kicol-banner__visual { min-height: 128px; justify-content: flex-start; }
  .kicol-{{ section.id }} .kicol-banner__stack { width: 250px; gap: 7px; }
  .kicol-{{ section.id }} .kicol-banner__mini { border-radius: 12px; }
  .kicol-{{ section.id }} .kicol-banner__mini:nth-child(2) { transform: translateY(-8px); }
  .kicol-{{ section.id }} .kicol-toolbar__inner { padding: 8px 14px; }
  .kicol-{{ section.id }} .kicol-main { padding: 18px 14px 48px; }
  .kicol-{{ section.id }} .kicol-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 10px; }
  .kicol-{{ section.id }} .kicol-card__body { padding: 11px 12px 13px; }
  .kicol-{{ section.id }} .kicol-card__title { font-size: 12px; }
  .kicol-{{ section.id }} .kicol-card__price { font-size: 13px; }
  .kicol-{{ section.id }} .kicol-card__btn { width: 28px; height: 28px; }
  .kicol-{{ section.id }} .kicol-card__btn svg { width: 12px; height: 12px; }
  .kicol-{{ section.id }} .kicol-grid--bundle { grid-template-columns: 1fr !important; }
  .kicol-{{ section.id }} .kicol-grid--bundle .kicol-card__img-wrap { aspect-ratio: 3/2; }
}
@media (min-width: 750px) and (max-width: 989px) {
  .kicol-{{ section.id }} .kicol-grid { grid-template-columns: repeat(2, 1fr) !important; }
  .kicol-{{ section.id }} .kicol-main { padding: 24px 20px 56px; }
  .kicol-{{ section.id }} .kicol-toolbar__inner { padding: 0 20px; }
}
</style>

{%- assign products_per_page = section.settings.products_per_page | default: 12 -%}
{%- assign is_bundle = false -%}
{%- if section.settings.columns_desktop == 2 -%}{%- assign is_bundle = true -%}{%- endif -%}

<div class="kicol-{{ section.id }}">

  <!-- BANNER -->
  <div class="kicol-banner">
    <div class="kicol-banner__inner">
      <div class="kicol-banner__copy">
        <p class="kicol-banner__eyebrow">{{ eyebrow | escape }}</p>
        <h1 class="kicol-banner__title">{{ section.settings.hero_title | default: collection.title | escape }}</h1>
        <p class="kicol-banner__desc">
          {%- if section.settings.hero_description != blank -%}
            {{ section.settings.hero_description | escape }}
          {%- elsif collection.description != blank -%}
            {{ collection.description }}
          {%- else -%}
            Kadın sağlığının farklı dönemleri için geliştirilen tüm .ki ürünlerini bir arada keşfet.
          {%- endif -%}
        </p>
        <span class="kicol-banner__count">{{ visible_product_count }} ürün</span>
        <div class="kicol-banner__trust" aria-label="Koleksiyon özellikleri">
          <span>Uzman eczacı formülü</span><span>Bilimsel yaklaşım</span><span>Aboneliğe uygun</span>
        </div>
      </div>
      <div class="kicol-banner__visual" aria-hidden="true">
        <div class="kicol-banner__stack">
          {%- assign hero_product_count = 0 -%}
          {%- for hero_product in source_collection.products -%}
            {%- unless hidden_handles contains hero_product.handle -%}
              {%- if hero_product.featured_image and hero_product_count < 3 -%}
                <div class="kicol-banner__mini">
                  {{ hero_product.featured_image | image_url: width: 360 | image_tag: loading: 'eager', alt: '' }}
                </div>
                {%- assign hero_product_count = hero_product_count | plus: 1 -%}
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <!-- TOOLBAR -->
  {%- if section.settings.show_filters or section.settings.show_sort -%}
  <div class="kicol-toolbar">
    <div class="kicol-toolbar__inner">
      {%- if section.settings.show_filters and collection.all_tags.size > 0 -%}
        <ul class="kicol-tags">
          <li><a href="{{ collection.url }}" class="kicol-tag{% unless collection.current_tags.size > 0 %} is-active{% endunless %}">Hepsi</a></li>
          {%- for tag in collection.all_tags -%}
            <li><a href="{{ collection.url }}/{{ tag | handle }}" class="kicol-tag{% if collection.current_tags contains tag %} is-active{% endif %}">{{ tag | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.show_sort -%}
        <div class="kicol-sort">
          <span>Sırala:</span>
          <select onchange="window.location.href=this.value">
            {%- for option in collection.sort_options -%}
              <option value="{{ collection.url }}?sort_by={{ option.value }}" {% if collection.sort_by == option.value %}selected{% endif %}>
                {{ option.name }}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}

  <!-- ÜRÜN GRİD -->
  <div class="kicol-main">
    {%- paginate source_collection.products by products_per_page -%}
      {%- if source_collection.products.size > 0 -%}
        <ul class="kicol-grid{% if is_bundle %} kicol-grid--bundle{% endif %}">
          {%- for product in source_collection.products -%}
            {%- if hidden_handles contains product.handle -%}{%- continue -%}{%- endif -%}
            {%- assign cv = product.selected_or_first_available_variant -%}
            {%- assign bundle_contents = blank -%}
            {%- case product.handle -%}
              {%- when 'ki-dongu-destek-paketi' -%}
                {%- assign bundle_contents = '.ki Balance,.ki flow.care,.ki intimate' -%}
              {%- when 'ki-hassas-bakim-paketi' -%}
                {%- assign bundle_contents = '.ki sens.care,.ki intimate' -%}
              {%- when 'ki-menopoz-bakim-paketi' -%}
                {%- assign bundle_contents = '.ki Change,.ki 50+.care,.ki intimate' -%}
              {%- when 'ki-light-ped-paketi-15-adet' -%}
                {%- assign bundle_contents = '9 Günlük Ped,4 Gündüz Ped,2 Gece Ped' -%}
              {%- when 'ki-medium-ped-paketi-22-adet' -%}
                {%- assign bundle_contents = '9 Günlük Ped,9 Gündüz Ped,4 Gece Ped' -%}
              {%- when 'ki-yogun-gunler-ped-paketi-26-adet' -%}
                {%- assign bundle_contents = '6 Günlük Ped,12 Gündüz Ped,8 Gece Ped' -%}
              {%- when 'balance-ve-intimate-bundle' -%}
                {%- assign bundle_contents = '.ki Balance,.ki intimate' -%}
              {%- when 'ki-intimate-arkadas-paketi' -%}
                {%- assign bundle_contents = '2 × .ki intimate' -%}
            {%- endcase -%}
            <li class="kicol-card">
              <a href="{{ product.url }}" class="kicol-card__img-wrap">
                {% render 'ki-product-card-media', product: product, image_class: 'kicol-card__img', image_width: 600, placeholder_name: 'product-1' %}
                {%- if cv.compare_at_price > cv.price -%}
                  {%- assign save_pct = cv.compare_at_price | minus: cv.price | times: 100 | divided_by: cv.compare_at_price -%}
                  <span class="kicol-card__badge">%{{ save_pct }} İndirim</span>
                {%- endif -%}
              </a>
              <div class="kicol-card__body">
                {%- if product.vendor != blank -%}
                  <span class="kicol-card__vendor">{{ product.vendor }}</span>
                {%- endif -%}
                <a href="{{ product.url }}" class="kicol-card__title">{{ product.title | escape }}</a>
                {%- if section.settings.show_description and product.description != blank -%}
                  <p class="kicol-card__desc">{{ product.description | strip_html }}</p>
                {%- endif -%}
                {%- if bundle_contents != blank -%}
                  <div class="kicol-card__bundle-tags" aria-label="Paket içeriği">
                    {%- assign bundle_items = bundle_contents | split: ',' -%}
                    {%- for bundle_item in bundle_items -%}
                      <span class="kicol-card__bundle-tag">✓ {{ bundle_item | strip | escape }}</span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
                <div class="kicol-card__footer">
                  <div class="kicol-card__prices">
                    <span class="kicol-card__price">{{ cv.price | money }}</span>
                    {%- if cv.compare_at_price > cv.price -%}
                      <span class="kicol-card__price-compare">{{ cv.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>
                  <a href="{{ product.url }}" class="kicol-card__btn" aria-label="İncele">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                </div>
                <div class="kicol-card__actions">
                  <button type="button" class="kicol-card__atc" data-kicol-add="{{ cv.id }}"{% unless cv.available %} disabled{% endunless %}>
                    {%- if cv.available -%}Sepete Ekle{%- else -%}Satışa kapalı{%- endif -%}
                  </button>
                  {% render 'ki-subscribe-link', product: product, class: 'kicol-card__subscribe' %}
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <div class="kicol-pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&#8592;</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}<span class="current">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&#8594;</a>{%- endif -%}
          </div>
        {%- endif -%}

      {%- else -%}
        <div class="kicol-empty">
          <p>Bu koleksiyonda henüz ürün bulunmuyor.</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>

</div>

<script>
(function() {
  var root = document.querySelector('.kicol-{{ section.id }}');
  if (!root) return;
  root.addEventListener('click', function(event) {
    var button = event.target.closest('[data-kicol-add]');
    if (!button || button.disabled) return;
    button.disabled = true;
    button.textContent = 'Ekleniyor…';
    fetch('{{ routes.cart_add_url }}.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [{ id: Number(button.dataset.kicolAdd), quantity: 1 }] })
    })
      .then(function(response) {
        if (!response.ok) throw new Error('cart-add');
        button.textContent = 'Eklendi';
        document.dispatchEvent(new CustomEvent('cart:refresh'));
      })
      .catch(function() {
        button.disabled = false;
        button.textContent = 'Tekrar dene';
      });
  });
})();
</script>

