    {"type":"text","id":"sheet_url","label":"Google Sheets CSV URL","info":"Google Sheets → Dosya → Web'de yayınla → CSV formatını seçin."},
    {"type":"color","id":"bg","label":"Arka plan","default":"#f8f8f6"}
  ],
  "presets":[{"name":"Anlaşmalı Eczaneler"}]
}
