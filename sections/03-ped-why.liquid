{% comment %}
  Why .ki Ped — "Cildine layık olan ped"
  Pozisyon: Pedler #3
  Sol: eyebrow + başlık + açıklama + 4 madde liste + CTA
  Sağ: kare görsel
{% endcomment %}

<section id="why-pad-{{ section.id }}" class="section why-pad">
  <style>
    #why-pad-{{ section.id }} {
      --y-bg: {{ section.settings.bg | default: '#fffaf3' }};
      --y-primary: {{ section.settings.primary_color | default: '#3a2d6e' }};
      --y-primary-fg: #ffffff;
      --y-rose: {{ section.settings.rose_color | default: '#d96d8a' }};
      --y-rose-light: {{ section.settings.rose_light | default: '#f6dce4' }};
      --y-sage: {{ section.settings.sage_color | default: '#7b9d6f' }};
      --y-sage-light: {{ section.settings.sage_light | default: '#dde8d4' }};
      background: var(--y-bg);
      padding: 56px 0;
      font-family: system-ui, -apple-system, sans-serif;
    }
    #why-pad-{{ section.id }} .y-wrap {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 20px;
    }
    #why-pad-{{ section.id }} .y-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
      align-items: center;
    }

    #why-pad-{{ section.id }} .y-eyebrow {
      display: block;
      font-size: 12px; font-weight: 700;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--y-rose);
      margin-bottom: 12px;
    }
    #why-pad-{{ section.id }} .y-title {
      font-size: 28px; line-height: 1.1;
      letter-spacing: -.02em;
      font-weight: 500;
      color: var(--y-primary);
      margin: 0;
    }
    #why-pad-{{ section.id }} .y-text {
      font-size: 15px; line-height: 1.6;
      color: rgba(26,26,26,.8);
      max-width: 560px;
      margin: 20px 0 0;
    }

    #why-pad-{{ section.id }} .y-list {
      list-style: none;
      padding: 0;
      margin: 28px 0 0;
      display: flex; flex-direction: column;
      gap: 16px;
    }
    #why-pad-{{ section.id }} .y-li { display: flex; gap: 12px; align-items: flex-start; }
    #why-pad-{{ section.id }} .y-check {
      flex-shrink: 0;
      width: 20px; height: 20px;
      border-radius: 50%;
      background: var(--y-sage-light);
      color: var(--y-sage);
      display: grid; place-items: center;
      margin-top: 2px;
    }
    #why-pad-{{ section.id }} .y-check svg { width: 12px; height: 12px; }
    #why-pad-{{ section.id }} .y-li-title {
      font-size: 14.5px; font-weight: 700;
      color: var(--y-primary);
      margin: 0;
    }
    #why-pad-{{ section.id }} .y-li-desc {
      font-size: 13.5px; line-height: 1.6;
      color: rgba(26,26,26,.7);
      margin: 2px 0 0;
    }

    #why-pad-{{ section.id }} .y-cta {
      display: inline-flex; align-items: center; gap: 8px;
      margin-top: 32px;
      font-size: 13.5px; font-weight: 600;
      color: var(--y-primary);
      border: 1px solid rgba(58,45,110,.4);
      padding: 10px 20px;
      border-radius: 999px;
      text-decoration: none;
      transition: background .2s, color .2s;
    }
    #why-pad-{{ section.id }} .y-cta:hover {
      background: var(--y-primary);
      color: var(--y-primary-fg);
    }
    #why-pad-{{ section.id }} .y-cta svg { width: 16px; height: 16px; }

    #why-pad-{{ section.id }} .y-img-wrap {
      border-radius: 24px;
      overflow: hidden;
      aspect-ratio: 1/1;
      background: var(--y-rose-light);
    }
    #why-pad-{{ section.id }} .y-img-wrap img {
      width: 100%; height: 100%;
      object-fit: cover;
    }

    @media (min-width: 1024px) {
      #why-pad-{{ section.id }} { padding: 80px 0; }
      #why-pad-{{ section.id }} .y-wrap { padding: 0 32px; }
      #why-pad-{{ section.id }} .y-grid {
        grid-template-columns: 1.1fr 1fr;
        gap: 64px;
      }
      #why-pad-{{ section.id }} .y-content { order: 1; }
      #why-pad-{{ section.id }} .y-image { order: 2; }
      #why-pad-{{ section.id }} .y-title { font-size: 44px; }
    }
  </style>

  <div class="y-wrap">
    <div class="y-grid">
      <div class="y-content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="y-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="y-title">{{ section.settings.heading | default: 'Cildine layık olan ped' }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="y-text">{{ section.settings.description }}</p>
        {%- endif -%}

        <ul class="y-list">
          {%- for block in section.blocks -%}
            <li class="y-li" {{ block.shopify_attributes }}>
              <span class="y-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <div>
                <p class="y-li-title">{{ block.settings.title }}</p>
                <p class="y-li-desc">{{ block.settings.description }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: '#' }}" class="y-cta">
            {{ section.settings.cta_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        {%- endif -%}
      </div>

      <div class="y-image">
        <div class="y-img-wrap">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.heading, loading: 'lazy' }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why .ki Pad",
  "tag": "section",
  "class": "why-pad",
  "settings": [
    { "type": "header", "content": "İçerik" },
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Doğal · Şeffaf · Güvenli" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Cildine layık olan ped" },
    { "type": "textarea", "id": "description", "label": "Açıklama", "default": ".ki Ped, Soft Cotton & Bamboo Fiber üst yüzey ve nefes alan arka yüzeyle hassas bölgene nazikçe uyum sağlar. Tüm seri Mugwort (Pelin Otu) infüzyonludur ve SLS / SLES içermez." },

    { "type": "header", "content": "CTA" },
    { "type": "text", "id": "cta_label", "label": "CTA metni", "default": "Paketini oluştur" },
    { "type": "url", "id": "cta_link", "label": "CTA linki" },

    { "type": "header", "content": "Görsel" },
    { "type": "image_picker", "id": "image", "label": "Sağ görsel" },

    { "type": "header", "content": "Renkler" },
    { "type": "color", "id": "bg", "label": "Arka plan", "default": "#fffaf3" },
    { "type": "color", "id": "primary_color", "label": "Primary", "default": "#3a2d6e" },
    { "type": "color", "id": "rose_color", "label": "Rose (eyebrow)", "default": "#d96d8a" },
    { "type": "color", "id": "rose_light", "label": "Rose light (görsel arka plan)", "default": "#f6dce4" },
    { "type": "color", "id": "sage_color", "label": "Sage (check)", "default": "#7b9d6f" },
    { "type": "color", "id": "sage_light", "label": "Sage light (check arka plan)", "default": "#dde8d4" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Fayda maddesi",
      "settings": [
        { "type": "text", "id": "title", "label": "Başlık" },
        { "type": "textarea", "id": "description", "label": "Açıklama" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why .ki Pad",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Mugwort (Pelin Otu) infüzyonu", "description": "Geleneksel tıbbın bilgeliğini modern konforla buluşturan doğal antibakteriyel bariyer." } },
        { "type": "benefit", "settings": { "title": "Soft Cotton & Bamboo Fiber üst yüzey", "description": "Yumuşak pamuk ve bambu lifi karışımı, hassas cilde nazikçe uyum sağlar." } },
        { "type": "benefit", "settings": { "title": "SLS / SLES içermez", "description": "Sert sülfat bazlı kimyasallar yok — pH dengesi korunur." } },
        { "type": "benefit", "settings": { "title": "Nefes alan üst & arka yüzey", "description": "Breathable yapı sayesinde gün boyu serin ve kuru kullanım hissi." } }
      ]
    }
  ]
}
{% endschema %}
