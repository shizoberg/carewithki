<style>
  .camp-whatsapp {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 50;
    width: 3.5rem;
    height: 3.5rem;
    background-color: #25D366;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    color: #fff;
    text-decoration: none;
  }
  .camp-whatsapp:hover {
    transform: scale(1.05);
  }
  .camp-whatsapp svg {
    width: 28px;
    height: 28px;
  }
</style>

{%- if section.settings.phone_number != blank -%}
  <a
    href="https://wa.me/{{ section.settings.phone_number | remove: ' ' | remove: '+' }}?text={{ section.settings.message | url_encode }}"
    target="_blank"
    rel="noopener noreferrer"
    class="camp-whatsapp"
    id="{{ section.id }}"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
    </svg>
  </a>
{%- endif -%}

{% schema %}
{
  "name": "Camp: WhatsApp",
  "settings": [
    { "type": "text", "id": "phone_number", "label": "WhatsApp Numarası", "default": "905000000000", "info": "Ülke kodu ile boşluksuz (Örn: 905xxxxxxxxx)" },
    { "type": "text", "id": "message", "label": "Hazır Mesaj", "default": "Merhaba, .ki Campus hakkında bilgi almak istiyorum." }
  ],
  "presets": [
    { 
      "name": "Camp: WhatsApp"
    }
  ]
}
{% endschema %}
