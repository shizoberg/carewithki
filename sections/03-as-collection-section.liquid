{% comment %}
  Collection Section — "Sana özel paketler" 4 lü ürün kartları
  Pozisyon: Anasayfa #3
  Mobile: yatay snap scroll, Desktop: 4 sütun grid
  Header sağında "Tüm Paketler / Kendine özel paket oluştur" CTA
{% endcomment %}

<section id="collection-section-{{ section.id }}" class="section collection-section">
  <style>
    #collection-section-{{ section.id }} {
      --cs-bg: {{ section.settings.bg | default: '#fffaf3' }};
      --cs-card-bg: {{ section.settings.card_bg | default: '#ffffff' }};
      --cs-primary: {{ section.settings.primary_color | default: '#3a2d6e' }};
      --cs-primary-fg: {{ section.settings.primary_fg | default: '#ffffff' }};
      --cs-text: {{ section.settings.text_color | default: '#1a1a1a' }};
      --cs-border: rgba(0,0,0,.1);
      --cs-star: #f5b400;
      background: var(--cs-bg);
      padding: 32px 0 48px;
      font-family: system-ui, -apple-system, sans-serif;
    }

    #collection-section-{{ section.id }} .cs-wrap {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 20px;
    }

    #collection-section-{{ section.id }} .cs-header {
      display: flex; align-items: flex-end; justify-content: space-between;
      gap: 16px; margin-bottom: 20px;
    }

    #collection-section-{{ section.id }} .cs-title {
      font-size: 22px; line-height: 1.1;
      font-weight: 500;
      letter-spacing: -.02em;
      color: var(--cs-primary);
      margin: 0;
    }

    #collection-section-{{ section.id }} .cs-cta {
      display: inline-flex; align-items: center; justify-content: center;
      white-space: nowrap;
      border: 1px solid rgba(58,45,110,.8);
      background: var(--cs-bg);
      color: var(--cs-primary);
      font-size: 12px; font-weight: 600;
      padding: 8px 28px;
      border-radius: 999px;
      text-decoration: none;
      transition: all .2s ease;
      flex-shrink: 0;
    }
    #collection-section-{{ section.id }} .cs-cta:hover {
      background: var(--cs-primary); color: var(--cs-primary-fg);
    }

    /* Mobile: snap scroll */
    #collection-section-{{ section.id }} .cs-mobile {
      margin: 0 -20px;
      overflow-x: auto;
      scrollbar-width: none;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    #collection-section-{{ section.id }} .cs-mobile::-webkit-scrollbar { display: none; }

    #collection-section-{{ section.id }} .cs-mobile-track {
      display: flex; gap: 12px;
      padding: 0 20px 8px;
    }

    #collection-section-{{ section.id }} .cs-card {
      scroll-snap-align: start;
      flex-shrink: 0;
      width: 68%;
      max-width: 260px;
      display: flex; flex-direction: column;
      overflow: hidden;
      border-radius: 16px;
      border: 1px solid var(--cs-border);
      background: var(--cs-card-bg);
      text-decoration: none;
      color: inherit;
    }

    #collection-section-{{ section.id }} .cs-card-img {
      position: relative;
      aspect-ratio: 1/1;
      overflow: hidden;
      background: var(--cs-primary);
    }
    #collection-section-{{ section.id }} .cs-card-img img {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform .5s ease;
    }
    #collection-section-{{ section.id }} .cs-card:hover .cs-card-img img {
      transform: scale(1.03);
    }

    #collection-section-{{ section.id }} .cs-card-body {
      display: flex; flex-direction: column; flex: 1;
      padding: 14px;
    }
    #collection-section-{{ section.id }} .cs-rating {
      display: flex; align-items: center; gap: 6px;
      margin-bottom: 6px;
    }
    #collection-section-{{ section.id }} .cs-rating svg {
      width: 15px; height: 15px;
      fill: var(--cs-star); color: var(--cs-star);
    }
    #collection-section-{{ section.id }} .cs-rating span {
      font-size: 12px; font-weight: 600;
      color: rgba(0,0,0,.8);
    }
    #collection-section-{{ section.id }} .cs-name {
      font-size: 14px; line-height: 1.3;
      color: var(--cs-primary);
      min-height: 38px;
      margin: 0 0 8px;
    }
    #collection-section-{{ section.id }} .cs-price {
      font-size: 13px; font-weight: 600;
      color: var(--cs-text);
      margin: auto 0 10px;
    }
    #collection-section-{{ section.id }} .cs-add {
      display: inline-flex; align-items: center; justify-content: center;
      width: 100%;
      padding: 8px 12px;
      border-radius: 999px;
      background: var(--cs-primary);
      color: var(--cs-primary-fg);
      font-size: 12px; font-weight: 700;
      border: 0; cursor: pointer;
    }

    /* Desktop: grid */
    #collection-section-{{ section.id }} .cs-grid { display: none; }

    @media (min-width: 640px) {
      #collection-section-{{ section.id }} { padding: 48px 0 64px; }
      #collection-section-{{ section.id }} .cs-wrap { padding: 0 32px; }
      #collection-section-{{ section.id }} .cs-title { font-size: 26px; }
      #collection-section-{{ section.id }} .cs-cta { font-size: 13px; padding: 10px 29px; }
      #collection-section-{{ section.id }} .cs-mobile { display: none; }
      #collection-section-{{ section.id }} .cs-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
      }
      #collection-section-{{ section.id }} .cs-card { width: auto; max-width: none; }
      #collection-section-{{ section.id }} .cs-name { font-size: 16px; min-height: 42px; }
      #collection-section-{{ section.id }} .cs-price { font-size: 15px; }
      #collection-section-{{ section.id }} .cs-add { padding: 10px 16px; font-size: 13px; }
    }

    @media (min-width: 1024px) {
      #collection-section-{{ section.id }} .cs-wrap { padding: 0 48px; }
      #collection-section-{{ section.id }} .cs-title { font-size: 32px; white-space: nowrap; }
      #collection-section-{{ section.id }} .cs-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
      }
      #collection-section-{{ section.id }} .cs-card { transition: transform .3s ease, box-shadow .3s ease; }
      #collection-section-{{ section.id }} .cs-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 40px -20px rgba(58,45,110,.25);
      }
    }
  </style>

  <div class="cs-wrap">
    <div class="cs-header">
      <h2 class="cs-title">{{ section.settings.heading | default: 'Sana özel oluşturduğumuz paketler' }}</h2>
      {%- if section.settings.cta_link != blank -%}
        <a href="{{ section.settings.cta_link }}" class="cs-cta">
          {{ section.settings.cta_label | default: 'Kendine özel paket oluştur' }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      {%- capture pack_cards -%}
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" class="cs-card" {{ block.shopify_attributes }}>
            <div class="cs-card-img">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: alt: block.settings.name, loading: 'lazy' }}
              {%- endif -%}
            </div>
            <div class="cs-card-body">
              <div class="cs-rating">
                <svg viewBox="0 0 24 24"><path d="M12 17.3l-6.18 3.7 1.64-7.03L2 9.24l7.19-.61L12 2l2.81 6.63 7.19.61-5.46 4.73 1.64 7.03z"/></svg>
                <span>{{ block.settings.rating | default: '4.9' }}</span>
              </div>
              <h3 class="cs-name">{{ block.settings.name }}</h3>
              <p class="cs-price">{{ block.settings.price }}</p>
              <button type="button" class="cs-add">Sepete Ekle</button>
            </div>
          </a>
        {%- endfor -%}
      {%- endcapture -%}

      <div class="cs-mobile">
        <div class="cs-mobile-track">{{ pack_cards }}</div>
      </div>

      <div class="cs-grid">{{ pack_cards }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection Cards",
  "tag": "section",
  "class": "collection-section",
  "settings": [
    { "type": "header", "content": "Başlık" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Sana özel oluşturduğumuz paketler" },
    { "type": "text", "id": "cta_label", "label": "CTA metni", "default": "Kendine özel paket oluştur" },
    { "type": "url", "id": "cta_link", "label": "CTA linki" },

    { "type": "header", "content": "Renkler" },
    { "type": "color", "id": "bg", "label": "Arka plan", "default": "#fffaf3" },
    { "type": "color", "id": "card_bg", "label": "Kart arka planı", "default": "#ffffff" },
    { "type": "color", "id": "primary_color", "label": "Primary", "default": "#3a2d6e" },
    { "type": "color", "id": "primary_fg", "label": "Primary üzeri yazı", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Yazı rengi", "default": "#1a1a1a" }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Paket kartı",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Görsel" },
        { "type": "text", "id": "name", "label": "Paket adı", "default": "Balance Deneme Paketi" },
        { "type": "text", "id": "rating", "label": "Puan", "default": "4.9" },
        { "type": "text", "id": "price", "label": "Fiyat", "default": "₺197,50" },
        { "type": "url", "id": "link", "label": "Ürün linki" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Cards",
      "blocks": [
        { "type": "pack", "settings": { "name": "Balance Deneme Paketi", "rating": "4.9", "price": "₺197,50" } },
        { "type": "pack", "settings": { "name": "Tanışma Paketi: .ki ile başla", "rating": "4.7", "price": "₺349,00" } },
        { "type": "pack", "settings": { "name": "Aylık Döngü Paketi", "rating": "4.8", "price": "₺499,00" } },
        { "type": "pack", "settings": { "name": "Yoğun Destek Paketi", "rating": "4.8", "price": "₺695,00" } }
      ]
    }
  ]
}
{% endschema %}
