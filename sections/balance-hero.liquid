<style>
  #shopify-section-{{ section.id }} {
    /* Brand Kit variables */
    --ki-purple-dark: #493d9a;
    --ki-purple: #b2a5ff;
    --ki-offwhite: #f8f8f6;
  }
  
  .balance-hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: linear-gradient(to bottom right, #1a0f40, var(--ki-purple-dark), #3f347f);
    padding: 64px 20px;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .balance-hero__bg {
    position: absolute;
    inset: 0;
    opacity: 0.12;
    mix-blend-mode: luminosity;
    background-size: cover;
    background-position: center;
    z-index: 1;
  }

  .balance-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 680px;
    color: #ffffff;
  }

  .balance-hero__title {
    font-size: clamp(24px, 4vw, 30px);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 4px 0;
    letter-spacing: -0.025em;
  }

  .balance-hero__subtitle {
    font-size: clamp(14px, 2vw, 16px);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 24px 0;
    letter-spacing: 0.025em;
  }

  .balance-hero__counter-wrap {
    display: flex;
    align-items: baseline;
    justify-content: center;
    line-height: 1;
  }

  .balance-hero__counter-val {
    font-size: 72px;
    font-weight: 800;
    letter-spacing: -2px;
    background: linear-gradient(to bottom right, #ffffff, rgba(255, 255, 255, 0.7));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .balance-hero__counter-plus {
    font-size: 72px;
    font-weight: 800;
    color: #ffffff;
  }

  .balance-hero__counter-text {
    font-size: 16px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 20px 0;
    letter-spacing: 0.025em;
  }

  .balance-hero__product-img {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
  }

  .balance-hero__product-img img {
    height: 128px;
    width: auto;
    user-select: none;
    pointer-events: none;
    filter: drop-shadow(0 12px 28px rgba(0,0,0,0.35));
  }
  @media(min-width: 640px) {
    .balance-hero__product-img img {
      height: 160px;
    }
  }

  .balance-hero__stars {
    font-size: 20px;
    color: #f5a623; /* var(--star) */
    letter-spacing: 3px;
    margin-bottom: 6px;
  }

  .balance-hero__rating {
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 24px;
  }

  .balance-hero__features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    max-width: 420px;
    margin: 0 auto 28px auto;
  }
  @media(min-width: 640px) {
    .balance-hero__features {
      gap: 16px;
    }
  }

  .balance-hero__feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }

  .balance-hero__feature-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }
  
  .balance-hero__feature-icon svg {
    width: 20px;
    height: 20px;
  }

  .balance-hero__feature-label {
    font-size: 11px;
    line-height: 1.2;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
  }

  .balance-hero__desc {
    font-size: clamp(15px, 2vw, 16px);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
    max-width: 460px;
    margin: 0 auto 28px auto;
  }
  .balance-hero__desc strong {
    font-weight: 600;
    color: #ffffff;
  }

  .balance-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    color: var(--ki-purple-dark);
    font-size: 15px;
    font-weight: 700;
    padding: 14px 36px;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  
  .balance-hero__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.25);
  }

  .balance-hero__cta svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }

  .balance-hero__cta:hover svg {
    transform: translateX(2px);
  }

  /* Reveal Animations */
  .bh-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bh-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .bh-delay-1 { transition-delay: 0.1s; }
  .bh-delay-2 { transition-delay: 0.2s; }
  .bh-delay-3 { transition-delay: 0.3s; }
  .bh-delay-4 { transition-delay: 0.4s; }
</style>

<div class="balance-hero">
  {%- if section.settings.bg_image != blank -%}
    {%- assign bg_url = section.settings.bg_image | image_url: width: 1600 -%}
  {%- else -%}
    {%- assign bg_url = 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=1200' -%}
  {%- endif -%}
  <div class="balance-hero__bg" style="background-image: url('{{ bg_url }}');"></div>
  
  <div class="balance-hero__content" id="bh-content-{{ section.id }}">
    <h1 class="balance-hero__title bh-reveal">{{ section.settings.title }}</h1>
    <p class="balance-hero__subtitle bh-reveal bh-delay-1">{{ section.settings.subtitle }}</p>
    
    <div class="balance-hero__counter-wrap bh-reveal bh-delay-2">
      <span class="balance-hero__counter-val" data-target="{{ section.settings.counter_target }}" id="bh-counter-{{ section.id }}">0</span>
      <span class="balance-hero__counter-plus">+</span>
    </div>
    
    <div class="balance-hero__counter-text bh-reveal bh-delay-1">
      {{ section.settings.counter_text }}
    </div>

    <div class="balance-hero__product-img bh-reveal bh-delay-2">
      {%- if section.settings.product_gif != blank -%}
        {{ section.settings.product_gif | image_url: width: 800 | image_tag: alt: 'Product', loading: 'lazy' }}
      {%- else -%}
        <img src="https://cdn.shopify.com/s/files/1/0818/8860/8549/files/sachet-360.gif?v=1738096280" alt="Product" width="360" height="360" loading="lazy">
      {%- endif -%}
    </div>

    <div class="balance-hero__stars bh-reveal bh-delay-2">★★★★★</div>
    <div class="balance-hero__rating bh-reveal bh-delay-2">{{ section.settings.rating_text }}</div>

    <div class="balance-hero__features bh-reveal bh-delay-2">
      {% for block in section.blocks %}
        <div class="balance-hero__feature">
          <div class="balance-hero__feature-icon">
            {% if block.settings.icon_svg != blank %}
              {{ block.settings.icon_svg }}
            {% else %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            {% endif %}
          </div>
          <span class="balance-hero__feature-label">{{ block.settings.title }}</span>
        </div>
      {% endfor %}
    </div>

    <p class="balance-hero__desc bh-reveal bh-delay-3">
      {{ section.settings.description }}
    </p>

    {% if section.settings.cta_text != blank %}
      <a href="{{ section.settings.cta_link }}" class="balance-hero__cta bh-reveal bh-delay-4">
        {{ section.settings.cta_text }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    function initHero() {
      var sectionContents = document.querySelectorAll('#bh-content-{{ section.id }} .bh-reveal');
      
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          }
        });
      }, { threshold: 0.1 });
      
      sectionContents.forEach(function(el) {
        observer.observe(el);
      });

      // Animated counter logic
      var counterEl = document.getElementById('bh-counter-{{ section.id }}');
      if (counterEl) {
        var target = parseInt(counterEl.getAttribute('data-target'), 10) || 0;
        var duration = 2000;
        var hasRun = false;

        var counterObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting && !hasRun) {
              hasRun = true;
              var start = 0;
              var startTime = null;
              
              function step(timestamp) {
                if (!startTime) startTime = timestamp;
                var progress = Math.min((timestamp - startTime) / duration, 1);
                // easeOutQuint
                var ease = 1 - Math.pow(1 - progress, 5);
                counterEl.textContent = Math.floor(ease * target).toLocaleString('tr-TR');
                
                if (progress < 1) {
                  window.requestAnimationFrame(step);
                } else {
                  counterEl.textContent = target.toLocaleString('tr-TR');
                }
              }
              window.requestAnimationFrame(step);
            }
          });
        }, { threshold: 0.5 });
        
        counterObserver.observe(counterEl);
      }
    }

    initHero();

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initHero();
      }
    });

  })();
</script>

{% schema %}
{
  "name": "Balance: Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Headline",
      "default": ".ki Balance"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Döngü Dönemi Desteği"
    },
    {
      "type": "number",
      "id": "counter_target",
      "label": "Counter Target",
      "default": 2400
    },
    {
      "type": "text",
      "id": "counter_text",
      "label": "Counter Text",
      "default": "kadın tarafından tercih ediliyor"
    },
    {
      "type": "image_picker",
      "id": "product_gif",
      "label": "Product Image / GIF"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "5.0 ortalama puan"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>PMS döneminde yaşadığın <strong>şişkinlik</strong>, <strong>kas/sinir gerilimleri</strong> ve <strong>ruh hali dalgalanmalarını</strong> desteklemek için geliştirildi.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Hikayeleri oku"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 3,
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG Path"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Balance: Hero",
      "blocks": [
        { "type": "feature", "settings": { "title": "Şişkinlik", "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3c3.5 4 6 7 6 11a6 6 0 0 1-12 0c0-4 2.5-7 6-11z\"/><path d=\"M10 14c.5 1 1.2 1.5 2 1.5s1.5-.5 2-1.5\"/></svg>" } },
        { "type": "feature", "settings": { "title": "Kas/sinir gerilimleri", "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 2 4 14h7l-1 8 9-12h-7l1-8z\"/></svg>" } },
        { "type": "feature", "settings": { "title": "Ruh hali dalgalanmaları", "icon_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 12c2-3 4-3 6 0s4 3 6 0 4-3 6 0\"/><path d=\"M3 18c2-3 4-3 6 0s4 3 6 0 4-3 6 0\"/></svg>" } }
      ]
    }
  ]
}
{% endschema %}
