{% comment %}
  ki-pack-builder — Lovable demo (PaketOlustur.tsx) parite Shopify versiyonu.
  Mobile-first; admin Shopify product picker üzerinden ürün/görsel/fiyat yönetir.
  Subscription kontratı: window.ki.subscription + selling_plan + /pages/paket-checkout.
  Block tipleri:
    - category : kategori paneli (key, label, description, hint)
    - product  : Shopify product picker, category_key ile kategoriye bağlanır
    - frequency: Shopify Selling Plan ID
    - guarantee: özet altı checklist
    - step     : "Nasıl çalışır?" adımı
{% endcomment %}

<section id="ki-{{ section.id }}" class="ki-section ki-pack" data-ki-section="pack">
  <style>
    /* ============================================================
       MOBILE-FIRST (≤ 1023px native) — Lovable PaketOlustur parite
       ============================================================ */

    /* ============================================================
       BULLETPROOF OVERFLOW GUARD — ekrandan dışarı HİÇBİR ŞEY çıkamaz,
       sığmayan otomatik alt satıra düşer (flex-wrap: wrap).
       ============================================================ */
    #ki-{{ section.id }} {
      --ki-primary: #493d9a;
      --ki-primary-medium: #6254b4;
      --ki-primary-fg: #ffffff;
      --ki-secondary: #f0eef9;
      --ki-card: #ffffff;
      --ki-border: #e1ddf0;
      --ki-muted: #6f6978;
      --ki-bg: #ffffff;
      background: var(--ki-bg);
      padding: 24px 0 120px;
      width: 100%;
      max-width: 100vw;
      overflow-x: hidden;
    }
    #ki-{{ section.id }}, #ki-{{ section.id }} * {
      box-sizing: border-box;
      min-width: 0;
      max-width: 100%;
    }
    #ki-{{ section.id }} > * { max-width: 100vw; }
    /* Tüm flex container'lar sığmayanı alt satıra düşürür */
    #ki-{{ section.id }} .ki-pack__cat-head,
    #ki-{{ section.id }} .ki-pack__cat-title,
    #ki-{{ section.id }} .ki-pack__sum-head,
    #ki-{{ section.id }} .ki-pack__item-name,
    #ki-{{ section.id }} .ki-pack__totals .ki-pack__tot-row,
    #ki-{{ section.id }} .ki-pack__mode,
    #ki-{{ section.id }} .ki-pack__ship-row,
    #ki-{{ section.id }} .ki-pack__guarantees li,
    #ki-{{ section.id }} .ki-pack__howit li {
      flex-wrap: wrap !important;
    }
    /* Uzun kelimeler kırılabilsin (URL, kategori isim vb.) */
    #ki-{{ section.id }} .ki-pack__cat-title,
    #ki-{{ section.id }} .ki-pack__cat-desc,
    #ki-{{ section.id }} .ki-pack__cat-hint,
    #ki-{{ section.id }} .ki-pack__item-name,
    #ki-{{ section.id }} .ki-pack__item-short,
    #ki-{{ section.id }} .ki-pack__sum-li-name,
    #ki-{{ section.id }} .ki-pack__sum-li-meta {
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    /* Wrap — kenarlardan 20px sabit nefes, taşma yok */
    #ki-{{ section.id }} .ki-pack__wrap {
      max-width: 1240px;
      margin: 0 auto;
      padding-inline: 20px !important;
      width: 100%;
    }

    /* Grid: mobile tek kolon, desktop 1fr / 400px */
    #ki-{{ section.id }} .ki-pack__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      align-items: start;
    }

    /* ===== Tabs (yatay pill scroll) — negative margin YOK, container içinde kalır ===== */
    #ki-{{ section.id }} .ki-pack__tabs {
      display: flex; gap: 6px;
      overflow-x: auto;
      margin: 0 0 16px;
      padding: 10px 0;
      border-bottom: 1px solid rgba(0,0,0,.08);
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      max-width: 100%;
      width: 100%;
    }
    #ki-{{ section.id }} .ki-pack__tabs::-webkit-scrollbar { display: none; }
    #ki-{{ section.id }} .ki-pack__tab {
      flex-shrink: 0;
      font-size: 13px; font-weight: 600;
      padding: 9px 14px;
      border-radius: 999px;
      background: var(--ki-secondary, #ebe9f5);
      color: var(--ki-primary, #3a2d6e);
      border: 1.5px solid rgba(73,61,154,.08);
      transition: all .2s ease;
      white-space: nowrap !important;
      word-break: normal !important;
      cursor: pointer;
    }
    #ki-{{ section.id }} .ki-pack__tab.is-active {
      background: var(--ki-primary, #3a2d6e);
      color: var(--ki-primary-fg, #fff);
      border-color: var(--ki-primary, #3a2d6e);
    }
    #ki-{{ section.id }} .ki-pack__tab-count {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 18px; height: 18px; padding: 0 5px;
      margin-left: 6px;
      border-radius: 999px;
      background: var(--ki-rose, #d96d8a);
      color: #fff;
      font-size: 10.5px; font-weight: 700;
    }
    #ki-{{ section.id }} .ki-pack__tab-count[data-count="0"] { display: none; }
    #ki-{{ section.id }} .ki-pack__tab.is-active .ki-pack__tab-count {
      background: var(--ki-primary-fg, #fff);
      color: var(--ki-primary, #3a2d6e);
    }

    /* ===== Categories ===== */
    #ki-{{ section.id }} .ki-pack__cats {
      display: flex; flex-direction: column;
      gap: 14px;
    }
    #ki-{{ section.id }} .ki-pack__cat {
      background: var(--ki-card, #fff);
      border: 1px solid var(--ki-border, #e6e3ee);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 8px 28px -24px rgba(73,61,154,.45);
    }
    #ki-{{ section.id }} .ki-pack__cat-head {
      width: 100%;
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px;
      padding: 18px;
      text-align: left;
      background: transparent;
      border: 0; cursor: pointer;
      transition: background .15s ease;
    }
    #ki-{{ section.id }} .ki-pack__cat-head:hover { background: rgba(0,0,0,.02); }
    #ki-{{ section.id }} .ki-pack__cat-title {
      font-family: var(--ki-font-primary, serif);
      font-size: 20px; line-height: 1.15;
      font-weight: 500;
      color: var(--ki-primary, #3a2d6e);
      margin: 0;
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    }
    #ki-{{ section.id }} .ki-pack__cat-count {
      display: inline-flex; align-items: center; justify-content: center;
      min-width: 22px; height: 22px; padding: 0 6px;
      border-radius: 999px;
      background: var(--ki-rose, #d96d8a);
      color: #fff;
      font-size: 11px; font-weight: 700;
    }
    #ki-{{ section.id }} .ki-pack__cat-count[data-count="0"] { display: none; }
    #ki-{{ section.id }} .ki-pack__cat-desc {
      font-size: 12.5px; line-height: 1.4;
      color: var(--ki-muted, #5a5a5a);
      margin: 4px 0 0;
    }
    #ki-{{ section.id }} .ki-pack__chev {
      width: 20px; height: 20px;
      color: var(--ki-primary, #3a2d6e);
      flex-shrink: 0;
      transition: transform .3s ease;
    }
    #ki-{{ section.id }} .ki-pack__cat[data-open="true"] .ki-pack__chev {
      transform: rotate(180deg);
    }
    #ki-{{ section.id }} .ki-pack__cat-body {
      display: none;
      border-top: 1px solid var(--ki-border, #e6e3ee);
    }
    #ki-{{ section.id }} .ki-pack__cat[data-open="true"] .ki-pack__cat-body {
      display: block;
    }

    /* ===== Items — 2-satırlı grid: image+info üstte, stepper altta right-aligned ===== */
    #ki-{{ section.id }} .ki-pack__items {
      display: flex; flex-direction: column;
    }
    #ki-{{ section.id }} .ki-pack__item {
      display: grid !important;
      grid-template-columns: 56px minmax(0, 1fr) !important;
      grid-template-areas:
        "img info"
        "img stepper" !important;
      gap: 6px 14px;
      padding: 14px 18px;
      align-items: start;
      border-bottom: 1px solid var(--ki-border, #e6e3ee);
      transition: background .15s ease;
      width: 100%;
      max-width: 100%;
    }
    #ki-{{ section.id }} .ki-pack__item:last-child { border-bottom: 0; }
    #ki-{{ section.id }} .ki-pack__item.is-selected {
      background: rgba(73,61,154,.06);
    }
    #ki-{{ section.id }} .ki-pack__item.is-unavailable {
      opacity: .62;
    }
    #ki-{{ section.id }} .ki-pack__item-img {
      grid-area: img;
      width: 56px; height: 56px;
      border-radius: 12px;
      overflow: hidden;
      background: var(--ki-secondary, #ebe9f5);
      border: 1px solid var(--ki-border, #e6e3ee);
      flex-shrink: 0;
      align-self: center;
    }
    #ki-{{ section.id }} .ki-pack__item-img img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
    }
    #ki-{{ section.id }} .ki-pack__item-img-placeholder {
      width: 100%; height: 100%;
      display: grid; place-items: center;
      color: var(--ki-muted, #6b6360);
    }
    #ki-{{ section.id }} .ki-pack__item-info {
      grid-area: info;
      min-width: 0;
      overflow: hidden;
    }
    #ki-{{ section.id }} .ki-pack__item-name {
      font-size: 14px; font-weight: 600;
      line-height: 1.25;
      color: var(--ki-primary, #3a2d6e);
      display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
      margin: 0;
    }
    #ki-{{ section.id }} .ki-pack__item-name > span:first-child {
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    #ki-{{ section.id }} .ki-pack__pad-size {
      width: 48px;
      height: 24px;
      flex: 0 0 48px;
      overflow: visible;
      color: var(--ki-primary, #493d9a);
    }
    #ki-{{ section.id }} .ki-pack__pad-shape {
      fill: rgba(73,61,154,.05);
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      opacity: .42;
      vector-effect: non-scaling-stroke;
    }
    #ki-{{ section.id }} .ki-pack__pad-shape.is-active {
      fill: currentColor;
      opacity: 1;
    }
    #ki-{{ section.id }} .ki-pack__item-badge {
      font-size: 9px; font-weight: 700;
      letter-spacing: .04em; text-transform: uppercase;
      padding: 2px 6px;
      border-radius: 4px;
      background: var(--ki-rose-light, #f6dce4);
      color: var(--ki-rose, #d96d8a);
      flex-shrink: 0;
    }
    #ki-{{ section.id }} .ki-pack__item-short {
      font-size: 11.5px; line-height: 1.4;
      color: var(--ki-muted, #5a5a5a);
      margin: 3px 0 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    #ki-{{ section.id }} .ki-pack__item-price {
      font-size: 13px; font-weight: 600;
      color: var(--ki-primary, #3a2d6e);
      margin: 4px 0 0;
    }
    #ki-{{ section.id }} .ki-pack__item-price small {
      font-size: 10.5px; font-weight: 500;
      color: var(--ki-muted, #5a5a5a);
      margin-left: 3px;
    }
    #ki-{{ section.id }} .ki-pack__item-price s {
      color: var(--ki-muted, #5a5a5a);
      font-size: 11px;
      font-weight: 500;
      margin-left: 4px;
    }
    #ki-{{ section.id }} .ki-pack__item-discount {
      display: inline-block;
      margin-top: 3px;
      color: #287457;
      font-size: 10px;
      font-weight: 700;
    }
    #ki-{{ section.id }} .ki-pack__bundle {
      display: grid;
      grid-template-columns: 76px minmax(0,1fr);
      gap: 10px 14px;
      padding: 16px 18px;
      border-bottom: 1px solid var(--ki-border, #e6e3ee);
      background: linear-gradient(135deg, rgba(73,61,154,.055), rgba(255,255,255,.98));
    }
    #ki-{{ section.id }} .ki-pack__bundle:last-child { border-bottom: 0; }
    #ki-{{ section.id }} .ki-pack__bundle-media {
      display: flex;
      align-items: center;
      width: 76px;
      min-height: 70px;
      padding-left: 10px;
    }
    #ki-{{ section.id }} .ki-pack__bundle-media img {
      width: 42px;
      height: 58px;
      margin-left: -10px;
      border: 2px solid #fff;
      border-radius: 10px;
      object-fit: cover;
      box-shadow: 0 7px 18px rgba(42,31,94,.15);
    }
    #ki-{{ section.id }} .ki-pack__bundle-info { min-width: 0; }
    #ki-{{ section.id }} .ki-pack__bundle-title {
      margin: 0;
      color: var(--ki-primary, #3a2d6e);
      font-size: 15px;
      font-weight: 800;
      line-height: 1.25;
    }
    #ki-{{ section.id }} .ki-pack__bundle-copy {
      margin: 4px 0 0;
      color: var(--ki-muted, #5a5a5a);
      font-size: 11px;
      line-height: 1.4;
    }
    #ki-{{ section.id }} .ki-pack__bundle-products {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin: 8px 0 0;
    }
    #ki-{{ section.id }} .ki-pack__bundle-products span {
      padding: 4px 6px;
      border-radius: 7px;
      background: #f0eef9;
      color: #554a97;
      font-size: 9px;
      font-weight: 700;
      line-height: 1.2;
    }
    #ki-{{ section.id }} .ki-pack__bundle-footer {
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    #ki-{{ section.id }} .ki-pack__bundle-price { color: var(--ki-primary, #3a2d6e); }
    #ki-{{ section.id }} .ki-pack__bundle-price strong { font-size: 15px; }
    #ki-{{ section.id }} .ki-pack__bundle-price s { margin-left: 5px; color: var(--ki-muted, #6b6360); font-size: 10px; }
    #ki-{{ section.id }} .ki-pack__bundle-price small { display: block; margin-top: 2px; color: #287457; font-size: 9px; font-weight: 800; }
    #ki-{{ section.id }} .ki-pack__bundle-apply {
      min-height: 36px;
      padding: 8px 13px;
      border: 0;
      border-radius: 999px;
      background: var(--ki-primary, #3a2d6e);
      color: #fff;
      font: inherit;
      font-size: 10px;
      font-weight: 800;
      cursor: pointer;
      white-space: nowrap;
    }
    #ki-{{ section.id }} .ki-pack__bundle-apply.is-applied { background: #287457; }
    #ki-{{ section.id }} .ki-pack__bundle-apply:disabled { cursor: not-allowed; opacity: .45; }

    /* ===== Stepper — 2-row layout'ta alt satır, sağa hizalı ===== */
    #ki-{{ section.id }} .ki-pack__stepper {
      grid-area: stepper;
      justify-self: end;
      display: inline-flex;
      align-items: center; justify-content: space-between; gap: 2px;
      width: 112px;
      min-width: 112px;
      padding: 3px;
      background: var(--ki-card, #fff);
      border: 1px solid var(--ki-border, #e6e3ee);
      border-radius: 999px;
      flex-shrink: 0;
      margin-top: 6px;
      box-shadow: 0 4px 14px rgba(73,61,154,.08);
    }
    #ki-{{ section.id }} .ki-pack__stepper button {
      width: 32px; height: 32px;
      border: 0; border-radius: 50%;
      display: grid; place-items: center;
      cursor: pointer;
      transition: opacity .15s, background .15s;
      white-space: nowrap !important;
    }
    #ki-{{ section.id }} .ki-pack__step-minus {
      background: transparent;
      color: var(--ki-primary, #3a2d6e);
    }
    #ki-{{ section.id }} .ki-pack__step-minus:hover:not(:disabled) {
      background: var(--ki-secondary, #ebe9f5);
    }
    #ki-{{ section.id }} .ki-pack__step-minus:disabled {
      opacity: .3; cursor: not-allowed;
    }
    #ki-{{ section.id }} .ki-pack__step-plus {
      background: var(--ki-primary, #3a2d6e);
      color: var(--ki-primary-fg, #fff);
    }
    #ki-{{ section.id }} .ki-pack__step-plus:hover {
      background: var(--ki-primary-medium, #5946b3);
    }
    #ki-{{ section.id }} .ki-pack__step-qty {
      min-width: 32px; height: 32px;
      display: grid; place-items: center;
      text-align: center;
      font-size: 14px; font-weight: 800;
      line-height: 1;
      color: #493d9a;
      font-variant-numeric: tabular-nums;
      white-space: nowrap !important;
      opacity: 1;
      visibility: visible;
    }

    /* ===== Category hint (sage) ===== */
    #ki-{{ section.id }} .ki-pack__cat-hint {
      display: flex; gap: 10px; align-items: flex-start;
      padding: 12px 18px;
      background: var(--ki-sage-light, #dde8d4);
      border-top: 1px solid rgba(0,0,0,.06);
      font-size: 11.5px; line-height: 1.45;
      color: var(--ki-sage, #5d7a52);
    }
    #ki-{{ section.id }} .ki-pack__cat-hint > span:first-child { flex-shrink: 0; }
    #ki-{{ section.id }} .ki-pack__cat-hint-copy { display: grid; gap: 2px; }
    #ki-{{ section.id }} .ki-pack__cat-hint-title {
      color: #347154;
      font-size: 9px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    #ki-{{ section.id }} .ki-pack__ped-modes {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      padding: 14px 18px 8px;
      border-top: 1px solid var(--ki-border, #e6e3ee);
      background: #faf9ff;
    }
    #ki-{{ section.id }} .ki-pack__ped-mode {
      min-height: 42px;
      padding: 9px 12px;
      border: 1px solid rgba(73,61,154,.18);
      border-radius: 12px;
      background: #fff;
      color: var(--ki-primary, #493d9a);
      font: inherit;
      font-size: 11px;
      line-height: 1.25;
      font-weight: 750;
      cursor: pointer;
      transition: background .16s ease, border-color .16s ease, color .16s ease;
    }
    #ki-{{ section.id }} .ki-pack__ped-mode.is-active {
      border-color: var(--ki-primary, #493d9a);
      background: var(--ki-primary, #493d9a);
      color: #fff;
    }
    #ki-{{ section.id }} .ki-pack__ped-mode-note {
      margin: 0;
      padding: 0 18px 12px;
      background: #faf9ff;
      color: var(--ki-muted, #5a5a5a);
      font-size: 10.5px;
      line-height: 1.4;
    }

    /* ===== Summary card ===== */
    #ki-{{ section.id }} .ki-pack__summary-wrap {
      position: relative;
      isolation: isolate;
    }
    #ki-{{ section.id }} .ki-pack__summary-wrap::before {
      content: "";
      position: absolute;
      z-index: -1;
      inset: -16px;
      border-radius: 32px;
      background: radial-gradient(circle at 50% 18%, rgba(112,91,231,.34), rgba(73,61,154,.13) 48%, transparent 76%);
      filter: blur(24px);
      pointer-events: none;
    }
    #ki-{{ section.id }} .ki-pack__summary {
      position: relative;
      z-index: 1;
      background: var(--ki-card, #fff);
      border: 1px solid var(--ki-border, #e6e3ee);
      border-radius: 18px;
      padding: 20px;
      box-shadow: 0 20px 58px -34px rgba(73,61,154,.62);
    }
    #ki-{{ section.id }} .ki-pack__sum-head {
      display: flex; justify-content: space-between; align-items: center;
      gap: 8px;
      margin-bottom: 4px;
      flex-wrap: wrap;
    }
    #ki-{{ section.id }} .ki-pack__sum-title {
      font-family: var(--ki-font-primary, serif);
      font-size: 22px; font-weight: 500;
      color: var(--ki-primary, #3a2d6e);
      margin: 0;
    }
    #ki-{{ section.id }} .ki-pack__sum-pill {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 10.5px; font-weight: 700;
      color: var(--ki-sage, #5d7a52);
      background: var(--ki-sage-light, #dde8d4);
      padding: 4px 9px;
      border-radius: 999px;
      white-space: nowrap !important;
    }
    #ki-{{ section.id }} .ki-pack__frequency {
      margin: 12px 0 0;
      padding: 10px;
      border: 1px solid #cfe5d8;
      border-radius: 14px;
      background: linear-gradient(135deg, #f4fbf7, #edf8f1);
    }
    #ki-{{ section.id }} .ki-pack__frequency-label {
      display: block;
      margin: 0 0 7px;
      color: #2f765b;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .08em;
      line-height: 1.2;
      text-transform: uppercase;
    }
    #ki-{{ section.id }} .ki-pack__frequency-options {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      padding: 1px 1px 4px;
    }
    #ki-{{ section.id }} .ki-pack__frequency-options::-webkit-scrollbar { display: none; }
    #ki-{{ section.id }} .ki-pack__frequency-option {
      min-width: 58px;
      min-height: 36px;
      flex: 1 0 auto;
      scroll-snap-align: start;
      border: 1px solid #c7dfd0;
      border-radius: 999px;
      background: rgba(255,255,255,.9);
      color: #34775e;
      padding: 7px 10px;
      font: inherit;
      font-size: 11px;
      font-weight: 750;
      line-height: 1;
      white-space: nowrap !important;
      cursor: pointer;
      transition: background .15s ease, border-color .15s ease, color .15s ease, transform .15s ease;
    }
    #ki-{{ section.id }} .ki-pack__frequency-option:hover:not(:disabled) { transform: translateY(-1px); }
    #ki-{{ section.id }} .ki-pack__frequency-option.is-active {
      border-color: #34775e;
      background: #34775e;
      color: #fff;
      box-shadow: 0 5px 14px -8px rgba(32,97,71,.9);
    }
    #ki-{{ section.id }} .ki-pack__frequency-option:disabled {
      opacity: .38;
      cursor: not-allowed;
      text-decoration: line-through;
    }
    #ki-{{ section.id }} .ki-pack__frequency-note {
      margin: 5px 1px 0;
      color: #557065;
      font-size: 9.5px;
      line-height: 1.35;
    }
