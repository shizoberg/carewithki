{% comment %}
  Ingredients Grid — .ki v2
  + Popup (tıklayınca açılır)
  + Ürün rozeti (görsel üzerinde)
{% endcomment %}

<style>
  #ing-{{ section.id }} {
    --p: #493d9a;
    --lil: #dad2ff;
    --pur: #b2a5ff;
    --bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text: {{ section.settings.text_color | default: '#1a1a1a' }};
    background-color: var(--bg);
    color: var(--text);
    padding: 40px 0 {{ section.settings.padding_bottom }}px 0;
    font-family: inherit;
  }
  .ing__wrap { max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: 0 20px; }
  .ing__header { margin-bottom: 20px; max-width: 1100px; }
  .ing__title { font-size: clamp(28px,5vw,48px); line-height:1.1; margin:0 0 12px; font-weight:700; color:var(--p); }
  .ing__description { font-size:clamp(14px,1.2vw,17px); line-height:1.55; margin-bottom:24px; color:rgba(26,26,26,.8); }

  /* Filter tabs */
  .ing__filters { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:20px; }
  .ing__filter-btn {
    padding:6px 14px; border:1.5px solid rgba(73,61,154,.2);
    border-radius:50px; background:transparent; cursor:pointer;
    font-size:12px; font-weight:600; transition:all .2s; color:var(--text);
  }
  .ing__filter-btn:hover { border-color:var(--p); background:rgba(73,61,154,.05); }
  .ing__filter-btn.is-active { background:var(--p); color:#fff; border-color:var(--p); }

  /* Grid */
  .ing__grid { display:grid; grid-template-columns:repeat(6,1fr); gap:12px; }
  @media(max-width:1100px){ .ing__grid{ grid-template-columns:repeat(4,1fr); } }
  @media(max-width:749px){
    .ing__grid{ grid-template-columns:repeat(2,1fr); gap:8px; }
    .ing__item-name{ font-size:10px; }
    .ing__title{ font-size:24px; }
  }

  /* Kart */
  .ing__item {
    cursor: pointer;
    transition: transform .3s;
  }
  .ing__item.is-hidden { display:none; }
  .ing__item:hover { transform: translateY(-3px); }

  .ing__item-media {
    position:relative; width:100%; aspect-ratio:1/1;
    background:#e5e5e5; margin-bottom:8px;
    border-radius:8px; overflow:hidden;
  }
  .ing__item-media img {
    width:100%; height:100%; object-fit:cover; transition:transform .5s;
  }
  .ing__item:hover .ing__item-media img { transform:scale(1.06); }

  /* Ürün rozetleri — görsel üzerine */
  .ing__badges {
    position:absolute; bottom:6px; left:6px;
    display:flex; flex-wrap:wrap; gap:3px; z-index:2;
  }
  .ing__badge {
    font-size:8px; font-weight:700;
    padding:2px 7px; border-radius:50px;
    backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px);
    white-space:nowrap; line-height:1.4;
  }
  .ing__badge--balance  { background:rgba(73,61,154,.82);  color:#fff; }
  .ing__badge--change   { background:rgba(30,18,80,.82);   color:#dad2ff; }
  .ing__badge--intimate { background:rgba(120,60,180,.82); color:#fff; }
  .ing__badge--custom   { background:rgba(0,0,0,.55);      color:#fff; }

  /* İnfo ikonu */
  .ing__info-icon {
    position:absolute; top:6px; right:6px;
    width:22px; height:22px; border-radius:50%;
    background:rgba(255,255,255,.85); backdrop-filter:blur(6px);
    display:flex; align-items:center; justify-content:center;
    color:var(--p); z-index:2; opacity:0;
    transition:opacity .2s;
  }
  .ing__item:hover .ing__info-icon { opacity:1; }
  .ing__info-icon svg { width:13px; height:13px; }

  .ing__item-name {
    font-size:11px; text-transform:uppercase; letter-spacing:.1em;
    font-weight:700; line-height:1.2; color:var(--text);
  }
  .ing__item-subtitle {
    font-size:10px; color:rgba(73,61,154,.6); margin-top:2px;
    line-height:1.3;
  }

  /* CTA */
  .ing__cta-group { display:flex; flex-wrap:nowrap; gap:8px; margin-top:10px; }
  .ing__cta {
    display:inline-flex; align-items:center; gap:4px;
    background:var(--p); color:#fff; padding:8px 16px;
    border-radius:999px; text-decoration:none; font-size:12px;
    font-weight:700; transition:all .2s; white-space:nowrap;
  }
  .ing__cta svg { width:14px; height:14px; }
  .ing__cta--lilac { background:var(--pur); color:var(--p); }
  .ing__cta:hover { filter:brightness(1.1); transform:translateY(-2px); box-shadow:0 8px 24px rgba(73,61,154,.2); }

  /* =====================
     POPUP
     ===================== */
  .ki-ing-overlay {
    position:fixed; inset:0; z-index:9998;
    background:rgba(15,8,50,.55);
    backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px);
    opacity:0; pointer-events:none;
    transition:opacity .25s;
  }
  .ki-ing-overlay.is-open { opacity:1; pointer-events:all; }

  .ki-ing-popup {
    position:fixed; z-index:9999;
    top:50%; left:50%;
    transform:translate(-50%,-50%) scale(.94);
    width:min(520px, 92vw);
    background:#fff; border-radius:20px;
    box-shadow:0 24px 64px rgba(73,61,154,.22);
    overflow:hidden;
    opacity:0; pointer-events:none;
    transition:opacity .25s, transform .25s;
  }
  .ki-ing-popup.is-open {
    opacity:1; pointer-events:all;
    transform:translate(-50%,-50%) scale(1);
  }

  .ki-ing-popup__img {
    width:100%; aspect-ratio:16/9;
    object-fit:cover; display:block;
    background:#f0eef8;
  }
  .ki-ing-popup__img-placeholder {
    width:100%; aspect-ratio:16/9;
    background:linear-gradient(135deg,#e8e4ff,#f5f3ff);
    display:flex; align-items:center; justify-content:center;
  }
  .ki-ing-popup__img-placeholder svg { width:48px; height:48px; color:var(--lil); }

  .ki-ing-popup__body { padding:22px 24px 24px; }

  .ki-ing-popup__close {
    position:absolute; top:12px; right:12px;
    width:32px; height:32px; border-radius:50%;
    background:rgba(255,255,255,.9); backdrop-filter:blur(6px);
    border:none; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    color:#333; z-index:10; transition:background .15s;
  }
  .ki-ing-popup__close:hover { background:#fff; }
  .ki-ing-popup__close svg { width:16px; height:16px; }

  .ki-ing-popup__name {
    font-size:10px; font-weight:800; letter-spacing:.12em;
    text-transform:uppercase; color:var(--p); margin:0 0 6px;
  }
  .ki-ing-popup__title {
    font-size:22px; font-weight:800; color:#1a1340;
    margin:0 0 10px; line-height:1.15;
  }
  .ki-ing-popup__desc {
    font-size:13px; color:#6b6b8a; line-height:1.65; margin:0 0 14px;
  }

  /* "Hangi üründe kullanılır" bantı */
  .ki-ing-popup__products {
    border-top:1px solid rgba(73,61,154,.1);
    padding-top:14px; margin-top:4px;
  }
  .ki-ing-popup__products-label {
    font-size:10px; font-weight:700; letter-spacing:.08em;
    text-transform:uppercase; color:rgba(73,61,154,.55);
    margin:0 0 8px;
  }
  .ki-ing-popup__product-tags {
    display:flex; flex-wrap:wrap; gap:6px;
  }
  .ki-ing-popup__product-tag {
    display:inline-flex; align-items:center; gap:5px;
    padding:5px 12px; border-radius:50px; font-size:11px; font-weight:700;
    background:rgba(73,61,154,.08); color:var(--p);
    border:1px solid rgba(73,61,154,.15);
  }
  .ki-ing-popup__product-tag svg { width:11px; height:11px; }

  /* Neden kullanılır */
  .ki-ing-popup__why {
    background:rgba(73,61,154,.05); border-radius:10px;
    padding:12px 14px; margin-top:12px;
    font-size:12px; color:#493d9a; line-height:1.55;
    border:1px solid rgba(73,61,154,.1);
  }
  .ki-ing-popup__why strong { font-weight:800; display:block; margin-bottom:3px; font-size:11px; }

  @media(max-width:480px){
    .ki-ing-popup__body{ padding:16px 18px 20px; }
    .ki-ing-popup__title{ font-size:18px; }
  }
</style>

<!-- POPUP OVERLAY + MODAL -->
<div class="ki-ing-overlay" id="IngOverlay-{{ section.id }}"></div>
<div class="ki-ing-popup" id="IngPopup-{{ section.id }}" role="dialog" aria-modal="true">
  <button class="ki-ing-popup__close" id="IngClose-{{ section.id }}" aria-label="Kapat">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <div id="IngPopupImg-{{ section.id }}"></div>
  <div class="ki-ing-popup__body">
    <p class="ki-ing-popup__name" id="IngPopupCat-{{ section.id }}"></p>
    <h3 class="ki-ing-popup__title" id="IngPopupTitle-{{ section.id }}"></h3>
    <p class="ki-ing-popup__desc" id="IngPopupDesc-{{ section.id }}"></p>
    <div class="ki-ing-popup__products" id="IngPopupProducts-{{ section.id }}" style="display:none">
      <p class="ki-ing-popup__products-label">Bu hammadde hangi ürünlerde kullanılır</p>
      <div class="ki-ing-popup__product-tags" id="IngPopupTags-{{ section.id }}"></div>
    </div>
    <div class="ki-ing-popup__why" id="IngPopupWhy-{{ section.id }}" style="display:none">
      <strong>Neden kullanıyoruz?</strong>
      <span id="IngPopupWhyText-{{ section.id }}"></span>
    </div>
  </div>
</div>

<!-- SECTION -->
<div id="ing-{{ section.id }}">
  <div class="ing__wrap">
    <div class="ing__header">
      {% if section.settings.title != blank %}
        {% if request.page_type == 'collection' and collection.handle == 'ki-bilimi' %}
          <h1 class="ing__title">{{ section.settings.title }}</h1>
        {% elsif request.page_type == 'collection' and collection.handle == 'pedler' %}
          <h1 class="ing__title">.ki Premium Hijyenik Pedler</h1>
        {% else %}
          <h2 class="ing__title">{{ section.settings.title }}</h2>
        {% endif %}
      {% endif %}

      {%- assign all_categories = "" -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.category != blank -%}
          {%- unless all_categories contains block.settings.category -%}
            {%- assign all_categories = all_categories | append: block.settings.category | append: "," -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign category_array = all_categories | split: "," -%}

      <div class="ing__filters">
        <button class="ing__filter-btn is-active" data-filter="all">Tümünü Göster</button>
        {% for cat in category_array %}
          {% if cat != blank %}
            <button class="ing__filter-btn" data-filter="{{ cat | handleize }}">{{ cat }}</button>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.description != blank %}
        <div class="ing__description">{{ section.settings.description }}</div>
      {% endif %}

      <div class="ing__cta-group">
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="ing__cta">
            {{ section.settings.button_label }}
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 10h10M12 6l4 4-4 4"/></svg>
          </a>
        {% endif %}
        {% if section.settings.button_label_2 != blank %}
          <a href="{{ section.settings.button_link_2 }}" class="ing__cta ing__cta--lilac">
            {{ section.settings.button_label_2 }}
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 10h10M12 6l4 4-4 4"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="ing__grid">
      {% for block in section.blocks %}
        {%- assign popup_title   = block.settings.popup_title   | default: block.settings.name -%}
        {%- assign popup_desc    = block.settings.popup_desc    | default: '' -%}
        {%- assign popup_why     = block.settings.popup_why     | default: '' -%}
        {%- assign popup_products = block.settings.popup_products | default: '' -%}
        {%- assign popup_subtitle = block.settings.popup_subtitle | default: '' -%}

        {%- comment %} Görsel URL'i JSON için hazırla {%- endcomment -%}
        {%- assign img_src = '' -%}
        {%- if block.settings.image != blank -%}
          {%- assign img_src = block.settings.image | image_url: width: 800 -%}
        {%- endif -%}

        <div
          class="ing__item"
          data-category="{{ block.settings.category | handleize }}"
          data-popup="true"
          data-name="{{ block.settings.name | escape }}"
          data-cat="{{ block.settings.category | escape }}"
          data-title="{{ popup_title | escape }}"
          data-desc="{{ popup_desc | escape }}"
          data-why="{{ popup_why | escape }}"
          data-products="{{ popup_products | escape }}"
          data-img="{{ img_src }}"
          data-alt="{{ block.settings.name | escape }}"
          {{ block.shopify_attributes }}
        >
          <div class="ing__item-media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}

            <!-- Ürün rozetleri -->
            {%- assign has_badge = false -%}
            {%- if block.settings.badge_balance or block.settings.badge_change or block.settings.badge_intimate or block.settings.badge_custom != blank -%}
              {%- assign has_badge = true -%}
            {%- endif -%}
            {%- if has_badge -%}
            <div class="ing__badges">
              {%- if block.settings.badge_balance -%}
                <span class="ing__badge ing__badge--balance">Balance</span>
              {%- endif -%}
              {%- if block.settings.badge_change -%}
                <span class="ing__badge ing__badge--change">Change</span>
              {%- endif -%}
              {%- if block.settings.badge_intimate -%}
                <span class="ing__badge ing__badge--intimate">intimate</span>
              {%- endif -%}
              {%- if block.settings.badge_custom != blank -%}
                <span class="ing__badge ing__badge--custom">{{ block.settings.badge_custom | escape }}</span>
              {%- endif -%}
            </div>
            {%- endif -%}

            <!-- İnfo ikonu -->
            <div class="ing__info-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
          </div>

          {% if block.settings.name != blank %}
            <div class="ing__item-name">{{ block.settings.name }}</div>
          {% endif %}
          {% if popup_subtitle != blank %}
            <div class="ing__item-subtitle">{{ popup_subtitle }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
(function(){
  var sid = '{{ section.id }}';
  var parent  = document.getElementById('ing-' + sid);
  var overlay = document.getElementById('IngOverlay-' + sid);
  var popup   = document.getElementById('IngPopup-' + sid);
  var closeBtn= document.getElementById('IngClose-' + sid);
  if (!parent || !overlay || !popup) return;

  /* --- Popup aç --- */
  function openPopup(data) {
    /* Görsel */
    var imgWrap = document.getElementById('IngPopupImg-' + sid);
    if (data.img) {
      imgWrap.innerHTML = '<img src="' + data.img + '" alt="' + data.alt + '" class="ki-ing-popup__img" loading="lazy">';
    } else {
      imgWrap.innerHTML = '<div class="ki-ing-popup__img-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>';
    }
    /* Metinler */
    document.getElementById('IngPopupCat-'  + sid).textContent = data.cat   || '';
    document.getElementById('IngPopupTitle-'+ sid).textContent = data.title || data.name || '';
    document.getElementById('IngPopupDesc-' + sid).textContent = data.desc  || '';

    /* Hangi ürünler */
    var productsWrap = document.getElementById('IngPopupProducts-' + sid);
    var tagsWrap     = document.getElementById('IngPopupTags-' + sid);
    if (data.products && data.products.trim() !== '') {
      var items = data.products.split(',');
      tagsWrap.innerHTML = '';
      items.forEach(function(p) {
        p = p.trim();
        if (!p) return;
        var span = document.createElement('span');
        span.className = 'ki-ing-popup__product-tag';
        span.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>' + p;
        tagsWrap.appendChild(span);
      });
      productsWrap.style.display = '';
    } else {
      productsWrap.style.display = 'none';
    }

    /* Neden */
    var whyWrap  = document.getElementById('IngPopupWhy-'    + sid);
    var whyText  = document.getElementById('IngPopupWhyText-'+ sid);
    if (data.why && data.why.trim() !== '') {
      whyText.textContent = data.why;
      whyWrap.style.display = '';
    } else {
      whyWrap.style.display = 'none';
    }

    overlay.classList.add('is-open');
    popup.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  /* --- Popup kapat --- */
  function closePopup() {
    overlay.classList.remove('is-open');
    popup.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  /* --- Kart tıklama --- */
  parent.querySelectorAll('.ing__item[data-popup]').forEach(function(item) {
    item.addEventListener('click', function() {
      openPopup({
        img:      item.dataset.img,
        alt:      item.dataset.alt,
        name:     item.dataset.name,
        cat:      item.dataset.cat,
        title:    item.dataset.title,
        desc:     item.dataset.desc,
        products: item.dataset.products,
        why:      item.dataset.why
      });
    });
  });

  closeBtn.addEventListener('click', closePopup);
  overlay.addEventListener('click', closePopup);
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') closePopup(); });

  /* --- Filtre --- */
  var btns  = parent.querySelectorAll('.ing__filter-btn');
  var items = parent.querySelectorAll('.ing__item');
  btns.forEach(function(btn){
    btn.addEventListener('click', function(){
      btns.forEach(function(b){ b.classList.remove('is-active'); });
      btn.classList.add('is-active');
      var f = btn.getAttribute('data-filter');
      items.forEach(function(item){
        if(f==='all' || item.getAttribute('data-category')===f){
          item.classList.remove('is-hidden');
        } else {
          item.classList.add('is-hidden');
        }
      });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Ingredients Grid (Ki)",
  "settings": [
    { "type":"text",     "id":"title",       "label":"Başlık",   "default":".ki'nin Gücünü Oluşturan Bileşenler" },
    { "type":"textarea","id":"description","label":"Açıklama" },
    { "type":"header",  "content":"Buton 1" },
    { "type":"text",    "id":"button_label",  "label":"Buton 1 yazı",  "default":"Balance Your Cycle" },
    { "type":"url",     "id":"button_link",   "label":"Buton 1 link" },
    { "type":"header",  "content":"Buton 2" },
    { "type":"text",    "id":"button_label_2","label":"Buton 2 yazı",  "default":"Change is Good" },
    { "type":"url",     "id":"button_link_2", "label":"Buton 2 link" },
    { "type":"header",  "content":"Layout" },
    { "type":"range",   "id":"max_width",    "label":"Maks. genişlik","min":1000,"max":1600,"step":20,"default":1300 },
    { "type":"range",   "id":"padding_top",  "label":"Padding top",   "min":0,"max":100,"step":4,"default":40 },
    { "type":"range",   "id":"padding_bottom","label":"Padding bottom","min":0,"max":100,"step":4,"default":80 },
    { "type":"color",   "id":"bg_color",     "label":"Arka plan",     "default":"#ffffff" },
    { "type":"color",   "id":"text_color",   "label":"Metin rengi",    "default":"#1a1a1a" }
  ],
  "blocks": [{
    "type": "ingredient",
    "name": "Hammadde",
    "settings": [
      { "type":"image_picker","id":"image",   "label":"Görsel" },
      { "type":"text",       "id":"name",    "label":"Hammadde adı",   "default":"Magnezyum" },
      { "type":"text",       "id":"popup_subtitle","label":"Kısa tanım (kart altı)","info":"Gridde ismin altında görünür" },
      { "type":"text",       "id":"category","label":"Kategori (filtre)","default":"Mineral" },
      { "type":"header",     "content":"Popup İçeriği" },
      { "type":"text",       "id":"popup_title","label":"Popup başlığı (boş bırakırsan hammadde adı kullanılır)" },
      { "type":"textarea",   "id":"popup_desc","label":"Popup açıklaması","default":"Bu hammadde hakkında kısa bir bilgi." },
      { "type":"textarea",   "id":"popup_why","label":"Neden kullanıyoruz?","default":"Hormonal dengeyi destekler, kasları gevşetir." },
      { "type":"text",       "id":"popup_products","label":"Hangi ürünlerde? (virgülle ayır)","default":".ki Balance Your Cycle, .ki Change is Good","info":"Popup'ta rozet olarak görünür" },
      { "type":"header",     "content":"Ürün Rozetleri (görsel üzerine)" },
      { "type":"checkbox",   "id":"badge_balance",  "label":"Balance rozeti göster",  "default":false },
      { "type":"checkbox",   "id":"badge_change",   "label":"Change rozeti göster",   "default":false },
      { "type":"checkbox",   "id":"badge_intimate", "label":"intimate rozeti göster","default":false },
      { "type":"text",       "id":"badge_custom",   "label":"Özel rozet metni (opsiyonel)" }
    ]
  }],
  "presets": [{
    "name": "Ingredients Grid (Ki)",
    "blocks": [
      { "type":"ingredient","settings":{ "name":"Magnezyum",   "category":"Mineral",  "badge_balance":true } },
      { "type":"ingredient","settings":{ "name":"Vitex Agnus","category":"Bitki",   "badge_balance":true } },
      { "type":"ingredient","settings":{ "name":"Dong Quai",  "category":"Bitki",   "badge_balance":true } },
      { "type":"ingredient","settings":{ "name":"B Vitamini", "category":"Vitamin",  "badge_change":true  } },
      { "type":"ingredient","settings":{ "name":"Bor",         "category":"Mineral",  "badge_change":true  } },
      { "type":"ingredient","settings":{ "name":"Selenyum",   "category":"Mineral",  "badge_change":true  } }
    ]
  }]
}
{% endschema %}
