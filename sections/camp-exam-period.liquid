<style>
  .camp-exam {
    padding-top: 6rem;
    padding-bottom: 6rem;
    background-color: {{ section.settings.bg_color }};
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }
  .camp-container {
    width: 100%;
    margin-right: auto;
    margin-left: auto;
    padding-right: 1.5rem;
    padding-left: 1.5rem;
    max-width: 1200px;
  }
  .camp-exam-header {
    text-align: center;
    margin-bottom: 4rem;
    animation: fadeUp 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .camp-exam-title {
    font-size: clamp(1.875rem, 4vw, 2.5rem);
    font-weight: 800;
    color: #1a1a1a;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .camp-exam-split {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    max-width: 64rem;
    margin: 0 auto;
  }
  @media(min-width: 768px) {
    .camp-exam-split {
      flex-direction: row;
    }
  }
  .camp-exam-left {
    flex: 1;
    animation: fadeRight 0.6s ease-out both;
  }
  .camp-exam-right {
    flex: 1;
    display: flex;
    justify-content: center;
    animation: fadeLeft 0.6s ease-out 0.15s both;
  }
  .camp-exam-desc {
    font-size: 1.125rem;
    color: #444; /* text-foreground/80 */
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .camp-exam-desc strong {
    font-weight: 600;
    color: #3d3099;
  }
  .camp-exam-quote-box {
    border-left: 4px solid #ff6666;
    padding-left: 1.5rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }
  .camp-exam-quote {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1a1a1a;
    font-style: italic;
    line-height: 1.3;
    margin: 0;
  }
  .camp-exam-visual-wrap {
    position: relative;
    width: 18rem;
    height: 18rem;
  }
  @media(min-width: 640px) {
    .camp-exam-visual-wrap {
      width: 20rem;
      height: 20rem;
    }
  }
  .camp-exam-blob {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom right, rgba(255, 153, 153, 0.3), rgba(143, 229, 200, 0.3));
    border-radius: 40px;
    transform: rotate(6deg);
  }
  .camp-exam-card {
    position: absolute;
    inset: 0;
    background-color: #fff;
    border-radius: 36px;
    box-shadow: 0 4px 6px -1px rgba(61, 48, 153, 0.05), 0 10px 15px -3px rgba(61, 48, 153, 0.1);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 2rem;
    z-index: 2;
  }
  .camp-exam-icons {
    display: flex;
    gap: 0.75rem;
  }
  .camp-icon-book {
    width: 40px;
    height: 40px;
    color: #3d3099;
  }
  .camp-icon-heart {
    width: 40px;
    height: 40px;
    color: #ff6666;
  }
  .camp-card-title {
    text-align: center;
    font-weight: 600;
    color: #1a1a1a;
    font-size: 1.125rem;
    margin: 0;
  }
  .camp-card-subtitle {
    text-align: center;
    color: #666;
    font-size: 0.875rem;
    margin: 0;
  }

  @keyframes fadeRight {
    from { opacity: 0; transform: translateX(-30px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes fadeLeft {
    from { opacity: 0; transform: translateX(30px); }
    to { opacity: 1; transform: translateX(0); }
  }
</style>

<section class="camp-exam" id="program">
  <div class="camp-container">
    <div class="camp-exam-header">
      <h2 class="camp-exam-title">{{ section.settings.title }}</h2>
    </div>

    <div class="camp-exam-split">
      <div class="camp-exam-left">
        <div class="camp-exam-desc">
          {{ section.settings.description }}
        </div>

        {%- if section.settings.quote != blank -%}
        <div class="camp-exam-quote-box">
          <p class="camp-exam-quote">
            "{{ section.settings.quote }}"
          </p>
        </div>
        {%- endif -%}
      </div>

      <div class="camp-exam-right">
        <div class="camp-exam-visual-wrap">
          <div class="camp-exam-blob"></div>
          <div class="camp-exam-card">
            <div class="camp-exam-icons">
              {{ section.settings.icon_svg_1 }}
              {{ section.settings.icon_svg_2 }}
            </div>
            <p class="camp-card-title">{{ section.settings.card_title }}</p>
            <p class="camp-card-subtitle">{{ section.settings.card_subtitle }}</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Camp: Exam Period",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Arka Plan Rengi", "default": "#e6f8f1" },
    { "type": "text", "id": "title", "label": "Ana Başlık", "default": "Sınav Döneminde PMS ile Uğraşma, Biz Yanındayız" },
    { "type": "richtext", "id": "description", "label": "Açıklama Metni", "default": "<p>Vize ve final haftalarında stres zaten yeterince yüksek. PMS semptomları bu stresi ikiye katlayabiliyor. <strong>.ki Campus</strong> elçileri olarak kütüphanelerde ve çalışma alanlarında öğrencilere ulaşıyoruz. <strong>drawpms.com</strong> üzerinde 2 dakikalık bir çizim molası vererek hem rahatlamalarını sağlıyor hem de regl farkındalığı yaratıyoruz.</p>" },
    { "type": "textarea", "id": "quote", "label": "Alıntı (İtalik) Metni", "default": "Sınav stresini tuvale dök, kendine iyi bak." },
    { "type": "header", "content": "Görsel Kart Ayarları" },
    { "type": "text", "id": "card_title", "label": "Kart Başlığı", "default": "2 dakikalık çizim molası" },
    { "type": "text", "id": "card_subtitle", "label": "Kart Alt Başlığı", "default": "drawpms.com ile rahatla" },
    { "type": "html", "id": "icon_svg_1", "label": "1. SVG İkon" },
    { "type": "html", "id": "icon_svg_2", "label": "2. SVG İkon" }
  ],
  "presets": [
    { 
      "name": "Camp: Exam Period"
    }
  ]
}
{% endschema %}
