{%- style -%}
  .header{padding:0!important;}

  /* ===== DESKTOP ≥ 990px =====
     page-width max-width ile hizalı — site içeriği ile aynı sınır
  */
  @media screen and (min-width:990px){
    /* Header wrapper tam genislik ama ic .header page-width ile sınırlanır */
    .section-header .header-wrapper { width: 100%; }

    .section-header .header.page-width,
    .section-header .header {
      display: grid !important;
      grid-template-columns: 1fr auto 1fr !important;
      grid-template-rows: 68px !important;
      align-items: center !important;
      /* page-width margin: auto + max-width ile site icerik siniriyla esle */
      max-width: 1320px !important;
      margin-left: auto !important;
      margin-right: auto !important;
      padding-left: 32px !important;
      padding-right: 32px !important;
      box-sizing: border-box !important;
      width: 100% !important;
      flex-direction: unset !important;
      flex-wrap: unset !important;
      justify-content: unset !important;
    }

    /* Sol: mega nav */
    .ki-mega-nav {
      grid-column: 1 !important;
      grid-row: 1 !important;
      justify-self: start !important;
      align-self: center !important;
    }

    /* Orta: logo */
    .section-header .header__heading,
    .section-header h1.header__heading,
    .section-header div.header__heading {
      grid-column: 2 !important;
      grid-row: 1 !important;
      justify-self: center !important;
      align-self: center !important;
      margin: 0 28px !important;
      padding: 0 !important;
      position: static !important;
      transform: none !important;
    }
    .section-header .header__heading-logo-wrapper {
      display: block;
      transform: scale(0.75);
      transform-origin: center center;
    }

    /* Sag: ikonlar + CTA */
    .section-header .header__icons {
      grid-column: 3 !important;
      grid-row: 1 !important;
      justify-self: end !important;
      align-self: center !important;
      display: flex !important;
      align-items: center !important;
      justify-content: flex-end !important;
      gap: 6px !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    header-drawer { display: none !important; }
    .section-header .header__inline-menu { display: none !important; }

    /* CTA */
    .section-header .header__cta {
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
      height: 38px;
      padding: 0 18px;
      background: #493d9a;
      color: #fff;
      font-weight: 700;
      font-size: 13px;
      line-height: 1;
      border: 0;
      border-radius: 10px;
      text-decoration: none;
      white-space: nowrap;
      flex-shrink: 0;
      transition: background .2s, transform .15s;
    }
    .section-header .header__cta:hover { background: #3b3280; transform: translateY(-1px); }

    /* Ikon butonlar */
    .section-header .header__icon {
      width: 36px; height: 36px; padding: 0;
      display: inline-flex !important;
      align-items: center; justify-content: center;
      border-radius: 10px;
      background: rgba(73,61,154,.08);
      transition: background .2s;
      flex-shrink: 0;
    }
    .section-header .header__icon:hover { background: rgba(73,61,154,.16); }
    .section-header .header__icon svg { color: #493d9a; width: 18px; height: 18px; }

    .desktop-only { display: inline-flex !important; }
    .mobile-only  { display: none !important; }
  }

  /* ===== MOBILE ≤ 989px ===== */
  @media screen and (max-width:989px){
    .section-header{
      position:sticky!important;top:0!important;
      z-index:1000!important;
      background:var(--ki-offwhite,#f8f8f6)!important;
    }
    /* ki-base.css mobil guard'i [class*="-wrap"] ile header-wrapper'a 16px padding
       ekliyordu -> header icerigi iceri kayiyordu. Sifirla (sadece bu temada). */
    .section-header .header-wrapper{
      padding-inline:0!important;margin-inline:0!important;
      max-width:100%!important;width:100%!important;
    }
    /* Drawer scroll chaining fix: menu sonuna gelince kaydirma arkadaki siteye gecmesin */
    .section-header .menu-drawer__inner-container,
    .section-header .menu-drawer__navigation-container,
    .section-header .menu-drawer__navigation{
      overscroll-behavior:contain!important;
      -webkit-overflow-scrolling:touch;
    }
    .section-header .header.page-width,
    .section-header .header,.header{
      position:relative!important;padding:0!important;
      min-height:52px!important;max-height:52px!important;height:52px!important;
      display:flex!important;align-items:center!important;
      justify-content:space-between!important;
      width:100%!important;box-sizing:border-box!important;
      max-width:unset!important;margin:0!important;
    }
    .section-header .header__heading,
    .section-header h1.header__heading,
    .section-header div.header__heading{
      position:absolute!important;left:50%!important;top:50%!important;
      transform:translate(-50%,-50%)!important;
      margin:0!important;z-index:50!important;
      display:flex!important;align-items:center!important;justify-content:center!important;
    }
    .section-header .header__heading-logo-wrapper{transform:scale(0.35)!important;transform-origin:center center!important;}
    header-drawer{margin-left:-1px;display:flex!important;align-items:center;width:90px;flex-shrink:0;justify-content:flex-start;}
    header-drawer summary{width:38px;height:38px;display:grid;place-items:center;padding:0;}
    header-drawer svg{width:22px;height:22px;}
    .header__icons{margin-right:13px;display:flex;align-items:center;justify-content:flex-end;width:90px;flex-shrink:0;gap:6px;}
    .header__icon{width:38px;height:38px;padding:0;display:grid;place-items:center;background:rgba(73,61,154,.08);border-radius:9px;}
    .header__icon svg{width:22px;height:22px;color:#493d9a;}
    /* Profil (account) ikonu kaldirildi; sepet flex-end oldugu icin yeri degismez.
       Hamburger (soldan 14px) ile sepet (sagdan 14px) simetrik kalir. */
    .section-header .header__icon--account{display:none!important;}
    .section-header .header__cta{display:none!important;}
    .desktop-only{display:none!important;}
    .mobile-only{display:block!important;}
    .ki-mega-nav{display:none!important;}
  }
  @media screen and (max-width:600px){
    .section-header .header.page-width,.section-header .header,.header{min-height:44px!important;max-height:44px!important;height:44px!important;}
    .section-header .header__heading-logo-wrapper{transform:scale(0.3)!important;}
    header-drawer{margin-left:-1px;width:90px;}
    header-drawer summary,.header__icon{width:34px;height:34px;}
    header-drawer svg,.header__icon svg{width:20px;height:20px;}
    .header__icons{margin-right:13px;width:90px;}
  }

  .section-header{position:sticky;margin-bottom:{{ section.settings.margin_bottom | times:0.75 | round:0 }}px;}
  @media screen and (min-width:750px){.section-header{margin-bottom:{{ section.settings.margin_bottom }}px;}}
  .ki-mobile-floating-bar{display:none!important;}
  /* Drawer acikken arkadaki sayfa scroll edilmesin (scroll chaining + body kilidi) */
  @media screen and (max-width:989px){
    body:has(.section-header .menu-drawer-container[open]){overflow:hidden!important;}
    /* Sticky header scroll'da yukari gizleniyordu; menu acilinca drawer da onunla
       kayboluyordu. Menu acikken header'i viewport tepesine sabitle -> nerede
       acilirsa acilsin header(X)+drawer o anki ekranda gorunur. */
    body:has(.section-header .menu-drawer-container[open]) .section-header{
      position:fixed!important;top:0!important;left:0!important;right:0!important;
      transform:none!important;z-index:10000!important;
    }
  }
{%- endstyle -%}

