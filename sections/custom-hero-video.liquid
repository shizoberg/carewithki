{% comment %}
  .ki Hero Slider Section — v2
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
  :root {
    --ki-purple-dark: #493d9a;
    --ki-offwhite: #f8f8f6;
    --ki-purple: #b2a5ff;
    --ki-lilac: #dad2ff;
  }

  .ki-hero-slider {
    position: relative;
    width: 100%;
    z-index: 1;
    background: var(--ki-offwhite);
  }

  .ki-hero-slider__media-wrap {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ki-hero-slider__track {
    display: flex;
    width: 100%;
    transition: none;
  }

  .ki-hero-slider__slide {
    flex: 0 0 100%;
    width: 100%;
    position: relative;
  }

  /* Desktop */
  .ki-hero-slider__media {
    position: relative;
    width: 100%;
    height: 90vh;
    min-height: 500px;
    overflow: hidden;
  }

  /* MOBILE — 110px sabit yükseklik */
  @media (max-width: 749px) {
    .ki-hero-slider__media {
      height: 110px;
      min-height: 110px;
      max-height: 110px;
    }
  }

  .ki-hero-slider__media video,
  .ki-hero-slider__media img {
    position: absolute;
    top: 50%; left: 50%;
    width: 100%; height: 100%;
    object-fit: cover;
    transform: translate(-50%, -50%);
    display: block;
  }

  .ki-hero-slider__overlay {
    position: absolute;
    inset: 0; z-index: 2;
    background: linear-gradient(to right, rgba(73,61,154,0.62) 0%, rgba(73,61,154,0.32) 55%, rgba(0,0,0,0.08) 100%);
    pointer-events: none;
  }

  .ki-hero-slider__content-over {
    position: absolute;
    inset: 0; z-index: 3;
    display: flex; align-items: center;
    pointer-events: none;
  }
  .ki-hero-slider__content-over .ki-hero-slider__inner { pointer-events: auto; }

  .ki-hero-slider__inner {
    width: 100%;
    max-width: var(--page-width, 120rem);
    margin: 0 auto;
    padding: 0 3rem;
    display: flex; flex-direction: column; justify-content: center;
  }

  .ki-hero-title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 800; line-height: 1.2;
    color: #fff; margin: 0 0 20px;
    max-width: 560px; letter-spacing: -0.01em;
    font-family: 'Raleway', system-ui, sans-serif;
    text-shadow: 0 2px 20px rgba(0,0,0,0.25);
  }
  .ki-hero-desc {
    font-size: clamp(15px, 1.2vw, 20px);
    line-height: 1.55; color: #fff;
    margin: 0 0 28px; max-width: 520px;
    text-shadow: 0 2px 10px rgba(0,0,0,0.2);
  }
  .ki-hero-slider__content-over .ki-btn {
    padding: 18px 40px; font-size: 17px; width: fit-content;
  }

  /* Dots desktop */
  .ki-hero-slider__dots {
    position: absolute; bottom: 22px; left: 50%;
    transform: translateX(-50%); z-index: 10;
    display: flex; gap: 10px; align-items: center;
  }
  .ki-hero-slider__dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: rgba(255,255,255,0.45); border: none;
    cursor: pointer; padding: 0;
    transition: background 0.3s, transform 0.3s; flex-shrink: 0;
  }
  .ki-hero-slider__dot.is-active { background: #fff; transform: scale(1.35); }

  /* Mobile content below */
  .ki-hero-slider__content-below { display: none; }
  .ki-hero-slider__mobile-strip { overflow: hidden; position: relative; }
  .ki-hero-slider__mobile-track {
    display: flex;
    transition: transform 0.55s cubic-bezier(0.4,0,0.2,1);
  }

  /* MOBILE slide — kompakt */
  .ki-hero-slider__mobile-slide {
    flex: 0 0 100%; width: 100%;
    padding: 12px 16px 16px;
    text-align: center; box-sizing: border-box;
  }
  .ki-hero-slider__mobile-slide .ki-hero-title {
    color: var(--ki-purple-dark); text-shadow: none;
    font-size: clamp(16px, 5vw, 22px);
    margin: 0 auto 6px; max-width: 100%;
  }
  .ki-hero-slider__mobile-slide .ki-hero-desc {
    color: #555; text-shadow: none;
    font-size: 11px; line-height: 1.4;
    margin: 0 auto 10px; max-width: 92%;
  }
  .ki-hero-slider__mobile-slide .ki-btn {
    margin: 0 auto; width: 75%; max-width: 240px;
    padding: 9px 16px; font-size: 12px;
  }

  @media (max-width: 749px) {
    .ki-hero-slider__overlay,
    .ki-hero-slider__content-over,
    .ki-hero-slider__dots { display: none; }
    .ki-hero-slider__content-below { display: block; }
    .ki-hero-slider__mobile-dots {
      display: flex; justify-content: center;
      gap: 8px; margin-top: 2px; padding-bottom: 2px;
    }
    .ki-hero-slider__mobile-dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--ki-lilac, #dad2ff);
      border: none; cursor: pointer; padding: 0;
      transition: background 0.3s, transform 0.3s;
    }
    .ki-hero-slider__mobile-dot.is-active {
      background: var(--ki-purple-dark, #493d9a);
      transform: scale(1.35);
    }
  }
  @media (min-width: 750px) {
    .ki-hero-slider__mobile-dots { display: none; }
  }
</style>

{%- assign slide_count = section.blocks.size -%}

<section
  class="ki-hero-slider"
  id="KiHeroSlider-{{ section.id }}"
  data-autoplay="{{ section.settings.auto_rotate }}"
  data-speed="{{ section.settings.change_slides_speed }}"
  data-total="{{ slide_count }}"
>
  {%- if slide_count > 0 -%}
  <div class="ki-hero-slider__media-wrap">
    <div class="ki-hero-slider__track" id="KiHeroTrack-{{ section.id }}">
      {%- for block in section.blocks -%}
      <div class="ki-hero-slider__slide" {{ block.shopify_attributes }}>
        <div class="ki-hero-slider__media">
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'ki-slide-video' }}
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1920 | image_tag: loading: 'eager', decoding: 'async', alt: block.settings.title }}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <div class="ki-hero-slider__overlay"></div>
        <div class="ki-hero-slider__content-over">
          <div class="ki-hero-slider__inner">
            {%- if block.settings.title != blank -%}<h1 class="ki-hero-title">{{ block.settings.title }}</h1>{%- endif -%}
            {%- if block.settings.description != blank -%}<div class="ki-hero-desc">{{ block.settings.description }}</div>{%- endif -%}
            {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
              {% render 'ki-button', label: block.settings.button_text, url: block.settings.button_link, size: 'large' %}
            {%- endif -%}
          </div>
        </div>
      </div>
      {%- endfor -%}
    </div>
    {%- if slide_count > 1 -%}
    <div class="ki-hero-slider__dots" id="KiHeroDots-{{ section.id }}" aria-hidden="true">
      {%- for block in section.blocks -%}
        <button class="ki-hero-slider__dot{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>

  <div class="ki-hero-slider__content-below">
    <div class="ki-hero-slider__mobile-strip">
      <div class="ki-hero-slider__mobile-track" id="KiHeroMobileTrack-{{ section.id }}">
        {%- for block in section.blocks -%}
        <div class="ki-hero-slider__mobile-slide">
          {%- if block.settings.title != blank -%}<h1 class="ki-hero-title">{{ block.settings.title }}</h1>{%- endif -%}
          {%- if block.settings.description != blank -%}<div class="ki-hero-desc">{{ block.settings.description }}</div>{%- endif -%}
          {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
            {% render 'ki-button', label: block.settings.button_text, url: block.settings.button_link %}
          {%- endif -%}
        </div>
        {%- endfor -%}
      </div>
    </div>
    {%- if slide_count > 1 -%}
    <div class="ki-hero-slider__mobile-dots" id="KiHeroMobileDots-{{ section.id }}">
      {%- for block in section.blocks -%}
        <button class="ki-hero-slider__mobile-dot{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>

  {%- else -%}
  <div class="ki-hero-slider__media-wrap">
    <div class="ki-hero-slider__media">
      {% if section.settings.video != blank %}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
      {% elsif section.settings.background_image != blank %}
        {{ section.settings.background_image | image_url: width: 1920 | image_tag: loading: 'eager', alt: section.settings.title }}
      {% endif %}
      <div class="ki-hero-slider__overlay"></div>
      <div class="ki-hero-slider__content-over">
        <div class="ki-hero-slider__inner">
          {% if section.settings.title != blank %}<h1 class="ki-hero-title">{{ section.settings.title }}</h1>{% endif %}
          {% if section.settings.description != blank %}<div class="ki-hero-desc">{{ section.settings.description }}</div>{% endif %}
          {% if section.settings.button_text != blank and section.settings.button_link != blank %}
            {% render 'ki-button', label: section.settings.button_text, url: section.settings.button_link, size: 'large' %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  {%- endif -%}
</section>

<script>
(function() {
  const section = document.getElementById('KiHeroSlider-{{ section.id }}');
  if (!section) return;
  const total = parseInt(section.dataset.total, 10);
  if (total < 2) return;
  const autoplay = section.dataset.autoplay === 'true';
  const speed    = (parseInt(section.dataset.speed, 10) || 5) * 1000;
  const desktopTrack  = document.getElementById('KiHeroTrack-{{ section.id }}');
  const mobileTrack   = document.getElementById('KiHeroMobileTrack-{{ section.id }}');
  const desktopDotsEl = document.getElementById('KiHeroDots-{{ section.id }}');
  const mobileDotsEl  = document.getElementById('KiHeroMobileDots-{{ section.id }}');
  let current = 0, timer = null;

  function goTo(idx) {
    current = (idx + total) % total;
    if (desktopTrack) {
      desktopTrack.style.transition = 'transform 0.65s cubic-bezier(0.4,0,0.2,1)';
      desktopTrack.style.transform  = `translateX(-${current * 100}%)`;
    }
    if (mobileTrack) mobileTrack.style.transform = `translateX(-${current * 100}%)`;
    const slides = desktopTrack ? desktopTrack.querySelectorAll('.ki-hero-slider__slide') : [];
    slides.forEach((s, i) => {
      const v = s.querySelector('video');
      if (!v) return;
      if (i === current) { v.currentTime = 0; v.play().catch(() => {}); } else v.pause();
    });
    [desktopDotsEl, mobileDotsEl].forEach(el => {
      if (!el) return;
      el.querySelectorAll('button').forEach((b, i) => b.classList.toggle('is-active', i === current));
    });
  }

  function startAutoplay() { if (!autoplay) return; timer = setInterval(() => goTo(current + 1), speed); }
  function stopAutoplay()  { clearInterval(timer); }

  [desktopDotsEl, mobileDotsEl].forEach(el => {
    if (!el) return;
    el.addEventListener('click', e => {
      const btn = e.target.closest('button[data-index]');
      if (!btn) return;
      stopAutoplay(); goTo(parseInt(btn.dataset.index, 10)); startAutoplay();
    });
  });

  const mw = section.querySelector('.ki-hero-slider__media-wrap');
  if (mw) {
    let tx = 0;
    mw.addEventListener('touchstart', e => { tx = e.changedTouches[0].clientX; }, { passive: true });
    mw.addEventListener('touchend', e => {
      const d = tx - e.changedTouches[0].clientX;
      if (Math.abs(d) > 40) { stopAutoplay(); goTo(d > 0 ? current + 1 : current - 1); startAutoplay(); }
    }, { passive: true });
  }

  goTo(0); startAutoplay();
  document.addEventListener('shopify:section:select', e => {
    if (e.detail.sectionId === '{{ section.id }}') goTo(0);
  });
})();
</script>

{% schema %}
{
  "name": "Hero Slider (.ki)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Otomatik Kaydırma" },
    { "type": "checkbox", "id": "auto_rotate", "label": "Otomatik kaydır", "default": true },
    { "type": "range", "id": "change_slides_speed", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Geçiş hızı", "default": 5 },
    { "type": "header", "content": "Eski Tek Video (Fallback)", "info": "Block eklenirse devre dışı kalır." },
    { "type": "text", "id": "title", "label": "Başlık", "default": "Önce Kendine İyi Bak" },
    { "type": "textarea", "id": "description", "label": "Açıklama", "default": "Modern Kadın Sağlığı Çözümleri" },
    { "type": "image_picker", "id": "background_image", "label": "Arka plan görseli" },
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "text", "id": "button_text", "label": "Buton metni", "default": "Ürünleri Gör" },
    { "type": "url", "id": "button_link", "label": "Buton linki", "default": "/collections/all" }
  ],
  "blocks": [
    {
      "type": "slide", "name": "Slide", "limit": 5,
      "settings": [
        { "type": "header", "content": "Medya" },
        { "type": "video", "id": "video", "label": "Video", "info": "Video eklenirse görsel kullanılmaz." },
        { "type": "image_picker", "id": "image", "label": "Görsel", "info": "Video yoksa bu görsel gösterilir." },
        { "type": "header", "content": "İçerik" },
        { "type": "text", "id": "title", "label": "Başlık", "default": "Önce Kendine İyi Bak" },
        { "type": "textarea", "id": "description", "label": "Açıklama", "default": "Modern Kadın Sağlığı Çözümleri" },
        { "type": "text", "id": "button_text", "label": "Buton metni", "default": "Ürünleri Gör" },
        { "type": "url", "id": "button_link", "label": "Buton linki" }
      ]
    }
  ],
  "presets": [{ "name": "Hero Slider (.ki)", "blocks": [{ "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
