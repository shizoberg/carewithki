{% comment %}.ki Kampüs Elçisi Sayfası — v1{% endcomment %}
<link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,400;0,600;0,700;0,800;1,700;1,800&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;}
.kampus{--p:#493d9a;--pd:#3b3280;--lil:#dad2ff;--lilf:#f0eeff;--bg:#f8f8f6;--txt:#1a1340;--mut:#6b6b8a;--bdr:#e8e2ff;font-family:'Raleway',system-ui,sans-serif;background:var(--bg);color:var(--txt);}
.kampus__hero{background:linear-gradient(135deg,#2d1b69 0%,#493d9a 55%,#6b5dd3 100%);position:relative;overflow:hidden;padding:80px 24px 90px;text-align:center;}
.kampus__hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 70% 30%,rgba(218,210,255,.15) 0%,transparent 60%),radial-gradient(ellipse at 20% 80%,rgba(255,255,255,.06) 0%,transparent 50%);pointer-events:none;}
.kampus__hero-eyebrow{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:rgba(255,255,255,.8);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:6px 16px;border-radius:50px;margin-bottom:22px;}
.kampus__hero h1{font-size:clamp(32px,5vw,58px);font-weight:800;color:#fff;margin:0 0 16px;line-height:1.05;letter-spacing:-.03em;}
.kampus__hero h1 em{font-style:italic;color:#c4b5fd;}
.kampus__hero p{font-size:clamp(15px,2vw,18px);color:rgba(255,255,255,.7);max-width:560px;margin:0 auto 32px;line-height:1.7;font-weight:400;}
.kampus__hero-cta{display:inline-flex;align-items:center;gap:8px;background:#fff;color:var(--p);font-size:14px;font-weight:800;letter-spacing:.02em;padding:14px 28px;border-radius:50px;text-decoration:none;box-shadow:0 8px 32px rgba(0,0,0,.2);transition:transform .2s,box-shadow .2s;}
.kampus__hero-cta:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(0,0,0,.28);}
.kampus__hero-cta svg{width:16px;height:16px;}
.kampus__hero-tags{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:28px;}
.kampus__htag{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);color:rgba(255,255,255,.85);font-size:12px;font-weight:600;padding:5px 14px;border-radius:50px;}
.kampus__wrap{max-width:1060px;margin:0 auto;padding:0 24px;}
.kampus__perks{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--bdr);border:1px solid var(--bdr);border-radius:20px;overflow:hidden;margin:56px auto;max-width:900px;}
.kampus__perk{background:#fff;padding:28px 24px;display:flex;flex-direction:column;gap:10px;}
.kampus__perk .ico{font-size:28px;line-height:1;}
.kampus__perk h3{font-size:14px;font-weight:800;color:var(--txt);margin:0;}
.kampus__perk p{font-size:13px;color:var(--mut);line-height:1.65;margin:0;font-weight:400;}
.kampus__split{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;padding:0 0 64px;}
.kampus__col h2{font-size:clamp(20px,2.5vw,28px);font-weight:800;color:var(--txt);margin:0 0 20px;letter-spacing:-.02em;}
.kampus__col h2 span{color:var(--p);}
.kampus__who{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:32px;}
.kampus__who-tag{display:inline-flex;align-items:center;gap:6px;background:var(--lilf);border:1.5px solid var(--lil);color:var(--p);font-size:12px;font-weight:700;padding:6px 14px;border-radius:8px;}
.kampus__learn{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px;}
.kampus__learn li{display:flex;align-items:flex-start;gap:12px;font-size:14px;color:var(--txt);line-height:1.6;font-weight:500;}
.kampus__learn li .dot{width:20px;height:20px;border-radius:6px;background:var(--lilf);border:1.5px solid var(--lil);color:var(--p);display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:800;flex-shrink:0;margin-top:2px;}
.kampus__form-section{background:linear-gradient(135deg,#2d1b69 0%,#493d9a 100%);padding:80px 24px;position:relative;overflow:hidden;}
.kampus__form-section::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 80% 20%,rgba(255,255,255,.08) 0%,transparent 55%);pointer-events:none;}
.kampus__form-inner{max-width:720px;margin:0 auto;position:relative;z-index:1;}
.kampus__form-hd{text-align:center;margin-bottom:40px;}
.kampus__form-hd h2{font-size:clamp(24px,3vw,36px);font-weight:800;color:#fff;margin:0 0 10px;letter-spacing:-.02em;}
.kampus__form-hd p{font-size:15px;color:rgba(255,255,255,.65);margin:0;font-weight:400;}
.kampus__form{display:flex;flex-direction:column;gap:14px;}
.kampus__form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.kampus__field{display:flex;flex-direction:column;gap:6px;}
.kampus__field label{font-size:11px;font-weight:700;color:rgba(255,255,255,.6);letter-spacing:.08em;text-transform:uppercase;}
.kampus__field input,.kampus__field select,.kampus__field textarea{font-family:'Raleway',system-ui,sans-serif;font-size:14px;font-weight:500;color:#fff;background:rgba(255,255,255,.08);border:1.5px solid rgba(255,255,255,.15);border-radius:12px;padding:13px 16px;outline:none;transition:border-color .15s,background .15s;width:100%;}
.kampus__field input::placeholder,.kampus__field textarea::placeholder{color:rgba(255,255,255,.35);}
.kampus__field input:focus,.kampus__field select:focus,.kampus__field textarea:focus{border-color:rgba(255,255,255,.45);background:rgba(255,255,255,.13);}
.kampus__field select option{background:#2d1b69;color:#fff;}
.kampus__field textarea{resize:vertical;min-height:110px;}
.kampus__submit{background:#fff;color:var(--p);font-family:'Raleway',system-ui,sans-serif;font-size:15px;font-weight:800;letter-spacing:.02em;border:none;border-radius:14px;padding:16px 36px;cursor:pointer;align-self:center;margin-top:8px;transition:transform .15s,box-shadow .15s;box-shadow:0 4px 20px rgba(0,0,0,.2);display:flex;align-items:center;gap:8px;}
.kampus__submit:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(0,0,0,.3);}
.kampus__note{text-align:center;font-size:12px;color:rgba(255,255,255,.4);margin-top:8px;font-weight:400;}
.kampus__success{display:none;background:rgba(255,255,255,.1);border:1.5px solid rgba(255,255,255,.2);border-radius:16px;padding:28px 32px;text-align:center;color:#fff;font-size:16px;font-weight:700;line-height:1.6;margin-top:20px;}
@media(max-width:900px){.kampus__perks{grid-template-columns:repeat(3,1fr);}.kampus__split{grid-template-columns:1fr;gap:32px;}}
@media(max-width:600px){.kampus__hero{padding:56px 20px 64px;}.kampus__perks{grid-template-columns:1fr;margin:32px 12px;}.kampus__perk{padding:20px 16px;}.kampus__form-row{grid-template-columns:1fr;}.kampus__wrap{padding:0 16px;}.kampus__form-section{padding:56px 16px;}}
</style>

<div class="kampus">
  <div class="kampus__hero">
    <p class="kampus__hero-eyebrow">.ki Kampüs Elçisi Programı</p>
    <h1>Kampüsünde<br><em>.ki'yi temsil et.</em></h1>
    <p>Arkadaşlarına .ki'yi anlat, paylaş ve kazan. Üniversitende kadın sağlığı hakkında farkındalık yarat.</p>
    <a href="#basvur" class="kampus__hero-cta">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      Elçi Ol
    </a>
    <div class="kampus__hero-tags">
      <span class="kampus__htag">🎓 Üniversite öğrencisi</span>
      <span class="kampus__htag">📣 Sosyal medya</span>
      <span class="kampus__htag">💰 Komisyon kazan</span>
      <span class="kampus__htag">💜 Üretsiz ürünler</span>
    </div>
  </div>

  <div class="kampus__perks">
    <div class="kampus__perk"><span class="ico">💰</span><h3>Komisyon Kazan</h3><p>Her satıştan komisyon al. Kendi indirim kodunla arkadaşlarına özel fırsat sun.</p></div>
    <div class="kampus__perk"><span class="ico">📦</span><h3>Ücretsiz .ki Ürünleri</h3><p>Elçi süresince tüm ürünlerimize ücretsiz erişim. Kullan, hisset, paylaş.</p></div>
    <div class="kampus__perk"><span class="ico">🌟</span><h3>Portföyüne Ekle</h3><p>Gerçek bir markada deneyim kazan. CV'ne ve LinkedIn'e ekleyebileceğin somut bir iş deneyimi.</p></div>
  </div>

  <div class="kampus__wrap">
    <div class="kampus__split">
      <div class="kampus__col">
        <h2>Kimler <span>başvurabilir?</span></h2>
        <div class="kampus__who">
          <span class="kampus__who-tag">🎓 Üniversite öğrencisi</span>
          <span class="kampus__who-tag">📣 Sosyal medya aktif</span>
          <span class="kampus__who-tag">💜 Kadın sağlığına ilgili</span>
          <span class="kampus__who-tag">💊 Eczacılık</span>
          <span class="kampus__who-tag">🎨 İçerik üretici</span>
          <span class="kampus__who-tag">🌍 Her bölüm</span>
        </div>
        <p style="font-size:14px;color:#6b6b8a;line-height:1.7;font-weight:400;">.ki'ye inanan, çevresine anlatabilen, sosyal medyada aktif olan herkes başvurabilir.</p>
      </div>
      <div class="kampus__col">
        <h2>Elçi olunca <span>ne olur?</span></h2>
        <ul class="kampus__learn">
          <li><span class="dot">01</span>Sana özel indirim kodu tanımlanır</li>
          <li><span class="dot">02</span>Tüm .ki ürünleri ücretsiz gönderilir</li>
          <li><span class="dot">03</span>Her satıştan komisyon hesabına geçer</li>
          <li><span class="dot">04</span>Kampus etkinlikleri için destek alırsın</li>
          <li><span class="dot">05</span>.ki sosyal medyasında öne çıkarılırsın</li>
          <li><span class="dot">06</span>Referans mektubu hakkı kazanırsın</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="kampus__form-section" id="basvur">
    <div class="kampus__form-inner">
      <div class="kampus__form-hd">
        <h2>Başvurunu yap 👇</h2>
        <p>Formu doldur — 3 iş günü içinde sana dönelim.</p>
      </div>
      <form class="kampus__form" id="ki-kampus-form">
        <div class="kampus__form-row">
          <div class="kampus__field"><label>Ad Soyad</label><input type="text" name="name" placeholder="Ada Yılmaz" required></div>
          <div class="kampus__field"><label>E-posta</label><input type="email" name="email" placeholder="ada@uni.edu.tr" required></div>
        </div>
        <div class="kampus__form-row">
          <div class="kampus__field"><label>Üniversite</label><input type="text" name="university" placeholder="DEÜ, Boğaziçi..." required></div>
          <div class="kampus__field"><label>Bölüm &amp; Sınıf</label><input type="text" name="department" placeholder="Eczacılık, 3. sınıf" required></div>
        </div>
        <div class="kampus__field"><label>Instagram / TikTok hesabın</label><input type="text" name="social" placeholder="@kullaniciadiniz" required></div>
        <div class="kampus__field"><label>Takipçi sayın (yaklaşık)</label>
          <select name="followers" required>
            <option value="">Seç...</option>
            <option>500 altı</option>
            <option>500 — 2.000</option>
            <option>2.000 — 10.000</option>
            <option>10.000+</option>
          </select>
        </div>
        <div class="kampus__field"><label>Neden .ki elçisi olmak istiyorsun?</label><textarea name="message" placeholder="Motivasyonunu kısaca anlat." required></textarea></div>
        <button type="submit" class="kampus__submit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          Başvuruyu Gönder
        </button>
        <p class="kampus__note">Başvurun berk@carewithki.com ve arin@carewithki.com adreslerine iletilir.</p>
      </form>
      <div class="kampus__success" id="ki-kampus-success">✅ Başvurun alındı!<br><span style="font-weight:400;font-size:14px;opacity:.85;">3 iş günü içinde seninle iletişime geçeceğiz. .ki ailesine hoş geldin 💜</span></div>
    </div>
  </div>
</div>

<script>
document.getElementById('ki-kampus-form').addEventListener('submit',function(e){
  e.preventDefault();
  var d=new FormData(this);
  var lines=[];
  d.forEach(function(v,k){if(v) lines.push(k.toUpperCase()+': '+v);});
  var body=lines.join('\n\n');
  var subject=encodeURIComponent('.ki Kampüs Elçisi Başvurusu — '+(d.get('name')||''));
  var bodyEnc=encodeURIComponent(body);
  window.location.href='mailto:berk@carewithki.com,arin@carewithki.com?subject='+subject+'&body='+bodyEnc;
  this.style.display='none';
  document.getElementById('ki-kampus-success').style.display='block';
  document.getElementById('ki-kampus-success').scrollIntoView({behavior:'smooth'});
});
document.querySelector('.kampus__hero-cta').addEventListener('click',function(e){
  var t=document.getElementById('basvur');
  if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth'});}
});
</script>

{% schema %}
{"name":"Kampüs Elçisi (.ki)","tag":"section","class":"section","settings":[],"presets":[{"name":"Kampüs Elçisi (.ki)"}]}
{% endschema %}
