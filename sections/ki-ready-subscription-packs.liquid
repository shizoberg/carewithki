{%- assign ready_pack_blocks = section.blocks | where: 'type', 'ready_pack' -%}

{%- if ready_pack_blocks.size > 0 -%}
  <section id="ki-ready-packs-{{ section.id }}" class="ki-ready-packs" aria-labelledby="ki-ready-packs-title-{{ section.id }}">
    <style>
      #ki-ready-packs-{{ section.id }} {
        --ready-primary:#493d9a;
        --ready-border:#e1ddf0;
        --ready-muted:#706a7b;
        overflow:hidden;
        padding:28px 0 18px;
        background:linear-gradient(180deg,#fff 0%,#faf9ff 100%);
      }
      #ki-ready-packs-{{ section.id }} *{box-sizing:border-box}
      #ki-ready-packs-{{ section.id }} .ki-ready-packs__wrap{width:100%;max-width:1240px;margin:0 auto;padding:0 20px}
      #ki-ready-packs-{{ section.id }} .ki-ready-packs__head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:18px}
      #ki-ready-packs-{{ section.id }} .ki-ready-packs__eyebrow{display:block;margin:0 0 6px;color:#766bbd;font-size:10px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}
      #ki-ready-packs-{{ section.id }} .ki-ready-packs__title{margin:0;color:var(--ready-primary);font-family:var(--ki-font-primary,'Raleway',sans-serif);font-size:26px;line-height:1.12;font-weight:800;letter-spacing:-.02em}
      #ki-ready-packs-{{ section.id }} .ki-ready-packs__desc{max-width:620px;margin:8px 0 0;color:var(--ready-muted);font-size:13px;line-height:1.55}
      #ki-ready-packs-{{ section.id }} .ki-ready-packs__arrows{display:none;align-items:center;gap:8px;flex-shrink:0}
      #ki-ready-packs-{{ section.id }} .ki-ready-packs__arrow{display:grid;place-items:center;width:38px;height:38px;padding:0;border:1px solid var(--ready-border);border-radius:50%;background:#fff;color:var(--ready-primary);cursor:pointer}
      #ki-ready-packs-{{ section.id }} .ki-ready-packs__arrow svg{width:16px;height:16px}
      #ki-ready-packs-{{ section.id }} .ki-ready-packs__track{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(272px,86%);gap:12px;overflow-x:auto;padding:2px 1px 8px;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch}
      #ki-ready-packs-{{ section.id }} .ki-ready-packs__track::-webkit-scrollbar{display:none}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack{position:relative;display:flex;min-height:100%;flex-direction:column;overflow:hidden;border:1px solid var(--ready-border);border-radius:20px;background:#fff;box-shadow:0 12px 32px -24px rgba(73,61,154,.55);scroll-snap-align:start;transition:border-color .2s,transform .2s,box-shadow .2s}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack.is-active{border-color:var(--ready-primary);box-shadow:0 14px 36px -20px rgba(73,61,154,.62)}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__media{position:relative;display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);height:138px;overflow:hidden;background:linear-gradient(135deg,#28204f,#5d51b1)}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__media.is-single{display:block;height:180px;background:#17142f}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__image{position:relative;min-width:0;overflow:hidden}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__image::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 60%,rgba(19,13,54,.22))}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__image img{display:block;width:100%;height:100%;object-fit:cover}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__media.is-single .ki-ready-pack__image{height:100%}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__media.is-single .ki-ready-pack__image::after{display:none}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__media.is-single .ki-ready-pack__image img{object-fit:contain}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__badge{position:absolute;z-index:2;top:10px;left:10px;padding:6px 9px;border-radius:999px;background:rgba(255,255,255,.92);color:var(--ready-primary);font-size:9px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;backdrop-filter:blur(8px)}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__body{display:flex;flex:1;flex-direction:column;padding:15px}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__title{margin:0;color:#2d245f;font-size:17px;line-height:1.25;font-weight:800}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__text{margin:6px 0 0;color:var(--ready-muted);font-size:11.5px;line-height:1.45}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__products{display:flex;flex-wrap:wrap;gap:5px;margin:11px 0 13px}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__product{padding:5px 7px;border-radius:8px;background:#f2f0fb;color:#554a97;font-size:9.5px;font-weight:700;line-height:1.2}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__price{display:block;color:var(--ready-primary);font-size:17px;font-weight:900;line-height:1}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__price-row{display:flex;align-items:baseline;gap:7px;margin-bottom:3px}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__compare{color:#88818e;font-size:11px}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__saving{display:block;color:#287655;font-size:9.5px;font-weight:800}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__footer{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:auto}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__meta{color:#786fa5;font-size:10px;font-weight:700}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__apply{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:9px 14px;border:0;border-radius:999px;background:var(--ready-primary);color:#fff;font:inherit;font-size:11px;font-weight:800;line-height:1;text-decoration:none;white-space:nowrap;cursor:pointer}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__apply:hover{background:#6254b4}
      #ki-ready-packs-{{ section.id }} .ki-ready-pack__apply.is-applied{background:#287655}
      #ki-ready-packs-{{ section.id }} .ki-ready-packs__status{min-height:16px;margin:7px 0 0;color:#287655;font-size:10.5px;font-weight:700}
      #ki-ready-packs-{{ section.id }} .ki-ready-packs__status:empty{display:none}
      @media (min-width:750px){
        #ki-ready-packs-{{ section.id }}{padding:38px 0 24px}
        #ki-ready-packs-{{ section.id }} .ki-ready-packs__wrap{padding:0 32px}
        #ki-ready-packs-{{ section.id }} .ki-ready-packs__title{font-size:32px}
        #ki-ready-packs-{{ section.id }} .ki-ready-packs__desc{font-size:14px}
        #ki-ready-packs-{{ section.id }} .ki-ready-packs__arrows{display:flex}
        #ki-ready-packs-{{ section.id }} .ki-ready-packs__track{grid-auto-columns:minmax(310px,32%)}
        #ki-ready-packs-{{ section.id }} .ki-ready-pack__media{height:158px}
        #ki-ready-packs-{{ section.id }} .ki-ready-pack__media.is-single{height:220px}
      }
      @media (max-width:380px){
        #ki-ready-packs-{{ section.id }} .ki-ready-packs__wrap{padding:0 14px}
        #ki-ready-packs-{{ section.id }} .ki-ready-packs__track{grid-auto-columns:minmax(258px,90%)}
        #ki-ready-packs-{{ section.id }} .ki-ready-pack__footer{align-items:stretch;flex-direction:column}
        #ki-ready-packs-{{ section.id }} .ki-ready-pack__apply{width:100%}
      }
    </style>

    <div class="ki-ready-packs__wrap">
      <div class="ki-ready-packs__head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <span class="ki-ready-packs__eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2 id="ki-ready-packs-title-{{ section.id }}" class="ki-ready-packs__title">{{ section.settings.heading }}</h2>
          {%- if section.settings.description != blank -%}
            <p class="ki-ready-packs__desc">{{ section.settings.description }}</p>
          {%- endif -%}
        </div>
        <div class="ki-ready-packs__arrows" aria-label="Hazır paket kontrolleri">
          <button type="button" class="ki-ready-packs__arrow" data-ready-packs-prev aria-label="Önceki hazır paket">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button type="button" class="ki-ready-packs__arrow" data-ready-packs-next aria-label="Sonraki hazır paket">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div class="ki-ready-packs__track" data-ready-packs-track>
        {%- for block in ready_pack_blocks -%}
          {%- assign ready_card_first = forloop.first -%}
          {%- assign ready_product_1 = block.settings.product_1 -%}
          {%- assign ready_product_2 = block.settings.product_2 -%}
          {%- assign ready_product_3 = block.settings.product_3 -%}
          {%- assign ready_fallback_asset = block.settings.fallback_asset | strip -%}
          {%- assign ready_discount_percent = block.settings.subscription_discount_percent | default: 0 -%}
          {%- if ready_discount_percent == 0 and ready_fallback_asset contains 'ki-ped-pack-' -%}
            {%- assign ready_discount_percent = 15 -%}
          {%- endif -%}
          {%- assign ready_original_price = ready_product_1.price | default: 0 -%}
          {%- assign ready_discount_amount = ready_original_price | times: ready_discount_percent | divided_by: 100 -%}
          {%- assign ready_discount_price = ready_original_price | minus: ready_discount_amount -%}
          {%- assign ready_product_count = 0 -%}
          {%- if ready_product_1 != blank -%}{%- assign ready_product_count = ready_product_count | plus: 1 -%}{%- endif -%}
          {%- if ready_product_2 != blank -%}{%- assign ready_product_count = ready_product_count | plus: 1 -%}{%- endif -%}
          {%- if ready_product_3 != blank -%}{%- assign ready_product_count = ready_product_count | plus: 1 -%}{%- endif -%}
          <article class="ki-ready-pack" data-ready-pack-card {{ block.shopify_attributes }}>
            <div class="ki-ready-pack__media{% if ready_fallback_asset != blank %} is-single{% endif %}">
              {%- if ready_fallback_asset != blank -%}
                <div class="ki-ready-pack__image">
                  <img src="{{ ready_fallback_asset | asset_url }}" alt="{{ block.settings.title | escape }}" width="1080" height="1350" loading="{% if ready_card_first %}eager{% else %}lazy{% endif %}">
                </div>
              {%- else -%}
                {%- for product_index in (1..3) -%}
                  {%- case product_index -%}
                    {%- when 1 -%}{%- assign ready_product = ready_product_1 -%}
                    {%- when 2 -%}{%- assign ready_product = ready_product_2 -%}
                    {%- when 3 -%}{%- assign ready_product = ready_product_3 -%}
                  {%- endcase -%}
                  {%- if ready_product != blank and ready_product.featured_image -%}
                    <div class="ki-ready-pack__image">
                      {%- assign ready_loading = 'lazy' -%}
                      {%- if ready_card_first -%}{%- assign ready_loading = 'eager' -%}{%- endif -%}
                      {{ ready_product.featured_image | image_url: width: 420 | image_tag: loading: ready_loading, widths: '160,240,320,420', sizes: '(min-width: 750px) 120px, 96px', alt: ready_product.title }}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- if block.settings.badge != blank -%}
                <span class="ki-ready-pack__badge">{{ block.settings.badge }}</span>
              {%- endif -%}
            </div>
            <div class="ki-ready-pack__body">
              <h3 class="ki-ready-pack__title">{{ block.settings.title }}</h3>
              {%- if block.settings.description != blank -%}
                <p class="ki-ready-pack__text">{{ block.settings.description }}</p>
              {%- endif -%}
              <div class="ki-ready-pack__products">
                {%- if block.settings.composition_text != blank -%}<span class="ki-ready-pack__product">{{ block.settings.composition_text }}</span>{%- endif -%}
                {%- if block.settings.composition_text == blank -%}
                  {%- if ready_product_1 != blank -%}<span class="ki-ready-pack__product">{{ block.settings.qty_1 }}× {{ ready_product_1.title }}</span>{%- endif -%}
                  {%- if ready_product_2 != blank -%}<span class="ki-ready-pack__product">{{ block.settings.qty_2 }}× {{ ready_product_2.title }}</span>{%- endif -%}
                  {%- if ready_product_3 != blank -%}<span class="ki-ready-pack__product">{{ block.settings.qty_3 }}× {{ ready_product_3.title }}</span>{%- endif -%}
                {%- endif -%}
              </div>
              <div class="ki-ready-pack__footer">
                <span class="ki-ready-pack__meta">
                  {%- if ready_discount_percent > 0 and ready_original_price > 0 -%}
                    <span class="ki-ready-pack__price-row">
                      <s class="ki-ready-pack__compare">{{ ready_original_price | money }}</s>
                      <strong class="ki-ready-pack__price">{{ ready_discount_price | money }}</strong>
                    </span>
                    <span class="ki-ready-pack__saving">Abonelikte %{{ ready_discount_percent }} indirim</span>
                  {%- elsif block.settings.price_text != blank -%}
                    <strong class="ki-ready-pack__price">{{ block.settings.price_text }}</strong>
                  {%- endif -%}
                  Dilediğin an düzenle
                </span>
                {%- if ready_product_count > 0 -%}
                  <button
                    type="button"
                    class="ki-ready-pack__apply"
                    data-ready-pack-apply
                    data-ready-product-1="{{ ready_product_1.handle }}"
                    data-ready-qty-1="{{ block.settings.qty_1 }}"
                    data-ready-product-2="{{ ready_product_2.handle }}"
                    data-ready-qty-2="{{ block.settings.qty_2 }}"
                    data-ready-product-3="{{ ready_product_3.handle }}"
                    data-ready-qty-3="{{ block.settings.qty_3 }}"
                  >
                    {{ section.settings.button_label }}
                  </button>
                {%- elsif block.settings.button_link != blank -%}
                  <a class="ki-ready-pack__apply" href="{{ block.settings.button_link }}">{{ section.settings.button_label }}</a>
                {%- else -%}
                  <button type="button" class="ki-ready-pack__apply" disabled>{{ section.settings.button_label }}</button>
                {%- endif -%}
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <p class="ki-ready-packs__status" data-ready-packs-status role="status" aria-live="polite"></p>
    </div>
  </section>

  <script>
    (function(){
      var root=document.getElementById('ki-ready-packs-{{ section.id }}');
      if(!root||root.dataset.readyPacksBound==='true') return;
      root.dataset.readyPacksBound='true';
      var track=root.querySelector('[data-ready-packs-track]');
      var status=root.querySelector('[data-ready-packs-status]');
      var defaultLabel={{ section.settings.button_label | json }};

      function scrollTrack(direction){
        if(!track) return;
        var card=track.querySelector('[data-ready-pack-card]');
        var amount=card ? card.getBoundingClientRect().width+12 : 300;
        track.scrollBy({left:direction*amount,behavior:'smooth'});
      }

      var previous=root.querySelector('[data-ready-packs-prev]');
      var next=root.querySelector('[data-ready-packs-next]');
      if(previous) previous.addEventListener('click',function(){scrollTrack(-1);});
      if(next) next.addEventListener('click',function(){scrollTrack(1);});

      root.addEventListener('click',function(event){
        var button=event.target.closest&&event.target.closest('[data-ready-pack-apply]');
        if(!button||button.disabled) return;
        var selected=[];
        for(var index=1;index<=3;index++){
          var handle=button.getAttribute('data-ready-product-'+index);
          var quantity=parseInt(button.getAttribute('data-ready-qty-'+index),10)||1;
          if(handle) selected.push({handle:handle,quantity:quantity});
        }
        if(!selected.length) return;
        root.querySelectorAll('[data-ready-pack-card]').forEach(function(card){card.classList.remove('is-active');});
        root.querySelectorAll('[data-ready-pack-apply]').forEach(function(item){
          item.classList.remove('is-applied');
          item.textContent=defaultLabel;
        });
        button.closest('[data-ready-pack-card]').classList.add('is-active');
        button.classList.add('is-applied');
        button.textContent='Hazırlanıyor…';
        if(status) status.textContent='Hazır paket ürünleri seçiliyor…';
        document.dispatchEvent(new CustomEvent('ki:apply-pack-preset',{detail:{items:selected}}));
      });

      document.addEventListener('ki:pack-preset-applied',function(event){
        var activeButton=root.querySelector('[data-ready-pack-apply].is-applied');
        if(!activeButton) return;
        if(event.detail&&event.detail.count>0){
          activeButton.textContent='Paket hazır ✓';
          if(status) status.textContent=event.detail.count+' ürün paketine eklendi. Aşağıdan adetleri değiştirebilirsin.';
          window.setTimeout(function(){
            var builder=document.getElementById('ki-builder');
            if(builder&&builder.scrollIntoView) builder.scrollIntoView({behavior:'smooth',block:'start'});
          },350);
        }else{
          activeButton.classList.remove('is-applied');
          activeButton.textContent=defaultLabel;
          if(status) status.textContent='Bu pakette eşleşen stoklu ürün bulunamadı.';
        }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Hazır abonelik paketleri",
  "tag": "section",
  "class": "ki-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Hızlı başlangıç" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Hazır paketler" },
    { "type": "textarea", "id": "description", "label": "Açıklama", "default": "En çok tercih edilen bakım rutinlerinden birini seç; ürünler paketine otomatik eklensin." },
    { "type": "text", "id": "button_label", "label": "Buton metni", "default": "Bu paketi seç" }
  ],
  "blocks": [
    {
      "type": "ready_pack",
      "name": "Hazır paket",
      "settings": [
        { "type": "text", "id": "badge", "label": "Rozet", "default": "Hazır abonelik" },
        { "type": "text", "id": "title", "label": "Paket adı", "default": "Bakım Rutini" },
        { "type": "textarea", "id": "description", "label": "Kısa açıklama", "default": "Birlikte iyi çalışan ürünlerle hızlıca paketini oluştur." },
        { "type": "text", "id": "fallback_asset", "label": "Tema görsel dosyası", "info": "Örn. ki-ped-pack-light.png" },
        { "type": "textarea", "id": "composition_text", "label": "Paket içeriği" },
        { "type": "text", "id": "price_text", "label": "Gösterim fiyatı" },
        { "type": "range", "id": "subscription_discount_percent", "label": "Abonelik indirimi", "min": 0, "max": 30, "step": 1, "unit": "%", "default": 0 },
        { "type": "url", "id": "button_link", "label": "Ürün seçilmemişse buton bağlantısı" },
        { "type": "product", "id": "product_1", "label": "Ürün 1" },
        { "type": "range", "id": "qty_1", "label": "Ürün 1 adedi", "min": 1, "max": 6, "step": 1, "default": 1 },
        { "type": "product", "id": "product_2", "label": "Ürün 2" },
        { "type": "range", "id": "qty_2", "label": "Ürün 2 adedi", "min": 1, "max": 6, "step": 1, "default": 1 },
        { "type": "product", "id": "product_3", "label": "Ürün 3" },
        { "type": "range", "id": "qty_3", "label": "Ürün 3 adedi", "min": 1, "max": 6, "step": 1, "default": 1 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hazır abonelik paketleri",
      "blocks": [
        { "type": "ready_pack", "settings": { "badge": "En popüler", "title": "Döngü Destek Paketi", "description": "Döngü dönemini destekleyen pratik bakım rutini." } },
        { "type": "ready_pack", "settings": { "badge": "Nazik bakım", "title": "Hassas Bakım Paketi", "description": "Hassas ciltler için günlük bakım ve ferahlık." } },
        { "type": "ready_pack", "settings": { "badge": "50+ rutin", "title": "Menopoz Bakım Paketi", "description": "Menopoz dönemine özel destek ve intim bakım." } }
      ]
    }
  ]
}
{% endschema %}
