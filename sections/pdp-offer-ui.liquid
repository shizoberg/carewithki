{% comment %}
  PDP Offer UI (UI-only) — scoped
  Mimics AG1 purchase module (right column).
  Backend (selling_plan + add to cart) will be added later.
{% endcomment %}

<section id="pdpui-{{ section.id }}" class="section">
  <style>
    /* ===== scoped root ===== */
    #pdpui-{{ section.id }}{
      --bg: {{ section.settings.bg | default: '#ffffff' }};
      --text: {{ section.settings.text | default: '#111111' }};
      --muted: {{ section.settings.muted | default: '#555555' }};
      --line: rgba(0,0,0,.12);

      --accent: {{ section.settings.accent | default: '#16c24a' }};
      --cta: {{ section.settings.cta_bg | default: '#0f3f3a' }};
      --cta_text: {{ section.settings.cta_text | default: '#ffffff' }};

      --radius: 10px;
      --card_radius: 10px;

      background: var(--bg);
      color: var(--text);
    }

    #pdpui-{{ section.id }} .pdpui__wrap{
      max-width: {{ section.settings.max_width | default: 1400 }}px;
      margin: 0 auto;
      padding: {{ section.settings.pad_y | default: 60 }}px {{ section.settings.pad_x | default: 40 }}px;
    }

    /* Right-column look (like screenshot) */
    #pdpui-{{ section.id }} .pdpui__panel{
      max-width: 760px;
      margin-left: auto;
    }

    /* Reviews row */
    #pdpui-{{ section.id }} .pdpui__reviews{
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 14px;
      font-size: 14px;
      color: var(--muted);
    }

    #pdpui-{{ section.id }} .pdpui__stars{
      display: inline-flex;
      gap: 2px;
      color: var(--accent);
      line-height: 1;
    }
    #pdpui-{{ section.id }} .pdpui__stars svg{ width: 14px; height: 14px; display:block; }

    /* Tabs */
    #pdpui-{{ section.id }} .pdpui__tabs{
      display: grid;
      grid-template-columns: 1fr 1fr;
      border: 1px solid var(--line);
      border-radius: 8px;
      overflow: hidden;
      margin-bottom: 18px;
    }
    #pdpui-{{ section.id }} .pdpui__tab{
      padding: 12px 14px;
      font-weight: 600;
      font-size: 14px;
      background: #fff;
      color: var(--text);
      border: 0;
      cursor: pointer;
    }
    #pdpui-{{ section.id }} .pdpui__tab[aria-selected="true"]{
      background: #000;
      color: #fff;
    }

    /* Offer text */
    #pdpui-{{ section.id }} .pdpui__offer{
      font-size: 16px;
      line-height: 1.45;
      font-weight: 600;
      margin: 0 0 16px 0;
    }

    /* Option cards */
    #pdpui-{{ section.id }} .pdpui__options{
      display: grid;
      gap: 14px;
      margin-bottom: 14px;
    }

    #pdpui-{{ section.id }} .pdpui__card{
      border: 1px solid var(--line);
      border-radius: var(--card_radius);
      background: #fff;
      overflow: hidden;
    }

    #pdpui-{{ section.id }} .pdpui__card.is-active{
      border-color: rgba(22,194,74,.65);
      box-shadow: 0 0 0 1px rgba(22,194,74,.35) inset;
      background: rgba(22,194,74,.06);
    }

    #pdpui-{{ section.id }} .pdpui__cardHead{
      display: grid;
      grid-template-columns: 22px 1fr auto;
      gap: 12px;
      padding: 16px 16px 12px 16px;
      align-items: start;
      cursor: pointer;
      user-select: none;
    }

    #pdpui-{{ section.id }} .pdpui__radio{
      width: 18px; height: 18px;
      border-radius: 999px;
      border: 2px solid rgba(0,0,0,.2);
      margin-top: 2px;
      position: relative;
      background: #fff;
    }
    #pdpui-{{ section.id }} .pdpui__card.is-active .pdpui__radio{
      border-color: rgba(22,194,74,.9);
    }
    #pdpui-{{ section.id }} .pdpui__card.is-active .pdpui__radio:after{
      content:"";
      position:absolute;
      inset: 3px;
      border-radius: 999px;
      background: var(--accent);
    }

    #pdpui-{{ section.id }} .pdpui__titleRow{
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    #pdpui-{{ section.id }} .pdpui__title{
      font-size: 18px;
      font-weight: 700;
      line-height: 1.2;
    }

    #pdpui-{{ section.id }} .pdpui__badge{
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .02em;
      text-transform: uppercase;
      padding: 5px 8px;
      border-radius: 999px;
      background: rgba(22,194,74,.18);
      color: #0b3b1b;
      white-space: nowrap;
    }

    #pdpui-{{ section.id }} .pdpui__sub{
      margin-top: 4px;
      font-size: 13px;
      color: var(--muted);
    }

    #pdpui-{{ section.id }} .pdpui__price{
      text-align: right;
      min-width: 130px;
    }
    #pdpui-{{ section.id }} .pdpui__compare{
      color: rgba(0,0,0,.45);
      text-decoration: line-through;
      font-weight: 600;
      font-size: 14px;
      margin-right: 6px;
    }
    #pdpui-{{ section.id }} .pdpui__now{
      font-weight: 800;
      font-size: 18px;
    }
    #pdpui-{{ section.id }} .pdpui__per{
      margin-top: 4px;
      font-size: 12px;
      color: rgba(0,0,0,.55);
    }

    #pdpui-{{ section.id }} .pdpui__benefits{
      padding: 0 16px 14px 48px;
      display: none;
      color: rgba(0,0,0,.75);
      font-size: 13px;
      line-height: 1.6;
    }
    #pdpui-{{ section.id }} .pdpui__card.is-active .pdpui__benefits{
      display: block;
    }

    #pdpui-{{ section.id }} .pdpui__benefits ul{
      margin: 8px 0 0 0;
      padding: 0;
      list-style: none;
    }
    #pdpui-{{ section.id }} .pdpui__benefits li{
      display: flex;
      gap: 10px;
      margin: 6px 0;
    }
    #pdpui-{{ section.id }} .pdpui__check{
      width: 16px; height: 16px; flex: 0 0 16px;
      color: rgba(0,0,0,.65);
      margin-top: 2px;
    }

    /* OR divider */
    #pdpui-{{ section.id }} .pdpui__or{
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 10px;
      color: rgba(0,0,0,.45);
      font-size: 12px;
      margin: 6px 0;
    }
    #pdpui-{{ section.id }} .pdpui__or:before,
    #pdpui-{{ section.id }} .pdpui__or:after{
      content:"";
      height: 1px;
      background: var(--line);
      display: block;
    }

    /* CTA */
    #pdpui-{{ section.id }} .pdpui__cta{
      width: 100%;
      border: 0;
      cursor: pointer;
      padding: 14px 18px;
      border-radius: 999px;
      background: var(--cta);
      color: var(--cta_text);
      font-weight: 700;
      font-size: 15px;
      margin-top: 8px;
    }

    #pdpui-{{ section.id }} .pdpui__ship{
      margin-top: 10px;
      display: flex;
      gap: 10px;
      justify-content: center;
      align-items: center;
      color: rgba(0,0,0,.7);
      font-size: 12px;
    }
    #pdpui-{{ section.id }} .pdpui__ship svg{ width: 14px; height: 14px; }

    #pdpui-{{ section.id }} .pdpui__disc{
      margin-top: 12px;
      font-size: 11px;
      line-height: 1.5;
      color: rgba(0,0,0,.45);
      text-align: center;
    }

    @media (max-width: 990px){
      #pdpui-{{ section.id }} .pdpui__wrap{
        padding: 40px 18px;
      }
      #pdpui-{{ section.id }} .pdpui__panel{
        max-width: 680px;
        margin-left: 0;
      }
      #pdpui-{{ section.id }} .pdpui__price{ min-width: 110px; }
    }
  </style>

  <div class="pdpui__wrap">
    <div class="pdpui__panel">
      <!-- Reviews -->
      <div class="pdpui__reviews">
        <span class="pdpui__stars" aria-hidden="true">
          {% for i in (1..5) %}
            <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
              <path fill="currentColor" d="M10 1.6l2.47 5.3 5.77.5-4.35 3.8 1.32 5.6L10 13.9 4.79 16.8l1.32-5.6L1.76 7.4l5.77-.5L10 1.6z"/>
            </svg>
          {% endfor %}
        </span>
        <span>{{ section.settings.reviews_text }}</span>
      </div>

      <!-- Tabs (UI only) -->
      <div class="pdpui__tabs" role="tablist" aria-label="Product format">
        <button class="pdpui__tab" type="button" role="tab" aria-selected="true" data-tab="a">
          {{ section.settings.tab_a }}
        </button>
        <button class="pdpui__tab" type="button" role="tab" aria-selected="false" data-tab="b">
          {{ section.settings.tab_b }}
        </button>
      </div>

      <!-- Offer headline -->
      <p class="pdpui__offer">{{ section.settings.offer_headline }}</p>

      <!-- Options -->
      <div class="pdpui__options" data-options>
        <!-- Subscription card -->
        <div class="pdpui__card is-active" data-card="sub">
          <div class="pdpui__cardHead" role="button" tabindex="0" aria-label="Select subscription" data-select="sub">
            <div class="pdpui__radio" aria-hidden="true"></div>

            <div>
              <div class="pdpui__titleRow">
                <div class="pdpui__title">{{ section.settings.sub_title }}</div>
                {% if section.settings.sub_badge != blank %}
                  <div class="pdpui__badge">{{ section.settings.sub_badge }}</div>
                {% endif %}
              </div>
              <div class="pdpui__sub">{{ section.settings.sub_subtitle }}</div>
            </div>

            <div class="pdpui__price">
              {% if section.settings.sub_compare != blank %}
                <span class="pdpui__compare">{{ section.settings.sub_compare }}</span>
              {% endif %}
              <span class="pdpui__now">{{ section.settings.sub_price }}</span>
              <div class="pdpui__per">{{ section.settings.sub_per }}</div>
            </div>
          </div>

          <div class="pdpui__benefits">
            {% if section.settings.sub_benefits != blank %}
              {{ section.settings.sub_benefits }}
            {% else %}
              <ul>
                <li>
                  <svg class="pdpui__check" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M7.8 14.6 3.6 10.4l1.4-1.4 2.8 2.8 7.2-7.2 1.4 1.4-8.6 8.6z"/></svg>
                  <span>Limited offer details…</span>
                </li>
                <li>
                  <svg class="pdpui__check" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M7.8 14.6 3.6 10.4l1.4-1.4 2.8 2.8 7.2-7.2 1.4 1.4-8.6 8.6z"/></svg>
                  <span>Pause or cancel anytime + money-back guarantee</span>
                </li>
              </ul>
            {% endif %}
          </div>
        </div>

        <div class="pdpui__or">OR</div>

        <!-- One-time card -->
        <div class="pdpui__card" data-card="once">
          <div class="pdpui__cardHead" role="button" tabindex="0" aria-label="Select one-time purchase" data-select="once">
            <div class="pdpui__radio" aria-hidden="true"></div>

            <div>
              <div class="pdpui__titleRow">
                <div class="pdpui__title">{{ section.settings.once_title }}</div>
              </div>
              <div class="pdpui__sub">{{ section.settings.once_subtitle }}</div>
            </div>

            <div class="pdpui__price">
              <span class="pdpui__now">{{ section.settings.once_price }}</span>
              <div class="pdpui__per">{{ section.settings.once_per }}</div>
            </div>
          </div>

          <div class="pdpui__benefits">
            {% if section.settings.once_note != blank %}
              {{ section.settings.once_note }}
            {% endif %}
          </div>
        </div>
      </div>

      <!-- CTA (UI only) -->
      <button class="pdpui__cta" type="button">
        {{ section.settings.cta_label }}
      </button>

      <div class="pdpui__ship">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M20 8h-3V4H3v13h2.2a3 3 0 0 0 5.6 0h6.4a3 3 0 0 0 5.6 0H24v-5l-4-4Zm-5 0H5V6h10v2Zm-7 11a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm12 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm2-4h-1.2a3 3 0 0 0-5.6 0H10.8a3 3 0 0 0-5.6 0H5V10h11v3h4.6l1.4 2Z"/></svg>
        <span>{{ section.settings.shipping_text }}</span>
      </div>

      {% if section.settings.disclaimer != blank %}
        <div class="pdpui__disc rte">{{ section.settings.disclaimer }}</div>
      {% endif %}
    </div>
  </div>

  <script>
    (function(){
      var root = document.getElementById('pdpui-{{ section.id }}');
      if(!root) return;

      // Tabs (UI only)
      var tabs = root.querySelectorAll('.pdpui__tab');
      tabs.forEach(function(t){
        t.addEventListener('click', function(){
          tabs.forEach(function(x){ x.setAttribute('aria-selected','false'); });
          t.setAttribute('aria-selected','true');
        });
      });

      // Option select (UI only)
      var cards = root.querySelectorAll('.pdpui__card');
      function activate(which){
        cards.forEach(function(c){
          c.classList.toggle('is-active', c.getAttribute('data-card') === which);
        });
      }

      root.querySelectorAll('[data-select]').forEach(function(el){
        el.addEventListener('click', function(){
          activate(el.getAttribute('data-select'));
        });
        el.addEventListener('keydown', function(e){
          if(e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activate(el.getAttribute('data-select'));
          }
        });
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "PDP Offer UI",
  "settings": [
    { "type": "header", "content": "Top row" },
    { "type": "text", "id": "reviews_text", "label": "Reviews text", "default": "50,000+ Verified 5-star reviews*" },

    { "type": "header", "content": "Tabs (UI only)" },
    { "type": "text", "id": "tab_a", "label": "Tab A", "default": "The Pouch" },
    { "type": "text", "id": "tab_b", "label": "Tab B", "default": "Travel Packs" },

    { "type": "header", "content": "Offer headline" },
    {
      "type": "text",
      "id": "offer_headline",
      "label": "Offer text",
      "default": "Our Best Offer Yet: First month for just 69€ instead of 87€ – plus Free Shipping and a premium Welcome Kit**"
    },

    { "type": "header", "content": "Subscription option (selected)" },
    { "type": "text", "id": "sub_title", "label": "Title", "default": "Single Subscription" },
    { "type": "text", "id": "sub_badge", "label": "Badge", "default": "MOST POPULAR" },
    { "type": "text", "id": "sub_subtitle", "label": "Subtitle", "default": "30 servings" },
    { "type": "text", "id": "sub_compare", "label": "Compare at", "default": "87€" },
    { "type": "text", "id": "sub_price", "label": "Price", "default": "69€" },
    { "type": "text", "id": "sub_per", "label": "Per serving", "default": "2,30 €/serving" },
    {
      "type": "richtext",
      "id": "sub_benefits",
      "label": "Benefits (richtext)",
      "default": "<ul><li>Limited offer details…</li><li>Pause or cancel anytime + money-back guarantee</li></ul>"
    },

    { "type": "header", "content": "One-time option" },
    { "type": "text", "id": "once_title", "label": "Title", "default": "One Time Purchase" },
    { "type": "text", "id": "once_subtitle", "label": "Subtitle", "default": "<p></p>" },
    { "type": "text", "id": "once_price", "label": "Price", "default": "107€" },
    { "type": "text", "id": "once_per", "label": "Per serving", "default": "2,2 €/serving" },
    { "type": "richtext", "id": "once_note", "label": "Note (optional)", "default": "<p></p>" },

    { "type": "header", "content": "CTA + footer" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Checkout" },
    { "type": "text", "id": "shipping_text", "label": "Shipping text", "default": "Free Shipping**" },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "<p>Discount applies to the first month when subscribing. Thereafter, monthly subscription will cost full price.</p>"
    },

    { "type": "header", "content": "Layout + colors" },
    { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 1000, "max": 1600, "step": 10, "default": 1400 },
    { "type": "range", "id": "pad_y", "label": "Vertical padding (px)", "min": 24, "max": 160, "step": 4, "default": 60 },
    { "type": "range", "id": "pad_x", "label": "Horizontal padding (px)", "min": 16, "max": 90, "step": 2, "default": 40 },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text", "label": "Text", "default": "#111111" },
    { "type": "color", "id": "muted", "label": "Muted text", "default": "#555555" },
    { "type": "color", "id": "accent", "label": "Accent (stars/selection)", "default": "#16c24a" },
    { "type": "color", "id": "cta_bg", "label": "CTA background", "default": "#0f3f3a" },
    { "type": "color", "id": "cta_text", "label": "CTA text", "default": "#ffffff" }
  ],
  "presets": [
    { "name": "PDP Offer UI" }
  ]
}
{% endschema %}
