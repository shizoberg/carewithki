{% comment %}.ki care bundle product page: actual Shopify product + editable subscription preset{% endcomment %}

{%- liquid
  assign bundle_variant = product.selected_or_first_available_variant
  assign preset_key = ''
  assign bundle_eyebrow = 'Hazır bakım paketi'
  assign bundle_summary = product.description | strip_html
  assign component_1 = nil
  assign component_2 = nil
  assign component_3 = nil
  assign component_1_label = 'Takviye'
  assign component_2_label = 'İntim bakım'
  assign component_3_label = 'Günlük ferahlık'

  case product.handle
    when 'ki-dongu-destek-paketi'
      assign preset_key = 'cycle'
      assign bundle_eyebrow = 'Döngü rutini'
      assign bundle_summary = 'Döngü desteği, regl dönemi bakımı ve gün boyu ferahlığı tek pakette birleştiren eksiksiz rutin.'
      assign component_1 = all_products['balance-your-cycle']
      assign component_2 = all_products['ki-flow-care-intim-bakim-jeli']
      assign component_3 = all_products['ki-intimate-intim-bakim-spreyi']
      assign component_1_label = 'Döngü desteği'
      assign component_2_label = 'Üriner sistem desteği'
    when 'ki-hassas-bakim-paketi'
      assign preset_key = 'sensitive'
      assign bundle_eyebrow = 'Hassas bakım rutini'
      assign bundle_summary = 'Hassas ciltlere uygun intim yıkama ve pratik ferahlık bakımını birlikte sunan sade rutin.'
      assign component_1 = all_products['ki-sens-care-intim-bakim-jeli']
      assign component_2 = all_products['ki-intimate-intim-bakim-spreyi']
      assign component_1_label = 'Hassas intim bakım'
      assign component_2_label = 'Günlük ferahlık'
    when 'ki-menopoz-bakim-paketi'
      assign preset_key = 'menopause'
      assign bundle_eyebrow = 'Menopoz bakım rutini'
      assign bundle_summary = 'Menopoz dönemine özel takviye, yoğun nem ve günlük ferahlık desteğini bir araya getiren rutin.'
      assign component_1 = all_products['change-is-good']
      assign component_2 = all_products['ki-50-care-intim-bakim-jeli']
      assign component_3 = all_products['ki-intimate-intim-bakim-spreyi']
      assign component_1_label = 'Menopoz desteği'
      assign component_2_label = '50+ yoğun bakım'
  endcase

  assign subscription_price = bundle_variant.price | times: 85 | divided_by: 100
-%}

<style>
.kicbp-{{ section.id }}{--p:#4d3ea7;--deep:#171238;--mut:#747080;--soft:#f5f3ff;background:#fff;color:var(--deep);padding:34px 24px 76px}.kicbp-{{ section.id }} *{box-sizing:border-box}.kicbp-{{ section.id }} .kicbp-shell{max-width:1260px;margin:0 auto}.kicbp-{{ section.id }} .kicbp-main{display:grid;grid-template-columns:minmax(0,1.03fr) minmax(390px,.97fr);gap:46px;align-items:start}.kicbp-{{ section.id }} .kicbp-visual{position:sticky;top:22px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;min-height:560px;padding:44px 34px;border-radius:28px;overflow:hidden;background:linear-gradient(142deg,#19143e 0%,#4f43a0 55%,#7569ce 100%);box-shadow:0 28px 70px rgba(35,27,89,.18)}.kicbp-{{ section.id }} .kicbp-visual:before{content:'';position:absolute;inset:-25%;background:radial-gradient(circle at 72% 38%,rgba(255,255,255,.2),transparent 31%);pointer-events:none}.kicbp-{{ section.id }} .kicbp-visual__item{position:relative;z-index:1;align-self:center;aspect-ratio:.78;border-radius:18px;overflow:hidden;background:#fff;box-shadow:0 18px 38px rgba(10,6,38,.27)}.kicbp-{{ section.id }} .kicbp-visual__item:nth-child(2){transform:translateY(-22px)}.kicbp-{{ section.id }} .kicbp-visual__item img,.kicbp-{{ section.id }} .kicbp-visual__item svg{width:100%;height:100%;display:block;object-fit:cover}.kicbp-{{ section.id }} .kicbp-copy{padding:18px 0 0}.kicbp-{{ section.id }} .kicbp-eyebrow{margin:0 0 13px;color:var(--p);font-size:11px;font-weight:850;letter-spacing:.16em;text-transform:uppercase}.kicbp-{{ section.id }} .kicbp-title{margin:0 0 15px;color:var(--deep);font:800 clamp(34px,4.7vw,62px)/1.02 'Raleway',system-ui,sans-serif;letter-spacing:-.045em}.kicbp-{{ section.id }} .kicbp-summary{margin:0 0 22px;color:var(--mut);font-size:15px;line-height:1.7}.kicbp-{{ section.id }} .kicbp-trust{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:24px}.kicbp-{{ section.id }} .kicbp-trust span{padding:7px 10px;border-radius:999px;background:var(--soft);color:var(--p);font-size:10px;font-weight:800}.kicbp-{{ section.id }} .kicbp-price-box{padding:19px;border:1px solid rgba(77,62,167,.15);border-radius:20px;background:#fff;box-shadow:0 12px 34px rgba(77,62,167,.08)}.kicbp-{{ section.id }} .kicbp-price-row{display:flex;align-items:end;justify-content:space-between;gap:18px;margin-bottom:15px}.kicbp-{{ section.id }} .kicbp-price-label{display:block;margin-bottom:5px;color:var(--mut);font-size:11px;font-weight:700}.kicbp-{{ section.id }} .kicbp-price{color:var(--p);font-size:30px;font-weight:900}.kicbp-{{ section.id }} .kicbp-sub-price{text-align:right;color:#277653;font-size:12px;font-weight:700}.kicbp-{{ section.id }} .kicbp-sub-price strong{display:block;font-size:18px}.kicbp-{{ section.id }} .kicbp-actions{display:grid;gap:9px}.kicbp-{{ section.id }} .kicbp-atc,.kicbp-{{ section.id }} .kicbp-subscribe{display:flex;align-items:center;justify-content:center;min-height:52px;padding:12px 18px;border-radius:14px;font:800 13px/1 system-ui,sans-serif;text-decoration:none;cursor:pointer}.kicbp-{{ section.id }} .kicbp-atc{width:100%;border:0;background:var(--p);color:#fff}.kicbp-{{ section.id }} .kicbp-atc:disabled{background:#c9c6d8;cursor:not-allowed}.kicbp-{{ section.id }} .kicbp-subscribe{border:1.5px solid var(--p);background:#fff;color:var(--p)}.kicbp-{{ section.id }} .kicbp-note{margin:10px 0 0;text-align:center;color:var(--mut);font-size:10px}.kicbp-{{ section.id }} .kicbp-section-head{margin:54px 0 19px;text-align:center}.kicbp-{{ section.id }} .kicbp-section-head span{color:var(--p);font-size:10px;font-weight:850;letter-spacing:.15em}.kicbp-{{ section.id }} .kicbp-section-head h2{margin:7px 0 5px;font:800 clamp(24px,3vw,36px)/1.1 'Raleway',system-ui,sans-serif}.kicbp-{{ section.id }} .kicbp-section-head p{margin:0;color:var(--mut);font-size:13px}.kicbp-{{ section.id }} .kicbp-components{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.kicbp-{{ section.id }} .kicbp-component{display:grid;grid-template-columns:100px 1fr;gap:13px;align-items:center;padding:13px;border:1px solid rgba(77,62,167,.12);border-radius:18px;background:#fff;box-shadow:0 6px 20px rgba(77,62,167,.06)}.kicbp-{{ section.id }} .kicbp-component__image{display:block;aspect-ratio:1;border-radius:13px;overflow:hidden;background:var(--soft)}.kicbp-{{ section.id }} .kicbp-component__image img,.kicbp-{{ section.id }} .kicbp-component__image svg{width:100%;height:100%;object-fit:cover;display:block}.kicbp-{{ section.id }} .kicbp-component__copy{min-width:0}.kicbp-{{ section.id }} .kicbp-component__copy span{display:block;margin-bottom:4px;color:#9b92c7;font-size:8px;font-weight:850;letter-spacing:.09em;text-transform:uppercase}.kicbp-{{ section.id }} .kicbp-component__copy a{display:block;color:var(--deep);font-size:12px;font-weight:800;line-height:1.35;text-decoration:none}.kicbp-{{ section.id }} .kicbp-component__copy strong{display:block;margin-top:6px;color:var(--p);font-size:12px}.kicbp-{{ section.id }} .kicbp-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:22px}.kicbp-{{ section.id }} .kicbp-step{padding:16px;border-radius:17px;background:var(--soft)}.kicbp-{{ section.id }} .kicbp-step b{display:flex;align-items:center;justify-content:center;width:28px;height:28px;margin-bottom:10px;border-radius:50%;background:var(--p);color:#fff;font-size:11px}.kicbp-{{ section.id }} .kicbp-step strong{display:block;margin-bottom:4px;font-size:12px}.kicbp-{{ section.id }} .kicbp-step span{color:var(--mut);font-size:10px;line-height:1.45}
@media(max-width:900px){.kicbp-{{ section.id }} .kicbp-main{grid-template-columns:1fr;gap:24px}.kicbp-{{ section.id }} .kicbp-visual{position:relative;top:auto;min-height:430px}.kicbp-{{ section.id }} .kicbp-components{grid-template-columns:1fr 1fr}}
@media(max-width:749px){.kicbp-{{ section.id }}{padding:14px 14px 48px}.kicbp-{{ section.id }} .kicbp-main{gap:18px}.kicbp-{{ section.id }} .kicbp-visual{min-height:285px;padding:27px 20px;border-radius:20px;gap:6px}.kicbp-{{ section.id }} .kicbp-visual__item{border-radius:11px}.kicbp-{{ section.id }} .kicbp-visual__item:nth-child(2){transform:translateY(-12px)}.kicbp-{{ section.id }} .kicbp-copy{padding-top:0}.kicbp-{{ section.id }} .kicbp-title{font-size:34px}.kicbp-{{ section.id }} .kicbp-summary{font-size:13px;margin-bottom:15px}.kicbp-{{ section.id }} .kicbp-price-box{padding:14px;border-radius:16px}.kicbp-{{ section.id }} .kicbp-price{font-size:24px}.kicbp-{{ section.id }} .kicbp-components{grid-template-columns:1fr;gap:9px}.kicbp-{{ section.id }} .kicbp-component{grid-template-columns:72px 1fr;padding:9px}.kicbp-{{ section.id }} .kicbp-steps{grid-template-columns:repeat(3,1fr);gap:7px}.kicbp-{{ section.id }} .kicbp-step{padding:11px 9px}.kicbp-{{ section.id }} .kicbp-step span{font-size:9px}.kicbp-{{ section.id }} .kicbp-section-head{margin-top:36px}}
</style>

<section class="kicbp-{{ section.id }}">
  <div class="kicbp-shell">
    <div class="kicbp-main">
      <div class="kicbp-visual" aria-label="Paket içeriği görselleri">
        {%- for media in product.media limit: 3 -%}
          <div class="kicbp-visual__item">{{ media.preview_image | image_url: width: 760 | image_tag: loading: 'eager', alt: product.title }}</div>
        {%- else -%}
          {%- if component_1 != blank -%}<div class="kicbp-visual__item">{{ component_1.featured_image | image_url: width: 620 | image_tag: loading: 'eager', alt: component_1.title }}</div>{%- endif -%}
          {%- if component_2 != blank -%}<div class="kicbp-visual__item">{{ component_2.featured_image | image_url: width: 620 | image_tag: loading: 'eager', alt: component_2.title }}</div>{%- endif -%}
          {%- if component_3 != blank -%}<div class="kicbp-visual__item">{{ component_3.featured_image | image_url: width: 620 | image_tag: loading: 'eager', alt: component_3.title }}</div>{%- endif -%}
        {%- endfor -%}
      </div>
      <div class="kicbp-copy">
        <p class="kicbp-eyebrow">{{ bundle_eyebrow | escape }}</p><h1 class="kicbp-title">{{ product.title | escape }}</h1><p class="kicbp-summary">{{ bundle_summary | escape }}</p>
        <div class="kicbp-trust"><span>Uzman eczacı yaklaşımı</span><span>Tek pakette eksiksiz rutin</span><span>Abonelikte %15 avantaj</span></div>
        <div class="kicbp-price-box">
          <div class="kicbp-price-row"><div><span class="kicbp-price-label">Tek seferlik paket fiyatı</span><strong class="kicbp-price">{{ bundle_variant.price | money }}</strong></div><div class="kicbp-sub-price"><span>Abonelikte yaklaşık</span><strong>{{ subscription_price | money }}</strong></div></div>
          <div class="kicbp-actions">
            {%- form 'product', product -%}<input type="hidden" name="id" value="{{ bundle_variant.id }}"><button class="kicbp-atc" type="submit"{% unless bundle_variant.available %} disabled{% endunless %}>{% if bundle_variant.available %}Paketi Sepete Ekle{% else %}Stokta Yok{% endif %}</button>{%- endform -%}
            {%- if preset_key != blank -%}<a class="kicbp-subscribe" href="/pages/paket-olustur?preset={{ preset_key | url_encode }}">Abone ol · Paketi hazır seçili aç →</a>{%- endif -%}
          </div>
          <p class="kicbp-note">Tek seferlik alımda bu paket ürün olarak sepete eklenir. Abonelikte içeriği ve gönderim sıklığını değiştirebilirsin.</p>
        </div>
      </div>
    </div>
    <div class="kicbp-section-head"><span>PAKETİNDE NELER VAR?</span><h2>Birlikte çalışan bakım rutini</h2><p>Her ürün kendi ihtiyacına odaklanır; paket içinde tamamlayıcı bir rutin oluşturur.</p></div>
    <div class="kicbp-components">{% render 'ki-care-bundle-component', component_product: component_1, component_label: component_1_label %}{% render 'ki-care-bundle-component', component_product: component_2, component_label: component_2_label %}{% render 'ki-care-bundle-component', component_product: component_3, component_label: component_3_label %}</div>
    <div class="kicbp-steps"><div class="kicbp-step"><b>1</b><strong>Paketi seç</strong><span>Tek seferlik satın al veya aboneliğe geç.</span></div><div class="kicbp-step"><b>2</b><strong>Rutini düzenle</strong><span>Abonelikte ürün ve gönderim sıklığını değiştir.</span></div><div class="kicbp-step"><b>3</b><strong>Kapına gelsin</strong><span>Bakım rutinin planladığın zamanda hazırlansın.</span></div></div>
  </div>
</section>

{% schema %}
{"name":"Bakım Paket Ürünü (.ki)","tag":"section","class":"section","settings":[],"presets":[{"name":"Bakım Paket Ürünü (.ki)"}]}
{% endschema %}
