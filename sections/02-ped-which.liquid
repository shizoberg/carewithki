{% comment %}
  Which Pad — "Senin için en uygun .ki Ped hangisi?"
  Pozisyon: Pedler #2
  3 ped kartı (görsel + isim + emicilik damlaları + açıklama + ekle butonu)
{% endcomment %}

<section id="which-pad-{{ section.id }}" class="section which-pad">
  <style>
    #which-pad-{{ section.id }} {
      --w-bg: {{ section.settings.bg | default: '#f4ede1' }};
      --w-card: #ffffff;
      --w-primary: {{ section.settings.primary_color | default: '#3a2d6e' }};
      --w-primary-fg: #ffffff;
      --w-rose: {{ section.settings.rose_color | default: '#d96d8a' }};
      --w-rose-light: {{ section.settings.rose_light | default: '#f6dce4' }};
      --w-border: rgba(0,0,0,.12);
      background: var(--w-bg);
      border-block: 1px solid var(--w-border);
      padding: 56px 0;
      font-family: system-ui, -apple-system, sans-serif;
    }

    #which-pad-{{ section.id }} .w-wrap {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 20px;
    }

    #which-pad-{{ section.id }} .w-head {
      max-width: 640px;
      margin: 0 auto 40px;
      text-align: center;
    }
    #which-pad-{{ section.id }} .w-eyebrow {
      display: block;
      font-size: 12px; font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .2em;
      color: var(--w-rose);
      margin-bottom: 12px;
    }
    #which-pad-{{ section.id }} .w-title {
      font-size: 28px; line-height: 1.1;
      letter-spacing: -.02em;
      font-weight: 500;
      color: var(--w-primary);
      margin: 0;
    }
    #which-pad-{{ section.id }} .w-desc {
      font-size: 14.5px; line-height: 1.6;
      color: rgba(26,26,26,.7);
      margin: 16px 0 0;
    }

    #which-pad-{{ section.id }} .w-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
    }

    #which-pad-{{ section.id }} .w-card {
      display: flex; flex-direction: column;
      background: var(--w-card);
      border: 1px solid var(--w-border);
      border-radius: 24px;
      overflow: hidden;
      transition: box-shadow .3s ease;
    }
    #which-pad-{{ section.id }} .w-card:hover { box-shadow: 0 8px 28px -16px rgba(0,0,0,.18); }

    #which-pad-{{ section.id }} .w-card-img {
      aspect-ratio: 1/1;
      background: var(--w-rose-light);
      overflow: hidden;
    }
    #which-pad-{{ section.id }} .w-card-img img {
      width: 100%; height: 100%;
      object-fit: cover;
      transition: transform .5s ease;
    }
    #which-pad-{{ section.id }} .w-card:hover .w-card-img img { transform: scale(1.04); }

    #which-pad-{{ section.id }} .w-card-body {
      display: flex; flex-direction: column; flex: 1;
      padding: 20px;
    }
    #which-pad-{{ section.id }} .w-card-head {
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px;
    }
    #which-pad-{{ section.id }} .w-card-name {
      font-size: 20px; font-weight: 500;
      color: var(--w-primary);
      margin: 0;
    }
    #which-pad-{{ section.id }} .w-drops {
      display: inline-flex; align-items: center; gap: 1px;
    }
    #which-pad-{{ section.id }} .w-drops svg {
      width: 12px; height: 12px;
      color: var(--w-border);
    }
    #which-pad-{{ section.id }} .w-drops svg.is-on { color: var(--w-rose); }
    #which-pad-{{ section.id }} .w-card-text {
      font-size: 13.5px; line-height: 1.6;
      color: rgba(26,26,26,.7);
      margin: 8px 0 0;
    }
    #which-pad-{{ section.id }} .w-card-foot {
      margin-top: 20px;
      display: flex; align-items: center; justify-content: space-between;
      gap: 12px;
    }
    #which-pad-{{ section.id }} .w-card-meta {
      font-size: 12.5px; font-weight: 600;
      color: rgba(58,45,110,.8);
    }
    #which-pad-{{ section.id }} .w-card-cta {
      display: inline-flex; align-items: center; gap: 6px;
      background: var(--w-primary);
      color: var(--w-primary-fg);
      font-size: 12.5px; font-weight: 600;
      padding: 8px 16px;
      border-radius: 999px;
      border: 0; cursor: pointer;
      text-decoration: none;
    }
    #which-pad-{{ section.id }} .w-card-cta svg { width: 14px; height: 14px; }

    @media (min-width: 640px) {
      #which-pad-{{ section.id }} { padding: 80px 0; }
      #which-pad-{{ section.id }} .w-wrap { padding: 0 32px; }
      #which-pad-{{ section.id }} .w-title { font-size: 36px; }
      #which-pad-{{ section.id }} .w-card-body { padding: 24px; }
    }
    @media (min-width: 768px) {
      #which-pad-{{ section.id }} .w-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
      }
    }
    @media (min-width: 1024px) {
      #which-pad-{{ section.id }} .w-title { font-size: 44px; }
      #which-pad-{{ section.id }} .w-grid { gap: 24px; }
    }
  </style>

  <div class="w-wrap">
    <div class="w-head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="w-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="w-title">{{ section.settings.heading | default: 'Senin için en uygun .ki Ped hangisi?' }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="w-desc">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="w-grid">
      {%- for block in section.blocks -%}
        <article class="w-card" {{ block.shopify_attributes }}>
          <div class="w-card-img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: alt: block.settings.name, loading: 'lazy' }}
            {%- endif -%}
          </div>
          <div class="w-card-body">
            <div class="w-card-head">
              <h3 class="w-card-name">{{ block.settings.name }}</h3>
              <span class="w-drops" aria-label="{{ block.settings.drops }}/4 emicilik">
                {%- assign drops = block.settings.drops | plus: 0 -%}
                {%- for i in (1..4) -%}
                  <svg viewBox="0 0 24 24" fill="currentColor" class="{% if forloop.index <= drops %}is-on{% endif %}"><path d="M12 2.5s7 8.2 7 13a7 7 0 1 1-14 0c0-4.8 7-13 7-13z"/></svg>
                {%- endfor -%}
              </span>
            </div>
            <p class="w-card-text">{{ block.settings.description }}</p>
            <div class="w-card-foot">
              <span class="w-card-meta">{{ block.settings.size }} · {{ block.settings.per_box }} adet / paket</span>
              <a href="{{ block.settings.cta_link | default: '#' }}" class="w-card-cta">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
                {{ block.settings.cta_label | default: 'Ekle' }}
              </a>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Which Pad",
  "tag": "section",
  "class": "which-pad",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket", "default": "Sana Özel" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Senin için en uygun .ki Ped hangisi?" },
    { "type": "textarea", "id": "description", "label": "Açıklama", "default": "Akış seviyene göre 3 farklı emicilik. Tek bir pakette istediğin gibi karıştır." },
    { "type": "color", "id": "bg", "label": "Arka plan", "default": "#f4ede1" },
    { "type": "color", "id": "primary_color", "label": "Primary", "default": "#3a2d6e" },
    { "type": "color", "id": "rose_color", "label": "Rose (üst etiket / damla)", "default": "#d96d8a" },
    { "type": "color", "id": "rose_light", "label": "Rose light (kart görsel arkaplanı)", "default": "#f6dce4" }
  ],
  "blocks": [
    {
      "type": "pad",
      "name": "Ped kartı",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Görsel" },
        { "type": "text", "id": "name", "label": "Ped adı", "default": "Günlük Ped" },
        { "type": "range", "id": "drops", "label": "Emicilik (1-4)", "min": 1, "max": 4, "step": 1, "default": 1 },
        { "type": "textarea", "id": "description", "label": "Açıklama" },
        { "type": "text", "id": "size", "label": "Boyut", "default": "155 mm" },
        { "type": "number", "id": "per_box", "label": "Paket başına adet", "default": 30 },
        { "type": "text", "id": "cta_label", "label": "CTA metni", "default": "Ekle" },
        { "type": "url", "id": "cta_link", "label": "CTA linki" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Which Pad",
      "blocks": [
        { "type": "pad", "settings": { "name": "Günlük Ped", "drops": 1, "size": "155 mm", "per_box": 30 } },
        { "type": "pad", "settings": { "name": "Gündüz Pedi", "drops": 3, "size": "245 mm", "per_box": 12 } },
        { "type": "pad", "settings": { "name": "Gece Pedi", "drops": 4, "size": "335 mm", "per_box": 8 } }
      ]
    }
  ]
}
{% endschema %}
