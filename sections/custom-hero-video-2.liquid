{% comment %}
  .ki Hero Slider v3 — Premium
  + Mobilde tam ekran video + overlay metin
  + Progress bar (nokta yerine)
  + Sol/sag ok navigasyonu (desktop)
  + Scroll down bounce animasyonu
  + Her slide icin overlay opasite ayari
  + Slide degisince baslik/aciklama fade-in animasyonu
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;600;700;800&display=swap" rel="stylesheet">

<style>
.khs2-{{ section.id }} {
  --p:    #493d9a;
  --lil:  #dad2ff;
  --off:  #f8f8f6;
  position: relative;
  width: 100%;
  background: #111;
  overflow: hidden;
}

/* ── Track ── */
.khs2-{{ section.id }} .khs2-track {
  display: flex;
  width: 100%;
  will-change: transform;
}
.khs2-{{ section.id }} .khs2-slide {
  flex: 0 0 100%;
  width: 100%;
  position: relative;
}

/* ── Media ── */
.khs2-{{ section.id }} .khs2-media {
  position: relative;
  width: 100%;
  height: 92vh;
  min-height: 560px;
  overflow: hidden;
}
@media (max-width: 749px) {
  .khs2-{{ section.id }} .khs2-media {
    height: 100svh;
    min-height: 100svh;
  }
}
.khs2-{{ section.id }} .khs2-media video,
.khs2-{{ section.id }} .khs2-media img {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
}
/* Ken Burns subtle zoom on image slides */
.khs2-{{ section.id }} .khs2-slide.is-active .khs2-media img {
  animation: khs2-zoom-{{ section.id }} 8s ease-out forwards;
}
@keyframes khs2-zoom-{{ section.id }} {
  from { transform: scale(1.06); }
  to   { transform: scale(1.0); }
}

/* ── Overlay ── */
.khs2-{{ section.id }} .khs2-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  /* default; overridden per-slide via inline style */
  background: linear-gradient(
    105deg,
    rgba(30,18,80,0.72) 0%,
    rgba(73,61,154,0.38) 50%,
    rgba(0,0,0,0.10) 100%
  );
}
/* Bottom fade for progress bar readability */
.khs2-{{ section.id }} .khs2-overlay::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 120px;
  background: linear-gradient(to top, rgba(0,0,0,0.45) 0%, transparent 100%);
}

/* ── Content ── */
.khs2-{{ section.id }} .khs2-content {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  align-items: center;
  pointer-events: none;
}
.khs2-{{ section.id }} .khs2-inner {
  pointer-events: auto;
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 4rem;
}
@media (max-width: 749px) {
  .khs2-{{ section.id }} .khs2-inner {
    padding: 0 22px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
}

/* Text enter animation */
.khs2-{{ section.id }} .khs2-text-wrap {
  opacity: 0;
  transform: translateY(22px);
  transition: opacity 0.7s ease, transform 0.7s ease;
}
.khs2-{{ section.id }} .khs2-slide.is-active .khs2-text-wrap {
  opacity: 1;
  transform: translateY(0);
}

/* Badge */
.khs2-{{ section.id }} .khs2-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,0.14);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.22);
  color: #fff;
  padding: 5px 14px;
  border-radius: 50px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  margin-bottom: 18px;
  width: fit-content;
}
.khs2-{{ section.id }} .khs2-badge svg {
  width: 12px; height: 12px; opacity: 0.85;
}

/* Title */
.khs2-{{ section.id }} .khs2-title {
  font-family: 'Raleway', system-ui, sans-serif;
  font-size: clamp(30px, 4.5vw, 60px);
  font-weight: 800;
  line-height: 1.08;
  color: #fff;
  margin: 0 0 18px;
  max-width: 600px;
  letter-spacing: -0.02em;
  text-shadow: 0 2px 24px rgba(0,0,0,0.28);
}
@media (max-width: 749px) {
  .khs2-{{ section.id }} .khs2-title {
    font-size: clamp(26px, 8vw, 38px);
    max-width: 100%;
  }
}

/* Description */
.khs2-{{ section.id }} .khs2-desc {
  font-size: clamp(14px, 1.2vw, 18px);
  line-height: 1.6;
  color: rgba(255,255,255,0.88);
  margin: 0 0 32px;
  max-width: 500px;
  text-shadow: 0 1px 8px rgba(0,0,0,0.2);
}
@media (max-width: 749px) {
  .khs2-{{ section.id }} .khs2-desc { font-size: 14px; max-width: 100%; margin-bottom: 24px; }
}

/* Button */
.khs2-{{ section.id }} .khs2-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 15px 32px;
  border-radius: 50px;
  background: #fff;
  color: var(--p);
  font-weight: 800;
  font-size: 15px;
  text-decoration: none;
  transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
  box-shadow: 0 4px 20px rgba(0,0,0,0.22);
  border: none;
  cursor: pointer;
}
.khs2-{{ section.id }} .khs2-btn:hover {
  background: var(--lil);
  color: var(--p);
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(0,0,0,0.28);
}
.khs2-{{ section.id }} .khs2-btn svg {
  width: 16px; height: 16px;
  transition: transform 0.2s;
}
.khs2-{{ section.id }} .khs2-btn:hover svg { transform: translateX(3px); }
@media (max-width: 749px) {
  .khs2-{{ section.id }} .khs2-btn { padding: 13px 26px; font-size: 14px; }
}

/* ── Arrow nav (desktop) ── */
.khs2-{{ section.id }} .khs2-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  width: 48px; height: 48px;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.25);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s;
  opacity: 0;
  pointer-events: none;
}
.khs2-{{ section.id }}:hover .khs2-arrow {
  opacity: 1;
  pointer-events: auto;
}
.khs2-{{ section.id }} .khs2-arrow:hover {
  background: rgba(255,255,255,0.28);
  transform: translateY(-50%) scale(1.08);
}
.khs2-{{ section.id }} .khs2-arrow svg { width: 20px; height: 20px; }
.khs2-{{ section.id }} .khs2-arrow--prev { left: 24px; }
.khs2-{{ section.id }} .khs2-arrow--next { right: 24px; }
@media (max-width: 749px) {
  .khs2-{{ section.id }} .khs2-arrow { display: none; }
}

/* ── Progress bar ── */
.khs2-{{ section.id }} .khs2-progress-wrap {
  position: absolute;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  display: flex;
  gap: 8px;
  align-items: center;
}
.khs2-{{ section.id }} .khs2-progress-item {
  width: 40px; height: 3px;
  border-radius: 2px;
  background: rgba(255,255,255,0.28);
  overflow: hidden;
  cursor: pointer;
  transition: width 0.2s;
}
.khs2-{{ section.id }} .khs2-progress-item.is-active {
  width: 72px;
}
.khs2-{{ section.id }} .khs2-progress-fill {
  height: 100%;
  width: 0%;
  background: #fff;
  border-radius: 2px;
  transition: none;
}
.khs2-{{ section.id }} .khs2-progress-item.is-active .khs2-progress-fill {
  transition: width linear;
}
@media (max-width: 749px) {
  .khs2-{{ section.id }} .khs2-progress-wrap { bottom: 20px; }
  .khs2-{{ section.id }} .khs2-progress-item { width: 28px; }
  .khs2-{{ section.id }} .khs2-progress-item.is-active { width: 52px; }
}

/* ── Scroll down bounce ── */
.khs2-{{ section.id }} .khs2-scroll-cue {
  position: absolute;
  bottom: 32px;
  right: 40px;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  color: rgba(255,255,255,0.65);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  animation: khs2-bounce-{{ section.id }} 2s ease-in-out infinite;
  cursor: pointer;
  text-decoration: none;
}
.khs2-{{ section.id }} .khs2-scroll-cue svg {
  width: 20px; height: 20px;
}
@keyframes khs2-bounce-{{ section.id }} {
  0%, 100% { transform: translateY(0); opacity: 0.65; }
  50%       { transform: translateY(7px); opacity: 1; }
}
@media (max-width: 749px) {
  .khs2-{{ section.id }} .khs2-scroll-cue { right: 16px; bottom: 24px; }
}
</style>

{%- assign slide_count = section.blocks.size -%}
{%- assign spd = section.settings.change_slides_speed | default: 5 -%}

<section
  class="khs2-{{ section.id }}"
  id="KHS2-{{ section.id }}"
  data-autoplay="{{ section.settings.auto_rotate }}"
  data-speed="{{ spd }}"
  data-total="{{ slide_count }}"
>

  <!-- Track -->
  <div class="khs2-track" id="KHS2Track-{{ section.id }}">
    {%- for block in section.blocks -%}
      {%- assign opa = block.settings.overlay_opacity | default: 55 | times: 0.01 -%}
      <div
        class="khs2-slide{% if forloop.first %} is-active{% endif %}"
        id="KHS2Slide-{{ section.id }}-{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        <!-- Media -->
        <div class="khs2-media">
          {%- if block.settings.video != blank -%}
            {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1920 | image_tag: loading: 'eager', decoding: 'async', alt: block.settings.title }}
          {%- else -%}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <!-- Overlay -->
        <div class="khs2-overlay" style="opacity: {{ opa }};"></div>

        <!-- Content -->
        <div class="khs2-content">
          <div class="khs2-inner">
            <div class="khs2-text-wrap">
              {%- if block.settings.badge != blank -%}
                <div class="khs2-badge">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                  {{ block.settings.badge | escape }}
                </div>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h1 class="khs2-title">{{ block.settings.title }}</h1>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="khs2-desc">{{ block.settings.description | escape }}</p>
              {%- endif -%}
              {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                <a href="{{ block.settings.button_link }}" class="khs2-btn">
                  {{ block.settings.button_text | escape }}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>

      </div>
    {%- endfor -%}
  </div>

  <!-- Arrow prev -->
  {%- if slide_count > 1 -%}
  <button class="khs2-arrow khs2-arrow--prev" id="KHS2Prev-{{ section.id }}" aria-label="Önceki slide" type="button">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  </button>
  <!-- Arrow next -->
  <button class="khs2-arrow khs2-arrow--next" id="KHS2Next-{{ section.id }}" aria-label="Sonraki slide" type="button">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
  </button>

  <!-- Progress bar -->
  <div class="khs2-progress-wrap" id="KHS2Progress-{{ section.id }}">
    {%- for block in section.blocks -%}
      <div class="khs2-progress-item{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}">
        <div class="khs2-progress-fill"></div>
      </div>
    {%- endfor -%}
  </div>
  {%- endif -%}

  <!-- Scroll cue -->
  {%- if section.settings.show_scroll_cue -%}
  <a class="khs2-scroll-cue" href="#" onclick="window.scrollBy({top: window.innerHeight * 0.85, behavior: 'smooth'}); return false;" aria-label="Aşağı kaydır">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
  </a>
  {%- endif -%}

</section>

<script>
(function(){
  var sid    = '{{ section.id }}';
  var root   = document.getElementById('KHS2-' + sid);
  if (!root) return;

  var total    = parseInt(root.dataset.total, 10) || 0;
  var autoplay = root.dataset.autoplay === 'true';
  var spd      = (parseInt(root.dataset.speed, 10) || 5) * 1000;
  if (total < 2) return;

  var track      = document.getElementById('KHS2Track-' + sid);
  var progressWr = document.getElementById('KHS2Progress-' + sid);
  var prevBtn    = document.getElementById('KHS2Prev-' + sid);
  var nextBtn    = document.getElementById('KHS2Next-' + sid);

  var current = 0;
  var timer   = null;
  var fillTimer = null;

  /* Slides & progress items */
  var slides   = track ? Array.from(track.querySelectorAll('.khs2-slide')) : [];
  var progItems = progressWr ? Array.from(progressWr.querySelectorAll('.khs2-progress-item')) : [];

  function goTo(idx, dir) {
    var prev = current;
    current = (idx + total) % total;
    if (prev === current) return;

    /* Slide classes */
    slides.forEach(function(s, i) {
      s.classList.toggle('is-active', i === current);
    });

    /* Track translate */
    if (track) {
      track.style.transition = 'transform 0.7s cubic-bezier(0.4,0,0.2,1)';
      track.style.transform  = 'translateX(-' + (current * 100) + '%)';
    }

    /* Video management */
    slides.forEach(function(s, i) {
      var vid = s.querySelector('video');
      if (!vid) return;
      if (i === current) { vid.currentTime = 0; vid.play().catch(function(){}); }
      else { vid.pause(); }
    });

    /* Progress */
    startProgress();
  }

  function startProgress() {
    clearInterval(fillTimer);

    progItems.forEach(function(item, i) {
      item.classList.toggle('is-active', i === current);
      var fill = item.querySelector('.khs2-progress-fill');
      if (fill) {
        fill.style.transition = 'none';
        fill.style.width = '0%';
      }
    });

    /* Animate active fill */
    var activeItem = progItems[current];
    if (!activeItem) return;
    var fill = activeItem.querySelector('.khs2-progress-fill');
    if (!fill) return;

    /* small delay so transition: none takes effect */
    requestAnimationFrame(function(){
      requestAnimationFrame(function(){
        fill.style.transition = 'width ' + spd + 'ms linear';
        fill.style.width = '100%';
      });
    });
  }

  function startAutoplay() {
    if (!autoplay) return;
    clearInterval(timer);
    timer = setInterval(function(){ goTo(current + 1); }, spd);
  }

  function stopAutoplay() { clearInterval(timer); }

  /* Arrow clicks */
  if (prevBtn) prevBtn.addEventListener('click', function(){ stopAutoplay(); goTo(current - 1); startAutoplay(); });
  if (nextBtn) nextBtn.addEventListener('click', function(){ stopAutoplay(); goTo(current + 1); startAutoplay(); });

  /* Progress item clicks */
  progItems.forEach(function(item) {
    item.addEventListener('click', function(){
      stopAutoplay();
      goTo(parseInt(item.dataset.index, 10));
      startAutoplay();
    });
  });

  /* Touch swipe */
  var touchStartX = 0;
  root.addEventListener('touchstart', function(e){ touchStartX = e.changedTouches[0].clientX; }, { passive: true });
  root.addEventListener('touchend', function(e){
    var diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 44) {
      stopAutoplay();
      goTo(diff > 0 ? current + 1 : current - 1);
      startAutoplay();
    }
  }, { passive: true });

  /* Keyboard */
  document.addEventListener('keydown', function(e){
    if (e.key === 'ArrowLeft')  { stopAutoplay(); goTo(current - 1); startAutoplay(); }
    if (e.key === 'ArrowRight') { stopAutoplay(); goTo(current + 1); startAutoplay(); }
  });

  /* Init */
  goTo(0);
  startAutoplay();

  /* Theme editor */
  document.addEventListener('shopify:section:select', function(e){
    if (e.detail.sectionId === sid) { stopAutoplay(); goTo(0); }
  });
})();
</script>

{% schema %}
{
  "name": "Hero Slider v2 (.ki)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Otomatik Kaydırma"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Otomatik kaydır",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Geçiş hızı",
      "default": 6
    },
    {
      "type": "header",
      "content": "Scroll Cue"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_cue",
      "label": "Scroll down okunu göster",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        {
          "type": "header",
          "content": "Medya"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Video varsa görsel kullanılmaz."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Görsel (video yoksa)"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 10,
          "max": 90,
          "step": 5,
          "unit": "%",
          "label": "Overlay koyu luk",
          "default": 55,
          "info": "Metni okunaklı kılacak kadar ayarla."
        },
        {
          "type": "header",
          "content": "İçerik"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Rozet (opsiyonel)",
          "info": "Videonun üstünde küçük etiket. Örn: Yeni Ürün"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Başlık",
          "default": "Önce Kendine İyi Bak"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Açıklama",
          "default": "Modern Kadın Sağlığı Çözümleri"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Buton metni",
          "default": "Ürünleri Gör"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Buton linki"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider v2 (.ki)",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
