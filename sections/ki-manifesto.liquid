{% comment %}
  .ki Manifesto (scoped) — Brand Kit
  Centered brand manifesto with optional body + signature.

  Brand kit:
    #493d9a (main)
    #f8f8f6 (offwhite)
    #b2a5ff (primary)
    #dad2ff (lilac)
{% endcomment %}

<section id="kmf-{{ section.id }}" class="section">
  <style>
    #kmf-{{ section.id }}{
      --ki-purple-dark: #493d9a;
      --ki-offwhite: #f8f8f6;
      --ki-purple: #b2a5ff;
      --ki-lilac: #dad2ff;

      --bg: {{ section.settings.bg | default: '#493d9a' }};
      --text: {{ section.settings.text | default: '#ffffff' }};

      --maxw: {{ section.settings.max_width | default: 900 }}px;
      --py: {{ section.settings.pad_y | default: 104 }}px;
      --px: {{ section.settings.pad_x | default: 40 }}px;

      background: var(--bg);
      color: var(--text);
    }
    #kmf-{{ section.id }} .kmf__wrap{ max-width: var(--maxw); margin: 0 auto; padding: var(--py) var(--px); text-align: center; }
    #kmf-{{ section.id }} .kmf__eyebrow{
      display: inline-block; font-size: 11px; font-weight: 700;
      letter-spacing: 1.8px; text-transform: uppercase; color: inherit;
      padding: 6px 14px; border-radius: 999px;
      background: rgba(255,255,255,.12); margin: 0 0 22px;
    }
    #kmf-{{ section.id }} .kmf__heading{
      font-size: clamp(30px,5vw,52px); font-weight: 650; letter-spacing: -0.02em;
      line-height: 1.15; margin: 0; color: inherit;
      text-shadow: 0 10px 26px rgba(0,0,0,.18);
    }
    #kmf-{{ section.id }} .kmf__body{
      margin-top: 22px; font-size: 17px; line-height: 1.75; opacity: 0.88;
    }
    #kmf-{{ section.id }} .kmf__body a{ color: inherit; text-decoration: underline; text-underline-offset: 3px; }
    #kmf-{{ section.id }} .kmf__sig{
      margin-top: 28px; font-style: italic; opacity: 0.75; font-size: 15px;
    }
    @media (max-width: 990px){
      #kmf-{{ section.id }} .kmf__wrap{ padding: 72px 20px; }
    }
    @media (max-width: 750px){
      #kmf-{{ section.id }} .kmf__wrap{ padding: 52px 16px; }
      #kmf-{{ section.id }} .kmf__body{ font-size: 15px; }
    }
  </style>

  <div class="kmf__wrap">
    {% if section.settings.eyebrow != blank %}
      <span class="kmf__eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="kmf__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <div class="kmf__body rte">{{ section.settings.body }}</div>
    {% endif %}
    {% if section.settings.signature != blank %}
      <div class="kmf__sig">— {{ section.settings.signature }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": ".ki Manifesto",
  "tag": "section",
  "settings": [
    { "type": "text",     "id": "eyebrow",   "label": "Üst etiket", "default": "MANİFESTO" },
    { "type": "text",     "id": "heading",   "label": "Manifesto",  "default": "Döngün, kendini dinleme zamanın." },
    { "type": "richtext", "id": "body",      "label": "Metin",      "default": "<p>Hormonal dengeni desteklemek için bilim, şeffaflık ve özenle üretilmiş tek bir formül.</p>" },
    { "type": "text",     "id": "signature", "label": "İmza",       "default": ".ki ekibi" },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg",   "label": "Background", "default": "#493d9a" },
    { "type": "color", "id": "text", "label": "Text",       "default": "#ffffff" },
    { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 700, "max": 1400, "step": 10, "default": 900 },
    { "type": "range", "id": "pad_y",     "label": "Vertical padding (px)", "min": 24, "max": 200, "step": 4, "default": 104 },
    { "type": "range", "id": "pad_x",     "label": "Horizontal padding (px)", "min": 16, "max": 90, "step": 2, "default": 40 }
  ],
  "presets": [{ "name": ".ki Manifesto" }]
}
{% endschema %}
