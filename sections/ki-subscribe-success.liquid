{% comment %}
  ki-subscribe-success — iyzico ödemesi başarılı sonrası landing.
  Backend /api/subscribe/callback bu sayfaya redirect eder.
{% endcomment %}

<section id="ki-{{ section.id }}" class="ki-section ki-subscribe-success">
  <style>
    #ki-{{ section.id }} {
      padding: 80px 0;
      background: var(--ki-bg, #fffaf3);
      text-align: center;
    }
    #ki-{{ section.id }} .ki-ss__wrap {
      max-width: 560px; margin: 0 auto; padding: 0 16px;
    }
    #ki-{{ section.id }} .ki-ss__icon {
      width: 72px; height: 72px;
      margin: 0 auto 20px;
      border-radius: 999px;
      background: #d4f5e0;
      display: grid; place-items: center;
    }
    #ki-{{ section.id }} .ki-ss__icon svg { width: 36px; height: 36px; color: #1c8c4a; }
    #ki-{{ section.id }} .ki-ss__title {
      font-family: var(--ki-font-primary, system-ui);
      font-size: 32px; font-weight: 500; color: var(--ki-primary, #3a2d6e);
      margin: 0 0 12px;
    }
    #ki-{{ section.id }} .ki-ss__desc {
      color: rgba(0,0,0,.7); font-size: 15px; line-height: 1.55;
      margin: 0 0 28px;
    }
    #ki-{{ section.id }} .ki-ss__actions {
      display: flex; flex-wrap: wrap; gap: 10px; justify-content: center;
    }
    #ki-{{ section.id }} .ki-ss__btn {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 12px 22px;
      border-radius: 999px;
      font-weight: 700; font-size: 14px;
      text-decoration: none;
      transition: opacity .15s ease, transform .15s ease;
    }
    #ki-{{ section.id }} .ki-ss__btn--primary { background: var(--ki-primary, #3a2d6e); color: #fff; }
    #ki-{{ section.id }} .ki-ss__btn--secondary { border: 1.5px solid var(--ki-primary, #3a2d6e); color: var(--ki-primary, #3a2d6e); }

    @media (max-width: 989px) {
      #ki-{{ section.id }} { padding: 56px 0; }
      #ki-{{ section.id }} .ki-ss__title { font-size: 24px; }
    }
  </style>

  <div class="ki-ss__wrap">
    <div class="ki-ss__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="4 12 10 18 20 6"/>
      </svg>
    </div>
    <h1 class="ki-ss__title">{{ section.settings.heading | default: 'Aboneliğin başladı! 🎉' }}</h1>
    <p class="ki-ss__desc">
      {{ section.settings.description | default: 'Ödemen başarıyla alındı. Paketinin ilk teslimatı 2-3 iş günü içinde kargoya verilecek; e-posta adresine onay maili gönderdik.' }}
    </p>
    <div class="ki-ss__actions">
      <a href="{{ section.settings.portal_link | default: '/pages/abonelik-portalim' }}" class="ki-ss__btn ki-ss__btn--primary">{{ section.settings.portal_label | default: 'Aboneliğimi yönet' }}</a>
      <a href="{{ routes.root_url }}" class="ki-ss__btn ki-ss__btn--secondary">{{ section.settings.home_label | default: 'Anasayfaya dön' }}</a>
    </div>
  </div>
</section>

<script>
  (function () {
    /* 1) Başarılı abonelik sonrası eski pack data'yı temizle — geri tuşuyla
       checkout sayfasına dönüldüğünde stale data çakışmasın. */
    try {
      sessionStorage.removeItem('ki_pack');
    } catch (e) {}

    /* 2) Backend'in URL fragment'ında gönderdiği JWT'yi al, localStorage'a kaydet.
       Sonraki portal API çağrıları bunu Authorization: Bearer header ile gönderir.
       Fragment server'a iletilmez (request log'larında görünmez), localStorage
       same-origin restricted — Shopify storefront domain'ine özel.
       Token kaydedildikten sonra URL'i temizle ki kullanıcı geri butonuyla token'lı
       URL'e dönmesin. */
    try {
      var hash = window.location.hash || '';
      if (hash.indexOf('token=') >= 0) {
        var params = new URLSearchParams(hash.replace(/^#/, ''));
        var token = params.get('token');
        if (token) {
          localStorage.setItem('ki_portal_token', token);
          // URL'den fragment'ı temizle (history entry değiştir)
          history.replaceState(null, '', window.location.pathname + window.location.search);
        }
      }
    } catch (e) { console.warn('[KI] Token save failed:', e); }
  })();
</script>

{% schema %}
{
  "name": "Subscribe success",
  "tag": "section",
  "class": "ki-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Aboneliğin başladı! 🎉" },
    { "type": "textarea", "id": "description", "label": "Açıklama", "default": "Ödemen başarıyla alındı. Paketinin ilk teslimatı 2-3 iş günü içinde kargoya verilecek; e-posta adresine onay maili gönderdik." },
    { "type": "text", "id": "portal_link",  "label": "Portal link",  "default": "/pages/abonelik-portalim", "info": "URL veya path (örn: /pages/abonelik-portalim)" },
    { "type": "text", "id": "portal_label", "label": "Portal buton metni", "default": "Aboneliğimi yönet" },
    { "type": "text", "id": "home_label",   "label": "Anasayfa buton metni", "default": "Anasayfaya dön" }
  ],
  "presets": [{ "name": "Subscribe success" }]
}
{% endschema %}
