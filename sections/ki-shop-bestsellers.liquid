{% comment %}
  .ki Bestsellers (scoped) — Brand Kit
  Collection product grid (or manual blocks fallback).

  Brand kit:
    #493d9a (main)
    #f8f8f6 (offwhite)
    #b2a5ff (primary)
    #dad2ff (lilac)
{% endcomment %}

{%- assign collection = collections[section.settings.collection] -%}

<section id="kbs-{{ section.id }}" class="section">
  <style>
    #kbs-{{ section.id }}{
      --ki-purple-dark: #493d9a;
      --ki-offwhite: #f8f8f6;
      --ki-purple: #b2a5ff;
      --ki-lilac: #dad2ff;

      --bg: {{ section.settings.bg | default: '#ffffff' }};
      --text: {{ section.settings.text | default: '#1a1a1a' }};
      --muted: {{ section.settings.muted | default: 'rgba(26,26,26,.72)' }};

      --maxw: {{ section.settings.max_width | default: 1200 }}px;
      --py: {{ section.settings.pad_y | default: 88 }}px;
      --px: {{ section.settings.pad_x | default: 40 }}px;

      background: var(--bg);
      color: var(--text);
    }
    #kbs-{{ section.id }} .kbs__wrap{ max-width: var(--maxw); margin: 0 auto; padding: var(--py) var(--px); }
    #kbs-{{ section.id }} .kbs__head{ display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 32px; }
    #kbs-{{ section.id }} .kbs__title{
      font-size: clamp(30px,4vw,48px); font-weight: 650; letter-spacing: -0.02em;
      line-height: 1.1; color: var(--ki-purple-dark);
      text-shadow: 0 10px 26px rgba(73,61,154,.10); margin: 0;
    }
    #kbs-{{ section.id }} .kbs__link{
      font-size: 14px; font-weight: 650; color: var(--ki-purple-dark);
      text-decoration: underline; text-underline-offset: 4px;
    }
    #kbs-{{ section.id }} .kbs__grid{
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px;
    }
    #kbs-{{ section.id }} .kbs__card{
      display: block; text-decoration: none; color: inherit;
      border-radius: 18px; background: transparent;
      transition: transform 0.25s ease;
    }
    #kbs-{{ section.id }} .kbs__card:hover{ transform: translateY(-4px); }
    #kbs-{{ section.id }} .kbs__visual{
      position: relative; aspect-ratio: 1; background: var(--ki-lilac);
      border-radius: 18px; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 18px 40px rgba(73,61,154,.14);
    }
    #kbs-{{ section.id }} .kbs__visual img{ width: 72%; height: 72%; object-fit: contain; }
    #kbs-{{ section.id }} .kbs__add{
      position: absolute; bottom: 12px; left: 12px;
      background: #fff; color: var(--ki-purple-dark);
      font-size: 13px; font-weight: 650; padding: 8px 14px; border-radius: 999px;
      box-shadow: 0 8px 20px rgba(73,61,154,.14);
    }
    #kbs-{{ section.id }} .kbs__text{ padding-top: 14px; }
    #kbs-{{ section.id }} .kbs__text h3{ font-size: 15px; font-weight: 700; color: var(--ki-purple-dark); margin: 0; letter-spacing: -0.01em; }
    #kbs-{{ section.id }} .kbs__text p{ font-size: 12px; color: var(--muted); margin: 2px 0 0; }
    #kbs-{{ section.id }} .kbs__price{ font-size: 15px; font-weight: 700; color: var(--ki-purple-dark); margin-top: 8px; }
    @media (max-width: 990px){
      #kbs-{{ section.id }} .kbs__wrap{ padding: 64px 20px; }
      #kbs-{{ section.id }} .kbs__grid{ grid-template-columns: repeat(2, 1fr); gap: 14px; }
    }
    @media (max-width: 750px){
      #kbs-{{ section.id }} .kbs__wrap{ padding: 48px 16px; }
      #kbs-{{ section.id }} .kbs__head{ flex-direction: column; align-items: flex-start; gap: 10px; }
    }
  </style>

  <div class="kbs__wrap">
    <div class="kbs__head">
      <h2 class="kbs__title">{{ section.settings.title }}</h2>
      {% if section.settings.link_text != blank %}
        <a href="{{ section.settings.link_url | default: collection.url | default: '#' }}" class="kbs__link">{{ section.settings.link_text }}</a>
      {% endif %}
    </div>

    <div class="kbs__grid">
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.product_limit %}
          <a href="{{ product.url }}" class="kbs__card">
            <div class="kbs__visual">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 480 }}" alt="{{ product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" loading="lazy" decoding="async">
              {% endif %}
              <span class="kbs__add">Ekle</span>
            </div>
            <div class="kbs__text">
              <h3>{{ product.title }}</h3>
              <p>{{ product.type }}</p>
              <div class="kbs__price">{{ product.price | money }}</div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          <div class="kbs__card" {{ block.shopify_attributes }}>
            <div class="kbs__visual" style="background: {{ block.settings.bg_color | default: '#dad2ff' }};">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 480 }}" alt="{{ block.settings.name | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" decoding="async">
              {% endif %}
              <span class="kbs__add">Ekle</span>
            </div>
            <div class="kbs__text">
              <h3>{{ block.settings.name }}</h3>
              <p>{{ block.settings.category }}</p>
              <div class="kbs__price">{{ block.settings.price }}</div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": ".ki Bestsellers",
  "tag": "section",
  "settings": [
    { "type": "text",       "id": "title",         "label": "Başlık",     "default": "En Çok Satanlar" },
    { "type": "collection", "id": "collection",    "label": "Koleksiyon (opsiyonel — yoksa manuel bloklar)" },
    { "type": "range",      "id": "product_limit", "label": "Ürün sayısı", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text",       "id": "link_text",     "label": "Link metni", "default": "Tümünü Gör" },
    { "type": "url",        "id": "link_url",      "label": "Link URL" },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg",    "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text",  "label": "Text",       "default": "#1a1a1a" },
    { "type": "color", "id": "muted", "label": "Muted text", "default": "#493d9a" },
    { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 1000, "max": 1600, "step": 10, "default": 1200 },
    { "type": "range", "id": "pad_y",     "label": "Vertical padding (px)", "min": 24, "max": 160, "step": 4, "default": 88 },
    { "type": "range", "id": "pad_x",     "label": "Horizontal padding (px)", "min": 16, "max": 90, "step": 2, "default": 40 }
  ],
  "blocks": [
    {
      "type": "manual_product",
      "name": "Manuel ürün",
      "settings": [
        { "type": "image_picker", "id": "image",    "label": "Görsel" },
        { "type": "text",     "id": "name",     "label": "İsim",      "default": ".ki Balance" },
        { "type": "text",     "id": "category", "label": "Kategori",  "default": "Döngü dengesi" },
        { "type": "text",     "id": "price",    "label": "Fiyat",     "default": "₺350" },
        { "type": "color",    "id": "bg_color", "label": "Arka plan", "default": "#dad2ff" }
      ]
    }
  ],
  "presets": [{ "name": ".ki Bestsellers" }]
}
{% endschema %}
