<style>
  .ing-sec {
    padding: 100px 24px;
    font-family: 'Raleway', 'Segoe UI', system-ui, sans-serif;
    color: #121212;
    line-height: 1.7;
    background: {{ section.settings.bg_color }};
  }
  .ing-wrap {
    max-width: 1200px;
    margin: 0 auto;
  }
  .ing-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .ing-stat-card {
    background: #fff;
    border-radius: 24px;
    padding: 48px 32px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
    border: 1px solid rgba(73, 61, 154, 0.05);
    transition: transform .3s ease, box-shadow .3s ease;
  }
  .ing-stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.08);
  }
  .ing-stat-n {
    font-size: 3.5rem;
    font-weight: 800;
    color: transparent;
    background: linear-gradient(135deg, #493D9A 0%, #121212 100%);
    -webkit-background-clip: text;
    line-height: 1;
    margin-bottom: 12px;
  }
  .ing-stat-l {
    font-size: 15px;
    font-weight: 600;
    color: #555;
    line-height: 1.5;
  }
  .ing-stat-l p {
    margin: 0;
  }
  .ing-history-bar {
    background: linear-gradient(135deg, #493D9A 0%, #292257 100%);
    border-radius: 32px;
    padding: 60px 80px;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 60px;
    box-shadow: 0 24px 48px rgba(73, 61, 154, 0.25);
    position: relative;
    overflow: hidden;
  }
  .ing-history-bar::after {
    content: '';
    position: absolute;
    top: 0; right: 0; width: 50%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.04));
    transform: skewX(-20deg) translateX(50%);
  }
  .ing-history-bar .num {
    font-size: 5rem;
    font-weight: 800;
    line-height: 1;
    flex-shrink: 0;
    letter-spacing: -2px;
  }
  .ing-history-text {
    font-size: 18px;
    font-weight: 300;
    opacity: .9;
    line-height: 1.6;
    margin: 0;
  }
  .ing-history-text p {
    margin: 0;
  }
  .ing-history-text strong {
    font-weight: 700;
    color: #fff;
  }
  
  @media(max-width: 900px) {
    .ing-sec { padding: 60px 20px; }
    .ing-stats-grid { grid-template-columns: 1fr; gap: 16px; }
    .ing-history-bar { flex-direction: column; gap: 24px; padding: 40px 30px; text-align: center; }
    .ing-history-bar .num { font-size: 4rem; }
    .ing-stat-n { font-size: 3rem; }
  }
</style>

<section class="ing-sec">
  <div class="ing-wrap">
    
    {%- if section.settings.layout == 'grid' -%}
      <div class="ing-stats-grid">
        {%- for block in section.blocks -%}
          <div class="ing-stat-card" {{ block.shopify_attributes }}>
            <div class="ing-stat-n">{{ block.settings.number }}</div>
            <div class="ing-stat-l">{{ block.settings.label }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="ing-history-bar">
        <div class="num">{{ section.settings.bar_number }}</div>
        <div class="ing-history-text">{{ section.settings.bar_text }}</div>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Ing: Premium Stats",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Arka Plan Rengi", "default": "#F8F7FC" },
    {
      "type": "select",
      "id": "layout",
      "label": "Görünüm Tipi",
      "options": [
        { "value": "grid", "label": "3'lü Grid Kartları (Beyaz Kartlar)" },
        { "value": "bar", "label": "Tekli Geniş Bar (Koyu Renk Gradient)" }
      ],
      "default": "grid"
    },
    { "type": "header", "content": "Tekli Bar Ayarları (Bar seçiliyse)" },
    { "type": "text", "id": "bar_number", "label": "Büyük Rakam", "default": "2.000+" },
    { "type": "richtext", "id": "bar_text", "label": "Açıklama (HTML destekli)", "default": "<p><strong>Yıllık geleneksel</strong> kullanım tarihi.</p>" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "İstatistik Kartı",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "number", "label": "Rakam", "default": "%100" },
        { "type": "richtext", "id": "label", "label": "Açıklama", "default": "<p>Müşteri Memnuniyeti</p>" }
      ]
    }
  ],
  "presets": [
    { 
      "name": "Ing: Premium Stats",
      "settings": { "layout": "grid" },
      "blocks": [
        { "type": "stat" }, { "type": "stat" }, { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
