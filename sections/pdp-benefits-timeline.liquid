{% comment %}
  PDP Benefits Timeline — "Benefits that build over time"
  Brand Kit uyumlu, modüler, mobil-uyumlu
  
  Özellikler:
  - Timeline badge'leri (Day 1, Week 4, Week 8)
  - Sağ tarafta 3 resim alanı
  - Alt kısımda "How to Use" bölümü
  - Tüm görseller ve metinler Shopify panelinden düzenlenebilir
{% endcomment %}

<section id="benefits-{{ section.id }}" class="section">
  <style>
    #benefits-{{ section.id }} {
      /* Brand Kit */
      --ki-purple-dark: #493d9a;
      --ki-offwhite: #f8f8f6;
      --ki-purple: #b2a5ff;
      --ki-lilac: #dad2ff;

      /* Functional */
      --bg: {{ section.settings.bg }};
      --text: {{ section.settings.text }};
      --muted: {{ section.settings.muted }};
      --badge-bg: {{ section.settings.badge_bg }};
      --badge-text: {{ section.settings.badge_text }};
      --line-color: {{ section.settings.line_color }};

      background: var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      overflow: hidden;
    }

    #benefits-{{ section.id }} .wrap {
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      padding: {{ section.settings.pad_y }}px {{ section.settings.pad_x }}px;
      overflow: hidden;
    }

    /* ===== HEADER ===== */
    #benefits-{{ section.id }} .header {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 40px;
      align-items: start;
      margin-bottom: 56px;
    }

    #benefits-{{ section.id }} .mainTitle {
      font-size: clamp(28px, 4vw, 44px);
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: var(--text);
      margin: 0;
      word-break: normal;
      overflow-wrap: normal;
    }

    #benefits-{{ section.id }} .subtitle {
      font-size: 15px;
      line-height: 1.6;
      color: var(--muted);
      margin: 0;
      text-align: left;
      padding-top: 8px;
      word-break: normal;
      overflow-wrap: normal;
    }

    /* ===== MAIN GRID ===== */
    #benefits-{{ section.id }} .mainGrid {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 48px;
      align-items: stretch;
    }

    /* ===== TIMELINE (Left) ===== */
    #benefits-{{ section.id }} .timeline {
      position: relative;
      padding-left: 28px;
      overflow: hidden;
    }

    /* Vertical line */
    #benefits-{{ section.id }} .timeline::before {
      content: "";
      position: absolute;
      left: 6px;
      top: 12px;
      bottom: 12px;
      width: 2px;
      background: var(--ki-lilac);
      border-radius: 2px;
    }

    /* Moving active indicator on timeline */
    #benefits-{{ section.id }} .timelineIndicator {
      position: absolute;
      left: 0;
      top: 28px; /* Initial position */
      width: 14px;
      height: 14px;
      background: var(--ki-purple-dark);
      border-radius: 50%;
      z-index: 3;
      transition: top 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 0 0 4px rgba(73,61,154,0.15), 0 2px 8px rgba(73,61,154,0.3);
    }

    #benefits-{{ section.id }} .timelineItem {
      position: relative;
      margin-bottom: 16px;
      border-radius: 12px;
      background: rgba(255,255,255,0.5);
      border: 1px solid rgba(73,61,154,0.08);
      overflow: hidden;
    }
    #benefits-{{ section.id }} .timelineItem:last-child {
      margin-bottom: 0;
    }

    /* Small dots on timeline for each item */
    #benefits-{{ section.id }} .timelineItem::before {
      content: "";
      position: absolute;
      left: -24px;
      top: 22px;
      width: 6px;
      height: 6px;
      background: var(--ki-lilac);
      border-radius: 50%;
      z-index: 1;
    }

    /* Accordion Header */
    #benefits-{{ section.id }} .accordionHeader {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px 20px;
      cursor: pointer;
      user-select: none;
      transition: background 0.2s ease;
    }
    #benefits-{{ section.id }} .accordionHeader:hover {
      background: rgba(178,165,255,0.1);
    }

    /* Badge */
    #benefits-{{ section.id }} .badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 5px 12px;
      border-radius: 999px;
      background: var(--badge-bg);
      color: var(--badge-text);
      flex-shrink: 0;
    }

    #benefits-{{ section.id }} .itemTitle {
      font-size: 16px;
      font-weight: 600;
      color: var(--text);
      margin: 0;
      line-height: 1.3;
      flex: 1;
      word-break: normal;
      overflow-wrap: normal;
    }

    /* Accordion Icon */
    #benefits-{{ section.id }} .accordionIcon {
      width: 24px;
      height: 24px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--ki-lilac);
      color: var(--ki-purple-dark);
      transition: transform 0.3s ease, background 0.2s ease;
    }
    #benefits-{{ section.id }} .accordionIcon svg {
      width: 14px;
      height: 14px;
    }
    #benefits-{{ section.id }} .timelineItem.is-open .accordionIcon {
      transform: rotate(45deg);
      background: var(--ki-purple-dark);
      color: #fff;
    }

    /* Accordion Content */
    #benefits-{{ section.id }} .accordionContent {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s ease, padding 0.35s ease;
      padding: 0 20px;
    }
    #benefits-{{ section.id }} .timelineItem.is-open .accordionContent {
      max-height: 500px;
      padding: 0 20px 20px 20px;
    }

    #benefits-{{ section.id }} .itemList {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    #benefits-{{ section.id }} .itemList li {
      position: relative;
      padding-left: 18px;
      font-size: 14px;
      line-height: 1.6;
      color: var(--muted);
      margin-bottom: 6px;
      word-break: normal;
      overflow-wrap: normal;
    }
    #benefits-{{ section.id }} .itemList li:last-child {
      margin-bottom: 0;
    }
    #benefits-{{ section.id }} .itemList li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: var(--line-color);
      font-weight: 700;
    }

    /* ===== IMAGE (Left) ===== */
    #benefits-{{ section.id }} .imagesCol {
      display: flex;
      order: -1;
    }

    #benefits-{{ section.id }} .imgWrap {
      border-radius: 16px;
      overflow: hidden;
      background: #fff;
      width: 100%;
      height: 100%;
    }

    #benefits-{{ section.id }} .imgWrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #benefits-{{ section.id }} .imgWrap svg {
      width: 100%;
      height: 100%;
      color: var(--ki-lilac);
    }

    /* ===== HOW TO USE ===== */
    #benefits-{{ section.id }} .howToUse {
      margin-top: 48px;
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 20px 24px;
      background: rgba(255,255,255,.6);
      border-radius: 16px;
      border: 1px solid rgba(73,61,154,.08);
    }

    #benefits-{{ section.id }} .howIcon {
      flex-shrink: 0;
      width: 48px;
      height: 48px;
    }

    #benefits-{{ section.id }} .howIcon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    #benefits-{{ section.id }} .howContent {
      flex: 1;
    }

    #benefits-{{ section.id }} .howTitle {
      font-size: 14px;
      font-weight: 700;
      color: var(--text);
      margin: 0 0 4px 0;
    }

    #benefits-{{ section.id }} .howDesc {
      font-size: 13px;
      line-height: 1.5;
      color: var(--muted);
      margin: 0;
    }

    /* ===== EMPTY STATE ===== */
    #benefits-{{ section.id }} .emptyNote {
      padding: 32px;
      border: 2px dashed rgba(73,61,154,.15);
      border-radius: 16px;
      background: var(--ki-offwhite);
      font-size: 14px;
      color: var(--muted);
      text-align: center;
    }

    /* ===== RESPONSIVE - TABLET ===== */
    @media (max-width: 990px) {
      #benefits-{{ section.id }} .wrap {
        padding: 48px 20px;
      }
      #benefits-{{ section.id }} .header {
        margin-bottom: 40px;
      }
      #benefits-{{ section.id }} .mainGrid {
        gap: 32px;
      }
      #benefits-{{ section.id }} .timeline {
        padding-left: 24px;
      }
      #benefits-{{ section.id }} .timelineItem::before {
        left: -24px;
        width: 12px;
        height: 12px;
      }
      #benefits-{{ section.id }} .imagesCol {
        gap: 12px;
      }
      #benefits-{{ section.id }} .imgWrap {
        border-radius: 12px;
      }
    }

    /* ===== RESPONSIVE - MOBILE ===== */
    @media (max-width: 768px) {
      #benefits-{{ section.id }} .wrap {
        padding: 16px 16px 40px 16px;
      }
      #benefits-{{ section.id }} .header {
        display: block;
        margin-top: 60px;
        margin-bottom:80px;
      }
      #benefits-{{ section.id }} .mainTitle {
        font-size: clamp(24px, 6vw, 32px);
        margin-bottom: 12px;
        word-break: normal;
        overflow-wrap: normal;
        white-space: normal;
      }
      #benefits-{{ section.id }} .subtitle {
        font-size: 14px;
        padding-top: 0;
      }
      #benefits-{{ section.id }} .mainGrid {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      /* Image goes first on mobile */
      #benefits-{{ section.id }} .imagesCol {
        order: -1;
      }
      #benefits-{{ section.id }} .imgWrap {
        aspect-ratio: 16/9;
        height: auto;
      }
      #benefits-{{ section.id }} .timeline {
        padding-left: 20px;
      }
      #benefits-{{ section.id }} .timeline::before {
        left: 5px;
      }
      #benefits-{{ section.id }} .timelineItem::before {
        left: -20px;
        width: 10px;
        height: 10px;
      }
      #benefits-{{ section.id }} .timelineItem {
        margin-bottom: 24px;
      }
      #benefits-{{ section.id }} .badge {
        font-size: 10px;
        padding: 4px 10px;
      }
      #benefits-{{ section.id }} .itemTitle {
        font-size: 15px;
        margin-bottom: 8px;
        word-break: normal;
        overflow-wrap: normal;
      }
      #benefits-{{ section.id }} .itemList li {
        font-size: 13px;
        padding-left: 14px;
      }
      #benefits-{{ section.id }} .howToUse {
        margin-top: 32px;
        padding: 16px;
        gap: 14px;
        flex-wrap: wrap;
      }
      #benefits-{{ section.id }} .howIcon {
        width: 40px;
        height: 40px;
      }
      #benefits-{{ section.id }} .howTitle {
        font-size: 13px;
      }
      #benefits-{{ section.id }} .howDesc {
        font-size: 12px;
      }
    }

    /* ===== VERY SMALL SCREENS ===== */
    @media (max-width: 360px) {
      #benefits-{{ section.id }} .mainTitle {
        font-size: 22px;
      }
      #benefits-{{ section.id }} .imagesCol {
        grid-template-columns: 1fr;
      }
      #benefits-{{ section.id }} .imgMain {
        aspect-ratio: 4/3;
      }
      #benefits-{{ section.id }} .imgSecondary {
        aspect-ratio: 16/9;
      }
    }

    /* ===== TOUCH OPTIMIZATIONS ===== */
    @media (hover: none) and (pointer: coarse) {
      #benefits-{{ section.id }} .timelineItem {
        -webkit-tap-highlight-color: transparent;
      }
    }
  </style>

  <div class="wrap">
    <!-- Header -->
    <div class="header">
      {% if section.settings.heading != blank %}
        <h2 class="mainTitle">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="subtitle">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <!-- Main Grid -->
    <div class="mainGrid">
      <!-- Left: Timeline -->
      <div class="timeline">
        <!-- Moving indicator dot -->
        <div class="timelineIndicator" data-timeline-indicator></div>
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'timeline_item' %}
              <div class="timelineItem{% if forloop.first %} is-open{% endif %}" {{ block.shopify_attributes }} data-accordion>
                <div class="accordionHeader" data-accordion-trigger>
                  {% if block.settings.badge != blank %}
                    <span class="badge">{{ block.settings.badge }}</span>
                  {% endif %}
                  {% if block.settings.title != blank %}
                    <h3 class="itemTitle">{{ block.settings.title }}</h3>
                  {% endif %}
                  <span class="accordionIcon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                      <path d="M12 5v14M5 12h14"/>
                    </svg>
                  </span>
                </div>
                <div class="accordionContent">
                  {% if block.settings.benefits != blank %}
                    <ul class="itemList">
                      {% assign benefits_list = block.settings.benefits | split: '|' %}
                      {% for benefit in benefits_list %}
                        <li>{{ benefit | strip }}</li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        {% else %}
          <div class="emptyNote">
            Timeline öğesi eklemek için blok ekleyin.
          </div>
        {% endif %}
      </div>

      <!-- Left: Image -->
      <div class="imagesCol">
        <div class="imgWrap">
          {% if section.settings.image_main != blank %}
            {{ section.settings.image_main | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.image_main_alt, class: '' }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {% endif %}
        </div>
      </div>
    </div>

    <!-- How to Use -->
    {% if section.settings.show_how_to_use %}
      <div class="howToUse">
        <div class="howIcon">
          {% if section.settings.how_icon != blank %}
            {{ section.settings.how_icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: 'Kullanım' }}
          {% else %}
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="8" y="2" width="8" height="20" rx="4" stroke="currentColor" stroke-width="1.5"/>
              <path d="M12 6v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          {% endif %}
        </div>
        <div class="howContent">
          {% if section.settings.how_title != blank %}
            <h4 class="howTitle">{{ section.settings.how_title }}</h4>
          {% endif %}
          {% if section.settings.how_description != blank %}
            <p class="howDesc">{{ section.settings.how_description }}</p>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<script>
  (function() {
    var section = document.getElementById('benefits-{{ section.id }}');
    if (!section) return;

    var timeline = section.querySelector('.timeline');
    var indicator = section.querySelector('[data-timeline-indicator]');
    var accordions = section.querySelectorAll('[data-accordion]');
    
    if (!timeline || !indicator || accordions.length === 0) return;

    // Function to move indicator to active accordion
    function moveIndicator() {
      var activeAccordion = section.querySelector('.timelineItem.is-open');
      if (!activeAccordion) return;
      
      var timelineRect = timeline.getBoundingClientRect();
      var accordionRect = activeAccordion.getBoundingClientRect();
      
      // Calculate position relative to timeline
      var topPos = accordionRect.top - timelineRect.top + 16; // 16px offset to align with header
      indicator.style.top = topPos + 'px';
    }

    // Initial position
    setTimeout(moveIndicator, 100);
    
    accordions.forEach(function(accordion) {
      var trigger = accordion.querySelector('[data-accordion-trigger]');
      if (!trigger) return;
      
      trigger.addEventListener('click', function() {
        var isOpen = accordion.classList.contains('is-open');
        
        // Close all other accordions
        accordions.forEach(function(other) {
          if (other !== accordion) {
            other.classList.remove('is-open');
          }
        });
        
        // Toggle current accordion
        accordion.classList.toggle('is-open', !isOpen);
        
        // Move indicator after state change
        setTimeout(moveIndicator, 50);
      });
    });

    // Recalculate on window resize
    window.addEventListener('resize', function() {
      setTimeout(moveIndicator, 100);
    });
  })();
</script>

{% schema %}
