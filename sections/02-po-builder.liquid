    { "type": "color", "id": "cream_color", "label": "Cream", "default": "#f7f1e6" },
    { "type": "color", "id": "primary_color", "label": "Primary", "default": "#3a2d6e" },
    { "type": "color", "id": "rose_color", "label": "Rose", "default": "#d96d8a" },
    { "type": "color", "id": "rose_light", "label": "Rose light", "default": "#f6dce4" },
