      "name": "Nasıl çalışır adımı",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Adım metni", "default": "İhtiyacın olan ürünleri ve adetleri seç." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Paket Builder",
      "blocks": [
        { "type": "category", "settings": { "key": "ped", "label": "Pedler", "description": "Soft Cotton & Bamboo Fiber üst yüzey · Pelin Otu infüzeli", "hint": "Çoğu kullanıcı 1 paket Günlük (30), 1 Gündüz (12), 1 Gece (8) tercih ediyor." } },
        { "type": "product", "settings": { "category": "ped", "name": ".ki Günlük Ped", "short": "155 mm · 30 adet · ultra ince", "price": 149, "step": 30, "unit": "adet" } },
        { "type": "product", "settings": { "category": "ped", "name": ".ki Gündüz Pedi", "short": "245 mm · 12 adet · orta yoğun", "price": 169, "step": 12, "unit": "adet" } },
        { "type": "product", "settings": { "category": "ped", "name": ".ki Gece Pedi", "short": "335 mm · 8 adet · yoğun akış", "price": 189, "step": 8, "unit": "adet" } },

