{% comment %}
  Product Showcase + Bundle Hero — .ki v4
  Bundle URL fix: bundle_product.url öncelikli
{% endcomment %}

<link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,700;0,800;1,700;1,800&display=swap" rel="stylesheet">

<style>
.psc-{{ section.id }} {
  --p:   #493d9a;
  --lil: #dad2ff;
  --bg:  {{ section.settings.bg | default: '#ffffff' }};
  background: var(--bg);
  padding: {{ section.settings.padding_top | default: 48 }}px 0 {{ section.settings.padding_bottom | default: 64 }}px;
}
.psc-{{ section.id }} .psc-inner { max-width: 1400px; margin: 0 auto; padding: 0 24px; }

/* ── Heading ── */
.psc-{{ section.id }} .psc-heading {
  text-align: center;
  font-size: clamp(22px, 4vw, 44px);
  font-weight: 700;
  background: linear-gradient(135deg, #493d9a 0%, #b2a5ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin: 0 0 28px;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

/* ── Product cards grid ── */
.psc-{{ section.id }} .psc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-bottom: 24px; }
.psc-{{ section.id }} .psc-card { position: relative; border-radius: 18px; overflow: hidden; aspect-ratio: 3/4; background: #f0eef8; box-shadow: 0 8px 28px rgba(73,61,154,.12); transition: transform .3s ease, box-shadow .3s ease; }
.psc-{{ section.id }} .psc-card:hover { transform: translateY(-6px); box-shadow: 0 18px 48px rgba(73,61,154,.22); }
.psc-{{ section.id }} .psc-card a { display: block; width: 100%; height: 100%; text-decoration: none; position: relative; }
.psc-{{ section.id }} .psc-card img, .psc-{{ section.id }} .psc-card svg.placeholder-svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
.psc-{{ section.id }} .psc-card:hover img { transform: scale(1.04); }
.psc-{{ section.id }} .psc-card-ov { position: absolute; bottom: 0; left: 0; right: 0; padding: 28px 20px 20px; background: linear-gradient(to top, rgba(40,26,100,.92) 0%, rgba(73,61,154,.55) 55%, transparent 100%); z-index: 2; display: flex; flex-direction: column; gap: 3px; }
.psc-{{ section.id }} .psc-badge { display: inline-block; background: rgba(255,255,255,.18); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); color: #fff; padding: 3px 10px; border-radius: 50px; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 4px; width: fit-content; border: 1px solid rgba(255,255,255,.2); }
.psc-{{ section.id }} .psc-card-title { font-size: 18px; font-weight: 700; color: #fff; margin: 0; line-height: 1.2; }
.psc-{{ section.id }} .psc-card-desc { color: rgba(255,255,255,.85); font-size: 12px; line-height: 1.45; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.psc-{{ section.id }} .psc-card-price { font-size: 20px; font-weight: 700; color: #fff; margin: 4px 0 0; }
.psc-{{ section.id }} .psc-card-cta { display: inline-flex; align-items: center; gap: 5px; padding: 7px 16px; background: #fff; color: var(--p); border-radius: 50px; font-weight: 700; font-size: 12px; transition: all .25s; margin-top: 8px; width: fit-content; border: none; }
.psc-{{ section.id }} .psc-card:hover .psc-card-cta { background: var(--lil); color: var(--p); }
.psc-{{ section.id }} .psc-card-cta svg { width: 13px; height: 13px; transition: transform .25s; }
.psc-{{ section.id }} .psc-card:hover .psc-card-cta svg { transform: translateX(3px); }

/* ── Bundle Hero ── */
.psc-{{ section.id }} .psc-bundle-hero { position: relative; border-radius: 22px; overflow: hidden; min-height: 420px; display: grid; grid-template-columns: 1fr 1fr; background: linear-gradient(135deg, #1e1460 0%, #2f2385 100%); }
.psc-{{ section.id }} .psc-bh-img { position: relative; overflow: hidden; }
.psc-{{ section.id }} .psc-bh-img img, .psc-{{ section.id }} .psc-bh-img svg.placeholder-svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s ease; }
.psc-{{ section.id }} .psc-bundle-hero:hover .psc-bh-img img { transform: scale(1.03); }
.psc-{{ section.id }} .psc-bh-img::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(to right, rgba(30,20,96,0.55) 0%, transparent 50%); pointer-events: none; }
.psc-{{ section.id }} .psc-bh-content { display: flex; flex-direction: column; justify-content: center; padding: 52px 48px 52px 44px; position: relative; z-index: 2; }
.psc-{{ section.id }} .psc-bh-label { display: inline-flex; align-items: center; gap: 6px; background: rgba(218,210,255,0.15); border: 1px solid rgba(218,210,255,0.28); color: var(--lil); font-size: 10px; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; padding: 5px 14px; border-radius: 50px; margin-bottom: 20px; width: fit-content; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
.psc-{{ section.id }} .psc-bh-label svg { width: 11px; height: 11px; }
.psc-{{ section.id }} .psc-bh-title { font-family: 'Raleway', system-ui, sans-serif; font-size: clamp(26px, 2.8vw, 44px); font-weight: 800; color: #fff; margin: 0 0 12px; line-height: 1.1; letter-spacing: -0.025em; }
.psc-{{ section.id }} .psc-bh-title em { font-style: italic; color: var(--lil); }
.psc-{{ section.id }} .psc-bh-sub { font-size: 14px; line-height: 1.65; color: rgba(255,255,255,0.72); margin: 0 0 28px; max-width: 380px; }
.psc-{{ section.id }} .psc-bh-price-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 28px; }
.psc-{{ section.id }} .psc-bh-original { font-size: 16px; color: rgba(255,255,255,0.40); text-decoration: line-through; font-weight: 500; }
.psc-{{ section.id }} .psc-bh-final { font-size: 34px; font-weight: 800; color: #fff; line-height: 1; font-family: 'Raleway', system-ui, sans-serif; }
.psc-{{ section.id }} .psc-bh-save { display: inline-flex; align-items: center; gap: 4px; background: #22c55e; color: #fff; padding: 4px 11px; border-radius: 50px; font-size: 11px; font-weight: 700; letter-spacing: 0.03em; }
.psc-{{ section.id }} .psc-bh-save svg { width: 11px; height: 11px; }
.psc-{{ section.id }} .psc-bh-btn { display: inline-flex; align-items: center; gap: 8px; padding: 16px 32px; border-radius: 50px; background: #fff; color: var(--p); font-weight: 800; font-size: 15px; text-decoration: none; border: none; transition: all .25s; width: fit-content; box-shadow: 0 6px 24px rgba(0,0,0,0.22); }
.psc-{{ section.id }} .psc-bh-btn:hover { background: var(--lil); transform: translateY(-2px); box-shadow: 0 10px 32px rgba(0,0,0,0.28); }
.psc-{{ section.id }} .psc-bh-btn svg { width: 16px; height: 16px; transition: transform .25s; }
.psc-{{ section.id }} .psc-bh-btn:hover svg { transform: translateX(3px); }
.psc-{{ section.id }} .psc-bh-note { font-size: 11px; color: rgba(255,255,255,0.45); margin-top: 8px; }

/* ── MOBILE ── */
@media (max-width: 749px) {
  .psc-{{ section.id }} { padding: 20px 0 32px; }
  .psc-{{ section.id }} .psc-inner { padding: 0 14px; }
  .psc-{{ section.id }} .psc-heading { font-size: 18px; margin-bottom: 16px; }
  .psc-{{ section.id }} .psc-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 12px; }
  .psc-{{ section.id }} .psc-card { border-radius: 12px; }
  .psc-{{ section.id }} .psc-card-ov { padding: 16px 12px 14px; }
  .psc-{{ section.id }} .psc-card-title { font-size: 13px; }
  .psc-{{ section.id }} .psc-card-desc { font-size: 10px; }
  .psc-{{ section.id }} .psc-card-price { font-size: 14px; }
  .psc-{{ section.id }} .psc-card-cta { padding: 5px 11px; font-size: 10px; margin-top: 5px; }
  .psc-{{ section.id }} .psc-card:hover { transform: none; }
  .psc-{{ section.id }} .psc-bundle-hero { grid-template-columns: 1fr; grid-template-rows: auto auto; border-radius: 14px; min-height: unset; }
  .psc-{{ section.id }} .psc-bh-img { aspect-ratio: 16 / 7; order: 1; }
  .psc-{{ section.id }} .psc-bh-img::before { background: linear-gradient(to top, rgba(30,20,96,0.6) 0%, transparent 60%); }
  .psc-{{ section.id }} .psc-bh-content { order: 2; padding: 18px 18px 22px; }
  .psc-{{ section.id }} .psc-bh-label { font-size: 9px; padding: 4px 10px; margin-bottom: 10px; }
  .psc-{{ section.id }} .psc-bh-title { font-size: 20px; margin-bottom: 6px; }
  .psc-{{ section.id }} .psc-bh-sub { font-size: 12px; margin-bottom: 14px; max-width: 100%; }
  .psc-{{ section.id }} .psc-bh-price-row { gap: 8px; margin-bottom: 14px; }
  .psc-{{ section.id }} .psc-bh-original { font-size: 13px; }
  .psc-{{ section.id }} .psc-bh-final { font-size: 22px; }
  .psc-{{ section.id }} .psc-bh-save { font-size: 10px; padding: 3px 8px; }
  .psc-{{ section.id }} .psc-bh-btn { width: 100%; justify-content: center; padding: 12px 16px; font-size: 13px; }
  .psc-{{ section.id }} .psc-bh-note { font-size: 10px; margin-top: 6px; }
}
@media (min-width: 750px) and (max-width: 1099px) {
  .psc-{{ section.id }} .psc-bh-content { padding: 36px 32px; }
  .psc-{{ section.id }} .psc-bh-title { font-size: clamp(22px, 3vw, 34px); }
  .psc-{{ section.id }} .psc-bh-final { font-size: 28px; }
}
</style>

<div class="psc-{{ section.id }}" id="ProductShowcase-{{ section.id }}">
  <div class="psc-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="psc-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- assign product_blocks = section.blocks | where: 'type', 'product_card' -%}
    {%- if product_blocks.size > 0 -%}
    <div class="psc-grid">
      {%- for block in product_blocks -%}
        {%- liquid
          assign card_url = ''
          if block.settings.product != blank
            assign card_url = block.settings.product.url
            assign card_price = block.settings.product.price | money
          elsif block.settings.card_link != blank
            assign card_url = block.settings.card_link
            assign card_price = block.settings.price_text
          else
            assign card_price = block.settings.price_text
          endif
        -%}
        <div class="psc-card" {{ block.shopify_attributes }}>
          <a href="{{ card_url | default: '#' }}">
            <div>
              {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
            </div>
            <div class="psc-card-ov">
              {%- if block.settings.badge != blank -%}<span class="psc-badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
              {%- if block.settings.title != blank -%}<h3 class="psc-card-title">{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.description != blank -%}<p class="psc-card-desc">{{ block.settings.description | escape }}</p>{%- endif -%}
              {%- if card_price != blank -%}<div class="psc-card-price">{{ card_price }}</div>{%- endif -%}
              {%- if block.settings.cta_label != blank -%}
                <span class="psc-card-cta">{{ block.settings.cta_label | escape }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
              {%- endif -%}
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
    {%- endif -%}

    {%- assign bundle_block = section.blocks | where: 'type', 'bundle' | first -%}
    {%- if bundle_block != blank -%}
    {%- comment -%} URL öncelik: bundle_product > bundle_link > # {%- endcomment -%}
    {%- assign bundle_url = '#' -%}
    {%- if bundle_block.settings.bundle_product != blank -%}
      {%- assign bundle_url = bundle_block.settings.bundle_product.url -%}
    {%- elsif bundle_block.settings.bundle_link != blank -%}
      {%- assign bundle_url = bundle_block.settings.bundle_link -%}
    {%- endif -%}
    <a href="{{ bundle_url }}" class="psc-bundle-hero" {{ bundle_block.shopify_attributes }} style="text-decoration:none;">
      <div class="psc-bh-content">
        {%- if bundle_block.settings.bundle_label != blank -%}
        <div class="psc-bh-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          {{ bundle_block.settings.bundle_label | escape }}
        </div>
        {%- endif -%}
        {%- if bundle_block.settings.bundle_title != blank -%}<h2 class="psc-bh-title">{{ bundle_block.settings.bundle_title }}</h2>{%- endif -%}
        {%- if bundle_block.settings.bundle_subtitle != blank -%}<p class="psc-bh-sub">{{ bundle_block.settings.bundle_subtitle | escape }}</p>{%- endif -%}
        <div class="psc-bh-price-row">
          {%- if bundle_block.settings.original_price != blank -%}<span class="psc-bh-original">{{ bundle_block.settings.original_price | escape }}</span>{%- endif -%}
          {%- if bundle_block.settings.bundle_price != blank -%}<span class="psc-bh-final">{{ bundle_block.settings.bundle_price | escape }}</span>{%- endif -%}
          {%- if bundle_block.settings.save_text != blank -%}
            <span class="psc-bh-save"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{{ bundle_block.settings.save_text | escape }}</span>
          {%- endif -%}
        </div>
        <span class="psc-bh-btn">
          {{ bundle_block.settings.bundle_cta | default: 'Seti İncele' | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </span>
        {%- if bundle_block.settings.bundle_note != blank -%}<p class="psc-bh-note">{{ bundle_block.settings.bundle_note | escape }}</p>{%- endif -%}
      </div>
      <div class="psc-bh-img">
        {%- if bundle_block.settings.bundle_hero_image != blank -%}{{ bundle_block.settings.bundle_hero_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: bundle_block.settings.bundle_title }}{%- else -%}{{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
      </div>
    </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product Showcase (.ki)",
  "tag": "section",
  "class": "section",
  "settings": [
    {"type":"color","id":"bg","label":"Arka plan","default":"#ffffff"},
    {"type":"text","id":"heading","label":"Başlık","default":"Senin için özel tasarlandı"},
    {"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"\u00dcst boşluk","default":48},
    {"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"Alt boşluk","default":64}
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "\u00dcr\u00fcn Kart\u0131",
      "settings": [
        {"type":"header","content":"\u00dcr\u00fcn Bağlantısı"},
        {"type":"product","id":"product","label":"\u00dcr\u00fcn se\u00e7 (opsiyonel)"},
        {"type":"url","id":"card_link","label":"\u00d6zel URL"},
        {"type":"header","content":"G\u00f6rsel & \u0130\u00e7erik"},
        {"type":"image_picker","id":"image","label":"G\u00f6rsel"},
        {"type":"text","id":"badge","label":"Rozet","default":"D\u00f6ng\u00fcne \u00d6zel"},
        {"type":"richtext","id":"title","label":"Başlık","default":"<p>.ki Balance Your Cycle<\/p>"},
        {"type":"textarea","id":"description","label":"Açıklama"},
        {"type":"text","id":"price_text","label":"Fiyat (manuel)","default":"1.400 \u20ba"},
        {"type":"text","id":"cta_label","label":"Buton yazısı","default":"\u00dcr\u00fcn\u00fc \u0130ncele"}
      ]
    },
    {
      "type": "bundle",
      "name": "Bundle Hero",
      "limit": 1,
      "settings": [
        {"type":"header","content":"Hero G\u00f6rseli"},
        {"type":"image_picker","id":"bundle_hero_image","label":"B\u00fcy\u00fck arka plan g\u00f6rseli"},
        {"type":"header","content":"Bundle \u0130\u00e7eriği"},
        {"type":"text","id":"bundle_label","label":"Rozet yazısı","default":"Tam Bakım"},
        {"type":"richtext","id":"bundle_title","label":"Başlık","default":"<p>Regl Bakım Seti<\/p>"},
        {"type":"textarea","id":"bundle_subtitle","label":"Alt başlık","default":"Balance + Intimate"},
        {"type":"header","content":"Fiyat"},
        {"type":"text","id":"original_price","label":"Orijinal fiyat (\u00fcst\u00fc \u00e7izili)","default":"2.350\u20ba"},
        {"type":"text","id":"bundle_price","label":"Bundle fiyatı","default":"2.100\u20ba"},
        {"type":"text","id":"save_text","label":"Tasarruf rozeti","default":"%11 Tasarruf"},
        {"type":"header","content":"Buton","info":"\u00d6nce Shopify \u00fcr\u00fcn\u00fc se\u00e7. Yoksa \u00f6zel URL yaz."},
        {"type":"product","id":"bundle_product","label":"Bundle \u00fcr\u00fcn\u00fc (Shopify)","info":"Se\u00e7ilince otomatik o \u00fcr\u00fcn\u00fcn sayfasına gider"},
        {"type":"url","id":"bundle_link","label":"\u00d6zel bundle URL","info":"Shopify \u00fcr\u00fcn\u00fc se\u00e7ilmemi\u015fse kullanılır"},
        {"type":"text","id":"bundle_cta","label":"Buton yazısı","default":"Seti \u0130ncele"},
        {"type":"text","id":"bundle_note","label":"Buton alt notu","default":"Kargo dahil"}
      ]
    }
  ],
  "presets": [{"name":"Product Showcase (.ki)","blocks":[{"type":"product_card"},{"type":"product_card"},{"type":"bundle"}]}]
}
{% endschema %}
