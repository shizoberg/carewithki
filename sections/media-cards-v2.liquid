{% comment %}
  Media Cards V2 — Ki
  AG1-style: Full-width header row, 3-card carousel with transform-based scrolling
  Each card: portrait image + name + role + quote
{% endcomment %}

<style>
  #mcv2-{{ section.id }} {
    --ki-purple-dark: #493d9a;
    padding: 60px 0;
    background: #fff;
    overflow: hidden;
  }

  #mcv2-{{ section.id }} .mcv2__container {
    max-width: var(--page-width, 1400px);
    margin: 0 auto;
    padding: 0 3rem;
  }

  /* --- Header Row --- */
  #mcv2-{{ section.id }} .mcv2__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 40px;
    gap: 40px;
  }

  #mcv2-{{ section.id }} .mcv2__header-text {
    max-width: 700px;
  }

  #mcv2-{{ section.id }} .mcv2__title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 800;
    color: var(--ki-purple-dark);
    margin: 0 0 12px 0;
    line-height: 1.1;
  }

  #mcv2-{{ section.id }} .mcv2__desc {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(26, 26, 26, 0.65);
    margin: 0;
  }

  #mcv2-{{ section.id }} .mcv2__nav {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
    align-items: center;
  }

  #mcv2-{{ section.id }} .mcv2__btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: transparent;
    color: #1a1a1a;
    transition: all 0.2s;
  }
  #mcv2-{{ section.id }} .mcv2__btn svg { width: 18px; height: 18px; }
  #mcv2-{{ section.id }} .mcv2__btn:hover {
    background: var(--ki-purple-dark);
    color: #fff;
    border-color: var(--ki-purple-dark);
  }

  /* --- Cards Track --- */
  #mcv2-{{ section.id }} .mcv2__track-wrap {
    overflow: hidden;
  }

  #mcv2-{{ section.id }} .mcv2__track {
    display: flex;
    gap: 24px;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  #mcv2-{{ section.id }} .mcv2__card {
    flex: 0 0 calc((100% - 48px) / 3);
    min-width: 0;
  }

  #mcv2-{{ section.id }} .mcv2__card-img {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    border-radius: 8px;
    overflow: hidden;
    background: #f0f0f0;
    margin-bottom: 16px;
  }

  #mcv2-{{ section.id }} .mcv2__card-img img,
  #mcv2-{{ section.id }} .mcv2__card-img video,
  #mcv2-{{ section.id }} .mcv2__card-img iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #mcv2-{{ section.id }} .mcv2__card-name {
    font-size: 18px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 4px 0;
    line-height: 1.3;
  }

  #mcv2-{{ section.id }} .mcv2__card-role {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(26,26,26,0.55);
    margin-bottom: 14px;
    line-height: 1.4;
  }

  #mcv2-{{ section.id }} .mcv2__card-quote {
    font-size: 14px;
    line-height: 1.6;
    color: #1a1a1a;
    margin: 0;
  }

  /* --- Mobile --- */
  @media (max-width: 900px) {
    #mcv2-{{ section.id }} { padding: 40px 0; }

    #mcv2-{{ section.id }} .mcv2__container { padding: 0 20px; }

    #mcv2-{{ section.id }} .mcv2__header {
      flex-direction: column;
      gap: 16px;
      margin-bottom: 24px;
    }

    #mcv2-{{ section.id }} .mcv2__title {
      font-size: 28px;
    }

    #mcv2-{{ section.id }} .mcv2__nav {
      align-self: flex-end;
    }

    #mcv2-{{ section.id }} .mcv2__card {
      flex: 0 0 80%;
    }

    #mcv2-{{ section.id }} .mcv2__card-name { font-size: 16px; }
    #mcv2-{{ section.id }} .mcv2__card-role { font-size: 10px; }
    #mcv2-{{ section.id }} .mcv2__card-quote { font-size: 13px; }
  }
</style>

<div id="mcv2-{{ section.id }}">
  <div class="mcv2__container">

    <!-- Header Row -->
    <div class="mcv2__header">
      <div class="mcv2__header-text">
        {% if section.settings.heading != blank %}
          <h2 class="mcv2__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <p class="mcv2__desc">{{ section.settings.description }}</p>
        {% endif %}
      </div>
      <div class="mcv2__nav">
        <button class="mcv2__btn" id="mcv2-prev-{{ section.id }}" aria-label="Önceki">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button class="mcv2__btn" id="mcv2-next-{{ section.id }}" aria-label="Sonraki">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
    </div>

    <!-- Cards -->
    <div class="mcv2__track-wrap">
      <div class="mcv2__track" id="mcv2-track-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="mcv2__card" {{ block.shopify_attributes }}>
            <div class="mcv2__card-img">
              {% if block.settings.video != blank %}
                {{ block.settings.video | video_tag: image_size: '600x', loop: false, controls: true, muted: false }}
              {% elsif block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', style: 'width:100%;height:100%;object-fit:cover;' }}
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>
            {% if block.settings.title != blank %}
              <h3 class="mcv2__card-name">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.role != blank %}
              <div class="mcv2__card-role">{{ block.settings.role }}</div>
            {% endif %}
            {% if block.settings.quote != blank %}
              <div class="mcv2__card-quote">{{ block.settings.quote }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

  </div>
</div>

<script>
  (function() {
    document.addEventListener('DOMContentLoaded', function() {
      var track = document.getElementById('mcv2-track-{{ section.id }}');
      var prevBtn = document.getElementById('mcv2-prev-{{ section.id }}');
      var nextBtn = document.getElementById('mcv2-next-{{ section.id }}');

      if (!track || !prevBtn || !nextBtn) return;

      var currentIndex = 0;
      var cards = track.querySelectorAll('.mcv2__card');
      var totalCards = cards.length;

      function getVisibleCount() {
        return window.innerWidth <= 900 ? 1 : 3;
      }

      function getMaxIndex() {
        return Math.max(0, totalCards - getVisibleCount());
      }

      function slide() {
        if (cards.length === 0 || currentIndex >= cards.length) return;
        var offset = cards[currentIndex].offsetLeft;
        track.style.transform = 'translateX(-' + offset + 'px)';
      }

      prevBtn.addEventListener('click', function() {
        if (currentIndex > 0) {
          currentIndex--;
          slide();
        }
      });

      nextBtn.addEventListener('click', function() {
        if (currentIndex < getMaxIndex()) {
          currentIndex++;
          slide();
        }
      });

      window.addEventListener('resize', function() {
        if (currentIndex > getMaxIndex()) {
          currentIndex = getMaxIndex();
        }
        slide();
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Media Cards V2",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "Kendine İyi Bakanlar"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Açıklama",
      "default": "Farklı hayatlar, farklı temposu olan günler..."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Kart",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Görsel"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Shopify Video"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "text",
          "id": "title",
          "label": "İsim",
          "default": "Kişi İsmi"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Rol / Ünvan",
          "default": "Sporcu, 18"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Alıntı / Yorum",
          "default": "<p>Yorum...</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Media Cards V2",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
