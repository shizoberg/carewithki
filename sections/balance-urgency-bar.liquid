<style>
  #shopify-section-{{ section.id }} {
    /* Scope variables */
    --ki-purple-dark: #493d9a;
    --ki-purple: #b2a5ff;
  }
  
  .balance-urgency-bar {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--ki-purple-dark) 0%, #3f347f 100%);
    color: #fff;
    text-align: center;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.025em;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .balance-urgency-bar__content {
    position: relative;
    z-index: 2;
  }

  /* Shimmer effect */
  .balance-urgency-bar::after {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);
    animation: urgShimmer 3s infinite linear;
    z-index: 1;
  }

  @keyframes urgShimmer {
    0% { left: -100%; }
    100% { left: 100%; }
  }
</style>

<div class="balance-urgency-bar">
  <div class="balance-urgency-bar__content">
    <span>{{ section.settings.text }}</span>
  </div>
</div>

{% schema %}
{
  "name": "Balance: Urgency Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "⚡ Bugün sipariş ver, yarın kargoda — ücretsiz kargo"
    }
  ],
  "presets": [
    {
      "name": "Balance: Urgency Bar"
    }
  ]
}
{% endschema %}
