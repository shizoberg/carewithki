{% comment %}
  .ki Profile Section (scoped) — Brand Kit
  Profile card (name/email + edit), Addresses card (empty-state ready), logout actions.

  Brand kit:
    #493d9a / #f8f8f6 / #b2a5ff / #dad2ff
{% endcomment %}

<section id="mshpro-{{ section.id }}" class="section">
  <style>
    #mshpro-{{ section.id }}{
      --ki-purple-dark: #493d9a;
      --ki-offwhite: #f8f8f6;
      --ki-purple: #b2a5ff;
      --ki-lilac: #dad2ff;

      --bg: {{ section.settings.bg | default: '#ffffff' }};
      --text: {{ section.settings.text | default: '#1a1a1a' }};
      --muted: {{ section.settings.muted | default: 'rgba(26,26,26,.64)' }};
      --line: rgba(73,61,154,.14);

      --maxw: {{ section.settings.max_width | default: 1000 }}px;
      --py: {{ section.settings.pad_y | default: 48 }}px;
      --px: {{ section.settings.pad_x | default: 32 }}px;

      background: var(--bg); color: var(--text);
    }
    #mshpro-{{ section.id }} .mshpro__wrap{ max-width: var(--maxw); margin: 0 auto; padding: var(--py) var(--px); }
    #mshpro-{{ section.id }} .mshpro__title{
      margin: 0 0 28px; font-size: clamp(28px, 4vw, 44px); font-weight: 650; letter-spacing: -0.02em;
      line-height: 1.1; color: var(--ki-purple-dark); text-shadow: 0 10px 26px rgba(73,61,154,.10);
    }

    #mshpro-{{ section.id }} .mshpro__stack{ display: grid; gap: 20px; }

    #mshpro-{{ section.id }} .mshpro__card{
      padding: 24px; border-radius: 18px; background: #fff; border: 1px solid var(--line);
      box-shadow: 0 18px 40px rgba(73,61,154,.14); transition: transform .2s, box-shadow .2s;
    }
    #mshpro-{{ section.id }} .mshpro__card:hover{
      transform: translateY(-4px); box-shadow: 0 22px 50px rgba(73,61,154,.18);
    }

    #mshpro-{{ section.id }} .mshpro__row{
      display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;
    }
    #mshpro-{{ section.id }} .mshpro__name{ margin: 0; font-size: 16px; font-weight: 650; }
    #mshpro-{{ section.id }} .mshpro__label{
      margin: 14px 0 2px; font-size: 11px; font-weight: 500; letter-spacing: 0.08em;
      text-transform: uppercase; color: var(--muted);
    }
    #mshpro-{{ section.id }} .mshpro__val{ margin: 0; font-size: 14px; color: var(--text); }
    #mshpro-{{ section.id }} .mshpro__icoBtn{
      width: 36px; height: 36px; border-radius: 999px; border: 0; background: transparent;
      display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
      color: var(--ki-purple-dark); transition: background .2s;
    }
    #mshpro-{{ section.id }} .mshpro__icoBtn:hover{ background: var(--ki-lilac); }
    #mshpro-{{ section.id }} .mshpro__icoBtn:focus-visible{ outline: 2px solid var(--ki-purple-dark); outline-offset: 2px; }

    #mshpro-{{ section.id }} .mshpro__cardHead{ display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
    #mshpro-{{ section.id }} .mshpro__cardTitle{ margin: 0; font-size: 15px; font-weight: 650; }
    #mshpro-{{ section.id }} .mshpro__add{
      display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px;
      background: transparent; color: var(--ki-purple-dark); font-size: 13px; font-weight: 650;
      border: 0; cursor: pointer; text-decoration: none;
    }
    #mshpro-{{ section.id }} .mshpro__add:hover{ background: var(--ki-lilac); }

    #mshpro-{{ section.id }} .mshpro__empty{
      display: flex; align-items: center; gap: 10px; padding: 16px;
      border-radius: 12px; border: 1px dashed var(--line); background: var(--ki-offwhite);
      color: var(--muted); font-size: 14px;
    }

    #mshpro-{{ section.id }} .mshpro__footer{ display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
    #mshpro-{{ section.id }} .mshpro__btn{
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 0 18px; height: 44px; border-radius: 999px; font-size: 14px; font-weight: 650;
      cursor: pointer; text-decoration: none; border: 1px solid transparent; transition: transform .2s, background .2s;
    }
    #mshpro-{{ section.id }} .mshpro__btn--outline{ background: #fff; color: var(--text); border-color: var(--line); }
    #mshpro-{{ section.id }} .mshpro__btn--outline:hover{ transform: translateY(-2px); background: var(--ki-lilac); border-color: rgba(73,61,154,.28); }
    #mshpro-{{ section.id }} .mshpro__btn--ghost{ color: var(--muted); }
    #mshpro-{{ section.id }} .mshpro__btn--ghost:hover{ background: var(--ki-lilac); color: var(--ki-purple-dark); }
    #mshpro-{{ section.id }} .mshpro__btn:focus-visible{ outline: 2px solid var(--ki-purple-dark); outline-offset: 3px; }

    @media (max-width: 750px){
      #mshpro-{{ section.id }} .mshpro__wrap{ padding: 32px 16px; }
      #mshpro-{{ section.id }} .mshpro__card{ padding: 20px; }
    }
  </style>

  <div class="mshpro__wrap">
    <h1 class="mshpro__title">{{ section.settings.title | default: 'Profil' }}</h1>

    <div class="mshpro__stack">
      <div class="mshpro__card">
        <div class="mshpro__row">
          <div>
            <p class="mshpro__name">{{ section.settings.user_name | default: 'bek aktas' }}</p>
            <p class="mshpro__label">E-posta</p>
            <p class="mshpro__val">{{ section.settings.user_email | default: 'shizoberg@gmail.com' }}</p>
          </div>
          <button type="button" class="mshpro__icoBtn" aria-label="Profili düzenle">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          </button>
        </div>
      </div>

      <div class="mshpro__card">
        <div class="mshpro__cardHead">
          <h3 class="mshpro__cardTitle">{{ section.settings.addresses_title | default: 'Adresler' }}</h3>
          <a href="{{ section.settings.add_address_href | default: '#' }}" class="mshpro__add">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Ekle
          </a>
        </div>

        {% if section.blocks.size > 0 %}
          <div class="mshpro__stack" style="gap:12px;">
            {% for block in section.blocks %}
              {% if block.type == 'address' %}
                <div class="mshpro__empty" style="border-style:solid;background:#fff;color:var(--text);" {{ block.shopify_attributes }}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" style="color:var(--ki-purple-dark);flex-shrink:0;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  <div>
                    <strong style="display:block;font-size:14px;">{{ block.settings.label }}</strong>
                    <span style="color:var(--muted);font-size:13px;">{{ block.settings.address }}</span>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% else %}
          <div class="mshpro__empty">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            {{ section.settings.empty_address_text | default: 'Adres eklenmedi' }}
          </div>
        {% endif %}
      </div>

      <div class="mshpro__footer">
        <a href="{{ section.settings.logout_href | default: '/account/logout' }}" class="mshpro__btn mshpro__btn--outline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          {{ section.settings.logout_label | default: 'Çıkış yap' }}
        </a>
        <a href="{{ section.settings.logout_all_href | default: '#' }}" class="mshpro__btn mshpro__btn--ghost">
          {{ section.settings.logout_all_label | default: 'Tüm cihazlardan çıkış yap' }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MSH · Profile",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Profil" },
    { "type": "text", "id": "user_name", "label": "Ad", "default": "bek aktas" },
    { "type": "text", "id": "user_email", "label": "E-posta", "default": "shizoberg@gmail.com" },
    { "type": "text", "id": "addresses_title", "label": "Adresler başlığı", "default": "Adresler" },
    { "type": "url", "id": "add_address_href", "label": "Adres ekle linki" },
    { "type": "text", "id": "empty_address_text", "label": "Boş adres metni", "default": "Adres eklenmedi" },
    { "type": "text", "id": "logout_label", "label": "Çıkış yap etiketi", "default": "Çıkış yap" },
    { "type": "url", "id": "logout_href", "label": "Çıkış yap linki" },
    { "type": "text", "id": "logout_all_label", "label": "Tüm cihazlardan çıkış etiketi", "default": "Tüm cihazlardan çıkış yap" },
    { "type": "url", "id": "logout_all_href", "label": "Tüm cihazlardan çıkış linki" },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text", "label": "Text", "default": "#1a1a1a" },
    { "type": "color", "id": "muted", "label": "Muted", "default": "#493d9a" },
    { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 600, "max": 1400, "step": 20, "default": 1000 },
    { "type": "range", "id": "pad_y", "label": "Vertical padding (px)", "min": 16, "max": 120, "step": 4, "default": 48 },
    { "type": "range", "id": "pad_x", "label": "Horizontal padding (px)", "min": 12, "max": 80, "step": 2, "default": 32 }
  ],
  "blocks": [
    {
      "type": "address",
      "name": "Adres",
      "settings": [
        { "type": "text", "id": "label", "label": "Etiket", "default": "Ev" },
        { "type": "textarea", "id": "address", "label": "Adres", "default": "Cihangir Mah. Sıraselviler Cad. No:24/3, Beyoğlu / İstanbul" }
      ]
    }
  ],
  "presets": [{ "name": "MSH · Profile" }]
}
{% endschema %}
