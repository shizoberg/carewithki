{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

<style>
cart-items {
  --p:#493d9a;--lil:#dad2ff;
  font-family:system-ui,sans-serif;
  display:block;
  background:#f8f8f6 !important;
}
cart-items .page-width {
  max-width:1200px;
}
cart-items .title-wrapper-with-link {
  align-items:flex-end;
  margin-bottom:24px;
}
cart-items .title--primary {
  font-family:'Raleway',system-ui,sans-serif;
  color:var(--p) !important;
  font-weight:800 !important;
  letter-spacing:-.02em;
  font-size:clamp(34px,4vw,52px);
  margin:0;
}
cart-items .underlined-link {
  color:var(--p) !important;
  text-decoration-color:rgba(73,61,154,.3) !important;
  font-size:13px;font-weight:500;
}
cart-items .underlined-link:hover { color:#7b6dd3 !important; }
cart-items .caption-with-letter-spacing {
  color:rgba(73,61,154,.5) !important;
  font-weight:700 !important;
  letter-spacing:.1em !important;
}
cart-items .cart__items {
  padding:0 26px 26px !important;
  border:1px solid rgba(73,61,154,.10) !important;
  border-radius:24px !important;
  background:#fff;
  box-shadow:0 14px 42px rgba(73,61,154,.07);
  overflow:hidden;
}
cart-items .cart-items th {
  padding-top:22px !important;
  padding-bottom:16px !important;
}
cart-items .cart-items td {
  vertical-align:middle !important;
  padding-top:26px !important;
  padding-bottom:26px !important;
}
cart-items .cart-item:not(:last-child) td {
  border-bottom:1px solid rgba(73,61,154,.08) !important;
}
cart-items .cart-item__image-container {
  border:0 !important;
  border-radius:18px !important;
  overflow:hidden;
  background:#f0eeff;
}
cart-items .cart-item__image {
  width:118px !important;
  max-width:118px !important;
  border-radius:18px !important;
}
cart-items .cart-item__name { color:var(--p) !important; font-weight:600 !important; }
cart-items .cart-item__name:hover { color:#7b6dd3 !important; }
cart-items .price--end { color:var(--p) !important; font-weight:700 !important; }
cart-items .cart-item__final-price { color:#7b6dd3 !important; }
cart-items .quantity__button {
  color:var(--p) !important;
  border-radius:50%;
}
cart-items .quantity__button:hover { background:rgba(73,61,154,.06) !important; }
cart-items .quantity__input {
  color:var(--p) !important;
  font-weight:700;
}
cart-items .quantity.cart-quantity {
  width:156px;
  min-height:46px;
  border-radius:999px !important;
  background:#f5f3ff;
}
cart-items .quantity.cart-quantity::after {
  border-radius:999px !important;
  box-shadow:0 0 0 1px rgba(73,61,154,.16) !important;
}
cart-items cart-remove-button a {
  color:rgba(73,61,154,.4) !important;
  background:transparent !important;
  border:none !important;
  box-shadow:none !important;
}
cart-items cart-remove-button a:hover {
  color:#e53e3e !important;
  background:transparent !important;
  box-shadow:none !important;
  transform:none !important;
}
cart-items cart-remove-button a {
  min-width:36px !important;
  min-height:36px !important;
  border-radius:50% !important;
}
.cart-remove-label{display:none}
cart-items cart-remove-button a:hover {
  background:#fff0f0 !important;
}
cart-items .discounts__discount { color:#7b6dd3 !important; }
cart-items .cart__empty-text { color:var(--p) !important; font-weight:700 !important; }
cart-items .cart__warnings a.button {
  background:var(--p) !important;
  color:#fff !important;
  border-radius:50px !important;
  padding:13px 32px !important;
  font-weight:700 !important;
  border:none !important;
  box-shadow:0 4px 16px rgba(73,61,154,.25) !important;
}
cart-items .cart__warnings a.button:hover {
  background:#7b6dd3 !important;
  transform:translateY(-2px);
  box-shadow:0 8px 24px rgba(73,61,154,.3) !important;
}
cart-items .cart__warnings a.button::before,
cart-items .cart__warnings a.button::after { display:none !important; }
@media(max-width:749px){
  cart-items .page-width{padding-left:12px;padding-right:12px}
  cart-items .title-wrapper-with-link{align-items:center;margin-bottom:14px}
  cart-items .title--primary{font-size:28px}
  cart-items .underlined-link{
    padding:7px 11px;
    border:1px solid rgba(73,61,154,.14);
    border-radius:999px;
    background:#fff;
    font-size:11px;
    line-height:1;
    text-decoration:none !important;
  }
  cart-items .cart__items{
    padding:10px !important;
    border-radius:18px !important;
    box-shadow:0 8px 24px rgba(73,61,154,.06);
  }
  cart-items .cart-items thead{display:none}
  cart-items .cart-item{
    position:relative;
    grid-template-columns:100px minmax(0,1fr);
    grid-template-rows:auto auto auto;
    padding:12px;
    margin-bottom:9px;
    border:1px solid rgba(73,61,154,.09);
    border-radius:15px;
    background:#fbfaff;
    column-gap:12px;
    row-gap:8px;
  }
  cart-items .cart-item:not(:last-child) td{border-bottom:0 !important}
  cart-items .cart-items td{padding:0 !important}
  cart-items .cart-item__media{grid-column:1;grid-row:1/3}
  cart-items .cart-item__image-container{
    width:84px;
    height:84px;
    border-radius:12px !important;
  }
  cart-items .cart-item__image{
    width:84px !important;
    height:84px !important;
    max-width:84px !important;
    object-fit:cover;
  }
  cart-items .cart-item__details{grid-column:2;grid-row:1;min-width:0}
  cart-items .cart-item__details>*{max-width:100%}
  cart-items .cart-item__details .caption-with-letter-spacing{
    margin-bottom:3px;
    font-size:9px;
    line-height:1;
  }
  cart-items .cart-item__name{
    display:-webkit-box;
    overflow:hidden;
    font-size:13.5px;
    line-height:1.35;
    -webkit-box-orient:vertical;
    -webkit-line-clamp:2;
  }
  cart-items .cart-item__details .product-option{font-size:11px;line-height:1.35}
  cart-items .cart-item__unit-price{display:none}
  cart-items .cart-item__totals.medium-hide{
    grid-column:2;
    grid-row:2;
    align-self:center;
    justify-content:flex-start;
    white-space:nowrap;
  }
  cart-items .cart-item__totals .price{font-size:14px}
  cart-items .cart-item__quantity{
    grid-column:1/3;
    grid-row:3;
    padding-top:2px !important;
  }
  cart-items .cart-item__quantity-wrapper{
    align-items:center;
    justify-content:space-between;
    flex-wrap:nowrap;
    gap:8px;
  }
  cart-items .quantity.cart-quantity{width:122px;min-height:38px}
  cart-items .quantity__button{width:38px}
  cart-items cart-remove-button{
    flex:0 0 76px;
    width:76px;
    margin:0 0 0 auto;
  }
  cart-items cart-remove-button a{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:5px;
    width:76px !important;
    min-width:76px !important;
    min-height:38px !important;
    padding:0 11px !important;
    border:1px solid rgba(197,61,54,.12) !important;
    border-radius:999px !important;
    background:#fff0ee !important;
    color:#bd3d37 !important;
    font-size:11px;
    font-weight:700;
    line-height:1;
    white-space:nowrap;
  }
  cart-items cart-remove-button a:hover{background:#ffe5e1 !important;color:#a82e29 !important}
  cart-items cart-remove-button .svg-wrapper{display:none}
  cart-items .cart-remove-label{display:inline}
  cart-items .cart-item__error{margin-top:6px}
}
</style>

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<cart-items class="gradient color-{{ section.settings.color_scheme }} isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
  <div class="page-width">
    <div class="title-wrapper-with-link">
      <h1 class="title title--primary">{{ 'sections.cart.title' | t }}</h1>
      <a href="{{ routes.collections_url }}/ki-urunler" class="underlined-link">{{- 'general.continue_shopping' | t -}}</a>
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      <a href="{{ routes.collections_url }}/ki-urunler" class="button">{{ 'general.continue_shopping' | t }}</a>
      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">{{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}</p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            <table class="cart-items">
              <caption class="visually-hidden">{{ 'sections.cart.title' | t }}</caption>
              <thead>
                <tr>
                  <th class="caption-with-letter-spacing" colspan="2" scope="col">{{ 'sections.cart.headings.product' | t }}</th>
                  <th class="medium-hide large-up-hide right caption-with-letter-spacing" colspan="1" scope="col">{{ 'sections.cart.headings.total' | t }}</th>
                  <th class="cart-items__heading--wide cart-items__heading--quantity small-hide caption-with-letter-spacing" colspan="1" scope="col">{{ 'sections.cart.headings.quantity' | t }}</th>
                  <th class="small-hide right caption-with-letter-spacing" colspan="1" scope="col">{{ 'sections.cart.headings.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {%- for item in cart.items -%}
                  <tr class="cart-item{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}" id="CartItem-{{ item.index | plus: 1 }}">
                    <td class="cart-item__media">
                      {% if item.image %}
                        <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
                        <div class="cart-item__image-container gradient{% if item.parent_relationship.parent == null %} global-media-settings{% endif %}">
                          <img src="{{ item.image | image_url: width: 300 }}" class="cart-item__image{% if item.parent_relationship.parent != null %} global-media-settings{% endif %}" alt="{{ item.image.alt | escape }}" loading="lazy" width="150" height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}">
                        </div>
                      {% endif %}
                    </td>

                    <td class="cart-item__details">
                      {%- if settings.show_vendor -%}<p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>{%- endif -%}
                      <a href="{{ item.url }}" class="cart-item__name h4 break">{{ item.product.title | escape }}</a>
                      {%- if item.original_price != item.final_price -%}
                        <div class="cart-item__discounted-prices cart-item__unit-price">
                          <s class="cart-item__old-price product-option">{{- item.original_price | money -}}</s>
                          <strong class="cart-item__final-price product-option">{{ item.final_price | money }}</strong>
                        </div>
                      {%- else -%}
                        <div class="product-option cart-item__unit-price">{{ item.original_price | money }}</div>
                      {%- endif -%}
                      {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != null -%}
                        <dl>
                          {%- if item.product.has_only_default_variant == false -%}
                            {%- for option in item.options_with_values -%}
                              <div class="product-option"><dt>{{ option.name }}:</dt><dd>{{ option.value }}</dd></div>
                            {%- endfor -%}
                          {%- endif -%}
                          {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' -%}
                              <div class="product-option">
                                <dt>{{ property.first }}:</dt>
                                <dd>
                                  {%- if property.last contains '/uploads/' -%}
                                    <a href="{{ property.last }}" class="link" target="_blank">{{ property.last | split: '/' | last }}</a>
                                  {%- else -%}
                                    {{ property.last }}
                                  {%- endif -%}
                                </dd>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </dl>
                        <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                      {%- endif -%}
                      <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li class="discounts__discount">{{- 'icon-discount.svg' | inline_asset_content -}}{{ discount.discount_application.title | escape }}</li>
                        {%- endfor -%}
                      </ul>
                    </td>

                    <td class="cart-item__totals right medium-hide large-up-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dd><s class="cart-item__old-price price price--end">{{ item.original_line_price | money }}</s></dd>
                            <dd class="price price--end">{{ item.final_line_price | money }}</dd>
                          </dl>
                        {%- else -%}
                          <span class="price price--end">{{ item.original_line_price | money }}</span>
                        {%- endif -%}
                        {%- if item.variant.available and item.unit_price_measurement -%}{% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}{%- endif -%}
                      </div>
                    </td>

                    {%- liquid
                      assign has_qty_rules = false
                      if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                        assign has_qty_rules = true
                      endif
                      assign has_vol_pricing = false
                      if item.variant.quantity_price_breaks.size > 0
                        assign has_vol_pricing = true
                      endif
                    -%}
                    <td class="cart-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}">
                      <quantity-popover>
                        <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                          <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">{{ 'products.product.quantity.label' | t }}</label>
                          <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                            {%- if has_qty_rules or has_vol_pricing -%}
                              <button type="button" aria-expanded="false" class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide">{{- 'icon-info.svg' | inline_asset_content -}}</button>
                            {%- endif -%}
                            <quantity-input class="quantity cart-quantity">
                              {%- assign can_update_quantity = item.instructions.can_update_quantity | default: true -%}
                              <button class="quantity__button" name="minus" type="button"{% if can_update_quantity == false %} disabled{% endif %}>
                                <span class="visually-hidden">{{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}</span>
                                <span class="svg-wrapper">{{- 'icon-minus.svg' | inline_asset_content -}}</span>
                              </button>
                              <input class="quantity__input" data-quantity-variant-id="{{ item.variant.id }}" type="number" name="updates[]" value="{{ item.quantity }}" data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}" min="0" data-min="{{ item.variant.quantity_rule.min }}"{% if item.variant.quantity_rule.max != null %} max="{{ item.variant.quantity_rule.max }}"{% endif %} step="{{ item.variant.quantity_rule.increment }}" aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}" id="Quantity-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}"{% if can_update_quantity == false %} disabled{% endif %}>
                              <button class="quantity__button" name="plus" type="button"{% if can_update_quantity == false %} disabled{% endif %}>
                                <span class="visually-hidden">{{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}</span>
                                <span class="svg-wrapper">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
                              </button>
                            </quantity-input>
                          </div>
                          <cart-remove-button id="Remove-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}"{% assign can_remove = item.instructions.can_remove | default: true %}{% if can_remove == false %} class="hidden"{% endif %}>
                            <a href="{{ item.url_to_remove }}" class="button button--tertiary" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}">
                              <span class="svg-wrapper">{{- 'icon-remove.svg' | inline_asset_content -}}</span>
                              <span class="cart-remove-label">Sil</span>
                            </a>
                          </cart-remove-button>
                        </div>
                        {%- if has_qty_rules or has_vol_pricing -%}
                          <button type="button" class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide" aria-expanded="false">
                            {{- 'icon-info.svg' | inline_asset_content -}}
                            <span>{%- if has_vol_pricing -%}{{ 'products.product.volume_pricing.note' | t }}{%- elsif has_qty_rules -%}{{ 'products.product.quantity.note' | t }}{%- endif -%}</span>
                          </button>
                        {%- endif -%}
                        <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                          <small class="cart-item__error-text"></small>
                          <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                        </div>
                      </quantity-popover>
                    </td>

                    <td class="cart-item__totals right small-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dd><s class="cart-item__old-price price price--end">{{ item.original_line_price | money }}</s></dd>
                            <dd class="price price--end">{{ item.final_line_price | money }}</dd>
                          </dl>
                        {%- else -%}
                          <span class="price price--end">{{ item.original_line_price | money }}</span>
                        {%- endif -%}
                        {%- if item.variant.available and item.unit_price_measurement -%}{% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}{%- endif -%}
                      </div>
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
            {% render 'ki-cart-cross-sell', context: 'page' %}
          {%- endif -%}
        </div>
      </div>
      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p class="visually-hidden" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">{{ 'accessibility.loading' | t }}</p>
    </form>
  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {"type":"color_scheme","id":"color_scheme","label":"t:sections.all.colors.label","default":"scheme-1"},
    {"type":"header","content":"t:sections.all.padding.section_padding_heading"},
    {"type":"range","id":"padding_top","min":0,"max":100,"step":4,"unit":"px","label":"t:sections.all.padding.padding_top","default":36},
    {"type":"range","id":"padding_bottom","min":0,"max":100,"step":4,"unit":"px","label":"t:sections.all.padding.padding_bottom","default":36}
  ]
}
{% endschema %}
