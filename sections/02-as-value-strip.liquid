{% comment %}
  Value Strip — Marquee güven şeridi
  Pozisyon: Anasayfa #2 (Hero altı)
  Sürekli kayan ikon + başlık + açıklama listesi.
  Hover ile pause; kenarlardan fade gradient.
{% endcomment %}

<section id="value-strip-{{ section.id }}" class="section value-strip">
  <style>
    #value-strip-{{ section.id }} {
      --vs-bg: {{ section.settings.bg | default: '#f7f1e6' }};
      --vs-primary: {{ section.settings.primary_color | default: '#3a2d6e' }};
      --vs-muted: {{ section.settings.muted_color | default: 'rgba(26,26,26,.7)' }};
      --vs-border: {{ section.settings.border_color | default: 'rgba(0,0,0,.1)' }};
      --vs-icon-bg: {{ section.settings.icon_bg | default: '#fffaf3' }};
      --vs-speed: {{ section.settings.speed | default: 35 }}s;
      background: var(--vs-bg);
      border-top: 1px solid var(--vs-border);
      border-bottom: 1px solid var(--vs-border);
      overflow: hidden;
      font-family: system-ui, -apple-system, sans-serif;
    }

    #value-strip-{{ section.id }} .vs-track-wrap {
      position: relative;
      padding: 20px 0;
    }

    #value-strip-{{ section.id }} .vs-fade {
      position: absolute; inset-block: 0;
      width: 64px;
      pointer-events: none;
      z-index: 2;
    }
    #value-strip-{{ section.id }} .vs-fade--l { left: 0; background: linear-gradient(to right, var(--vs-bg), transparent); }
    #value-strip-{{ section.id }} .vs-fade--r { right: 0; background: linear-gradient(to left, var(--vs-bg), transparent); }

    #value-strip-{{ section.id }} .vs-track {
      display: flex; width: max-content;
      animation: vs-marquee var(--vs-speed) linear infinite;
    }
    #value-strip-{{ section.id }} .vs-track-wrap:hover .vs-track {
      animation-play-state: paused;
    }

    #value-strip-{{ section.id }} .vs-item {
      display: flex; align-items: center; gap: 10px;
      padding: 0 20px;
      flex-shrink: 0;
    }

    #value-strip-{{ section.id }} .vs-icon {
      width: 32px; height: 32px;
      border-radius: 50%;
      background: var(--vs-icon-bg);
      border: 1px solid var(--vs-border);
      display: grid; place-items: center;
      flex-shrink: 0;
      color: var(--vs-primary);
    }
    #value-strip-{{ section.id }} .vs-icon img,
    #value-strip-{{ section.id }} .vs-icon svg {
      width: 16px; height: 16px;
    }

    #value-strip-{{ section.id }} .vs-text { white-space: nowrap; min-width: 0; }
    #value-strip-{{ section.id }} .vs-title {
      font-size: 11.5px; font-weight: 700;
      color: var(--vs-primary);
      line-height: 1.2;
      margin: 0 0 2px;
    }
    #value-strip-{{ section.id }} .vs-desc {
      font-size: 10px;
      color: var(--vs-muted);
      line-height: 1.3;
      margin: 0;
    }

    @media (min-width: 640px) {
      #value-strip-{{ section.id }} .vs-track-wrap { padding: 36px 0; }
      #value-strip-{{ section.id }} .vs-item { padding: 0 40px; gap: 12px; }
      #value-strip-{{ section.id }} .vs-icon { width: 40px; height: 40px; }
      #value-strip-{{ section.id }} .vs-icon img,
      #value-strip-{{ section.id }} .vs-icon svg { width: 18px; height: 18px; }
      #value-strip-{{ section.id }} .vs-fade { width: 96px; }
      #value-strip-{{ section.id }} .vs-title { font-size: 13px; }
      #value-strip-{{ section.id }} .vs-desc { font-size: 11.5px; }
    }

    @keyframes vs-marquee {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }

    @media (prefers-reduced-motion: reduce) {
      #value-strip-{{ section.id }} .vs-track { animation: none; }
    }
  </style>

  <div class="vs-track-wrap">
    <div class="vs-fade vs-fade--l"></div>
    <div class="vs-fade vs-fade--r"></div>

    {%- if section.blocks.size > 0 -%}
      <div class="vs-track">
        {%- for repeat in (1..2) -%}
          {%- for block in section.blocks -%}
            <div class="vs-item" {{ block.shopify_attributes }}>
              <div class="vs-icon">
                {%- if block.settings.icon != blank -%}
                  {{ block.settings.icon | image_url: width: 80 | image_tag: alt: block.settings.title, loading: 'lazy' }}
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}
              </div>
              <div class="vs-text">
                <div class="vs-title">{{ block.settings.title }}</div>
                <div class="vs-desc">{{ block.settings.description }}</div>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Value Strip",
  "tag": "section",
  "class": "value-strip",
  "settings": [
    { "type": "color", "id": "bg", "label": "Arka plan", "default": "#f7f1e6" },
    { "type": "color", "id": "icon_bg", "label": "İkon kutusu arka planı", "default": "#fffaf3" },
    { "type": "color", "id": "border_color", "label": "Çerçeve rengi", "default": "#e5dfd1" },
    { "type": "color", "id": "primary_color", "label": "Başlık rengi", "default": "#3a2d6e" },
    { "type": "color", "id": "muted_color", "label": "Açıklama rengi", "default": "#5a5a5a" },
    {
      "type": "range", "id": "speed",
      "label": "Hız (saniye)",
      "min": 15, "max": 90, "step": 5, "default": 35,
      "info": "Daha düşük = daha hızlı"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Değer maddesi",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "İkon" },
        { "type": "text", "id": "title", "label": "Başlık", "default": "Klinik dozaj" },
        { "type": "text", "id": "description", "label": "Açıklama", "default": "Etkin maddeler bilimsel dozda" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value Strip",
      "blocks": [
        { "type": "value", "settings": { "title": "Klinik dozaj", "description": "Etkin maddeler bilimsel dozda" } },
        { "type": "value", "settings": { "title": "Vegan & temiz", "description": "Yapay tatlandırıcı içermez" } },
        { "type": "value", "settings": { "title": "GMP sertifikalı", "description": "Bağımsız laboratuvarda test" } },
        { "type": "value", "settings": { "title": "Ücretsiz kargo", "description": "Tüm Türkiye'ye, 1-2 iş günü" } },
        { "type": "value", "settings": { "title": "Doğal içerikler", "description": "Bitkisel & mineral kaynaklı" } },
        { "type": "value", "settings": { "title": "FDA onaylı tesis", "description": "Uluslararası standartlarda üretim" } },
        { "type": "value", "settings": { "title": "30 gün iade", "description": "Koşulsuz memnuniyet garantisi" } }
      ]
    }
  ]
}
{% endschema %}
