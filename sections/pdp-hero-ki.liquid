{% comment %}
  PDP Hero Ki — Brand colors + modern design
  UI-first. Backend (ATC + selling_plan) later.
{% endcomment %}

{%- assign pdp_product = section.settings.product | default: product -%}
{%- assign media_items = pdp_product.media -%}
{%- assign ki_ready_ped_pack_handles = '|ki-light-ped-paketi-15-adet|ki-medium-ped-paketi-22-adet|ki-yogun-gunler-ped-paketi-26-adet|' -%}
{%- assign ki_current_product_token = '|' | append: product.handle | append: '|' -%}

{%- if ki_ready_ped_pack_handles contains ki_current_product_token -%}
  {% render 'ki-care-bundle-product-content' %}
{%- else -%}
<section id="pdpki-{{ section.id }}" class="section">
  <style>
    #pdpki-{{ section.id }} {
      overflow-x: hidden; /* Prevent horizontal scroll on this section */
      /* Brand Kit */
      --ki-purple-dark: #493d9a;
      --ki-offwhite: #f8f8f6;
      --ki-purple: #b2a5ff;
      --ki-lilac: #dad2ff;

      /* Functional */
      --bg: {{ section.settings.bg }};
      --text: {{ section.settings.text }};
      --muted: {{ section.settings.muted }};
      --line: rgba(73,61,154,.12);

      --accent: var(--ki-purple);
      --accent-dark: var(--ki-purple-dark);
      --cta: {{ section.settings.cta_bg }};
      --cta_text: {{ section.settings.cta_text }};

      --radius: 16px;
      --radius-sm: 10px;
      --panel_max: 520px;
      --gap: clamp(28px, 5vw, 72px);

      background: var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', 
        Roboto, sans-serif;
    }

    #pdpki-{{ section.id }} .wrap {
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
      padding: {{ section.settings.pad_y }}px {{ section.settings.pad_x }}px;
      box-sizing: border-box;
    }

    #pdpki-{{ section.id }} .grid {
      display: flex;
      flex-wrap: wrap;
      gap: var(--gap);
      align-items: start;
    }
    #pdpki-{{ section.id }} .left { flex: 1.3 1 0%; min-width: 0; }
    #pdpki-{{ section.id }} .right { flex: 1 1 0%; min-width: 0; }

    /* ===== LEFT: Media Gallery ===== */
    #pdpki-{{ section.id }} .mediaCard {
      border-radius: var(--radius);
      overflow: hidden;
    }

    /* Dynamic Lilac Frame removed - flat look */
    #pdpki-{{ section.id }} .mediaStage {
      position: relative;
      background: var(--ki-offwhite);
      border-radius: var(--radius);
      overflow: hidden;
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      margin-left: auto;
      margin-right: auto;
    }

    #pdpki-{{ section.id }} .mediaMain {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    #pdpki-{{ section.id }} .mediaItem {
      flex: 0 0 100%;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      margin: 0;
    }

    #pdpki-{{ section.id }} .mediaMain img {
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      border-radius: var(--radius-sm);
      display: block;
    }
    
    #pdpki-{{ section.id }} .mediaMain video,
    #pdpki-{{ section.id }} .mediaMain iframe {
      width: 100%;
      height: 100%;
      object-fit: cover; /* Fill the square naturally */
      border-radius: var(--radius-sm);
      display: block;
      border: none;
    }

    #pdpki-{{ section.id }} .navBtn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 32px;
      height: 32px;
      border-radius: 999px;
      border: none;
      background: rgba(255, 255, 255, 0.4); /* Slight circular overlay */
      display: grid;
      place-items: center;
      cursor: pointer;
      user-select: none;
      transition: transform .2s ease, background .2s ease, opacity .2s ease;
      z-index: 10;
      opacity: 0.8;
      backdrop-filter: blur(2px); /* Soft glass effect for visibility */
    }
    #pdpki-{{ section.id }} .navBtn:hover {
      transform: translateY(-50%) scale(1.1);
      background: rgba(255, 255, 255, 0.7);
      opacity: 1;
    }
    #pdpki-{{ section.id }} .navPrev { left: 8px; }
    #pdpki-{{ section.id }} .navNext { right: 8px; }
    #pdpki-{{ section.id }} .navBtn svg {
      width: 20px;
      height: 20px;
      color: var(--ki-purple-dark);
    }

    #pdpki-{{ section.id }} .thumbs {
      margin-top: 16px;
      display: flex;
      gap: 12px;
      overflow-x: auto;
      padding: 4px 4px 12px 4px;
    }
    #pdpki-{{ section.id }} .thumb {
      flex-shrink: 0;
      width: 72px;
      height: 72px;
      border-radius: var(--radius-sm);
      border: 2px solid transparent;
      background: #fff;
      overflow: hidden;
      cursor: pointer;
      display: block;
      padding: 6px;
      transition: border-color .2s ease, transform .2s ease;
    }
    #pdpki-{{ section.id }} .thumb:hover {
      transform: translateY(-2px);
    }
    #pdpki-{{ section.id }} .thumb.is-active {
      border-color: var(--ki-purple-dark);
    }
    #pdpki-{{ section.id }} .thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 6px;
      display: block;
    }

    /* ===== RIGHT: Panel ===== */
    #pdpki-{{ section.id }} .panel {
      max-width: var(--panel_max);
    }

    /* Product Title */
    #pdpki-{{ section.id }} .productTitle {
      font-size: 28px;
      font-weight: 800;
      line-height: 1.2;
      margin: 0 0 8px 0;
      color: var(--ki-purple-dark);
    }

    #pdpki-{{ section.id }} .productSubtitle {
      font-size: 15px;
      color: var(--muted);
      margin: 0 0 20px 0;
      line-height: 1.5;
    }

    /* Offer headline */
    #pdpki-{{ section.id }} .offer {
      font-size: 14px;
      line-height: 1.5;
      font-weight: 500;
      margin: 0 0 18px 0;
      padding: 14px 16px;
      background: linear-gradient(135deg, 
        rgba(218,210,255,.3) 0%, 
        rgba(178,165,255,.2) 100%);
      border-radius: var(--radius-sm);
      border-left: 4px solid var(--ki-purple);
      color: var(--ki-purple-dark);
    }

    /* Options */
    #pdpki-{{ section.id }} .options {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 16px;
    }

    /* Review Stars Row */
    #pdpki-{{ section.id }} .reviewRow {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 14px;
      flex-wrap: wrap;
    }
    #pdpki-{{ section.id }} .reviewStars {
      display: inline-flex;
      align-items: center;
      gap: 2px;
    }
    #pdpki-{{ section.id }} .reviewStars svg {
      width: 18px;
      height: 18px;
    }
    #pdpki-{{ section.id }} .reviewText {
      font-size: 13px;
      font-weight: 600;
      color: var(--ki-purple-dark);
      line-height: 1.3;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    #pdpki-{{ section.id }} .reviewScore {
      font-size: 14px;
      font-weight: 700;
      color: var(--ki-purple-dark);
    }

    /* ========== CARD - Minimal Clean Design ========== */
    #pdpki-{{ section.id }} .card {
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #fff;
      overflow: hidden;
      transition: border-color .2s ease, box-shadow .2s ease;
      cursor: pointer;
    }
    #pdpki-{{ section.id }} .card:hover {
      border-color: var(--ki-purple);
    }
    #pdpki-{{ section.id }} .card.is-active {
      border-color: var(--ki-purple-dark);
      border-width: 2px;
    }

    /* Card Head - Single Row Layout */
    #pdpki-{{ section.id }} .cardHead {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      gap: 12px;
    }

    /* Left: Title + Badge */
    #pdpki-{{ section.id }} .cardLeft {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    #pdpki-{{ section.id }} .cardTitle {
      font-size: 15px;
      font-weight: 700;
      color: var(--ki-purple-dark);
      margin: 0;
    }

    #pdpki-{{ section.id }} .badge {
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      padding: 4px 8px;
      border-radius: 4px;
      background: var(--ki-purple);
      color: var(--ki-purple-dark);
      line-height: 1;
    }

    /* Right: Price */
    #pdpki-{{ section.id }} .cardRight {
      text-align: right;
      flex-shrink: 0;
    }

    #pdpki-{{ section.id }} .priceRow {
      display: flex;
      align-items: baseline;
      gap: 6px;
      justify-content: flex-end;
    }

    #pdpki-{{ section.id }} .priceOld {
      font-size: 13px;
      color: var(--muted);
      text-decoration: line-through;
    }

    #pdpki-{{ section.id }} .priceNow {
      font-size: 20px;
      font-weight: 800;
      color: var(--ki-purple-dark);
    }

    #pdpki-{{ section.id }} .pricePer {
      font-size: 11px;
      color: var(--muted);
    }

    /* Benefits - Compact */
    #pdpki-{{ section.id }} .benefits {
      display: none;
      background: var(--ki-offwhite);
      border-top: 1px solid var(--line);
      padding: 12px 16px;
      font-size: 13px;
      color: var(--text);
    }
    #pdpki-{{ section.id }} .card.is-active .benefits {
      display: block;
    }
    #pdpki-{{ section.id }} .benefits ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }
    #pdpki-{{ section.id }} .benefits li {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 3px 0;
      font-size: 12px;
    }
    #pdpki-{{ section.id }} .benefits li::before {
      content: "✓";
      font-weight: 700;
      color: var(--ki-purple-dark);
      font-size: 11px;
    }

    /* OR divider */
    #pdpki-{{ section.id }} .or {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 12px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .05em;
    }
    #pdpki-{{ section.id }} .or:before,
    #pdpki-{{ section.id }} .or:after {
      content: "";
      height: 1px;
      background: var(--line);
      display: block;
    }

    /* CTA Button */
    #pdpki-{{ section.id }} .cta {
      width: 100%;
      border: 0;
      cursor: pointer;
      padding: 16px 24px;
      border-radius: 999px;
      background: var(--cta);
      color: var(--cta_text);
      font-weight: 700;
      font-size: 16px;
      transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease;
      box-shadow: 0 6px 20px rgba(73,61,154,.3);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    #pdpki-{{ section.id }} .cta:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(73,61,154,.3);
    }
    #pdpki-{{ section.id }} .cta:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    /* Promo Box (New) */
    #pdpki-{{ section.id }} .promo-box {
      margin-top: 12px;
      padding: 12px 16px;
      background: #f4f0ff; /* Light purple bg */
      border-left: 5px solid var(--ki-purple); /* Thick accent border */
      border-radius: 8px;
      color: var(--ki-purple-dark);
      font-size: 14px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      line-height: 1.4;
      text-align: left;
    }

    /* Shipping */
    #pdpki-{{ section.id }} .ship {
      margin-top: 8px;
      display: flex;
      gap: 8px;
      justify-content: center;
      align-items: center;
      color: var(--muted);
      font-size: 13px;
    }
    #pdpki-{{ section.id }} .ship svg {
      width: 16px;
      height: 16px;
      color: var(--ki-purple-dark);
    }

    /* Disclaimer */
    #pdpki-{{ section.id }} .disc {
      margin-top: 16px;
      font-size: 11px;
      line-height: 1.6;
      color: var(--muted);
      text-align: center;
    }

    /* Trust badges */
    #pdpki-{{ section.id }} .trust {
      margin-top: 24px;
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }
    #pdpki-{{ section.id }} .trustItem {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--muted);
    }
    #pdpki-{{ section.id }} .trustItem svg {
      width: 18px;
      height: 18px;
      color: var(--ki-purple-dark);
    }

    /* Trust Logos Image */
    #pdpki-{{ section.id }} .trustLogos {
      margin-top: 12px;
      margin-bottom: 0;
      text-align: center;
      line-height: 0; /* Remove inline spacing */
    }
    #pdpki-{{ section.id }} .trustLogos img {
      max-width: 260px;
      max-height: 40px; /* Constrain to logo height */
      width: auto;
      height: auto;
      display: inline-block;
      opacity: 0.85;
      object-fit: contain;
    }
    @media (max-width: 990px) {
      #pdpki-{{ section.id }} .trustLogos img {
        max-width: 220px;
        max-height: 36px;
      }
    }
    #pdpki-{{ section.id }} .trustItem {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      color: var(--muted);
    }
    #pdpki-{{ section.id }} .trustItem svg {
      width: 18px;
      height: 18px;
      color: var(--ki-purple-dark);
    }

    #pdpki-{{ section.id }} .emptyNote {
      padding: 20px;
      border: 2px dashed var(--line);
      border-radius: var(--radius);
      background: var(--ki-offwhite);
      font-size: 14px;
      color: var(--muted);
      text-align: center;
      margin-bottom: 20px;
    }

    @media (max-width: 990px) {
      #pdpki-{{ section.id }} .wrap {
        padding: 24px 16px;
      }
      #pdpki-{{ section.id }} .grid {
        flex-direction: column;
        gap: 24px;
      }
      #pdpki-{{ section.id }} .left,
      #pdpki-{{ section.id }} .right {
        width: 100%;
        flex: none;
      }
      #pdpki-{{ section.id }} .mediaStage {
        padding: 0;
        aspect-ratio: 1 / 1;
        width: calc(100vw - 32px);
        max-width: 100%;
        margin: 0 auto;
        background: var(--ki-offwhite);
      }
      #pdpki-{{ section.id }} .mediaMain {
        width: 100%;
        height: 100%;
      }
      #pdpki-{{ section.id }} .mediaItem {
        width: 100%;
        height: 100%;
        flex: 0 0 100%;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      #pdpki-{{ section.id }} .mediaMain img {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
      }
      #pdpki-{{ section.id }} .mediaMain video,
      #pdpki-{{ section.id }} .mediaMain iframe {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      #pdpki-{{ section.id }} .navBtn {
        display: none !important;
      }
      #pdpki-{{ section.id }} .productTitle {
        font-size: 24px;
      }
      #pdpki-{{ section.id }} .productSubtitle {
        font-size: 14px;
      }
      #pdpki-{{ section.id }} .cardHead {
        padding: 12px 14px;
      }
      #pdpki-{{ section.id }} .cardTitle {
        font-size: 14px;
      }
      #pdpki-{{ section.id }} .priceNow {
        font-size: 18px;
      }
      #pdpki-{{ section.id }} .benefits {
        padding: 10px 14px;
      }
    }

    @media (max-width: 480px) {
      #pdpki-{{ section.id }} .cardHead {
        flex-wrap: wrap;
      }
      #pdpki-{{ section.id }} .cardLeft {
        flex: 1 1 60%;
      }
      #pdpki-{{ section.id }} .cardRight {
        flex: 1 1 auto;
      }
    }
    
    .pdp-mobile-header { display: none; }
    .pdp-desktop-header { display: block; text-align: left; margin-bottom: 20px; }

    @media (max-width: 990px) {
      .pdp-mobile-header { 
        display: block; 
        text-align: center;
        margin-bottom: 24px;
        padding: 0 16px; 
      }
      .pdp-desktop-header { display: none; }
    }
  </style>

  <div class="wrap">
    {% if pdp_product == blank %}
      <div class="emptyNote">
        Bölüm ayarlarından bir ürün seçin.
      </div>
    {% endif %}

    <!-- Header (Mobile Only) -->
    <div class="pdp-mobile-header">
      <h1 class="productTitle">{{ section.settings.product_title | default: pdp_product.title }}</h1>
      <p class="productSubtitle">{{ section.settings.product_subtitle }}</p>
    </div>

    <div class="grid">
      <!-- LEFT: Media Gallery -->
      <div class="left">
        <div class="mediaCard">
          <div class="mediaStage">
            <div class="mediaMain" data-main>
              {% if media_items and media_items.size > 0 %}
                {% for m in media_items %}
                  {% assign m_alt = m.alt | default: pdp_product.title %}
                  <div class="mediaItem" data-media-id="{{ m.id }}" data-index="{{ forloop.index0 }}">
                    {% case m.media_type %}
                      {% when 'image' %}
                        {{ m | image_url: width: 1600 | image_tag: loading: 'lazy', alt: m_alt }}
                      {% when 'video' %}
                        {{ m | video_tag: controls: true, autoplay: false, loop: false, muted: false, playsinline: true }}
                      {% when 'external_video' %}
                        {{ m | external_video_tag }}
                      {% else %}
                        {{ 'image' | placeholder_svg_tag }}
                    {% endcase %}
                  </div>
                {% endfor %}
              {% else %}
                <div class="mediaItem">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if media_items and media_items.size > 1 %}
              <button class="navBtn navPrev" type="button" aria-label="Önceki" data-prev>
                <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12.8 3.6 6.4 10l6.4 6.4 1.2-1.2L8.8 10l5.2-5.2-1.2-1.2z" fill="currentColor"/>
                </svg>
              </button>
              <button class="navBtn navNext" type="button" aria-label="Sonraki" data-next>
                <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M7.2 16.4 13.6 10 7.2 3.6 6 4.8 11.2 10 6 15.2l1.2 1.2z" fill="currentColor"/>
                </svg>
              </button>
            {% endif %}
          </div>

          {% if media_items and media_items.size > 1 %}
            <div class="thumbs" data-thumbs>
              {% for m in media_items %}
                {% assign thumb_alt = m.alt | default: pdp_product.title %}
                <button class="thumb {% if forloop.first %}is-active{% endif %}" type="button"
                  aria-label="Medya {{ forloop.index }}"
                  data-thumb
                  data-media-index="{{ forloop.index0 }}">
                  {% if m.preview_image %}
                    {{ m.preview_image | image_url: width: 220 | image_tag: loading: 'lazy', alt: thumb_alt }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag }}
                  {% endif %}
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      <!-- RIGHT: Offer Panel -->
      <div class="right">
        <div class="panel">
          
          <!-- Product Title (Desktop Only) -->
          <div class="pdp-desktop-header">
            <h1 class="productTitle">{{ section.settings.product_title | default: pdp_product.title }}</h1>
            <p class="productSubtitle">{{ section.settings.product_subtitle }}</p>
          </div>

          <!-- Offer Removed per request -->

          <!-- Review Stars -->
          {% if section.settings.review_text != blank %}
            {%- assign star_color = section.settings.star_color | default: '#f5a623' -%}
            {%- assign rating_val = section.settings.review_rating | default: '5' | times: 1.0 -%}
            <div class="reviewRow">
              <div class="reviewStars">
                {% for i in (1..5) %}
                  {%- assign fill_pct = 100 -%}
                  {%- if i > rating_val -%}
                    {%- assign diff = i | minus: rating_val -%}
                    {%- if diff >= 1 -%}
                      {%- assign fill_pct = 0 -%}
                    {%- else -%}
                      {%- assign fill_pct = 1.0 | minus: diff | times: 100 | round -%}
                    {%- endif -%}
                  {%- endif -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <linearGradient id="starGrad-{{ section.id }}-{{ i }}">
                        <stop offset="{{ fill_pct }}%" stop-color="{{ star_color }}"/>
                        <stop offset="{{ fill_pct }}%" stop-color="#ddd"/>
                      </linearGradient>
                    </defs>
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="url(#starGrad-{{ section.id }}-{{ i }})"/>
                  </svg>
                {% endfor %}
                <span class="reviewScore" style="margin-left: 4px;">{{ rating_val }}</span>
              </div>
              <div class="reviewText">
                <span>{{ section.settings.review_text }}</span>
              </div>
            </div>
          {% endif %}

          <!-- Options -->
          <div class="options">
            <!-- One-time Card (Default Selected) -->
            <div class="card is-active" 
              data-card="once" 
              data-select="once" 
              data-variant-id="{{ pdp_product.selected_or_first_available_variant.id }}"
              tabindex="0">
              <div class="cardHead">
                <div class="cardLeft">
                  <span class="cardTitle">{{ section.settings.once_title }}</span>
                  {% if section.settings.once_badge != blank %}
                    <span class="badge">{{ section.settings.once_badge }}</span>
                  {% endif %}
                </div>
                <div class="cardRight">
                  <div class="priceRow">
                    {% if section.settings.once_compare != blank %}
                      <span class="priceOld">{{ section.settings.once_compare }}</span>
                    {% endif %}
                    <span class="priceNow">{{ section.settings.once_price }}</span>
                  </div>
                  <div class="pricePer">{{ section.settings.once_per }}</div>
                </div>
              </div>
              <div class="benefits">
                {{ section.settings.once_note }}
              </div>
            </div>

            <div class="or">veya</div>

            <!-- Subscription Card -->
            {%- assign sub_product_obj = section.settings.sub_product -%}
            {%- assign sub_variant_id = sub_product_obj.selected_or_first_available_variant.id | default: pdp_product.selected_or_first_available_variant.id -%}
            <div class="card" 
              data-card="sub" 
              data-select="sub" 
              data-variant-id="{{ sub_variant_id }}"
              tabindex="0">
              <div class="cardHead">
                <div class="cardLeft">
                  <span class="cardTitle">{{ section.settings.sub_title }}</span>
                  {% if section.settings.sub_badge != blank %}
                    <span class="badge">{{ section.settings.sub_badge }}</span>
                  {% endif %}
                </div>
                <div class="cardRight">
                  <div class="priceRow">
                    {% if section.settings.sub_compare != blank %}
                      <span class="priceOld">{{ section.settings.sub_compare }}</span>
                    {% endif %}
                    <span class="priceNow">{{ section.settings.sub_price }}</span>
                  </div>
                  <div class="pricePer">{{ section.settings.sub_per }}</div>
                </div>
              </div>
