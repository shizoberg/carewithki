              {{ section.settings.trust_logos_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'Sertifikalar' }}
            </div>
          {% endif %}

          <!-- Disclaimer -->
          {% if section.settings.disclaimer != blank %}
            <div class="disc rte">{{ section.settings.disclaimer }}</div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <script>
    (function(){
      var root = document.getElementById('pdpki-{{ section.id }}');
      if(!root) return;

      var activeOption = 'once'; // default - Tek Seferlik seçili gelir

      // ===== Option cards (UI + selection tracking) =====
      var cards = root.querySelectorAll('.card');
      function activate(which){
        activeOption = which;
        cards.forEach(function(c){
          c.classList.toggle('is-active', c.getAttribute('data-card') === which);
        });
      }
      root.querySelectorAll('[data-select]').forEach(function(el){
        el.addEventListener('click', function(){ activate(el.getAttribute('data-select')); });
        el.addEventListener('keydown', function(e){
          if(e.key === 'Enter' || e.key === ' ') { 
            e.preventDefault(); 
            activate(el.getAttribute('data-select')); 
          }
        });
      });

      // ===== Add to Cart Logic =====
      var atcBtn = root.querySelector('[data-atc]');
      if(atcBtn){
        atcBtn.addEventListener('click', function(){
          var activeCard = root.querySelector('.card.is-active');
          if(!activeCard) {
            alert('Lütfen bir seçenek seçin');
            return;
          }

          var variantId = parseInt(activeCard.getAttribute('data-variant-id'), 10);


          if(!variantId || isNaN(variantId)){
            alert('Ürün varyantı bulunamadı');
            return;
          }

          // Disable button
          atcBtn.disabled = true;
          atcBtn.textContent = 'Ekleniyor...';

          // Build main item
          var mainItem = {
            id: variantId,
            quantity: 1
          };

          var formData = { items: [mainItem] };

          console.log('ATC Request:', JSON.stringify(formData));

          // AJAX Add to Cart
          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(formData)
          })
          .then(function(response){
            if(!response.ok){
              return response.json().then(function(err){
                throw new Error(err.description || err.message || 'Sepete eklenemedi');
              });
            }
            return response.json();
          })
          .then(function(data){
            console.log('ATC Success:', data);
            atcBtn.textContent = '✓ Sepete Eklendi!';
            setTimeout(function(){
              window.location.href = '/cart';
            }, 800);
          })
          .catch(function(error){
            console.error('Sepete eklenirken hata:', error);
            alert('Hata: ' + error.message);
            atcBtn.disabled = false;
            atcBtn.textContent = '{{ section.settings.cta_label }}';
          });
        });
      }

      // ===== Media gallery =====
      var thumbs = root.querySelectorAll('[data-thumb]');
      var main = root.querySelector('[data-main]');
      if(!main || thumbs.length === 0) return;

      var mediaData = {{ media_items | json }};
      var idx = 0;



      function setActiveThumb(i){
        thumbs.forEach(function(t){ t.classList.remove('is-active'); });
        if(thumbs[i]) thumbs[i].classList.add('is-active');
      }

      function go(i){
        if(!mediaData || !mediaData.length) return;
        idx = (i + mediaData.length) % mediaData.length;
        
        setActiveThumb(idx);
        
        // Slide to the correct image
        main.style.transform = 'translateX(-' + (idx * 100) + '%)';
      }

      thumbs.forEach(function(t){
        t.addEventListener('click', function(){
          var i = parseInt(t.getAttribute('data-media-index'), 10) || 0;
          go(i);
        });
      });

      var prev = root.querySelector('[data-prev]');
      var next = root.querySelector('[data-next]');
      if(prev) prev.addEventListener('click', function(){ go(idx - 1); });
      if(next) next.addEventListener('click', function(){ go(idx + 1); });

      // ===== Swipe Support =====
      var touchstartX = 0;
      var touchendX = 0;
      var stage = root.querySelector('.mediaStage');

      if(stage){
        stage.addEventListener('touchstart', function(e) {
          touchstartX = e.changedTouches[0].screenX;
        }, {passive: true});

        stage.addEventListener('touchend', function(e) {
          touchendX = e.changedTouches[0].screenX;
          handleGesture();
        }, {passive: true});
      }

      function handleGesture() {
        var threshold = 50;
        if (touchendX < touchstartX - threshold) go(idx + 1); // Swipe Left -> Next
        if (touchendX > touchstartX + threshold) go(idx - 1); // Swipe Right -> Prev
      }

      go(0);
    })();
  </script>
</section>
{%- endif -%}

