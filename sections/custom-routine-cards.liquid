{% comment %}Routine Cards — .ki v4 — unified typography{% endcomment %}


<style>
.rcs-{{ section.id }} {
  --p:   #493d9a;
  --lil: #dad2ff;
  --bg:  {{ section.settings.bg | default: '#ffffff' }};
  --r:   13px;
  --gap: 16px;
  background: var(--bg);
  padding: 52px 24px 64px;
}
.rcs-{{ section.id }} .rcs-wrap { max-width: 1400px; margin: 0 auto; }

.rcs-{{ section.id }} .rcs-header { max-width: 760px; margin-bottom: 32px; }
.rcs-{{ section.id }} .rcs-eyebrow {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 10px; font-weight: 700;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--p); opacity: 0.72; margin-bottom: 10px;
}
.rcs-{{ section.id }} .rcs-eyebrow::before {
  content: ''; display: inline-block;
  width: 18px; height: 1.5px; background: var(--p); opacity: 0.5;
}
.rcs-{{ section.id }} .rcs-title {
  font-family: 'Raleway', system-ui, sans-serif;
  font-size: clamp(26px, 3.4vw, 46px);
  font-weight: 800; line-height: 1.08;
  color: #1a1340; margin: 0 0 12px;
  letter-spacing: -0.025em;
}
.rcs-{{ section.id }} .rcs-title em { font-style: italic; color: var(--p); }
.rcs-{{ section.id }} .rcs-desc { font-size: 15px; line-height: 1.65; color: #888; margin: 0; }

.rcs-{{ section.id }} .rcs-track {
  display: flex; gap: var(--gap);
  overflow-x: auto; scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch; scrollbar-width: none;
  padding: 4px 2px 10px; cursor: grab;
}
.rcs-{{ section.id }} .rcs-track::-webkit-scrollbar { display: none; }
.rcs-{{ section.id }} .rcs-track.dragging { cursor: grabbing; }
.rcs-{{ section.id }} .rcs-slide { flex: 0 0 300px; scroll-snap-align: start; scroll-snap-stop: always; }
.rcs-{{ section.id }} .rcs-card {
  position: relative; border-radius: var(--r); overflow: hidden;
  aspect-ratio: 3/4; background: #e8e4f5; display: block;
  text-decoration: none; transition: transform .25s, box-shadow .25s;
  border: 1px solid rgba(73,61,154,.10);
}
.rcs-{{ section.id }} a.rcs-card:hover { transform: translateY(-5px); box-shadow: 0 20px 44px rgba(73,61,154,.20); }
.rcs-{{ section.id }} .rcs-card img,
.rcs-{{ section.id }} .rcs-card svg.placeholder-svg {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; display: block; pointer-events: none;
}
.rcs-{{ section.id }} .rcs-ov {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(20,12,60,.88) 0%, rgba(73,61,154,.42) 48%, transparent 100%);
  display: flex; flex-direction: column; justify-content: flex-end; padding: 20px 16px;
}
.rcs-{{ section.id }} .rcs-card-title { font-size: 17px; font-weight: 700; color: #fff; margin: 0 0 4px; line-height: 1.2; }
.rcs-{{ section.id }} .rcs-card-text  { font-size: 13px; line-height: 1.45; color: rgba(255,255,255,.88); margin: 0; }
.rcs-{{ section.id }} .rcs-cue {
  display: inline-flex; align-items: center; gap: 4px; margin-top: 9px;
  font-size: 11px; font-weight: 600; color: var(--lil);
  letter-spacing: .04em; text-transform: uppercase;
}
.rcs-{{ section.id }} .rcs-cue svg { width: 12px; height: 12px; }

.rcs-{{ section.id }} .rcs-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 20px; gap: 12px; flex-wrap: wrap; }
.rcs-{{ section.id }} .rcs-btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 13px 26px; border-radius: 999px; background: var(--p); color: #fff;
  text-decoration: none; font-size: 15px; font-weight: 700;
  transition: background .2s, transform .2s, box-shadow .2s; white-space: nowrap;
}
.rcs-{{ section.id }} .rcs-btn:hover { background: #3b3280; transform: translateY(-2px); box-shadow: 0 12px 28px rgba(73,61,154,.25); }
.rcs-{{ section.id }} .rcs-btn svg { width: 17px; height: 17px; flex-shrink: 0; }
.rcs-{{ section.id }} .rcs-nav { display: flex; gap: 10px; }
.rcs-{{ section.id }} .rcs-nav-btn {
  width: 40px; height: 40px; border-radius: 50%;
  border: 1px solid rgba(73,61,154,.22); background: transparent; color: var(--p);
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: all .2s; flex-shrink: 0;
}
.rcs-{{ section.id }} .rcs-nav-btn svg { width: 17px; height: 17px; }
.rcs-{{ section.id }} .rcs-nav-btn:hover { background: var(--p); color: #fff; border-color: var(--p); }

@media (max-width: 749px) {
  .rcs-{{ section.id }} { padding: 28px 14px 44px; }
  .rcs-{{ section.id }} .rcs-header { margin-bottom: 18px; }
  .rcs-{{ section.id }} .rcs-title { font-size: clamp(22px, 6.5vw, 32px); margin-bottom: 6px; }
  .rcs-{{ section.id }} .rcs-desc  { font-size: 14px; }
  .rcs-{{ section.id }} .rcs-slide { flex: 0 0 calc(50% - var(--gap) / 2); }
  .rcs-{{ section.id }} .rcs-slide:nth-child(odd)  { scroll-snap-align: start; }
  .rcs-{{ section.id }} .rcs-slide:nth-child(even) { scroll-snap-align: none; }
  .rcs-{{ section.id }} .rcs-card { aspect-ratio: 3/3.8; border-radius: 10px; }
  .rcs-{{ section.id }} .rcs-ov   { padding: 10px 9px; }
  .rcs-{{ section.id }} .rcs-card-title { font-size: 12px; }
  .rcs-{{ section.id }} .rcs-card-text  { font-size: 10.5px; }
  .rcs-{{ section.id }} .rcs-cue        { font-size: 9.5px; margin-top: 5px; }
  .rcs-{{ section.id }} .rcs-footer { margin-top: 14px; flex-wrap: nowrap; }
  .rcs-{{ section.id }} .rcs-btn { padding: 11px 18px; font-size: 13px; flex: 1; justify-content: center; min-width: 0; }
  .rcs-{{ section.id }} .rcs-nav { display: flex; flex-shrink: 0; }
  .rcs-{{ section.id }} .rcs-nav-btn { width: 36px; height: 36px; }
}
</style>

<section class="rcs-{{ section.id }}" id="RoutineCards-{{ section.id }}">
  <div class="rcs-wrap">
    <div class="rcs-header">
      {%- if section.settings.eyebrow != blank -%}<p class="rcs-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="rcs-title">{{ section.settings.title | escape }}</h2>{%- endif -%}
      {%- if section.settings.description != blank -%}<p class="rcs-desc">{{ section.settings.description | escape }}</p>{%- endif -%}
    </div>
    <div class="rcs-track" id="RcsTrack-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_url = ''
          if block.settings.card_product != blank
            assign card_url = block.settings.card_product.url
          elsif block.settings.card_link != blank
            assign card_url = block.settings.card_link
          endif
        -%}
        <div class="rcs-slide" {{ block.shopify_attributes }}>
          {%- if card_url != blank -%}<a href="{{ card_url }}" class="rcs-card" aria-label="{{ block.settings.title | escape }}">
          {%- else -%}<div class="rcs-card">
          {%- endif -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: widths: '280, 420, 560, 700', sizes: '(max-width: 749px) 82vw, 32vw', loading: 'lazy', decoding: 'async', alt: block.settings.title }}
            {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
            <div class="rcs-ov">
              {%- if block.settings.title != blank -%}<h3 class="rcs-card-title">{{ block.settings.title | escape }}</h3>{%- endif -%}
              {%- if block.settings.description != blank -%}<p class="rcs-card-text">{{ block.settings.description | escape }}</p>{%- endif -%}
              {%- if card_url != blank -%}<span class="rcs-cue">{{ block.settings.cta_label | default: 'İncele' }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>{%- endif -%}
            </div>
          {%- if card_url != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="rcs-footer">
      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="rcs-btn">
          {{ section.settings.button_text | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {%- endif -%}
      <div class="rcs-nav">
        <button class="rcs-nav-btn" id="RcsPrev-{{ section.id }}" type="button" aria-label="Önceki"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg></button>
        <button class="rcs-nav-btn" id="RcsNext-{{ section.id }}" type="button" aria-label="Sonraki"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></button>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  var sid = {{ section.id | json }};
  var track = document.getElementById('RcsTrack-' + sid);
  if (!track) return;
  var down = false, sx, sl;
  track.addEventListener('mousedown', function(e){ if (window.innerWidth <= 749) return; down = true; sx = e.pageX - track.offsetLeft; sl = track.scrollLeft; track.classList.add('dragging'); });
  document.addEventListener('mouseup', function(){ down = false; track.classList.remove('dragging'); });
  track.addEventListener('mousemove', function(e){ if (!down) return; e.preventDefault(); track.scrollLeft = sl - (e.pageX - track.offsetLeft - sx) * 1.5; });
  function scrollAmount() { var slide = track.querySelector('.rcs-slide'); if (!slide) return 320; var gap = parseFloat(getComputedStyle(track).gap) || 16; return window.innerWidth <= 749 ? slide.offsetWidth * 2 + gap : slide.offsetWidth + gap; }
  var prev = document.getElementById('RcsPrev-' + sid);
  var next = document.getElementById('RcsNext-' + sid);
  if (prev) prev.addEventListener('click', function(){ track.scrollBy({ left: -scrollAmount(), behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function(){ track.scrollBy({ left:  scrollAmount(), behavior: 'smooth' }); });
})();
</script>

{% schema %}
{
  "name": "Routine Cards (.ki)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color",    "id": "bg",          "label": "Arka plan",    "default": "#ffffff" },
    { "type": "text",     "id": "eyebrow",     "label": "Üst etiket",   "info": "Örn: Takviye Çözümleri" },
    { "type": "text",     "id": "title",       "label": "Başlık",       "default": "Kadınlar İçin Modern Takviye Çözümleri" },
    { "type": "textarea","id": "description", "label": "Açıklama" },
    { "type": "header",  "content": "Alt buton" },
    { "type": "text",    "id": "button_text",  "label": "Buton metni",  "default": "Formülü Keşfet" },
    { "type": "url",     "id": "button_link",  "label": "Buton linki" }
  ],
  "blocks": [
    { "type": "card", "name": "Kart", "settings": [
      { "type": "image_picker", "id": "image",       "label": "Görsel" },
      { "type": "text",        "id": "title",       "label": "Başlık",    "default": "Yorgunluk ve Enerji" },
      { "type": "textarea",   "id": "description", "label": "Açıklama", "default": "Enerji metabolizmasını destekler." },
      { "type": "header",     "content": "Bağlantı" },
      { "type": "product",    "id": "card_product","label": "Ürün seç" },
      { "type": "url",        "id": "card_link",   "label": "Özel URL" },
      { "type": "text",       "id": "cta_label",   "label": "CTA etiketi", "default": "İncele" }
    ]}
  ],
  "presets": [{ "name": "Routine Cards (.ki)", "blocks": [{"type":"card"},{"type":"card"},{"type":"card"},{"type":"card"}] }]
}
{% endschema %}
