{% comment %}
  .ki Subscription Cards (scoped) — Brand Kit
  Block-driven subscription cards. Each card has header strip (title, freq, status),
  item list, and aside summary (next delivery / payment / total) + actions.

  Brand kit:
    #493d9a / #f8f8f6 / #b2a5ff / #dad2ff
{% endcomment %}

<section id="mshsub-{{ section.id }}" class="section">
  <style>
    #mshsub-{{ section.id }}{
      --ki-purple-dark: #493d9a;
      --ki-offwhite: #f8f8f6;
      --ki-purple: #b2a5ff;
      --ki-lilac: #dad2ff;

      --bg: {{ section.settings.bg | default: '#ffffff' }};
      --text: {{ section.settings.text | default: '#1a1a1a' }};
      --muted: {{ section.settings.muted | default: 'rgba(26,26,26,.64)' }};
      --line: rgba(73,61,154,.14);

      --maxw: {{ section.settings.max_width | default: 1400 }}px;
      --py: {{ section.settings.pad_y | default: 40 }}px;
      --px: {{ section.settings.pad_x | default: 32 }}px;

      background: var(--bg); color: var(--text);
    }
    #mshsub-{{ section.id }} .mshsub__wrap{ max-width: var(--maxw); margin: 0 auto; padding: var(--py) var(--px); }
    #mshsub-{{ section.id }} .mshsub__grid{ display: grid; gap: 20px; }

    #mshsub-{{ section.id }} .mshsub__card{
      overflow: hidden; border-radius: 18px; border: 1px solid var(--line); background: #fff;
      box-shadow: 0 18px 40px rgba(73,61,154,.14); transition: transform .2s, box-shadow .2s;
    }
    #mshsub-{{ section.id }} .mshsub__card:hover{
      transform: translateY(-4px); box-shadow: 0 22px 50px rgba(73,61,154,.18);
    }

    #mshsub-{{ section.id }} .mshsub__head{
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
      padding: 16px 24px; border-bottom: 1px solid var(--line);
      background: linear-gradient(90deg, rgba(218,210,255,.40), rgba(218,210,255,0));
    }
    #mshsub-{{ section.id }} .mshsub__hl{ display: flex; align-items: center; gap: 12px; }
    #mshsub-{{ section.id }} .mshsub__ico{
      width: 40px; height: 40px; border-radius: 999px;
      background: linear-gradient(135deg, var(--ki-purple-dark), var(--ki-purple));
      color: #fff; display: grid; place-items: center; flex-shrink: 0;
    }
    #mshsub-{{ section.id }} .mshsub__name{ margin: 0; font-size: 16px; font-weight: 650; line-height: 1.2; color: var(--text); }
    #mshsub-{{ section.id }} .mshsub__meta{ margin: 2px 0 0; font-size: 12px; color: var(--muted); }

    #mshsub-{{ section.id }} .mshsub__status{
      display: inline-flex; align-items: center; padding: 4px 12px; border-radius: 999px;
      font-size: 12px; font-weight: 500; border: 1px solid transparent;
    }
    #mshsub-{{ section.id }} .mshsub__status--active{ background: rgba(54,179,126,.10); color: #1f8457; border-color: rgba(54,179,126,.2); }
    #mshsub-{{ section.id }} .mshsub__status--paused{ background: rgba(234,168,26,.12); color: #8a6100; border-color: rgba(234,168,26,.24); }
    #mshsub-{{ section.id }} .mshsub__status--canceled{ background: #f4f3ef; color: var(--muted); border-color: var(--line); }

    #mshsub-{{ section.id }} .mshsub__body{
      display: grid; gap: 24px; padding: 24px; grid-template-columns: 1fr;
    }
    @media (min-width: 900px){
      #mshsub-{{ section.id }} .mshsub__body{ grid-template-columns: 1fr 300px; }
    }

    #mshsub-{{ section.id }} .mshsub__items{ display: flex; flex-direction: column; gap: 12px; }
    #mshsub-{{ section.id }} .mshsub__item{ display: flex; align-items: center; gap: 12px; }
    #mshsub-{{ section.id }} .mshsub__img{
      width: 56px; height: 56px; border-radius: 12px; object-fit: cover;
      box-shadow: inset 0 0 0 1px var(--line);
    }
    #mshsub-{{ section.id }} .mshsub__itemMain{ min-width: 0; flex: 1; }
    #mshsub-{{ section.id }} .mshsub__itemName{ margin: 0; font-size: 14px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #mshsub-{{ section.id }} .mshsub__itemVar{ margin: 2px 0 0; font-size: 12px; color: var(--muted); }
    #mshsub-{{ section.id }} .mshsub__itemPrice{ font-size: 14px; font-weight: 500; font-variant-numeric: tabular-nums; white-space: nowrap; }

    #mshsub-{{ section.id }} .mshsub__aside{
      border-radius: 14px; padding: 20px; background: var(--ki-offwhite); border: 1px solid var(--line);
    }
    #mshsub-{{ section.id }} .mshsub__dl{ display: flex; flex-direction: column; gap: 12px; margin: 0; font-size: 14px; }
    #mshsub-{{ section.id }} .mshsub__row{ display: flex; justify-content: space-between; align-items: center; }
    #mshsub-{{ section.id }} .mshsub__dt{ display: inline-flex; align-items: center; gap: 8px; color: var(--muted); }
    #mshsub-{{ section.id }} .mshsub__dd{ font-weight: 500; font-variant-numeric: tabular-nums; }
    #mshsub-{{ section.id }} .mshsub__total{ border-top: 1px solid var(--line); padding-top: 12px; margin-top: 4px; }
    #mshsub-{{ section.id }} .mshsub__total .mshsub__dd{ font-weight: 650; }

    #mshsub-{{ section.id }} .mshsub__actions{ margin-top: 20px; display: flex; flex-direction: column; gap: 8px; }
    #mshsub-{{ section.id }} .mshsub__btn{
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 0 16px; height: 40px; border-radius: 999px; font-size: 13px; font-weight: 650;
      cursor: pointer; text-decoration: none; border: 1px solid transparent; transition: transform .2s, box-shadow .2s, background .2s;
    }
    #mshsub-{{ section.id }} .mshsub__btn--primary{ background: var(--ki-purple-dark); color: #fff; }
    #mshsub-{{ section.id }} .mshsub__btn--primary:hover{ transform: translateY(-2px); box-shadow: 0 14px 28px rgba(73,61,154,.24); }
    #mshsub-{{ section.id }} .mshsub__btn--outline{ background: #fff; color: var(--text); border-color: var(--line); }
    #mshsub-{{ section.id }} .mshsub__btn--outline:hover{ background: var(--ki-lilac); border-color: rgba(73,61,154,.28); }
    #mshsub-{{ section.id }} .mshsub__btn--danger{ color: #b3261e; }
    #mshsub-{{ section.id }} .mshsub__btn--danger:hover{ background: rgba(179,38,30,.06); }
    #mshsub-{{ section.id }} .mshsub__split{ display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    #mshsub-{{ section.id }} .mshsub__btn:focus-visible{ outline: 2px solid var(--ki-purple-dark); outline-offset: 2px; }

    @media (max-width: 750px){
      #mshsub-{{ section.id }} .mshsub__wrap{ padding: 24px 16px; }
      #mshsub-{{ section.id }} .mshsub__body{ padding: 20px; gap: 16px; }
      #mshsub-{{ section.id }} .mshsub__head{ padding: 14px 20px; }
    }
  </style>

  <div class="mshsub__wrap">
    <div class="mshsub__grid">
      {% for block in section.blocks %}
        {% if block.type == 'subscription' %}
          {% assign status = block.settings.status | default: 'active' %}
          <article class="mshsub__card" {{ block.shopify_attributes }}>
            <div class="mshsub__head">
              <div class="mshsub__hl">
                <div class="mshsub__ico" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                </div>
                <div>
                  <h3 class="mshsub__name">{{ block.settings.title }}</h3>
                  <p class="mshsub__meta">{{ block.settings.frequency_label }} · {{ block.settings.item_count }} ürün</p>
                </div>
              </div>
              <span class="mshsub__status mshsub__status--{{ status }}">{{ block.settings.status_label }}</span>
            </div>

            <div class="mshsub__body">
              <div class="mshsub__items">
                {% if block.settings.item1_name != blank %}
                  <div class="mshsub__item">
                    <img class="mshsub__img" src="{{ block.settings.item1_image }}" alt="{{ block.settings.item1_name | escape }}" width="{{ block.settings.item1_image.width | default: 80 }}" height="{{ block.settings.item1_image.height | default: 80 }}" loading="lazy" decoding="async">
                    <div class="mshsub__itemMain">
                      <p class="mshsub__itemName">{{ block.settings.item1_name }}</p>
                      <p class="mshsub__itemVar">{{ block.settings.item1_variant }}</p>
                    </div>
                    <span class="mshsub__itemPrice">{{ block.settings.item1_price }}</span>
                  </div>
                {% endif %}
                {% if block.settings.item2_name != blank %}
                  <div class="mshsub__item">
                    <img class="mshsub__img" src="{{ block.settings.item2_image }}" alt="{{ block.settings.item2_name | escape }}" width="{{ block.settings.item2_image.width | default: 80 }}" height="{{ block.settings.item2_image.height | default: 80 }}" loading="lazy" decoding="async">
                    <div class="mshsub__itemMain">
                      <p class="mshsub__itemName">{{ block.settings.item2_name }}</p>
                      <p class="mshsub__itemVar">{{ block.settings.item2_variant }}</p>
                    </div>
                    <span class="mshsub__itemPrice">{{ block.settings.item2_price }}</span>
                  </div>
                {% endif %}
                {% if block.settings.item3_name != blank %}
                  <div class="mshsub__item">
                    <img class="mshsub__img" src="{{ block.settings.item3_image }}" alt="{{ block.settings.item3_name | escape }}" width="{{ block.settings.item3_image.width | default: 80 }}" height="{{ block.settings.item3_image.height | default: 80 }}" loading="lazy" decoding="async">
                    <div class="mshsub__itemMain">
                      <p class="mshsub__itemName">{{ block.settings.item3_name }}</p>
                      <p class="mshsub__itemVar">{{ block.settings.item3_variant }}</p>
                    </div>
                    <span class="mshsub__itemPrice">{{ block.settings.item3_price }}</span>
                  </div>
                {% endif %}
              </div>

              <aside class="mshsub__aside">
                <dl class="mshsub__dl">
                  <div class="mshsub__row">
                    <dt class="mshsub__dt">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                      Sonraki teslimat
                    </dt>
                    <dd class="mshsub__dd">{{ block.settings.next_delivery }}</dd>
                  </div>
                  <div class="mshsub__row">
                    <dt class="mshsub__dt">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                      Sonraki ödeme
                    </dt>
                    <dd class="mshsub__dd">{{ block.settings.next_payment }}</dd>
                  </div>
                  <div class="mshsub__row mshsub__total">
                    <dt class="mshsub__dt">Tutar</dt>
                    <dd class="mshsub__dd">{{ block.settings.total }}</dd>
                  </div>
                </dl>

                <div class="mshsub__actions">
                  <a href="{{ block.settings.edit_href | default: '#' }}" class="mshsub__btn mshsub__btn--primary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    Sepeti düzenle
                  </a>
                  <div class="mshsub__split">
                    <a href="{{ block.settings.pause_href | default: '#' }}" class="mshsub__btn mshsub__btn--outline">
                      {% if status == 'active' %}
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                        Duraklat
                      {% else %}
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                        Devam et
                      {% endif %}
                    </a>
                    <a href="{{ block.settings.cancel_href | default: '#' }}" class="mshsub__btn mshsub__btn--outline mshsub__btn--danger">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                      İptal et
                    </a>
                  </div>
                </div>
              </aside>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MSH · Subscription cards",
  "settings": [
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text", "label": "Text", "default": "#1a1a1a" },
    { "type": "color", "id": "muted", "label": "Muted", "default": "#493d9a" },
    { "type": "range", "id": "max_width", "label": "Max width (px)", "min": 1000, "max": 1600, "step": 10, "default": 1400 },
    { "type": "range", "id": "pad_y", "label": "Vertical padding (px)", "min": 16, "max": 120, "step": 4, "default": 40 },
    { "type": "range", "id": "pad_x", "label": "Horizontal padding (px)", "min": 12, "max": 80, "step": 2, "default": 32 }
  ],
  "blocks": [
    {
      "type": "subscription",
      "name": "Abonelik",
      "settings": [
        { "type": "text", "id": "title", "label": "Başlık", "default": "Günlük Vitamin Paketi" },
        { "type": "text", "id": "frequency_label", "label": "Sıklık etiketi", "default": "Ayda bir" },
        { "type": "text", "id": "item_count", "label": "Ürün adedi", "default": "3" },
        {
          "type": "select", "id": "status", "label": "Durum",
          "options": [
            { "value": "active", "label": "Aktif" },
            { "value": "paused", "label": "Duraklatıldı" },
            { "value": "canceled", "label": "İptal edildi" }
          ],
          "default": "active"
        },
        { "type": "text", "id": "status_label", "label": "Durum etiketi", "default": "Aktif" },
        { "type": "text", "id": "next_delivery", "label": "Sonraki teslimat", "default": "8 Mayıs 2026" },
        { "type": "text", "id": "next_payment", "label": "Sonraki ödeme", "default": "6 Mayıs 2026" },
        { "type": "text", "id": "total", "label": "Tutar", "default": "749 ₺" },
        { "type": "url", "id": "edit_href", "label": "Düzenle linki" },
        { "type": "url", "id": "pause_href", "label": "Duraklat linki" },
        { "type": "url", "id": "cancel_href", "label": "İptal linki" },

        { "type": "header", "content": "Ürün 1" },
        { "type": "text", "id": "item1_name", "label": "Ad", "default": "Magnezyum Glisinat" },
        { "type": "text", "id": "item1_variant", "label": "Varyant", "default": "60 kapsül · Adet 1" },
        { "type": "text", "id": "item1_price", "label": "Fiyat", "default": "299 ₺" },
        { "type": "image_picker", "id": "item1_image", "label": "Görsel" },

        { "type": "header", "content": "Ürün 2" },
        { "type": "text", "id": "item2_name", "label": "Ad", "default": "Vitamin D3 + K2" },
        { "type": "text", "id": "item2_variant", "label": "Varyant", "default": "30 ml damla · Adet 1" },
        { "type": "text", "id": "item2_price", "label": "Fiyat", "default": "219 ₺" },
        { "type": "image_picker", "id": "item2_image", "label": "Görsel" },

        { "type": "header", "content": "Ürün 3" },
        { "type": "text", "id": "item3_name", "label": "Ad", "default": "Omega 3" },
        { "type": "text", "id": "item3_variant", "label": "Varyant", "default": "90 softgel · Adet 1" },
        { "type": "text", "id": "item3_price", "label": "Fiyat", "default": "231 ₺" },
        { "type": "image_picker", "id": "item3_image", "label": "Görsel" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MSH · Subscription cards",
      "blocks": [
        { "type": "subscription" },
        {
          "type": "subscription",
          "settings": {
            "title": "Cilt Bakım Rutini",
            "frequency_label": "2 ayda bir",
            "item_count": "2",
            "status": "paused",
            "status_label": "Duraklatıldı",
            "next_delivery": "2 Haziran 2026",
            "next_payment": "31 Mayıs 2026",
            "total": "489 ₺",
            "item1_name": "Hyaluronik Asit Serum",
            "item1_variant": "30 ml · Adet 1",
            "item1_price": "269 ₺",
            "item2_name": "C Vitamini Tonik",
            "item2_variant": "150 ml · Adet 1",
            "item2_price": "220 ₺",
            "item3_name": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
