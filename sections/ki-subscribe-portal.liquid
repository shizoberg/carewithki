    { "type": "text", "id": "subscribe_link", "label": "Abone ol linki (fallback)", "default": "/pages/paket-olustur", "info": "URL veya path (örn: /pages/paket-olustur)." }
  ],
  "presets": [{ "name": "Subscribe portal" }]
}
