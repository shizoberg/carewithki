{% comment %}
  ki-subscribe-portal — Profilim sayfası (Lovable Profil.tsx parite).
  3 tab: Siparişler (Shopify orders) | Abonelikler (backend /api/portal/me) | Kullanıcı Bilgileri (Shopify customer).
  Misafir kullanıcı → /account/login (return_url=portal). Shopify /account hiç gösterilmez.
{% endcomment %}

{%- comment -%} ===== Misafir guard: server-side redirect, hiç render etmeden ===== {%- endcomment -%}
{%- unless customer -%}
  {%- assign portal_login_url = routes.storefront_login_url | default: routes.account_login_url -%}
  {%- comment -%}
    Misafir guard — CSP-safe: meta refresh (HTML-only, JS gerektirmez).
    Shopify storefront strict CSP'sinde inline script bloke olur; meta refresh hep çalışır.
  {%- endcomment -%}
  <meta http-equiv="refresh" content="0; url={{ portal_login_url }}">
  <div style="padding:40px 16px;text-align:center;font-family:system-ui;">
    <h1 style="font-size:20px;color:#3a2d6e;margin:0 0 8px;">Giriş ekranına yönlendiriliyorsun…</h1>
    <p style="margin:12px 0 24px;color:#5a5a5a;">Otomatik yönlendirilmezse aşağıdaki butona tıkla.</p>
    <a href="{{ portal_login_url }}" style="display:inline-block;padding:14px 28px;background:#493d9a;color:#fff;border-radius:999px;font-weight:700;text-decoration:none;">Giriş Yap</a>
  </div>
{%- endunless -%}

{%- if customer -%}
<section id="ki-{{ section.id }}" class="ki-section ki-profile" data-ki-section="profile">
  <style>
    /* ================ Reset / Base ================ */
    #ki-{{ section.id }} { background: var(--ki-bg, #fffaf3); }
    #ki-{{ section.id }} .ki-pr__hero {
      background: var(--ki-plum-pale, #f4f3fb);
      border-bottom: 1px solid var(--ki-border, rgba(0,0,0,.08));
      padding: 24px 0 0;
    }
    #ki-{{ section.id }} .ki-pr__wrap {
      max-width: 1080px;
      margin: 0 auto;
      padding: 0 20px;
    }
    #ki-{{ section.id }} .ki-pr__head {
      display: flex; align-items: center; justify-content: space-between;
      gap: 14px;
      padding-bottom: 16px;
    }
    #ki-{{ section.id }} .ki-pr__avatar {
      display: flex; align-items: center; gap: 12px;
    }
    #ki-{{ section.id }} .ki-pr__avatar-circle {
      width: 40px; height: 40px;
      border-radius: 50%;
      background: var(--ki-primary, #3a2d6e);
      color: var(--ki-primary-fg, #fff);
      display: grid; place-items: center;
      font-size: 14px; font-weight: 700;
    }
    #ki-{{ section.id }} .ki-pr__eyebrow {
      font-size: 11px; font-weight: 700;
      letter-spacing: .15em; text-transform: uppercase;
      color: var(--ki-primary-medium, #5946b3);
      line-height: 1;
    }
    #ki-{{ section.id }} .ki-pr__greeting {
      font-size: 15px; font-weight: 700;
      color: var(--ki-primary, #3a2d6e);
      margin-top: 4px;
    }
    #ki-{{ section.id }} .ki-pr__logout {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 8px 14px;
      border: 1px solid rgba(0,0,0,.12);
      border-radius: 999px;
      background: var(--ki-card, #fff);
      color: var(--ki-muted, #5a5a5a);
      font-size: 12.5px; font-weight: 600;
      text-decoration: none;
      transition: border-color .15s, color .15s;
    }
    #ki-{{ section.id }} .ki-pr__logout:hover { border-color: var(--ki-primary, #3a2d6e); color: var(--ki-primary, #3a2d6e); }

    /* ================ Desktop tabs ================ */
    #ki-{{ section.id }} .ki-pr__tabs-desktop {
      display: none;
      gap: 24px;
      border-top: 1px solid rgba(0,0,0,.08);
      padding-top: 8px;
    }
    #ki-{{ section.id }} .ki-pr__tab-btn {
      padding: 12px 4px 14px;
      border: 0; background: transparent;
      font-family: var(--ki-font-primary);
      font-size: 15px; font-weight: 500;
      color: var(--ki-muted, #5a5a5a);
      cursor: pointer;
      border-bottom: 2px solid transparent;
      display: inline-flex; align-items: center; gap: 8px;
    }
    #ki-{{ section.id }} .ki-pr__tab-btn:hover { color: var(--ki-primary, #3a2d6e); }
    #ki-{{ section.id }} .ki-pr__tab-btn.is-active {
      color: var(--ki-primary, #3a2d6e);
      border-bottom-color: var(--ki-primary, #3a2d6e);
      font-weight: 700;
    }

    /* ================ Mobile tab pill row ================ */
    #ki-{{ section.id }} .ki-pr__tabs-mobile {
      display: flex; gap: 6px;
      overflow-x: auto;
      padding: 16px 0 8px;
      scrollbar-width: none;
    }
    #ki-{{ section.id }} .ki-pr__tabs-mobile::-webkit-scrollbar { display: none; }
    #ki-{{ section.id }} .ki-pr__tabs-mobile .ki-pr__tab-btn {
      flex-shrink: 0;
      padding: 9px 14px;
      border-radius: 999px;
      background: var(--ki-card, #fff);
      border: 1px solid rgba(0,0,0,.1);
      font-size: 12.5px;
      border-bottom: 1px solid rgba(0,0,0,.1);
      white-space: nowrap;
    }
    #ki-{{ section.id }} .ki-pr__tabs-mobile .ki-pr__tab-btn.is-active {
      background: var(--ki-primary, #3a2d6e);
      color: var(--ki-primary-fg, #fff);
      border-color: var(--ki-primary, #3a2d6e);
    }

    @media (min-width: 768px) {
      #ki-{{ section.id }} .ki-pr__tabs-desktop { display: flex; }
      #ki-{{ section.id }} .ki-pr__tabs-mobile { display: none; }
    }

    /* ================ Body ================ */
    #ki-{{ section.id }} .ki-pr__body { padding: 24px 0 80px; }
    #ki-{{ section.id }} .ki-pr__view { display: none; }
    #ki-{{ section.id }} .ki-pr__view.is-active { display: block; }

    /* ================ Cards (paylaşılan) ================ */
    #ki-{{ section.id }} .ki-pr__card {
      background: var(--ki-card, #fff);
      border: 1px solid rgba(0,0,0,.08);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 14px;
    }
    #ki-{{ section.id }} .ki-pr__card h3 {
      font-family: var(--ki-font-primary);
      font-size: 18px; font-weight: 500;
      color: var(--ki-primary, #3a2d6e);
      margin: 0 0 12px;
    }

    /* ================ Section header ================ */
    #ki-{{ section.id }} .ki-pr__section-head {
      display: flex; justify-content: space-between; align-items: center; gap: 12px;
      margin-bottom: 16px; flex-wrap: wrap;
    }
    #ki-{{ section.id }} .ki-pr__section-title {
      font-family: var(--ki-font-primary);
      font-size: 24px; font-weight: 500;
      color: var(--ki-primary, #3a2d6e);
      margin: 0;
    }
    #ki-{{ section.id }} .ki-pr__section-desc {
      font-size: 13px; color: var(--ki-muted, #5a5a5a);
      margin: 4px 0 0;
    }
    #ki-{{ section.id }} .ki-pr__section-cta {
      padding: 9px 18px;
      border-radius: 999px;
      background: var(--ki-primary, #3a2d6e);
      color: var(--ki-primary-fg, #fff);
      font-size: 12.5px; font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }

    /* ================ Order/Sub list ================ */
    #ki-{{ section.id }} .ki-pr__list {
      display: flex; flex-direction: column; gap: 14px;
    }
    #ki-{{ section.id }} .ki-pr__list-empty {
      padding: 40px 20px; text-align: center;
      color: var(--ki-muted, #5a5a5a); font-size: 13px;
      background: var(--ki-card, #fff);
      border: 1px dashed rgba(0,0,0,.12);
      border-radius: 16px;
    }
    #ki-{{ section.id }} .ki-pr__list-empty-title {
      font-family: var(--ki-font-primary);
      font-size: 18px; color: var(--ki-primary, #3a2d6e);
      margin: 0 0 6px;
    }
    #ki-{{ section.id }} .ki-pr__list-empty a {
      color: var(--ki-primary, #3a2d6e); font-weight: 700;
    }

    /* Order card */
    #ki-{{ section.id }} .ki-pr__order {
      padding: 16px 18px;
      background: var(--ki-card, #fff);
      border: 1px solid rgba(0,0,0,.08);
      border-radius: 14px;
    }
    #ki-{{ section.id }} .ki-pr__order-head {
      display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;
      margin-bottom: 10px;
    }
    #ki-{{ section.id }} .ki-pr__order-no {
      font-size: 12.5px; font-weight: 700;
      color: var(--ki-primary, #3a2d6e);
    }
    #ki-{{ section.id }} .ki-pr__order-date {
      font-size: 11.5px; color: var(--ki-muted, #5a5a5a);
      margin-top: 2px;
    }
    #ki-{{ section.id }} .ki-pr__order-total {
      font-size: 15px; font-weight: 800;
      color: var(--ki-primary, #3a2d6e);
      font-variant-numeric: tabular-nums;
    }
    #ki-{{ section.id }} .ki-pr__order-status {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 11px; font-weight: 700;
    }
    #ki-{{ section.id }} .ki-pr__order-status--fulfilled,
    #ki-{{ section.id }} .ki-pr__order-status--delivered { background: var(--ki-sage-light, #dde8d4); color: var(--ki-sage, #5d7a52); }
    #ki-{{ section.id }} .ki-pr__order-status--paid,
    #ki-{{ section.id }} .ki-pr__order-status--pending { background: rgba(176,133,38,.15); color: var(--ki-amber, #b08526); }
    #ki-{{ section.id }} .ki-pr__order-status--cancelled,
    #ki-{{ section.id }} .ki-pr__order-status--refunded { background: var(--ki-rose-light, #f6dce4); color: var(--ki-rose, #d96d8a); }
    #ki-{{ section.id }} .ki-pr__order-items {
      list-style: none; padding: 0; margin: 0;
      font-size: 12.5px; color: var(--ki-muted, #5a5a5a);
    }
    #ki-{{ section.id }} .ki-pr__order-items li {
      padding: 4px 0;
      border-top: 1px solid rgba(0,0,0,.06);
    }
    #ki-{{ section.id }} .ki-pr__order-items li:first-child { border-top: 0; }
    #ki-{{ section.id }} .ki-pr__order-actions {
      margin-top: 12px;
      display: flex; gap: 8px; flex-wrap: wrap;
    }
    #ki-{{ section.id }} .ki-pr__order-link {
      font-size: 12px; font-weight: 600;
      color: var(--ki-primary, #3a2d6e);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    /* Subscription card */
    #ki-{{ section.id }} .ki-pr__sub {
      position: relative;
      overflow: hidden;
      padding: 24px;
      background: var(--ki-card, #fff);
      border: 1px solid #e3dff1;
      border-radius: 24px;
      box-shadow: 0 24px 60px -44px rgba(73,61,154,.75);
    }
    #ki-{{ section.id }} .ki-pr__sub::before {
      content: '';
      position: absolute;
      inset: 0 0 auto;
      height: 4px;
      background: linear-gradient(90deg, #493d9a, #7868db 55%, #b8afea);
    }
    #ki-{{ section.id }} .ki-pr__sub-head {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 18px;
    }
    #ki-{{ section.id }} .ki-pr__sub-title {
      font-family: var(--ki-font-primary);
      font-size: clamp(20px, 3vw, 27px); font-weight: 600;
      color: var(--ki-primary, #3a2d6e);
      margin: 0;
    }
    #ki-{{ section.id }} .ki-pr__sub-badge {
      display: inline-block;
      padding: 7px 13px;
      border-radius: 999px;
      font-size: 11px; font-weight: 800;
      letter-spacing: .02em;
    }
    #ki-{{ section.id }} .ki-pr__sub-badge--ACTIVE { background: var(--ki-sage-light, #dde8d4); color: var(--ki-sage, #5d7a52); }
    #ki-{{ section.id }} .ki-pr__sub-badge--PAUSED { background: rgba(176,133,38,.15); color: var(--ki-amber, #b08526); }
    #ki-{{ section.id }} .ki-pr__sub-badge--CANCELLED { background: var(--ki-rose-light, #f6dce4); color: var(--ki-rose, #d96d8a); }
    #ki-{{ section.id }} .ki-pr__sub-badge--PENDING,
    #ki-{{ section.id }} .ki-pr__sub-badge--PAST_DUE { background: rgba(58,45,110,.1); color: var(--ki-primary, #3a2d6e); }

    #ki-{{ section.id }} .ki-pr__sub-meta {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      font-size: 13px;
      color: var(--ki-muted, #5a5a5a);
      margin: 0 0 16px;
    }
    #ki-{{ section.id }} .ki-pr__sub-meta > div {
      min-width: 0;
      padding: 13px 15px;
      border: 1px solid #ebe8f5;
      border-radius: 14px;
      background: #faf9ff;
    }
    #ki-{{ section.id }} .ki-pr__sub-meta dt {
      font-size: 11px; font-weight: 700;
      letter-spacing: .1em; text-transform: uppercase;
      color: var(--ki-muted, #5a5a5a);
    }
    #ki-{{ section.id }} .ki-pr__sub-meta dd { font-weight: 750; color: var(--ki-primary, #3a2d6e); margin: 4px 0 0; }

    #ki-{{ section.id }} .ki-pr__sub-items {
      list-style: none; padding: 4px 0; margin: 0;
      border-top: 1px solid #ece9f4;
      border-bottom: 1px solid #ece9f4;
      font-size: 13px;
    }
    #ki-{{ section.id }} .ki-pr__sub-items li {
      display: flex; justify-content: space-between; gap: 16px; padding: 11px 2px;
      color: var(--ki-primary, #3a2d6e);
      border-top: 1px solid #f1eff7;
    }
    #ki-{{ section.id }} .ki-pr__sub-items li:first-child { border-top: 0; }
    #ki-{{ section.id }} .ki-pr__sub-items li span:first-child { min-width: 0; overflow-wrap: anywhere; }
    #ki-{{ section.id }} .ki-pr__sub-items li span:last-child { font-weight: 700; }

    #ki-{{ section.id }} .ki-pr__sub-actions {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 9px;
      margin-top: 18px;
    }
    #ki-{{ section.id }} .ki-pr__btn {
      min-height: 46px;
      padding: 10px 14px;
      border: 1px solid transparent;
      border-radius: 14px;
      font-size: 12.5px; font-weight: 700;
      cursor: pointer;
      text-align: center;
      text-decoration: none;
      display: inline-flex; align-items: center; justify-content: center;
      gap: 6px;
      line-height: 1.25;
      transition: opacity .15s, background .15s, border-color .15s, transform .15s;
    }
    #ki-{{ section.id }} .ki-pr__btn:hover:not(:disabled) { transform: translateY(-1px); }
    #ki-{{ section.id }} .ki-pr__btn--primary { background: var(--ki-primary, #3a2d6e); color: var(--ki-primary-fg, #fff); }
    #ki-{{ section.id }} .ki-pr__btn--ghost { border-color: #ddd8ef; background: #f2effb; color: var(--ki-primary, #3a2d6e); }
    #ki-{{ section.id }} .ki-pr__btn--pause { border-color: rgba(176,133,38,.22); background: #fbf6e9; color: #8d6718; }
    #ki-{{ section.id }} .ki-pr__btn--danger { border-color: rgba(217,109,138,.2); background: #fff3f6; color: #bd4f6d; }
    #ki-{{ section.id }} .ki-pr__btn:disabled { opacity: .5; cursor: not-allowed; }

    /* Portal modals */
    #ki-{{ section.id }} .ki-pr__modal {
      position: fixed;
      z-index: 10020;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 20px;
      background: rgba(25,18,62,.62);
      backdrop-filter: blur(7px);
      -webkit-backdrop-filter: blur(7px);
    }
    #ki-{{ section.id }} .ki-pr__modal-panel {
      width: min(100%, 680px);
      max-height: min(90vh, 860px);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(255,255,255,.7);
      border-radius: 24px;
      background: #fff;
      box-shadow: 0 36px 100px -30px rgba(20,13,55,.75);
    }
    #ki-{{ section.id }} .ki-pr__modal-panel--small { width: min(100%, 460px); }
    #ki-{{ section.id }} .ki-pr__modal-head {
      position: sticky;
      z-index: 3;
      top: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 16px 18px;
      border-bottom: 1px solid #ebe8f4;
      background: rgba(255,255,255,.97);
    }
    #ki-{{ section.id }} .ki-pr__modal-title {
      margin: 0;
      color: var(--ki-primary, #3a2d6e);
      font-family: var(--ki-font-primary);
      font-size: 18px;
      font-weight: 700;
    }
    #ki-{{ section.id }} .ki-pr__modal-close {
      min-width: 92px;
      min-height: 40px;
      padding: 8px 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      border: 1px solid #ddd8ec;
      border-radius: 999px;
      background: #f5f3fb;
      color: var(--ki-primary, #3a2d6e);
      font: inherit;
      font-size: 12px;
      font-weight: 800;
      cursor: pointer;
    }
    #ki-{{ section.id }} .ki-pr__modal-close-icon { font-size: 20px; line-height: .8; }
    #ki-{{ section.id }} .ki-pr__modal-body {
      overflow: auto;
      overscroll-behavior: contain;
      padding: 18px;
      -webkit-overflow-scrolling: touch;
    }
    #ki-{{ section.id }} .ki-pr__iyzico-target { min-height: 560px; }
    #ki-{{ section.id }} .ki-pr__modal-copy { margin: 0 0 18px; color: var(--ki-muted, #5a5a5a); font-size: 13px; line-height: 1.55; }
    #ki-{{ section.id }} .ki-pr__modal-label { display: block; margin-bottom: 7px; color: var(--ki-muted, #5a5a5a); font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
    #ki-{{ section.id }} .ki-pr__modal-select { width: 100%; min-height: 48px; padding: 10px 12px; border: 1px solid #ddd8ec; border-radius: 12px; background: #fff; color: var(--ki-primary, #3a2d6e); font: inherit; font-size: 14px; }
    #ki-{{ section.id }} .ki-pr__modal-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 18px; }
    body.ki-pr-modal-open { overflow: hidden; }

    @media (max-width: 720px) {
      #ki-{{ section.id }} .ki-pr__sub { padding: 18px; border-radius: 19px; }
      #ki-{{ section.id }} .ki-pr__sub-actions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      #ki-{{ section.id }} .ki-pr__modal { align-items: end; padding: 0; }
      #ki-{{ section.id }} .ki-pr__modal-panel,
      #ki-{{ section.id }} .ki-pr__modal-panel--small { width: 100%; max-height: 92vh; border-radius: 24px 24px 0 0; }
      #ki-{{ section.id }} .ki-pr__modal-body { padding: 14px; }
      #ki-{{ section.id }} .ki-pr__iyzico-target { min-height: 600px; }
    }

    /* Profile view */
    #ki-{{ section.id }} .ki-pr__profile-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: 14px 0;
      border-top: 1px solid rgba(0,0,0,.06);
      gap: 12px;
    }
    #ki-{{ section.id }} .ki-pr__profile-row:first-child { border-top: 0; }
    #ki-{{ section.id }} .ki-pr__profile-label {
      font-size: 11px; font-weight: 700;
      letter-spacing: .1em; text-transform: uppercase;
      color: var(--ki-muted, #5a5a5a);
    }
    #ki-{{ section.id }} .ki-pr__profile-value {
      font-size: 14px; color: var(--ki-primary, #3a2d6e);
      font-weight: 600;
      margin-top: 4px;
    }
    #ki-{{ section.id }} .ki-pr__profile-edit {
      font-size: 12.5px; font-weight: 700;
      color: var(--ki-primary, #3a2d6e);
      text-decoration: underline;
      text-underline-offset: 3px;
      white-space: nowrap;
    }

    /* Flash */
    #ki-{{ section.id }} .ki-pr__flash {
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 13px;
      margin-bottom: 14px;
    }
    #ki-{{ section.id }} .ki-pr__flash--ok { background: var(--ki-sage-light, #dde8d4); color: var(--ki-sage, #5d7a52); }
    #ki-{{ section.id }} .ki-pr__flash--err { background: var(--ki-rose-light, #f6dce4); color: var(--ki-rose, #d96d8a); }

    /* Loading */
    #ki-{{ section.id }} .ki-pr__loading {
      text-align: center; padding: 40px 16px;
      color: var(--ki-muted, #5a5a5a);
      font-size: 13px;
    }
  </style>

  {%- assign first_name = customer.first_name | default: customer.name | default: customer.email -%}
  {%- assign initial = first_name | upcase | slice: 0, 1 -%}

  <div class="ki-pr__hero">
    <div class="ki-pr__wrap">
      <div class="ki-pr__head">
        <div class="ki-pr__avatar">
          <div class="ki-pr__avatar-circle">{{ initial }}</div>
          <div>
            <div class="ki-pr__eyebrow">.ki Hesabım</div>
            <div class="ki-pr__greeting">Merhaba, {{ first_name }}</div>
          </div>
        </div>
        <a href="{{ routes.account_logout_url }}" class="ki-pr__logout">
          {% render 'ki-icon', name: 'close', size: 14 %}
          Çıkış
        </a>
      </div>

      {%- comment -%} Desktop tabs {%- endcomment -%}
      <nav class="ki-pr__tabs-desktop" role="tablist">
        <button type="button" class="ki-pr__tab-btn is-active" data-ki-pr-tab="subscriptions">
          {% render 'ki-icon', name: 'sparkles', size: 16 %}
          Abonelikler
        </button>
        <button type="button" class="ki-pr__tab-btn" data-ki-pr-tab="orders">
          {% render 'ki-icon', name: 'package', size: 16 %}
          Siparişler
        </button>
        <button type="button" class="ki-pr__tab-btn" data-ki-pr-tab="profile">
          {% render 'ki-icon', name: 'user', size: 16 %}
          Kullanıcı Bilgileri
        </button>
      </nav>

      {%- comment -%} Mobile pill row {%- endcomment -%}
      <nav class="ki-pr__tabs-mobile" role="tablist">
        <button type="button" class="ki-pr__tab-btn is-active" data-ki-pr-tab="subscriptions">Abonelikler</button>
        <button type="button" class="ki-pr__tab-btn" data-ki-pr-tab="orders">Siparişler</button>
        <button type="button" class="ki-pr__tab-btn" data-ki-pr-tab="profile">Kullanıcı Bilgileri</button>
      </nav>
    </div>
  </div>

  <div class="ki-pr__body">
    <div class="ki-pr__wrap">
      <div class="ki-pr__flash ki-pr__flash--ok" data-ki-pr-flash hidden></div>
      <div class="ki-pr__flash ki-pr__flash--err" data-ki-pr-flash-err hidden></div>

      {%- comment -%} ============== ABONELIKLER VIEW ============== {%- endcomment -%}
      <div class="ki-pr__view is-active" data-ki-pr-view="subscriptions">
        <div class="ki-pr__section-head">
          <div>
            <h2 class="ki-pr__section-title">Aboneliklerim</h2>
            <p class="ki-pr__section-desc">Aktif paketlerini yönet, duraklat veya iptal et.</p>
          </div>
          <a href="/pages/paket-olustur" class="ki-pr__section-cta">+ Yeni Abonelik</a>
        </div>
        <div data-ki-pr-subs-loading class="ki-pr__loading">Abonelikler yükleniyor…</div>
        <div data-ki-pr-subs-content class="ki-pr__list" hidden></div>
      </div>

      {%- comment -%} ============== SIPARISLER VIEW (Shopify customer.orders) ============== {%- endcomment -%}
      <div class="ki-pr__view" data-ki-pr-view="orders">
        <div class="ki-pr__section-head">
          <div>
            <h2 class="ki-pr__section-title">Siparişlerim</h2>
            <p class="ki-pr__section-desc">Tek seferlik alışverişlerinin durumu ve geçmişi.</p>
          </div>
        </div>
        <div class="ki-pr__list">
          {%- paginate customer.orders by 10 -%}
            {%- if customer.orders.size > 0 -%}
              {%- for order in customer.orders -%}
                <div class="ki-pr__order">
                  <div class="ki-pr__order-head">
                    <div>
                      <div class="ki-pr__order-no">Sipariş {{ order.name }}</div>
                      <div class="ki-pr__order-date">{{ order.created_at | date: '%d %b %Y' }}</div>
                    </div>
                    <div style="text-align:right;">
                      <div class="ki-pr__order-total">{{ order.total_price | money }}</div>
                      <span class="ki-pr__order-status ki-pr__order-status--{{ order.fulfillment_status | default: order.financial_status }}">
                        {%- case order.fulfillment_status -%}
                          {%- when 'fulfilled' -%}Teslim Edildi
                          {%- when 'partial' -%}Kısmen Gönderildi
                          {%- else -%}
                            {%- case order.financial_status -%}
                              {%- when 'paid' -%}Ödendi
                              {%- when 'pending' -%}Beklemede
                              {%- when 'refunded' -%}İade Edildi
                              {%- else -%}{{ order.financial_status | capitalize }}
                            {%- endcase -%}
                        {%- endcase -%}
                      </span>
                    </div>
                  </div>
                  <ul class="ki-pr__order-items">
                    {%- for line in order.line_items limit: 5 -%}
                      <li>{{ line.title }} × {{ line.quantity }}</li>
                    {%- endfor -%}
                    {%- if order.line_items.size > 5 -%}
                      <li>+ {{ order.line_items.size | minus: 5 }} ürün daha…</li>
                    {%- endif -%}
                  </ul>
                  {%- comment -%}
                    Sipariş detay linki yerine kargo takip linki — order_status_url Shopify
                    customer accounts dashboard'una yönlendiriyor; kullanıcının orayı görmesini
                    istemiyoruz. Fulfillment varsa kargo şirketinin sayfasına git.
                  {%- endcomment -%}
                  {%- assign track_url = '' -%}
                  {%- for f in order.fulfillments -%}
                    {%- if f.tracking_url != blank -%}
                      {%- assign track_url = f.tracking_url -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if track_url != blank -%}
                    <div class="ki-pr__order-actions">
                      <a href="{{ track_url }}" target="_blank" rel="noopener" class="ki-pr__order-link">Kargoyu takip et →</a>
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
              {%- if paginate.pages > 1 -%}
                <div style="display:flex;justify-content:center;gap:8px;margin-top:14px;font-size:12.5px;">
                  {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="ki-pr__order-link">‹ Önceki</a>{%- endif -%}
                  <span style="color:var(--ki-muted);">{{ paginate.current_page }} / {{ paginate.pages }}</span>
                  {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="ki-pr__order-link">Sonraki ›</a>{%- endif -%}
                </div>
              {%- endif -%}
            {%- else -%}
              <div class="ki-pr__list-empty">
                <h3 class="ki-pr__list-empty-title">Henüz tek seferlik siparişin yok</h3>
                <p>Mağazadan ürün satın aldığında siparişlerin burada görünür.</p>
                <p style="margin-top:14px;"><a href="{{ routes.all_products_collection_url }}">Ürünleri keşfet →</a></p>
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        </div>
      </div>

      {%- comment -%} ============== KULLANICI BILGILERI VIEW ============== {%- endcomment -%}
      <div class="ki-pr__view" data-ki-pr-view="profile">
        <div class="ki-pr__section-head">
          <div>
            <h2 class="ki-pr__section-title">Kullanıcı Bilgileri</h2>
            <p class="ki-pr__section-desc">Hesap bilgilerini güvenli şekilde güncelle. Adres ve email değişiklikleri Shopify hesabına yansır.</p>
          </div>
        </div>

        <div class="ki-pr__card">
          <h3>Profil</h3>
          <div class="ki-pr__profile-row">
            <div>
              <div class="ki-pr__profile-label">Ad Soyad</div>
              <div class="ki-pr__profile-value">{{ customer.name | default: '—' }}</div>
            </div>
            <a href="{{ routes.account_url }}" class="ki-pr__profile-edit">Düzenle</a>
          </div>
          <div class="ki-pr__profile-row">
            <div>
              <div class="ki-pr__profile-label">E-posta</div>
              <div class="ki-pr__profile-value">{{ customer.email }}</div>
            </div>
            <a href="{{ routes.account_url }}" class="ki-pr__profile-edit">Düzenle</a>
          </div>
          {%- if customer.phone != blank -%}
          <div class="ki-pr__profile-row">
            <div>
              <div class="ki-pr__profile-label">Telefon</div>
              <div class="ki-pr__profile-value">{{ customer.phone }}</div>
            </div>
            <a href="{{ routes.account_url }}" class="ki-pr__profile-edit">Düzenle</a>
          </div>
          {%- endif -%}
        </div>

        <div class="ki-pr__card">
          <h3>Adres Defteri</h3>
          {%- if customer.addresses.size > 0 -%}
            {%- for address in customer.addresses -%}
              <div class="ki-pr__profile-row">
                <div>
                  <div class="ki-pr__profile-label">
                    {%- if address.default? -%}Varsayılan adres{%- else -%}Adres {{ forloop.index }}{%- endif -%}
                  </div>
                  <div class="ki-pr__profile-value">
                    {{ address.address1 }}{%- if address.address2 != blank -%}, {{ address.address2 }}{%- endif -%}<br>
                    <span style="font-weight:500;color:var(--ki-muted);">{{ address.city }}{%- if address.province != blank -%} / {{ address.province }}{%- endif -%}, {{ address.country }}</span>
                  </div>
                </div>
                <a href="{{ routes.account_addresses_url }}" class="ki-pr__profile-edit">Düzenle</a>
              </div>
            {%- endfor -%}
          {%- else -%}
            <p style="font-size:13px;color:var(--ki-muted);margin:0 0 12px;">Henüz kayıtlı adresin yok.</p>
          {%- endif -%}
          <div style="margin-top:12px;">
            <a href="{{ routes.account_addresses_url }}" class="ki-pr__btn ki-pr__btn--ghost">+ Yeni adres ekle</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('ki-{{ section.id }}');
    if (!root) return;
    var apiBase = (window.kiConfig && window.kiConfig.subscriptionApiBase) || '';

    /* ============ Tab switching ============ */
    var tabBtns = root.querySelectorAll('[data-ki-pr-tab]');
    var views = root.querySelectorAll('[data-ki-pr-view]');
    function activateTab(key) {
      tabBtns.forEach(function (b) { b.classList.toggle('is-active', b.getAttribute('data-ki-pr-tab') === key); });
      views.forEach(function (v) { v.classList.toggle('is-active', v.getAttribute('data-ki-pr-view') === key); });
      try { history.replaceState(null, '', '#' + key); } catch (e) {}
    }
    tabBtns.forEach(function (b) {
      b.addEventListener('click', function () { activateTab(b.getAttribute('data-ki-pr-tab')); });
    });
    // URL sorgusu veya hash'ten initial tab seç
    var initialTab = '';
    try { initialTab = new URLSearchParams(window.location.search).get('tab') || ''; } catch (e) {}
    if (!initialTab) initialTab = (window.location.hash || '').replace('#', '');
    if (['subscriptions', 'orders', 'profile'].indexOf(initialTab) >= 0) activateTab(initialTab);

    /* iyzico card update callback dönüşü — URL'de ?card_updated=1 varsa success flash */
    (function () {
      try {
        var urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('card_updated') === '1') {
          setTimeout(function () { setFlash('ok', 'Kart bilgileriniz başarıyla güncellendi.'); }, 200);
          urlParams.delete('card_updated');
          var newSearch = urlParams.toString();
          history.replaceState(null, '', window.location.pathname + (newSearch ? '?' + newSearch : ''));
        }
      } catch (e) {}
    })();

    /* ============ Subscriptions (backend fetch) ============ */
    var subsLoading = root.querySelector('[data-ki-pr-subs-loading]');
    var subsContent = root.querySelector('[data-ki-pr-subs-content]');
    var flashOk = root.querySelector('[data-ki-pr-flash]');
    var flashErr = root.querySelector('[data-ki-pr-flash-err]');

    function setFlash(type, msg) {
      var el = type === 'ok' ? flashOk : flashErr;
      if (!el) { alert(msg); return; }
      el.textContent = msg; el.hidden = false;
      setTimeout(function () { el.hidden = true; }, 6000);
    }

    function escapeHtml(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
      });
    }

    function fmtMoney(n) {
      return '₺' + Number(n).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function fmtDate(iso) {
      try { return new Date(iso).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }); }
      catch (e) { return iso; }
    }

    function frequencyText(me, box) {
      var directLabel = box.intervalLabel || me.intervalLabel || box.frequencyLabel || me.frequencyLabel || box.sellingPlanName || me.sellingPlanName;
      if (directLabel) {
        var normalizedLabel = String(directLabel);
        return /kapında/i.test(normalizedLabel) ? normalizedLabel : normalizedLabel + ' kapında';
      }
      var monthCount = Number(box.frequencyMonths || me.frequencyMonths || box.intervalCount || me.intervalCount || 0);
      if (monthCount === 1) return 'Ayda bir kapında';
      if (monthCount > 1) return monthCount + ' ayda bir kapında';
      return 'Gönderim planına göre';
    }

    var STATUS_LABEL = { ACTIVE: 'Aktif', PAUSED: 'Duraklatıldı', PENDING: 'Beklemede', PAST_DUE: 'Ödeme Gecikti', CANCELLED: 'İptal Edildi' };

    async function api(path, opts) {
      opts = opts || {};
      opts.credentials = 'include';
      opts.headers = Object.assign({
        'Accept': 'application/json',
        'ngrok-skip-browser-warning': '1'
      }, opts.headers || {});

      // Auth: localStorage'da subscribe akışı sonrası kaydedilmiş JWT varsa
      // Authorization: Bearer header ile gönder. Backend JwtAuthFilter cookie'den
      // bulamazsa Bearer'dan okur. Cross-site third-party cookie problemini bypass eder.
      try {
        var portalToken = localStorage.getItem('ki_portal_token');
        if (portalToken && !opts.headers['Authorization']) {
          opts.headers['Authorization'] = 'Bearer ' + portalToken;
        }
      } catch (e) { /* localStorage erişimi engelliyse (incognito strict mode) sessiz geç */ }

      if (opts.body && typeof opts.body !== 'string') {
        opts.body = JSON.stringify(opts.body);
        opts.headers['Content-Type'] = 'application/json';
      }
      var res = await fetch(apiBase + path, opts);
      if (res.status === 401 || res.status === 403) {
        // Auth eksik — Shopify dashboard'a atma! Kullanıcı zaten Shopify'a login,
        // sorun backend tarafından kimliği tanımamasıdır (cookie JWT yok). Sessiz
        // throw → loadSubs catch'te yakalanır, "Abonelik bilgisi yüklenemedi" mesajı.
        throw new Error('unauthorized');
      }
      var json = {};
      try { json = await res.json(); } catch (_) {}
      if (!res.ok || !json.success) throw new Error(json.error || ('HTTP ' + res.status));
      return json.data;
    }

    function renderSubs(me) {
      var statusKey = me.paused ? 'PAUSED' : (me.status || 'PENDING');
      var box = me.activeBox || {};
      var items = box.items || [];
      var hasSub = box.id || (me.payments && me.payments.length > 0);

      if (!hasSub) {
        subsContent.innerHTML = ''
          + '<div class="ki-pr__list-empty">'
          +   '<h3 class="ki-pr__list-empty-title">Henüz aboneliğin yok</h3>'
          +   '<p>İhtiyacına göre kendi paketini oluştur, 2 ayda bir kapına gelsin.</p>'
          +   '<p style="margin-top:14px;"><a href="/pages/paket-olustur">Paket oluştur →</a></p>'
          + '</div>';
        subsLoading.hidden = true;
        subsContent.hidden = false;
        return;
      }

      var itemsHtml = items.map(function (it) {
        var qty = Number(it.quantity || 0);
        var price = Number(it.price || 0);
        return '<li><span>🛍️ ' + escapeHtml(it.title || 'Ürün') + ' × ' + qty + '</span><span>' + fmtMoney(qty * price) + '</span></li>';
      }).join('');

      var canPause = statusKey !== 'CANCELLED';
      var pauseLabel = me.paused ? '▶ Devam ettir' : '⏸ Duraklat';
      var pausedNote = me.paused && me.pausedUntil
        ? (me.pausedUntil === 'INDEFINITE'
            ? 'Süresiz duraklatıldı'
            : (fmtDate(me.pausedUntil) + ' tarihine kadar duraklatıldı'))
        : '';

      subsContent.innerHTML = ''
        + '<div class="ki-pr__sub">'
        +   '<div class="ki-pr__sub-head">'
        +     '<h3 class="ki-pr__sub-title">' + escapeHtml(box.displayName || 'Aktif Paketim') + '</h3>'
        +     '<span class="ki-pr__sub-badge ki-pr__sub-badge--' + statusKey + '">' + (STATUS_LABEL[statusKey] || statusKey) + '</span>'
        +   '</div>'
        +   (pausedNote ? '<p style="font-size:12.5px;color:var(--ki-amber,#b08526);margin:0 0 12px;font-weight:600;">⏸ ' + escapeHtml(pausedNote) + '</p>' : '')
        +   '<dl class="ki-pr__sub-meta">'
        +     '<div><dt>📅 Sıklık</dt><dd>' + escapeHtml(frequencyText(me, box)) + '</dd></div>'
        +     '<div><dt>✨ Paket toplamı</dt><dd>' + fmtMoney(Number(box.totalPrice || 0)) + '</dd></div>'
        +   '</dl>'
        +   '<ul class="ki-pr__sub-items">' + itemsHtml + '</ul>'
        +   '<div class="ki-pr__sub-actions">'
        +     '<a href="/pages/paket-olustur?edit=current" class="ki-pr__btn ki-pr__btn--ghost" aria-label="Mevcut paketimi düzenle">📦 Paketimi düzenle</a>'
        +     '<button type="button" class="ki-pr__btn ki-pr__btn--ghost" data-ki-pr-card>💳 Kartımı güncelle</button>'
        +     (canPause ? '<button type="button" class="ki-pr__btn ki-pr__btn--pause" data-ki-pr-pause data-paused="' + (me.paused ? 'true' : 'false') + '">' + pauseLabel + '</button>' : '')
        +     (statusKey !== 'CANCELLED' ? '<button type="button" class="ki-pr__btn ki-pr__btn--danger" data-ki-pr-cancel>✕ İptal et</button>' : '')
        +     (statusKey === 'CANCELLED' ? '<button type="button" class="ki-pr__btn ki-pr__btn--primary" data-ki-pr-restart>↻ Yeniden başlat</button>' : '')
        +   '</div>'
        + '</div>';

      subsLoading.hidden = true;
      subsContent.hidden = false;
    }

    async function loadSubs() {
      console.log('[KI Portal] loadSubs() called, apiBase:', apiBase);
      if (!apiBase) {
        subsLoading.innerHTML = 'API yapılandırılmamış. Theme settings → Subscription API → API base URL.';
        console.error('[KI Portal] apiBase boş!');
        return;
      }
      try {
        console.log('[KI Portal] /api/portal/me çağrılıyor…');
        var me = await api('/api/portal/me');
        console.log('[KI Portal] /me yanıt:', me);
        renderSubs(me);
        console.log('[KI Portal] renderSubs tamamlandı');
      } catch (err) {
        console.error('[KI Portal] HATA:', err);
        if (String(err && err.message) !== 'unauthorized') {
          subsLoading.innerHTML = 'Abonelik bilgisi yüklenemedi: ' + (err && err.message || 'bilinmeyen hata');
        } else {
          subsLoading.innerHTML = 'Backend kimliğinizi tanımıyor (401). Auth bridging gerekli.';
        }
      }
    }
    loadSubs();

    var activePortalModal = null;
    function closePortalModal(modal, restoreFocus) {
      if (!modal || !modal.isConnected) return;
      if (modal._kiKeydown) document.removeEventListener('keydown', modal._kiKeydown);
      modal.remove();
      if (activePortalModal === modal) activePortalModal = null;
      document.body.classList.remove('ki-pr-modal-open');
      if (restoreFocus && typeof restoreFocus.focus === 'function') restoreFocus.focus();
    }

    /* Ortak: iyzico htmlContent'ini erişilebilir modal içinde render eder (CSP nonce ile
       script inject). Kart güncelleme, resume ve restart akışları bunu paylaşır. */
    function renderIyzicoInline(html, title, targetDivId) {
      if (!html || String(html).trim().length < 20) {
        throw new Error('iyzico formu alınamadı.');
      }
      if (activePortalModal) closePortalModal(activePortalModal);
      var restoreFocus = document.activeElement;
      var hostArea = document.createElement('div');
      var titleId = targetDivId + '-title';
      hostArea.className = 'ki-pr__modal';
      hostArea.setAttribute('role', 'dialog');
      hostArea.setAttribute('aria-modal', 'true');
      hostArea.setAttribute('aria-labelledby', titleId);
      hostArea.innerHTML = ''
        + '<div class="ki-pr__modal-panel">'
        +   '<div class="ki-pr__modal-head">'
        +     '<h3 class="ki-pr__modal-title" id="' + titleId + '">' + escapeHtml(title) + '</h3>'
        +     '<button type="button" class="ki-pr__modal-close" data-iyzi-close aria-label="Ödeme panelini kapat">'
        +       '<span class="ki-pr__modal-close-icon" aria-hidden="true">×</span><span>Kapat</span>'
        +     '</button>'
        +   '</div>'
        +   '<div class="ki-pr__modal-body">'
        +     '<div id="' + targetDivId + '" class="responsive ki-pr__iyzico-target"></div>'
        +   '</div>'
        + '</div>';
      root.appendChild(hostArea);
      activePortalModal = hostArea;
      document.body.classList.add('ki-pr-modal-open');

      var pageNonce = '';
      var anyNonceScript = document.querySelector('script[nonce]');
      if (anyNonceScript) {
        pageNonce = anyNonceScript.nonce || anyNonceScript.getAttribute('nonce') || '';
      }
      var tmp = document.createElement('div');
      tmp.innerHTML = html;
      Array.prototype.slice.call(tmp.querySelectorAll('script')).forEach(function (oldScript) {
        var s = document.createElement('script');
        for (var i = 0; i < oldScript.attributes.length; i++) {
          s.setAttribute(oldScript.attributes[i].name, oldScript.attributes[i].value);
        }
        if (pageNonce) { s.setAttribute('nonce', pageNonce); s.nonce = pageNonce; }
        s.text = oldScript.textContent;
        hostArea.querySelector('.ki-pr__modal-body').appendChild(s);
      });
      function close() {
        document.removeEventListener('keydown', onKeydown);
        closePortalModal(hostArea, restoreFocus);
      }
      function onKeydown(event) {
        if (event.key === 'Escape') close();
      }
      hostArea._kiKeydown = onKeydown;
      hostArea.querySelector('[data-iyzi-close]').addEventListener('click', close);
      hostArea.addEventListener('click', function (event) {
        if (event.target === hostArea) close();
      });
      document.addEventListener('keydown', onKeydown);
      setTimeout(function () { hostArea.querySelector('[data-iyzi-close]').focus(); }, 20);
      return hostArea;
    }

    /* ============ Cancel / Pause / Card update handlers (event delegation) ============ */
    function handleCancel(btn) {
      if (activePortalModal) closePortalModal(activePortalModal);
      var overlay = document.createElement('div');
      overlay.className = 'ki-pr__modal';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.setAttribute('aria-labelledby', 'ki-cancel-title-{{ section.id }}');
      overlay.innerHTML = ''
        + '<div class="ki-pr__modal-panel ki-pr__modal-panel--small">'
        +   '<div class="ki-pr__modal-head">'
        +     '<h3 class="ki-pr__modal-title" id="ki-cancel-title-{{ section.id }}">✕ Aboneliği iptal et</h3>'
        +     '<button type="button" class="ki-pr__modal-close" data-cls aria-label="İptal penceresini kapat"><span class="ki-pr__modal-close-icon" aria-hidden="true">×</span><span>Kapat</span></button>'
        +   '</div>'
        +   '<div class="ki-pr__modal-body">'
        +     '<p class="ki-pr__modal-copy">Aboneliğini iptal ettiğinde bir sonraki teslimat oluşturulmayacak. Bu işlemden önce paketini duraklatmayı da tercih edebilirsin.</p>'
        +     '<div class="ki-pr__modal-actions">'
        +       '<button type="button" class="ki-pr__btn ki-pr__btn--ghost" data-cls>Vazgeç</button>'
        +       '<button type="button" class="ki-pr__btn ki-pr__btn--danger" data-cancel-confirm>✕ Evet, iptal et</button>'
        +     '</div>'
        +   '</div>'
        + '</div>';
      root.appendChild(overlay);
      activePortalModal = overlay;
      document.body.classList.add('ki-pr-modal-open');
      function closeCancelModal() {
        document.removeEventListener('keydown', onCancelKeydown);
        closePortalModal(overlay, btn);
      }
      function onCancelKeydown(event) {
        if (event.key === 'Escape') closeCancelModal();
      }
      overlay._kiKeydown = onCancelKeydown;
      overlay.querySelectorAll('[data-cls]').forEach(function (closeButton) {
        closeButton.addEventListener('click', closeCancelModal);
      });
      overlay.addEventListener('click', function (event) {
        if (event.target === overlay) closeCancelModal();
      });
      document.addEventListener('keydown', onCancelKeydown);
      var confirmButton = overlay.querySelector('[data-cancel-confirm]');
      setTimeout(function () { confirmButton.focus(); }, 20);
      confirmButton.addEventListener('click', async function () {
        confirmButton.disabled = true;
        confirmButton.textContent = 'İptal ediliyor…';
        try {
          await api('/api/portal/cancel', { method: 'POST', body: {} });
          document.removeEventListener('keydown', onCancelKeydown);
          closePortalModal(overlay);
          setFlash('ok', 'Aboneliğin iptal edildi.');
          setTimeout(function () { window.location.reload(); }, 1200);
        } catch (error) {
          setFlash('err', (error && error.message) || 'İptal başarısız.');
          confirmButton.disabled = false;
          confirmButton.textContent = '✕ Evet, iptal et';
        }
      });
    }

    async function handlePauseToggle(btn) {
      var isPaused = btn.getAttribute('data-paused') === 'true';
      if (isPaused) {
        if (!confirm('Aboneliğini devam ettirmek için kayıtlı kartınla ödeme onayı alınacak. Devam edilsin mi?')) return;
        btn.disabled = true;
        try {
          // Resume artık yeniden checkout başlatır (pause iyzico aboneliğini iptal etti).
          var data = await api('/api/portal/resume', { method: 'POST', body: {} });
          if (data && data.requiresCheckout && data.htmlContent) {
            renderIyzicoInline(data.htmlContent, 'Aboneliğini devam ettir', 'iyzipay-checkout-form');
          } else {
            setFlash('ok', 'Aboneliğin tekrar aktif.');
            setTimeout(function () { window.location.reload(); }, 1200);
          }
        } catch (e) { setFlash('err', (e && e.message) || 'Devam ettirme başarısız.'); btn.disabled = false; }
        return;
      }
      // Pause modal
      if (activePortalModal) closePortalModal(activePortalModal);
      var restoreFocus = btn;
      var overlay = document.createElement('div');
      overlay.className = 'ki-pr__modal';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.setAttribute('aria-labelledby', 'ki-pause-title-{{ section.id }}');
      overlay.innerHTML = ''
        + '<div class="ki-pr__modal-panel ki-pr__modal-panel--small">'
        +   '<div class="ki-pr__modal-head">'
        +     '<h3 class="ki-pr__modal-title" id="ki-pause-title-{{ section.id }}">⏸ Aboneliği duraklat</h3>'
        +     '<button type="button" class="ki-pr__modal-close" data-cls aria-label="Duraklatma penceresini kapat"><span class="ki-pr__modal-close-icon" aria-hidden="true">×</span><span>Kapat</span></button>'
        +   '</div>'
        +   '<div class="ki-pr__modal-body">'
        +     '<p class="ki-pr__modal-copy">Süre sonunda otomatik devam eder. İstediğin an portaldan değiştirebilirsin.</p>'
        +     '<label class="ki-pr__modal-label" for="ki-pause-duration-{{ section.id }}">Süre</label>'
        +     '<select class="ki-pr__modal-select" id="ki-pause-duration-{{ section.id }}" data-pdur>'
        +       '<option value="30">1 ay</option><option value="60" selected>2 ay</option><option value="90">3 ay</option><option value="0">Süresiz</option>'
        +     '</select>'
        +     '<div class="ki-pr__modal-actions">'
        +       '<button type="button" class="ki-pr__btn ki-pr__btn--ghost" data-cls>Vazgeç</button>'
        +       '<button type="button" class="ki-pr__btn ki-pr__btn--pause" data-pconf>⏸ Duraklat</button>'
        +     '</div>'
        +   '</div>'
        + '</div>';
      root.appendChild(overlay);
      activePortalModal = overlay;
      document.body.classList.add('ki-pr-modal-open');
      function closePauseModal() {
        document.removeEventListener('keydown', onPauseKeydown);
        closePortalModal(overlay, restoreFocus);
        btn.disabled = false;
      }
      function onPauseKeydown(event) {
        if (event.key === 'Escape') closePauseModal();
      }
      overlay._kiKeydown = onPauseKeydown;
      overlay.querySelectorAll('[data-cls]').forEach(function (c) {
        c.addEventListener('click', closePauseModal);
      });
      overlay.addEventListener('click', function (event) {
        if (event.target === overlay) closePauseModal();
      });
      document.addEventListener('keydown', onPauseKeydown);
      setTimeout(function () { overlay.querySelector('[data-pdur]').focus(); }, 20);
      overlay.querySelector('[data-pconf]').addEventListener('click', async function () {
        var dur = parseInt(overlay.querySelector('[data-pdur]').value, 10) || 0;
        btn.disabled = true;
        try {
          await api('/api/portal/pause', { method: 'POST', body: { durationDays: dur } });
          document.removeEventListener('keydown', onPauseKeydown);
          closePortalModal(overlay);
          setFlash('ok', dur === 0 ? 'Süresiz duraklatıldı.' : ('Aboneliğin ' + dur + ' gün duraklatıldı.'));
          setTimeout(function () { window.location.reload(); }, 1500);
        } catch (e) {
          setFlash('err', (e && e.message) || 'Duraklatma başarısız.');
          document.removeEventListener('keydown', onPauseKeydown);
          closePortalModal(overlay, restoreFocus);
          btn.disabled = false;
        }
      });
    }

    async function handleCardUpdate(btn) {
      btn.disabled = true;
      try {
        var data = await api('/api/portal/card-update/init', { method: 'POST' });
        renderIyzicoInline(data && data.htmlContent, 'Kart bilgilerini güncelle', 'iyzipay-card-update-form');
        btn.disabled = false;
      } catch (e) {
        setFlash('err', (e && e.message) || 'Kart güncelleme başlatılamadı.');
        btn.disabled = false;
      }
    }

    async function handleRestart(btn) {
      btn.disabled = true;
      try {
        var data = await api('/api/portal/subscription/restart', { method: 'POST', body: {} });
        renderIyzicoInline(data && data.htmlContent, 'Aboneliğini yeniden başlat', 'iyzipay-checkout-form');
        btn.disabled = false;
      } catch (e) {
        setFlash('err', (e && e.message) || 'Yeniden başlatma başarısız.');
        btn.disabled = false;
      }
    }

    root.addEventListener('click', function (e) {
      var t = e.target;
      var canEl = t.closest('[data-ki-pr-cancel]');
      var pauseEl = t.closest('[data-ki-pr-pause]');
      var cardEl = t.closest('[data-ki-pr-card]');
      var restartEl = t.closest('[data-ki-pr-restart]');
      if (canEl) { e.preventDefault(); handleCancel(canEl); return; }
      if (pauseEl) { e.preventDefault(); handlePauseToggle(pauseEl); return; }
      if (cardEl) { e.preventDefault(); handleCardUpdate(cardEl); return; }
      if (restartEl) { e.preventDefault(); handleRestart(restartEl); return; }
    });
  })();
</script>
{%- endif -%}

