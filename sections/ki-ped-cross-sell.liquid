{%- comment -%}Flexible cross-sell for ready pad packs and individual pad products.{%- endcomment -%}

<style>
  #KiPedCrossSell-{{ section.id }} { --kpc-purple:#493d9a; --kpc-dark:#1a1340; --kpc-muted:#706b7b; background:{{ section.settings.background }}; padding:{{ section.settings.padding_y }}px 0; overflow:hidden; }
  #KiPedCrossSell-{{ section.id }} * { box-sizing:border-box; }
  #KiPedCrossSell-{{ section.id }} .kpc-shell { width:min(1180px,calc(100% - 40px)); margin:0 auto; }
  #KiPedCrossSell-{{ section.id }} .kpc-head { display:flex; align-items:flex-end; justify-content:space-between; gap:18px; margin-bottom:24px; }
  #KiPedCrossSell-{{ section.id }} .kpc-eyebrow { display:block; margin-bottom:6px; color:rgba(73,61,154,.58); font-size:10px; font-weight:850; letter-spacing:.15em; text-transform:uppercase; }
  #KiPedCrossSell-{{ section.id }} .kpc-title { margin:0; color:var(--kpc-dark); font-family:var(--font-heading-family),Raleway,sans-serif; font-size:clamp(25px,3.2vw,38px); line-height:1.08; }
  #KiPedCrossSell-{{ section.id }} .kpc-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; }
  #KiPedCrossSell-{{ section.id }} .kpc-card { min-width:0; overflow:hidden; border:1px solid rgba(73,61,154,.12); border-radius:18px; background:#fff; color:inherit; text-decoration:none; box-shadow:0 7px 26px rgba(73,61,154,.06); }
  #KiPedCrossSell-{{ section.id }} .kpc-card.is-placeholder { cursor:default; }
  #KiPedCrossSell-{{ section.id }} .kpc-media { position:relative; aspect-ratio:16/10; overflow:hidden; display:grid; place-items:center; background:linear-gradient(145deg,#e6e1fa,#f6f4ff); }
  #KiPedCrossSell-{{ section.id }} .kpc-media img { width:100%; height:100%; object-fit:cover; display:block; }
  #KiPedCrossSell-{{ section.id }} .kpc-card.is-package .kpc-media { background:#17142f; }
  #KiPedCrossSell-{{ section.id }} .kpc-card.is-package .kpc-media img { object-fit:contain; }
  #KiPedCrossSell-{{ section.id }} .kpc-media svg { width:88px; height:48px; color:var(--kpc-purple); }
  #KiPedCrossSell-{{ section.id }} .kpc-badge { position:absolute; top:10px; left:10px; padding:5px 8px; border-radius:999px; background:var(--kpc-purple); color:#fff; font-size:8px; font-weight:850; letter-spacing:.08em; text-transform:uppercase; }
  #KiPedCrossSell-{{ section.id }} .kpc-body { padding:15px; }
  #KiPedCrossSell-{{ section.id }} .kpc-name { margin:0; color:var(--kpc-dark); font-size:15px; line-height:1.25; }
  #KiPedCrossSell-{{ section.id }} .kpc-copy { min-height:34px; margin:6px 0 0; color:var(--kpc-muted); font-size:11px; line-height:1.5; }
  #KiPedCrossSell-{{ section.id }} .kpc-footer { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:12px; }
  #KiPedCrossSell-{{ section.id }} .kpc-price { color:var(--kpc-purple); font-size:14px; font-weight:900; }
  #KiPedCrossSell-{{ section.id }} .kpc-price-wrap { display:flex; align-items:baseline; gap:6px; flex-wrap:wrap; }
  #KiPedCrossSell-{{ section.id }} .kpc-price-old { color:#8b8592; font-size:10px; }
  #KiPedCrossSell-{{ section.id }} .kpc-price-save { width:100%; color:#287655; font-size:8.5px; font-weight:800; }
  #KiPedCrossSell-{{ section.id }} .kpc-arrow { width:30px; height:30px; border-radius:50%; display:grid; place-items:center; background:#eeeafd; color:var(--kpc-purple); }
  #KiPedCrossSell-{{ section.id }} .kpc-arrow svg { width:14px; height:14px; }
  @media(max-width:749px){
    #KiPedCrossSell-{{ section.id }}{padding:28px 0;}
    #KiPedCrossSell-{{ section.id }} .kpc-shell{width:calc(100% - 28px);}
    #KiPedCrossSell-{{ section.id }} .kpc-head{margin-bottom:14px;}
    #KiPedCrossSell-{{ section.id }} .kpc-title{font-size:23px;}
    #KiPedCrossSell-{{ section.id }} .kpc-grid{display:flex;overflow-x:auto;gap:10px;margin:0 -14px;padding:0 14px 8px;scroll-snap-type:x mandatory;scrollbar-width:none;}
    #KiPedCrossSell-{{ section.id }} .kpc-grid::-webkit-scrollbar{display:none;}
    #KiPedCrossSell-{{ section.id }} .kpc-card{flex:0 0 min(64vw,240px);scroll-snap-align:start;display:grid;grid-template-columns:40% minmax(0,1fr);border-radius:14px;}
    #KiPedCrossSell-{{ section.id }} .kpc-media{height:100%;min-height:126px;aspect-ratio:auto;}
    #KiPedCrossSell-{{ section.id }} .kpc-body{padding:10px 9px;display:flex;flex-direction:column;}
    #KiPedCrossSell-{{ section.id }} .kpc-name{font-size:12px;}
    #KiPedCrossSell-{{ section.id }} .kpc-copy{font-size:9px;line-height:1.35;}
    #KiPedCrossSell-{{ section.id }} .kpc-price{font-size:11px;}
    #KiPedCrossSell-{{ section.id }} .kpc-arrow{width:25px;height:25px;}
    #KiPedCrossSell-{{ section.id }} .kpc-copy{min-height:0;}
    #KiPedCrossSell-{{ section.id }} .kpc-footer{margin-top:auto;}
  }
</style>

<section id="KiPedCrossSell-{{ section.id }}">
  <div class="kpc-shell">
    <header class="kpc-head">
      <div><span class="kpc-eyebrow">{{ section.settings.eyebrow }}</span><h2 class="kpc-title">{{ section.settings.heading }}</h2></div>
    </header>
    <div class="kpc-grid">
      {%- for block in section.blocks -%}
        {%- assign card_product = block.settings.product -%}
        {%- assign card_link = block.settings.link -%}
        {%- if card_product != blank -%}{%- assign card_link = card_product.url -%}{%- endif -%}
        {%- assign fallback_asset = block.settings.fallback_asset | strip -%}
        {%- assign is_package_card = false -%}
        {%- if fallback_asset contains 'ki-ped-pack-' -%}{%- assign is_package_card = true -%}{%- endif -%}
        {%- assign subscription_discount_percent = block.settings.subscription_discount_percent | default: 0 -%}
        {%- if subscription_discount_percent == 0 and is_package_card -%}{%- assign subscription_discount_percent = 15 -%}{%- endif -%}
        {%- assign card_original_price = card_product.price | default: 0 -%}
        {%- assign card_discount_amount = card_original_price | times: subscription_discount_percent | divided_by: 100 -%}
        {%- assign card_discount_price = card_original_price | minus: card_discount_amount -%}
        {%- if card_link != blank -%}<a href="{{ card_link }}" class="kpc-card{% if is_package_card %} is-package{% endif %}" {{ block.shopify_attributes }}>{%- else -%}<article class="kpc-card is-placeholder{% if is_package_card %} is-package{% endif %}" {{ block.shopify_attributes }}>{%- endif -%}
          <div class="kpc-media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: widths: '280, 420, 620, 800', sizes: '(max-width:749px) 34vw, 33vw', loading: 'lazy', alt: block.settings.title | default: card_product.title }}
            {%- elsif fallback_asset != blank -%}
              <img src="{{ fallback_asset | asset_url }}" width="1080" height="1350" loading="lazy" alt="{{ block.settings.title | escape }}">
            {%- elsif card_product.featured_image != blank -%}
              {{ card_product.featured_image | image_url: width: 800 | image_tag: widths: '280, 420, 620, 800', sizes: '(max-width:749px) 34vw, 33vw', loading: 'lazy', alt: card_product.title }}
            {%- else -%}
              <svg viewBox="0 0 110 60" fill="none" stroke="currentColor" stroke-width="2"><rect x="18" y="12" width="74" height="38" rx="8"/><path d="M28 22h30M28 30h44M28 38h25"/><path d="m78 22 6 6-6 6"/></svg>
            {%- endif -%}
            {%- if block.settings.badge != blank -%}<span class="kpc-badge">{{ block.settings.badge }}</span>{%- endif -%}
          </div>
          <div class="kpc-body">
            <h3 class="kpc-name">{{ block.settings.title | default: card_product.title }}</h3>
            <p class="kpc-copy">{{ block.settings.description }}</p>
            <div class="kpc-footer">
              {%- if card_product != blank and subscription_discount_percent > 0 -%}
                <span class="kpc-price-wrap"><s class="kpc-price-old">{{ card_original_price | money }}</s><strong class="kpc-price">{{ card_discount_price | money }}</strong><span class="kpc-price-save">Abonelikte %{{ subscription_discount_percent }} indirim</span></span>
              {%- else -%}
                <span class="kpc-price">{% if card_product != blank %}{{ card_product.price | money }}{% elsif block.settings.price_text != blank %}{{ block.settings.price_text }}{% else %}Ürün bilgisi yakında{% endif %}</span>
              {%- endif -%}
              <span class="kpc-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
            </div>
          </div>
        {%- if card_link != blank -%}</a>{%- else -%}</article>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Ped Çapraz Satış",
  "tag":"section",
  "class":"section",
  "settings":[
    {"type":"color","id":"background","label":"Arka plan","default":"#ffffff"},
    {"type":"range","id":"padding_y","label":"Dikey boşluk","min":28,"max":96,"step":4,"unit":"px","default":56},
    {"type":"text","id":"eyebrow","label":"Üst etiket","default":"Rutinin için seçtik"},
    {"type":"text","id":"heading","label":"Başlık","default":"Hazır paketler ve diğer pedler"}
  ],
  "blocks":[{
    "type":"product_card","name":"Ürün veya paket kartı","limit":6,"settings":[
      {"type":"product","id":"product","label":"Shopify ürünü"},
      {"type":"image_picker","id":"image","label":"Özel görsel"},
      {"type":"text","id":"fallback_asset","label":"Tema görsel dosyası","info":"Örn. ki-ped-pack-light.png"},
      {"type":"url","id":"link","label":"Ürün bağlı değilse bağlantı"},
      {"type":"text","id":"title","label":"Başlık","default":"Light Paket"},
      {"type":"text","id":"description","label":"Kısa açıklama","default":"İhtiyaca göre hazırlanan ped paketi."},
      {"type":"text","id":"badge","label":"Rozet","default":"Hazır Paket"},
      {"type":"text","id":"price_text","label":"Ürün bağlı değilse fiyat metni","default":"Fiyat yakında"}
      ,{"type":"range","id":"subscription_discount_percent","label":"Abonelik indirimi","min":0,"max":30,"step":1,"unit":"%","default":0}
    ]
  }],
  "presets":[{"name":"Ped Çapraz Satış"}]
}
{% endschema %}
