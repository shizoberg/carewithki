{{ 'section-serbetci.css' | asset_url | stylesheet_tag }}

<div class="serbetci-landing">

  <div class="hero">
    <div class="hero-inner">
      <div class="tag">{{ section.settings.hero_tag }}</div>
      <h1>{{ section.settings.hero_title_light }}<br><strong>{{ section.settings.hero_title_bold }}</strong></h1>
      <p>{{ section.settings.hero_text }}</p>
      <a href="{{ section.settings.hero_btn_link }}" class="btn white">{{ section.settings.hero_btn_text }} <span class="arr">&rarr;</span></a>
    </div>
  </div>

  <section class="sec">
    <div class="wrap">
      <div class="split">
        <div class="img-box">
          {%- if section.settings.science_image != blank -%}
            <img src="{{ section.settings.science_image | image_url: width: 600 }}" alt="{{ section.settings.science_tag }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;border-radius:24px">
          {%- else -%}
            {{ section.settings.science_emoji }}
          {%- endif -%}
        </div>
        <div>
          <div class="sec-tag">{{ section.settings.science_tag }}</div>
          <h2>{{ section.settings.science_title_light }}<br><strong>{{ section.settings.science_title_bold }}</strong></h2>
          <p class="body-text">{{ section.settings.science_text_1 }}</p>
          <p class="body-text">{{ section.settings.science_text_2 }}</p>
          <div class="pills">
            {%- for block in section.blocks -%}
              {%- if block.type == 'pill' -%}
                <span class="pill" {{ block.shopify_attributes }}>{{ block.settings.pill_text }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
      <div class="stats">
        <div class="stat"><div class="stat-n">{{ section.settings.stat_1_number }}</div><div class="stat-l">{{ section.settings.stat_1_label }}</div></div>
        <div class="stat"><div class="stat-n">{{ section.settings.stat_2_number }}</div><div class="stat-l">{{ section.settings.stat_2_label }}</div></div>
        <div class="stat"><div class="stat-n">{{ section.settings.stat_3_number }}</div><div class="stat-l">{{ section.settings.stat_3_label }}</div></div>
      </div>
    </div>
  </section>

  <section class="sec alt">
    <div class="wrap">
      <div class="split" style="gap:48px">
        <div>
          <div class="sec-tag">{{ section.settings.steps_tag }}</div>
          <h2>{{ section.settings.steps_title_light }}<br><strong>{{ section.settings.steps_title_bold }}</strong></h2>
          <p class="body-text">{{ section.settings.steps_text }}</p>
        </div>
        <div class="steps">
          {%- assign step_num = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              {%- assign step_num = step_num | plus: 1 -%}
              <div class="step" {{ block.shopify_attributes }}>
                <div class="step-n">{{ step_num }}</div>
                <div><h4>{{ block.settings.step_title }}</h4><p>{{ block.settings.step_text }}</p></div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div style="text-align:center;max-width:540px;margin:0 auto 44px">
        <div class="sec-tag">{{ section.settings.benefits_tag }}</div>
        <h2>{{ section.settings.benefits_title_light }}<br><strong>{{ section.settings.benefits_title_bold }}</strong></h2>
      </div>
      <div class="grid2">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <div class="bcard" {{ block.shopify_attributes }}>
              <div class="ico">{{ block.settings.benefit_icon }}</div>
              <h3>{{ block.settings.benefit_title }}</h3>
              <p>{{ block.settings.benefit_text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="sec alt">
    <div class="wrap-sm">
      <div class="quote-wrap">
        <div class="avatar">{{ section.settings.quote_avatar }}</div>
        <div>
          <div class="sec-tag" style="margin-bottom:8px">{{ section.settings.quote_tag }}</div>
          <blockquote>"{{ section.settings.quote_text }}"</blockquote>
          <cite>{{ section.settings.quote_author }}</cite>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="serbetci-cta">
    <div class="wrap">
      <div class="cta-box">
        <div class="sec-tag" style="color:rgba(255,255,255,.55);margin-bottom:8px">{{ section.settings.cta_tag }}</div>
        <h2>{{ section.settings.cta_title }}</h2>
        <p>{{ section.settings.cta_text }}</p>
        <a href="{{ section.settings.cta_btn_link }}" class="btn white">{{ section.settings.cta_btn_text }} <span class="arr">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="sec alt">
    <div class="wrap-sm">
      <div style="text-align:center;margin-bottom:40px">
        <div class="sec-tag">{{ section.settings.faq_tag }}</div>
        <h2>{{ section.settings.faq_title_light }} <strong>{{ section.settings.faq_title_bold }}</strong></h2>
      </div>
      <div class="faq-list" data-faq-group="serbetci">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <div class="faq-item" {{ block.shopify_attributes }}>
              <button class="faq-btn" type="button">{{ block.settings.faq_question }}<span class="faq-ico">+</span></button>
              <div class="faq-body"><p>{{ block.settings.faq_answer }}</p></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

</div>

<script>
(function(){
  document.querySelectorAll('.serbetci-landing .faq-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var body = this.nextElementSibling;
      var ico = this.querySelector('.faq-ico');
      var isOpen = body.classList.contains('open');
      this.closest('.faq-list').querySelectorAll('.faq-body.open').forEach(function(el){
        el.classList.remove('open');
        el.previousElementSibling.querySelector('.faq-ico').textContent = '+';
      });
      if(!isOpen){ body.classList.add('open'); ico.textContent = '\u2212'; }
    });
  });
})();
</script>

{% schema %}
