{% comment %}
  Ki — Custom Product Showcase
  Layout: 
  - Desktop: 2 Column Grid. Each Item: [Image Left] [Text Right].
  - Mobile: Stacked.
  - Footer: 4 Decorative Blobs (per sketch).
{% endcomment %}

<style>
  .ki-showcase {
    --ki-purple-dark: #493d9a;
    background: {{ section.settings.bg | default: '#ffffff' }};
    padding: 80px 0;
  }

  .ki-showcase__wrap {
    max-width: var(--page-width, 1300px);
    margin: 0 auto;
    padding: 0 3rem;
  }

  /* Header */
  .ki-showcase__header {
    display: flex;
    align-items: center;
    gap: 0; /* Fully adjacent */
    margin-bottom: 40px;
    text-decoration: none;
    color: var(--ki-purple-dark);
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .ki-showcase__header svg { width: 28px; height: 28px; }

  /* Grid Layout */
  .ki-showcase__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
    margin-bottom: 60px;
  }

  /* Card Item: Image Left, Text Right */
  .ki-showcase__item {
    display: flex;
    align-items: flex-start; /* or center? Sketch looks top aligned */
    gap: 24px;
    background: #fff; /* Optional: Card background? Sketch has none/transparent? */
    background: transparent;
  }

  .ki-showcase__img-box {
    flex: 0 0 200px; /* Fixed width for image container */
    width: 200px;
    height: 240px; /* Vertical box */
    background: #e2dff7; /* Light purple bg for product cutout */
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: flex-end; /* Product usually sits at bottom */
    justify-content: center;
  }

  .ki-showcase__img-box img {
    width: 90%;
    height: auto;
    object-fit: contain;
    display: block;
    margin-bottom: 0;
  }

  .ki-showcase__text-box {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 10px; /* Align with image top */
  }

  .ki-showcase__title {
    font-size: 20px;
    font-weight: 800;
    color: var(--ki-purple-dark);
    line-height: 1.3;
    margin: 0;
  }

  .ki-showcase__desc {
    font-size: 15px;
    line-height: 1.5;
    color: #666;
    margin: 0;
  }

  /* Footer Blobs/Placeholders */
  .ki-showcase__footer {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .ki-showcase__blob {
    height: 100px;
    background: var(--ki-purple-dark);
    border-radius: 20px;
    opacity: 0.9;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .ki-showcase__blob:hover {
    transform: translateY(-4px);
    opacity: 1;
  }

  /* Mobile */
  @media (max-width: 900px) {
    .ki-showcase__grid {
      grid-template-columns: 1fr; /* Stack */
      gap: 32px;
    }
    .ki-showcase__item {
      flex-direction: row; 
      align-items: flex-start; /* Align Top (not center) */
      text-align: left; /* Ensure left align */
    }
    
    .ki-showcase__text-box {
       justify-content: flex-start;
       margin-top: 0;
       padding-top: 0; /* Remove top padding for strict alignment if needed, or keep for visual balance */
    }
    /* Mobile Zigzag Logic: Even items reversed (Text Left, Img Right) */
    .ki-showcase__item:nth-child(even) {
      flex-direction: row-reverse;
    }

    .ki-showcase__img-box {
      flex: 0 0 120px;
      width: 120px;
      height: 140px;
    }
    .ki-showcase__title { font-size: 18px; }
    .ki-showcase__desc { font-size: 14px; }
    
    .ki-showcase__footer {
      grid-template-columns: repeat(2, 1fr); /* 2x2 on mobile */
    }
    .ki-showcase__blob { height: 80px; }
  }
</style>

<section class="ki-showcase">
  <div class="ki-showcase__wrap">

    {% if section.settings.heading != blank %}
      <a href="{{ section.settings.heading_link | default: '#' }}" class="ki-showcase__header">
        {{ section.settings.heading }}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 28px; height: 28px;">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    {% endif %}

    <div class="ki-showcase__grid">
      {% for block in section.blocks %}
        {% if block.type == 'item' %}
        <div class="ki-showcase__item" {{ block.shopify_attributes }}>
          <div class="ki-showcase__img-box">
             {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
          </div>
          <div class="ki-showcase__text-box">
             {% if block.settings.title != blank %}
                <h3 class="ki-showcase__title">{{ block.settings.title }}</h3>
             {% endif %}
             {% if block.settings.description != blank %}
                <div class="ki-showcase__desc">{{ block.settings.description | newline_to_br }}</div>
             {% endif %}
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ki-showcase__footer">
      {% for block in section.blocks %}
        {% if block.type == 'blob' %}
          <a href="{{ block.settings.link | default: '#' }}" class="ki-showcase__blob" style="background-color: {{ block.settings.bg_color | default: '#493d9a' }};" {{ block.shopify_attributes }}>
            {% if block.settings.text != blank %}
              <span style="color:#fff; font-weight:700; font-size:14px; text-align:center; padding:10px;">{{ block.settings.text }}</span>
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Showcase (List)",
  "settings": [
    { "type": "color", "id": "bg", "label": "Arka Plan Rengi", "default": "#ffffff" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "kendine iyi bakman için" },
    { "type": "url", "id": "heading_link", "label": "Heading Link" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "başlık başlık" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "açıklama açıklama..." }
      ]
    },
    {
      "type": "blob",
      "name": "Footer Box (Blob)",
      "settings": [
        { "type": "text", "id": "text", "label": "Button Text" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "color", "id": "bg_color", "label": "Background Color (Overrides default)", "default": "#493d9a" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Showcase (List)",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "blob" },
        { "type": "blob" },
        { "type": "blob" },
        { "type": "blob" }
      ]
    }
  ]
}
{% endschema %}
