{% comment %}
  Minimal media renderer (Liquid side).
  JS will re-render on thumb click anyway; this is for initial paint.
{% endcomment %}
{% comment %}theme-check-disable UndefinedObject{% endcomment %}

{% case media.media_type %}
  {% when 'image' %}
    {{ media | image_url: width: 1400 | image_tag: loading: 'lazy', alt: media.alt | escape }}

  {% when 'video' %}
    {{ media | video_tag: controls: true, autoplay: false, loop: false, muted: false, playsinline: true }}

  {% when 'external_video' %}
    {{ media | external_video_tag }}

  {% else %}
    {{ 'image' | placeholder_svg_tag }}
{% endcase %}
{% comment %}theme-check-enable UndefinedObject{% endcomment %}
