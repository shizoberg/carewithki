{%- comment -%}
  ki-icon — paylaşılan SVG ikon kütüphanesi.
  Usage: {% render 'ki-icon', name: 'check', size: 16, class: 'extra-cls' %}
{%- endcomment -%}
{%- liquid
  assign s = size | default: 16
  assign cls = class | default: ''
-%}
{%- case name -%}
