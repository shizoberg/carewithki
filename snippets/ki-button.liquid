{% comment %}
  Ki Brand Button — Global Reusable Snippet
  ==========================================
  Kullanım:
    {% render 'ki-button', label: 'Ürünleri Gör', url: '/collections/all' %}
    {% render 'ki-button', label: 'Sepete Ekle', url: '#', style: 'outline' %}
    {% render 'ki-button', label: 'İncele', url: '/products/xyz', size: 'small' %}
    {% render 'ki-button', label: 'Bize Ulaş', url: '/pages/contact', style: 'white' %}
    {% render 'ki-button', label: 'Gönder', type: 'submit' %}

  Parametreler:
    label     : Buton yazısı (zorunlu)
    url       : Link adresi (boşsa button elementi render edilir)
    style     : 'primary' (default), 'outline', 'white', 'ghost'
    size      : 'normal' (default), 'small', 'large'
    type      : 'button' (default), 'submit'
    icon      : true/false — sağ ok gösterir (default: true)
    fullwidth : true/false — tam genişlik (default: false)
    id        : Özel HTML id
    class     : Ek CSS class
{% endcomment %}

{%- liquid
  assign btn_label = label | default: 'Ürünleri Gör'
  assign btn_url = url | default: ''
  assign btn_style = style | default: 'primary'
  assign btn_size = size | default: 'normal'
  assign btn_type = type | default: 'button'
  assign btn_icon = icon | default: true
  assign btn_fullwidth = fullwidth | default: false
  assign btn_id = id | default: ''
  assign btn_extra_class = class | default: ''

  assign size_class = 'ki-btn--normal'
  if btn_size == 'small'
    assign size_class = 'ki-btn--small'
  elsif btn_size == 'large'
    assign size_class = 'ki-btn--large'
  endif

  assign style_class = 'ki-btn--primary'
  if btn_style == 'outline'
    assign style_class = 'ki-btn--outline'
  elsif btn_style == 'white'
    assign style_class = 'ki-btn--white'
  elsif btn_style == 'ghost'
    assign style_class = 'ki-btn--ghost'
  endif

  assign width_class = ''
  if btn_fullwidth
    assign width_class = 'ki-btn--full'
  endif
-%}

<style>
  /* ============================================
     Ki Button — Global Styles
     One source of truth for ALL buttons.
     ============================================ */

  .ki-btn {
    --_bg: var(--ki-purple-dark, #493d9a);
    --_text: #fff;
    --_border: transparent;
    --_shadow: rgba(73, 61, 154, 0.3);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 28px;
    border-radius: 999px;
    border: 2px solid var(--_border);
    background: var(--_bg);
    color: var(--_text);
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease;
    box-shadow: 0 6px 20px var(--_shadow);
    -webkit-tap-highlight-color: transparent;
  }

  /* ---- Hover / Active ---- */
  .ki-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px var(--_shadow);
  }
  .ki-btn:active {
    transform: translateY(0);
    box-shadow: 0 4px 12px var(--_shadow);
  }
  .ki-btn:focus-visible {
    outline: 3px solid var(--ki-purple, #b2a5ff);
    outline-offset: 3px;
  }
  .ki-btn:disabled,
  .ki-btn.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none !important;
    box-shadow: none !important;
  }

  /* ---- Icon Arrow ---- */
  .ki-btn__icon {
    display: inline-flex;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .ki-btn:hover .ki-btn__icon {
    transform: translateX(4px);
  }

  /* ======================
     STYLE VARIANTS
     ====================== */

  /* Primary (default) — Solid purple */
  .ki-btn--primary {
    --_bg: var(--ki-purple-dark, #493d9a);
    --_text: #fff;
    --_border: transparent;
    --_shadow: rgba(73, 61, 154, 0.3);
  }
  .ki-btn--primary:hover {
    --_bg: var(--ki-purple, #b2a5ff);
    --_text: var(--ki-purple-dark, #493d9a);
  }

  /* Outline — Transparent with purple border */
  .ki-btn--outline {
    --_bg: transparent;
    --_text: var(--ki-purple-dark, #493d9a);
    --_border: var(--ki-purple-dark, #493d9a);
    --_shadow: rgba(73, 61, 154, 0.1);
  }
  .ki-btn--outline:hover {
    --_bg: var(--ki-purple-dark, #493d9a);
    --_text: #fff;
    --_border: var(--ki-purple-dark, #493d9a);
    --_shadow: rgba(73, 61, 154, 0.3);
  }

  /* White — White bg, purple text (hero overlay'de kullanılır) */
  .ki-btn--white {
    --_bg: #fff;
    --_text: var(--ki-purple-dark, #493d9a);
    --_border: transparent;
    --_shadow: rgba(0, 0, 0, 0.15);
  }
  .ki-btn--white:hover {
    --_bg: var(--ki-lilac, #dad2ff);
    --_text: var(--ki-purple-dark, #493d9a);
    --_shadow: rgba(0, 0, 0, 0.2);
  }

  /* Ghost — No background, no border, minimal */
  .ki-btn--ghost {
    --_bg: transparent;
    --_text: var(--ki-purple-dark, #493d9a);
    --_border: transparent;
    --_shadow: transparent;
    padding-left: 4px;
    padding-right: 4px;
  }
  .ki-btn--ghost:hover {
    --_text: var(--ki-purple, #b2a5ff);
    --_shadow: transparent;
    transform: translateX(4px);
  }

  /* ======================
     SIZE VARIANTS
     ====================== */

  .ki-btn--small {
    padding: 10px 20px;
    font-size: 13px;
    gap: 8px;
  }
  .ki-btn--small .ki-btn__icon {
    width: 14px;
    height: 14px;
  }

  .ki-btn--normal {
    padding: 14px 28px;
    font-size: 15px;
  }

  .ki-btn--large {
    padding: 18px 36px;
    font-size: 17px;
    gap: 12px;
  }
  .ki-btn--large .ki-btn__icon {
    width: 18px;
    height: 18px;
  }

  /* Full width */
  .ki-btn--full {
    width: 100%;
  }

  /* ======================
     RESPONSIVE
     ====================== */
  @media (max-width: 749px) {
    .ki-btn--normal {
      padding: 12px 24px;
      font-size: 14px;
    }
    .ki-btn--large {
      padding: 14px 28px;
      font-size: 15px;
    }
    .ki-btn--small {
      padding: 8px 16px;
      font-size: 12px;
    }
  }
</style>

{%- if btn_url != blank -%}
  <a href="{{ btn_url }}"
    class="ki-btn {{ style_class }} {{ size_class }} {{ width_class }} {{ btn_extra_class }}"
    {% if btn_id != blank %}id="{{ btn_id }}"{% endif %}
    role="button">
    <span>{{ btn_label }}</span>
    {%- if btn_icon -%}
      <span class="ki-btn__icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 10h10M12 6l4 4-4 4"/>
        </svg>
      </span>
    {%- endif -%}
  </a>
{%- else -%}
  <button type="{{ btn_type }}"
    class="ki-btn {{ style_class }} {{ size_class }} {{ width_class }} {{ btn_extra_class }}"
    {% if btn_id != blank %}id="{{ btn_id }}"{% endif %}>
    <span>{{ btn_label }}</span>
    {%- if btn_icon -%}
      <span class="ki-btn__icon" aria-hidden="true">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 10h10M12 6l4 4-4 4"/>
        </svg>
      </span>
    {%- endif -%}
  </button>
{%- endif -%}