{%- comment -%}
  Ped boyutu göstergesi.
  active: small | medium | large
{%- endcomment -%}
{%- liquid
  case active
    when 'small'
      assign size_label = 'Günlük ped · küçük boy'
    when 'medium'
      assign size_label = 'Normal ped · orta boy'
    when 'large'
      assign size_label = 'Gece pedi · büyük boy'
    else
      assign size_label = 'Ped boyutu'
  endcase
-%}
<svg class="ki-pack__pad-size" viewBox="0 0 58 28" role="img" aria-label="{{ size_label }}">
  <path class="ki-pack__pad-shape{% if active == 'small' %} is-active{% endif %}" d="M3.8 7.2C4.7 4 6.3 2.8 9 2.8s4.3 1.2 5.2 4.4c.6 2.2-.2 4.4-1.2 6.8 1 2.4 1.8 4.6 1.2 6.8-.9 3.2-2.5 4.4-5.2 4.4s-4.3-1.2-5.2-4.4c-.6-2.2.2-4.4 1.2-6.8-1-2.4-1.8-4.6-1.2-6.8Z"/>
  <path class="ki-pack__pad-shape{% if active == 'medium' %} is-active{% endif %}" d="M21.2 5.6c1-2.7 2.9-3.8 5.8-3.8s4.8 1.1 5.8 3.8c.9 2.4.1 5.4-1 8.4 1.1 3 1.9 6 1 8.4-1 2.7-2.9 3.8-5.8 3.8s-4.8-1.1-5.8-3.8c-.9-2.4-.1-5.4 1-8.4-1.1-3-1.9-6-1-8.4Z"/>
  <path class="ki-pack__pad-shape{% if active == 'large' %} is-active{% endif %}" d="M39.2 4.8C40.2 2 42.3 1 45.5 1s5.3 1 6.3 3.8c1 2.7.2 5.9-1 9.2 1.2 3.3 2 6.5 1 9.2-1 2.8-3.1 3.8-6.3 3.8s-5.3-1-6.3-3.8c-1-2.7-.2-5.9 1-9.2-1.2-3.3-2-6.5-1-9.2Z"/>
</svg>
