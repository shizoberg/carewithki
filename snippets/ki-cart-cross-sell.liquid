{%- liquid
  assign cross_sell_products = settings.cart_cross_sell_products
  if cross_sell_products == blank
    assign cross_sell_products = collections['ki-magaza'].products
  endif
  assign discount_percent = settings.cart_cross_sell_discount_percent | default: 10
  assign cross_sell_limit = settings.cart_cross_sell_limit | default: 4
  capture cart_product_tokens
    for item in cart.items
      echo '|'
      echo item.product_id
      echo '|'
    endfor
  endcapture
  assign visible_cross_sell_count = 0
-%}

{%- if settings.cart_cross_sell_enabled and cross_sell_products.size > 0 -%}
  {%- capture cross_sell_cards -%}
    {%- for cross_sell_product in cross_sell_products -%}
      {%- assign product_token = '|' | append: cross_sell_product.id | append: '|' -%}
      {%- assign cross_sell_variant = cross_sell_product.selected_or_first_available_variant -%}
      {%- unless cart_product_tokens contains product_token or cross_sell_variant.available == false -%}
        {%- assign visible_cross_sell_count = visible_cross_sell_count | plus: 1 -%}
        {%- assign discount_multiplier = 100 | minus: discount_percent -%}
        {%- assign discounted_price = cross_sell_variant.price | times: discount_multiplier | divided_by: 100 -%}
        <article class="ki-cart-offer__card">
          <a href="{{ cross_sell_product.url }}" class="ki-cart-offer__image">
            {%- if cross_sell_product.featured_image -%}
              {{ cross_sell_product.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '100, 160, 220', sizes: '92px', alt: cross_sell_product.title }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </a>
          <div class="ki-cart-offer__body">
            <a href="{{ cross_sell_product.url }}" class="ki-cart-offer__title">{{ cross_sell_product.title | escape }}</a>
            <div class="ki-cart-offer__prices">
              {%- if settings.cart_cross_sell_discount_code != blank -%}
                <s>{{ cross_sell_variant.price | money }}</s>
                <strong>{{ discounted_price | money }}</strong>
              {%- else -%}
                <strong>{{ cross_sell_variant.price | money }}</strong>
              {%- endif -%}
            </div>
            <button
              type="button"
              class="ki-cart-offer__add"
              data-ki-cross-sell-add="{{ cross_sell_variant.id }}"
              data-discount-code="{{ settings.cart_cross_sell_discount_code | escape }}"
              data-discount-percent="{{ discount_percent }}"
            >
              {%- if settings.cart_cross_sell_discount_code != blank -%}
                Hemen ekle · %{{ discount_percent }} indirim
              {%- else -%}
                Hemen ekle
              {%- endif -%}
            </button>
          </div>
        </article>
        {%- if visible_cross_sell_count >= cross_sell_limit -%}{%- break -%}{%- endif -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if visible_cross_sell_count > 0 -%}
    <aside class="ki-cart-offer" aria-label="Sepetine özel ürün önerileri">
      <div class="ki-cart-offer__heading">
        <div>
          <span>Sepetine özel</span>
          <h3>{{ settings.cart_cross_sell_heading | default: 'Bunu da sevebilirsin' | escape }}</h3>
        </div>
        {%- if settings.cart_cross_sell_discount_code != blank -%}
          <b>%{{ discount_percent }}</b>
        {%- endif -%}
      </div>
      <div class="ki-cart-offer__track">
        {{ cross_sell_cards }}
      </div>
      <p class="ki-cart-offer__status" data-ki-cross-sell-status role="status" aria-live="polite"></p>
    </aside>
  {%- endif -%}
{%- endif -%}

<style>
.ki-cart-offer{margin:0 16px 16px;padding:14px;border:1px solid var(--ki-bdr);border-radius:14px;background:#fff}
.ki-cart-offer__heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}
.ki-cart-offer__heading span{display:block;color:var(--ki-mut);font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
.ki-cart-offer__heading h3{margin:2px 0 0;color:var(--ki-txt);font-size:14px;line-height:1.2}
.ki-cart-offer__heading b{display:inline-flex;align-items:center;justify-content:center;min-width:42px;padding:5px 8px;border-radius:30px;background:#e8f7ef;color:#16834b;font-size:11px}
.ki-cart-offer__track{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(245px,86%);gap:9px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:2px}
.ki-cart-offer__track::-webkit-scrollbar{display:none}
.ki-cart-offer__card{display:grid;grid-template-columns:78px 1fr;gap:10px;padding:8px;border:1px solid rgba(73,61,154,.1);border-radius:11px;background:var(--ki-lilf);scroll-snap-align:start}
.ki-cart-offer__image{width:78px;height:78px;border-radius:8px;overflow:hidden;background:#fff}
.ki-cart-offer__image img,.ki-cart-offer__image svg{display:block;width:100%;height:100%;object-fit:cover}
.ki-cart-offer__body{min-width:0;display:flex;flex-direction:column;align-items:flex-start}
.ki-cart-offer__title{color:var(--ki-txt);font-size:11.5px;font-weight:800;line-height:1.25;text-decoration:none;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.ki-cart-offer__prices{display:flex;align-items:center;gap:6px;margin:4px 0 7px;font-size:11px}
.ki-cart-offer__prices s{color:var(--ki-mut)}
.ki-cart-offer__prices strong{color:var(--ki-p);font-size:12px}
.ki-cart-offer__add{margin-top:auto;width:100%;min-height:29px;padding:5px 8px;border:0;border-radius:7px;background:var(--ki-p);color:#fff;font:inherit;font-size:9.5px;font-weight:800;cursor:pointer}
.ki-cart-offer__add:disabled{opacity:.6;cursor:wait}
.ki-cart-offer__status{min-height:0;margin:7px 0 0;color:var(--ki-mut);font-size:10px}
.ki-cart-offer__status:empty{display:none}
</style>
