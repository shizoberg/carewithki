{% comment %}.ki Cookie Banner{% endcomment %}

<style>
#ki-cookie {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%) translateY(120px);
  z-index: 99999;
  width: calc(100% - 32px);
  max-width: 520px;
  background: #fff;
  border-radius: 20px;
  box-shadow: 0 8px 40px rgba(73,61,154,0.18), 0 2px 12px rgba(0,0,0,0.08);
  padding: 24px 24px 20px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  font-family: system-ui, sans-serif;
  opacity: 0;
  transition: transform 0.45s cubic-bezier(0.34,1.56,0.64,1), opacity 0.35s ease;
  pointer-events: none;
  border: 1px solid rgba(73,61,154,0.10);
}
#ki-cookie.is-visible {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
  pointer-events: all;
}
#ki-cookie.is-hiding {
  transform: translateX(-50%) translateY(120px);
  opacity: 0;
  pointer-events: none;
}

#ki-cookie .kc-top {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}
#ki-cookie .kc-icon {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background: rgba(73,61,154,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
#ki-cookie .kc-icon svg {
  width: 20px;
  height: 20px;
}
#ki-cookie .kc-text-wrap {
  flex: 1;
  min-width: 0;
}
#ki-cookie .kc-title {
  font-size: 14px;
  font-weight: 700;
  color: #1a1340;
  margin: 0 0 4px;
  line-height: 1.3;
}
#ki-cookie .kc-text {
  font-size: 12.5px;
  line-height: 1.6;
  color: #666;
  margin: 0;
}
#ki-cookie .kc-text a {
  color: #493d9a;
  text-decoration: underline;
  text-underline-offset: 2px;
}

#ki-cookie .kc-actions {
  display: flex;
  gap: 10px;
  align-items: center;
}
#ki-cookie .kc-btn-accept {
  flex: 1;
  padding: 11px 20px;
  background: #493d9a;
  color: #fff;
  border: none;
  border-radius: 50px;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.2s, transform 0.15s;
  letter-spacing: 0.01em;
}
#ki-cookie .kc-btn-accept:hover {
  background: #3b3280;
  transform: translateY(-1px);
}
#ki-cookie .kc-btn-decline {
  padding: 11px 16px;
  background: transparent;
  color: #999;
  border: 1.5px solid rgba(0,0,0,0.10);
  border-radius: 50px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  white-space: nowrap;
}
#ki-cookie .kc-btn-decline:hover {
  border-color: rgba(73,61,154,0.25);
  color: #493d9a;
}

@media (max-width: 480px) {
  #ki-cookie {
    bottom: 16px;
    padding: 20px 18px 16px;
    border-radius: 16px;
  }
  #ki-cookie .kc-actions {
    flex-direction: column;
  }
  #ki-cookie .kc-btn-accept,
  #ki-cookie .kc-btn-decline {
    width: 100%;
    text-align: center;
  }
}
</style>

<div id="ki-cookie" role="dialog" aria-label="Çerez bildirimi" aria-live="polite">
  <div class="kc-top">
    <div class="kc-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="#493d9a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
        <path d="M8.5 8.5v.01"/>
        <path d="M16 15.5v.01"/>
        <path d="M12 12v.01"/>
      </svg>
    </div>
    <div class="kc-text-wrap">
      <p class="kc-title">Sana daha iyi bir deneyim sunmak istiyoruz 🌿</p>
      <p class="kc-text">
        Siteyi geliştirmek ve kişiselleştirmek için çerezler kullanıyoruz.
        Devam ederek <a href="/pages/gizlilik-politikasi">Gizlilik Politikamızı</a> kabul etmiş olursun.
      </p>
    </div>
  </div>
  <div class="kc-actions">
    <button class="kc-btn-accept" id="ki-cookie-accept">Kabul Et</button>
    <button class="kc-btn-decline" id="ki-cookie-decline">Reddet</button>
  </div>
</div>

<script>
(function() {
  var KEY = 'ki_cookie_consent';
  var banner = document.getElementById('ki-cookie');
  if (!banner) return;
  if (localStorage.getItem(KEY)) return;

  /* Sayfa yuklenince goster */
  setTimeout(function() {
    banner.classList.add('is-visible');
  }, 900);

  function dismiss(val) {
    localStorage.setItem(KEY, val);
    banner.classList.remove('is-visible');
    banner.classList.add('is-hiding');
    setTimeout(function() { banner.style.display = 'none'; }, 500);
  }

  document.getElementById('ki-cookie-accept').addEventListener('click', function() {
    dismiss('accepted');
  });
  document.getElementById('ki-cookie-decline').addEventListener('click', function() {
    dismiss('declined');
  });
})();
</script>
