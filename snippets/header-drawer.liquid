{% comment %} Ki Drawer v11 — hijyenik pedler kategorisi eklendi {% endcomment %}
<style>
.ki-drawer-header{padding:16px 16px 10px}
.ki-drawer-title{font-size:17px;font-weight:700;color:#493d9a;margin:0}
.ki-mc-grid{display:grid;grid-template-columns:1fr!important;gap:8px;padding:0 16px 8px}
.ki-mc{display:flex;flex-direction:row;align-items:stretch;min-height:82px;border-radius:12px;overflow:hidden;text-decoration:none;color:#222;border:1px solid rgba(73,61,154,.1);box-shadow:0 2px 8px rgba(73,61,154,.06)}
/* Görsel wrapper — div ile sabit oran */
.ki-mc__media{
  position:relative;
  width:96px;
  min-width:96px;
  height:82px;
  padding-top:0;
  overflow:hidden;
  background:#f0eeff;
  display:block;
}
.ki-mc__media img{
  position:absolute;
  top:0; left:0;
  width:100%; height:100%;
  object-fit:cover;
  display:block;
}
.ki-mc__ph{
  position:absolute;
  top:0; left:0; right:0; bottom:0;
  background:linear-gradient(135deg,#e8e4ff,#f8f6ff);
  display:flex;align-items:center;justify-content:center;
}
.ki-mc__ph svg{width:28px;height:28px;color:rgba(73,61,154,.25)}
.ki-mc__body{flex:1;padding:12px 14px;display:flex;align-items:center;justify-content:space-between;gap:10px}
.ki-mc__name{font-size:13px;font-weight:700;color:#493d9a}
.ki-mc__arr svg{width:12px;height:12px;color:#493d9a}
.ki-sec{padding:12px 16px 2px}
.ki-sec__ttl{font-size:10px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:#493d9a;margin:0 0 6px;padding-bottom:7px;border-bottom:2px solid rgba(73,61,154,.1)}
.ki-sec__list{list-style:none;margin:0;padding:0}
.ki-row{display:flex;align-items:center;gap:12px;padding:11px 4px;border-bottom:1px solid rgba(0,0,0,.04);text-decoration:none;color:#222}
.ki-row:last-child{border-bottom:none}
.ki-ico{width:36px;height:36px;border-radius:50%;background:rgba(73,61,154,.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#493d9a}
.ki-ico svg{width:17px;height:17px}
.ki-lbl{font-size:15px;font-weight:500;flex:1;color:#222}
.ki-chv{color:#ccc;flex-shrink:0}
.ki-chv svg{width:15px;height:15px;display:block}
.ki-other{padding:4px 16px 6px;margin-top:4px;border-top:1px solid rgba(0,0,0,.06)}
.ki-other a{display:flex;align-items:center;gap:12px;padding:12px 4px;border-bottom:1px solid rgba(0,0,0,.04);text-decoration:none;color:#333;font-size:15px;font-weight:500}
.ki-other a:last-child{border-bottom:none}
.ki-other .ki-ico{background:rgba(73,61,154,.06)}
.ki-trendyol{display:flex;align-items:center;gap:12px;margin:0 16px 4px;padding:12px 14px;border-radius:12px;background:rgba(255,110,0,.06);border:1px solid rgba(255,110,0,.18);text-decoration:none;color:#d94f00;font-size:14px;font-weight:700;transition:background .15s}
.ki-trendyol:hover{background:rgba(255,110,0,.12)}
.ki-trendyol__ico{width:34px;height:34px;border-radius:50%;background:rgba(255,110,0,.12);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ki-trendyol__ico svg{width:18px;height:18px}
.ki-trendyol__arrow{color:#d94f00;opacity:.5;margin-left:auto}
.ki-trendyol__arrow svg{width:14px;height:14px}
.ki-wa{display:flex;align-items:center;gap:10px;margin:10px 16px 6px;padding:13px 16px;background:#25d366;border-radius:12px;text-decoration:none;color:#fff;font-size:14px;font-weight:700;box-shadow:0 4px 12px rgba(37,211,102,.3)}
.ki-wa svg{width:22px;height:22px;flex-shrink:0}
.ki-bilimi{display:flex;align-items:center;justify-content:center;margin:6px 16px 16px;padding:14px 16px;background:#493d9a;border-radius:12px;text-decoration:none;color:#fff;font-size:15px;font-weight:700;box-shadow:0 4px 12px rgba(73,61,154,.3)}
</style>

