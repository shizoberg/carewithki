</nav>

<script>
(function() {
  function positionPanels() {
    var nav = document.getElementById('ki-mega-nav');
    if (!nav) return;
    nav.querySelectorAll('.ki-mega-nav__item').forEach(function(item) {
      var panel = item.querySelector('.ki-mega-panel');
      if (!panel) return;
      var link = item.querySelector('.ki-mega-nav__link');
      var rect = link.getBoundingClientRect();
      var pw = panel.scrollWidth || 760;
      var ww = window.innerWidth;
      var left = rect.left;
      if (left + pw > ww - 16) left = ww - pw - 16;
      if (left < 16) left = 16;
      panel.style.left = left + 'px';
      panel.style.top = (rect.bottom + 4) + 'px';
    });
  }
  document.addEventListener('DOMContentLoaded', positionPanels);
  window.addEventListener('resize', positionPanels);
  window.addEventListener('scroll', positionPanels, { passive: true });
})();
</script>
