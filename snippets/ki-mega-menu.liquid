{% comment %}Ki Mega Menu – Desktop v3 — hijyenik pedler kolonu eklendi{% endcomment %}

<style>
.ki-mega-nav { display: none; }
@media screen and (min-width: 990px) {
  .ki-mega-nav {
    display: flex; align-items: center; gap: 2px;
    list-style: none; margin: 0; padding: 0;
    grid-column: 1; grid-row: 1; justify-self: start;
  }
  .ki-mega-nav__item { position: relative; }
  .ki-mega-nav__link {
    display: flex; align-items: center; gap: 4px;
    padding: 8px 12px; font-size: 13px; font-weight: 500;
    color: #493d9a; text-decoration: none; border-radius: 8px;
    transition: background .15s; white-space: nowrap;
    background: none; border: none; cursor: pointer; font-family: inherit;
  }
  .ki-mega-nav__link:hover { background: rgba(73,61,154,.08); }
  .ki-mega-nav__chevron { width: 13px; height: 13px; transition: transform .2s; flex-shrink: 0; }

  /* Panel */
  .ki-mega-panel {
    visibility: hidden; opacity: 0; pointer-events: none;
    position: fixed;
    background: #fff; border-radius: 16px;
    box-shadow: 0 8px 40px rgba(73,61,154,.14), 0 2px 8px rgba(0,0,0,.06);
    border: 1px solid rgba(73,61,154,.08);
    padding: 20px; z-index: 9999;
    transition: opacity .15s ease, visibility .15s ease;
  }
  .ki-mega-nav__item:hover .ki-mega-panel,
  .ki-mega-panel:hover {
    visibility: visible; opacity: 1; pointer-events: auto;
  }
  .ki-mega-nav__item:hover .ki-mega-nav__chevron { transform: rotate(180deg); }

  .ki-mega-panel--full { grid-template-columns: 160px 190px 160px 150px 150px; gap: 0 18px; display: grid; }
  .ki-mega-panel--simple { min-width: 180px; display: block; }

  /* Sütun başlığı */
  .ki-mega-col__title {
    font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    color: #493d9a; padding: 0 6px 8px; margin-bottom: 2px;
    border-bottom: 2px solid rgba(73,61,154,.1);
  }
  .ki-mega-col__list { list-style: none; margin: 0; padding: 0; }

  /* Satır — mobil drawer ile aynı yapı */
  .ki-mega-col__item {
    display: flex; align-items: center; gap: 10px;
    padding: 7px 6px; border-radius: 8px;
    text-decoration: none; color: #222; transition: background .15s;
  }
  .ki-mega-col__item:hover { background: rgba(73,61,154,.06); }
  .ki-mega-col__icon {
    width: 32px; height: 32px; border-radius: 50%;
    background: rgba(73,61,154,.08);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; color: #493d9a;
  }
  .ki-mega-col__icon svg { width: 15px; height: 15px; }
  .ki-mega-col__icon--pad svg { width: 26px; height: 15px; }
  .ki-mega-col__icon--pad .ki-pack__pad-shape { fill: transparent; stroke: rgba(73,61,154,.3); stroke-width: 1.45; }
  .ki-mega-col__icon--pad .ki-pack__pad-shape.is-active { fill: #493d9a; stroke: #493d9a; }
  .ki-mega-col__label { font-size: 12px; font-weight: 600; line-height: 1.3; color: #222; }
  .ki-mega-col__item:hover .ki-mega-col__label { color: #493d9a; }
  .ki-mega-col__divider { margin-top: 14px; padding-top: 10px; border-top: 1px solid rgba(73,61,154,.08); }

  /* Kart — 4/3 oranı, wrapper ile */
  .ki-mega-card {
    display: flex; flex-direction: column; border-radius: 10px; overflow: hidden;
    text-decoration: none; color: #222;
    border: 1px solid rgba(73,61,154,.08);
    transition: box-shadow .2s, transform .2s;
  }
  .ki-mega-card:hover { box-shadow: 0 6px 20px rgba(73,61,154,.15); transform: translateY(-2px); }
  /* 4/3 wrapper */
  .ki-mega-card__media {
    position: relative;
    width: 100%;
    padding-top: 75%; /* 4:3 */
    overflow: hidden;
    background: #f0eeff;
  }
  .ki-mega-card__media img {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }
  .ki-mega-card__ph {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(135deg,#e8e4ff,#f8f6ff);
    display: flex; align-items: center; justify-content: center;
  }
  .ki-mega-card__ph svg { width: 32px; height: 32px; color: rgba(73,61,154,.25); }
  .ki-mega-card__body { padding: 8px 10px 10px; display: flex; align-items: center; justify-content: space-between; }
  .ki-mega-card__name { font-size: 12px; font-weight: 700; color: #493d9a; }
  .ki-mega-card__arrow svg { width: 14px; height: 14px; color: #493d9a; }

  /* Footer */
  .ki-mega-footer {
    grid-column: 1 / -1; padding-top: 12px; margin-top: 10px;
    border-top: 1px solid rgba(73,61,154,.08);
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;
  }
  .ki-mega-footer__link {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 12px; font-weight: 600; color: #493d9a;
    text-decoration: none; transition: gap .15s;
  }
  .ki-mega-footer__link:hover { gap: 8px; }
  .ki-mega-footer__link svg { width: 13px; height: 13px; }
  .ki-mega-wa {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 12px; font-weight: 600; color: #25d366; text-decoration: none;
  }
  .ki-mega-wa svg { width: 14px; height: 14px; }
  .ki-mega-simple-item {
    display: block; padding: 9px 12px; border-radius: 8px;
    text-decoration: none; color: #222; font-size: 13px; font-weight: 500; transition: background .15s;
  }
  .ki-mega-simple-item:hover { background: rgba(73,61,154,.06); color: #493d9a; }
}
@media screen and (max-width: 989px) { .ki-mega-nav { display: none !important; } }
</style>

{%- assign mega_menu_handle = section.settings.menu -%}
{%- assign mega_blocks = section.blocks | where: 'type', 'mega_image' -%}
{%- assign mega_block = mega_blocks | first -%}

<nav class="ki-mega-nav" aria-label="Ana navigasyon" id="ki-mega-nav">
  {%- for link in linklists[mega_menu_handle].links -%}
    <li class="ki-mega-nav__item">
      {%- if link.links.size > 0 -%}
        <a href="{{ link.url }}" class="ki-mega-nav__link">
          {{ link.title }}
          <svg class="ki-mega-nav__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
      {%- else -%}
        <a href="{{ link.url }}" class="ki-mega-nav__link">{{ link.title }}</a>
      {%- endif -%}

      {%- if link.links.size > 0 -%}
        {%- assign is_product_menu = false -%}
        {%- if link.title == 'Mağaza' or link.title == 'Takviye Edici Gıdalarımız' or link.title contains 'rün' -%}
          {%- assign is_product_menu = true -%}
        {%- endif -%}

        {%- if is_product_menu -%}
