              {%- else -%}
                <div class="ki-mega-card__ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>
              {%- endif -%}
            </div>
            <div class="ki-mega-card__body">
              <span class="ki-mega-card__name">{{ mega_block.settings.card2_label | default: 'Tüm Ürünler' }}</span>
              <span class="ki-mega-card__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg></span>
            </div>
