{%- liquid
  assign preset_product_1 = block.settings.product_1
  assign preset_product_2 = block.settings.product_2
  assign preset_product_3 = block.settings.product_3
  assign preset_total = 0

  if preset_product_1 != blank
    assign preset_line_1 = preset_product_1.selected_or_first_available_variant.price | times: block.settings.qty_1
    assign preset_total = preset_total | plus: preset_line_1
  endif
  if preset_product_2 != blank
    assign preset_line_2 = preset_product_2.selected_or_first_available_variant.price | times: block.settings.qty_2
    assign preset_total = preset_total | plus: preset_line_2
  endif
  if preset_product_3 != blank
    assign preset_line_3 = preset_product_3.selected_or_first_available_variant.price | times: block.settings.qty_3
    assign preset_total = preset_total | plus: preset_line_3
  endif

  assign preset_subscription_total = preset_total | times: 85 | divided_by: 100
  assign preset_key = block.settings.preset_key | handle
-%}

<li class="kbd-card kbd-card--virtual" {{ block.shopify_attributes }}>
  <a href="/pages/paket-olustur?preset={{ preset_key | url_encode }}" class="kbd-card__hero kbd-card__collage" aria-label="{{ block.settings.title | escape }}">
    {%- for collage_index in (1..3) -%}
      {%- liquid
        case collage_index
          when 1
            assign collage_product = preset_product_1
          when 2
            assign collage_product = preset_product_2
          else
            assign collage_product = preset_product_3
        endcase
      -%}
      {%- if collage_product != blank and collage_product.featured_image -%}
        <span class="kbd-card__collage-item kbd-card__collage-item--{{ collage_index }}">
          {{ collage_product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: collage_product.title }}
        </span>
      {%- endif -%}
    {%- endfor -%}
    <span class="kbd-card__save">Abonelikte %15</span>
    <span class="kbd-card__pack-label">{{ block.settings.pack_label | default: 'Bakım Rutini' | escape }}</span>
  </a>

  <div class="kbd-card__body">
    <div class="kbd-card__meta">Senin için hazırlanmış rutin</div>
    <a href="/pages/paket-olustur?preset={{ preset_key | url_encode }}" class="kbd-card__title">{{ block.settings.title | escape }}</a>
    {%- if block.settings.description != blank -%}
      <p class="kbd-card__desc">{{ block.settings.description | escape }}</p>
    {%- endif -%}

    <div class="kbd-card__products">
      {%- if preset_product_1 != blank -%}<span class="kbd-card__product-tag">{{ block.settings.qty_1 }}× {{ preset_product_1.title | escape }}</span>{%- endif -%}
      {%- if preset_product_2 != blank -%}<span class="kbd-card__product-tag">{{ block.settings.qty_2 }}× {{ preset_product_2.title | escape }}</span>{%- endif -%}
      {%- if preset_product_3 != blank -%}<span class="kbd-card__product-tag">{{ block.settings.qty_3 }}× {{ preset_product_3.title | escape }}</span>{%- endif -%}
    </div>

    <div class="kbd-card__footer">
      <div class="kbd-card__prices">
        <span class="kbd-card__price">{{ preset_subscription_total | money }}</span>
        <span class="kbd-card__compare">{{ preset_total | money }}</span>
      </div>
      <div class="kbd-card__actions">
        <a href="/pages/paket-olustur?preset={{ preset_key | url_encode }}" class="kbd-card__btn">Paketi seç →</a>
      </div>
    </div>
  </div>
</li>
