{%- comment -%}
  Technical SEO shared by products, collections and content pages.
  Human-facing title/description tags are prepared in layout/theme.liquid;
  this snippet adds machine-readable entities without duplicating those tags.
{%- endcomment -%}

{%- liquid
  assign ki_seo_title = seo_title | default: page_title
  assign ki_seo_description = seo_description | default: page_description
  assign ki_ped_bundle_handles = '|ki-light-ped-paketi-15-adet|ki-medium-ped-paketi-22-adet|ki-yogun-gunler-ped-paketi-26-adet|'
  assign ki_noindex_page_handles = '|spurit-invoices-cancelled|spurit-reminders-cancelled|spurit-notifications-cancelled|spurit-merchant-notifications-cancelled|'
  assign ki_product_token = ''
  assign ki_page_token = ''
  assign ki_noindex = false
  if product
    assign ki_product_token = '|' | append: product.handle | append: '|'
  endif
  if page
    assign ki_page_token = '|' | append: page.handle | append: '|'
  endif
  if request.page_type == 'product' and product.handle == 'ki-test-urun'
    assign ki_noindex = true
  elsif request.page_type == 'page' and ki_noindex_page_handles contains ki_page_token
    assign ki_noindex = true
  endif
-%}

<meta name="author" content=".ki">
{%- if ki_noindex -%}
  <meta name="robots" content="noindex,nofollow">
{%- elsif request.page_type == 'index' or request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'page' or request.page_type == 'article' -%}
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1">
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
  {%- liquid
    assign ki_seo_variant = product.selected_or_first_available_variant
    assign ki_availability = 'https://schema.org/OutOfStock'
    assign ki_structured_fallback_asset = ''
    assign ki_gtin_property = ''
    if ki_seo_variant.available
      assign ki_availability = 'https://schema.org/InStock'
    endif
    assign ki_barcode_size = ki_seo_variant.barcode | size
    case ki_barcode_size
      when 8
        assign ki_gtin_property = 'gtin8'
      when 12
        assign ki_gtin_property = 'gtin12'
      when 13
        assign ki_gtin_property = 'gtin13'
      when 14
        assign ki_gtin_property = 'gtin14'
    endcase
    case product.handle
      when 'ki-light-ped-paketi-15-adet'
        assign ki_structured_fallback_asset = 'ki-ped-pack-light.png'
      when 'ki-medium-ped-paketi-22-adet'
        assign ki_structured_fallback_asset = 'ki-ped-pack-medium.png'
      when 'ki-yogun-gunler-ped-paketi-26-adet'
        assign ki_structured_fallback_asset = 'ki-ped-pack-intense.png'
    endcase
  -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": {{ canonical_url | append: '#product' | json }},
    "name": {{ product.title | json }},
    "description": {{ ki_seo_description | json }},
    "brand": { "@type": "Brand", "name": ".ki" },
    "manufacturer": { "@id": "https://www.carewithki.com/#organization" }{% if ki_seo_variant.sku != blank %},
    "sku": {{ ki_seo_variant.sku | json }}{% endif %}{% if ki_gtin_property != blank %},
    {{ ki_gtin_property | json }}: {{ ki_seo_variant.barcode | json }}{% endif %},
    "url": {{ canonical_url | json }},
    "category": {{ product.type | default: 'Kadın sağlığı ve kişisel bakım' | json }}{% if product.images.size > 0 or ki_structured_fallback_asset != blank %},
    "image": [
      {%- if product.images.size > 0 -%}
        {%- for product_image in product.images limit: 6 -%}
          {{ product_image | image_url: width: 1600 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- elsif ki_structured_fallback_asset != blank -%}
        {{ ki_structured_fallback_asset | asset_url | prepend: 'https:' | json }}
      {%- endif -%}
    ]{% endif %},
    "offers": {
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
      "price": {{ ki_seo_variant.price | divided_by: 100.0 | json }},
      "availability": {{ ki_availability | json }},
      "itemCondition": "https://schema.org/NewCondition",
      "url": {{ canonical_url | json }},
      "seller": { "@id": "https://www.carewithki.com/#organization" }
    }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Ana Sayfa", "item": {{ shop.url | json }} },
      { "@type": "ListItem", "position": 2, "name": "Ürünler", "item": {{ shop.url | append: routes.all_products_collection_url | json }} },
      { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ canonical_url | json }} }
    ]
  }
  </script>

  {%- if ki_ped_bundle_handles contains ki_product_token -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Ped paketi tek seferlik satın alınabilir mi?", "acceptedAnswer": { "@type": "Answer", "text": "Evet. Hazır ped paketi tek seferlik ürün olarak sepete eklenebilir." } },
        { "@type": "Question", "name": "Hazır ped paketine abone olunabilir mi?", "acceptedAnswer": { "@type": "Answer", "text": "Evet. Pakete Abone Ol seçeneği paketi abonelik oluşturucuda seçili açar ve gönderim sıklığını belirlemeni sağlar." } },
        { "@type": "Question", "name": "Ped aboneliği daha sonra değiştirilebilir mi?", "acceptedAnswer": { "@type": "Answer", "text": "Evet. Gönderim sıklığı değiştirilebilir, gönderim duraklatılabilir veya abonelik iptal edilebilir." } }
      ]
    }
    </script>
  {%- endif -%}

{%- elsif request.page_type == 'collection' and collection -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": {{ canonical_url | append: '#collection' | json }},
    "name": {{ ki_seo_title | json }},
    "description": {{ ki_seo_description | json }},
    "url": {{ canonical_url | json }},
    "isPartOf": { "@type": "WebSite", "name": ".ki", "url": {{ shop.url | json }} },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": {{ collection.products_count | json }},
      "itemListElement": [
        {%- for listed_product in collection.products limit: 24 -%}
          { "@type": "ListItem", "position": {{ forloop.index }}, "url": {{ listed_product.url | prepend: shop.url | json }}, "name": {{ listed_product.title | json }} }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  }
  </script>

{%- elsif request.page_type == 'page' and page -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": {{ canonical_url | append: '#webpage' | json }},
    "name": {{ ki_seo_title | json }},
    "description": {{ ki_seo_description | json }},
    "url": {{ canonical_url | json }},
    "inLanguage": {{ request.locale.iso_code | json }},
    "isPartOf": { "@type": "WebSite", "name": ".ki", "url": {{ shop.url | json }} },
    "publisher": { "@type": "Organization", "name": ".ki", "url": {{ shop.url | json }} }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Ana Sayfa", "item": {{ shop.url | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ canonical_url | json }} }
    ]
  }
  </script>
{%- endif -%}
